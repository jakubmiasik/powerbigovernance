<%
  // Select. { ui: { id, name, label, options: [{ value, label, selected }], help, error, disabled, size: sm, attrs: {} } }
  var p = (typeof ui !== 'undefined' && ui) || {};
  function pdAttrs(o) { return Object.keys(o || {}).map(function (k) { var v = o[k]; if (v === false || v === null || v === undefined) return ""; return " " + k + (v === true ? "" : "=\"" + String(v).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;") + "\""); }).join(""); }
  var described = [p.help ? p.id + '-help' : null, p.error ? p.id + '-error' : null].filter(Boolean).join(' ');
  var extra = Object.assign({}, p.attrs || {});
  if (described) extra['aria-describedby'] = described;
  if (p.error) extra['aria-invalid'] = 'true';
  if (!p.label && p.ariaLabel) extra['aria-label'] = p.ariaLabel;
%><div class="pd-field">
  <% if (p.label) { %><label class="pd-label" for="<%= p.id %>"><%= p.label %></label><% } %>
  <select class="pd-select<%= p.size === 'sm' ? ' pd-select--sm' : '' %>" id="<%= p.id %>" name="<%= p.name || p.id %>"<%= p.disabled ? ' disabled' : '' %><%- pdAttrs(extra) %>>
    <% (p.options || []).forEach(function (o) { %><option value="<%= o.value %>"<%= o.selected ? ' selected' : '' %>><%= o.label %></option><% }) %>
  </select>
  <% if (p.help) { %><span class="pd-help" id="<%= p.id %>-help"><%= p.help %></span><% } %>
  <% if (p.error) { %><span class="pd-error-text" id="<%= p.id %>-error"><i data-lucide="circle-alert" aria-hidden="true"></i><%= p.error %></span><% } %>
</div>
