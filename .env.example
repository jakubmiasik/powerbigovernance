# =============================================================================
# Entra ID - Web App Registration (for user sign-in to this app)
# =============================================================================
# Register an app in Entra ID > App registrations
# Set redirect URI to: http://localhost:3000/auth/callback
ENTRA_CLIENT_ID=your-web-app-client-id
ENTRA_CLIENT_SECRET=your-web-app-client-secret
ENTRA_TENANT_ID=your-tenant-id

# =============================================================================
# Power BI Service Principal (for API access)
# =============================================================================
# Register a separate app in Entra ID for Power BI API access
# Grant it Power BI Service permissions (Tenant.Read.All, Tenant.ReadWrite.All)
# Add the SP to a security group and enable it in Power BI Admin Portal
POWERBI_CLIENT_ID=your-powerbi-sp-client-id
POWERBI_CLIENT_SECRET=your-powerbi-sp-client-secret
POWERBI_TENANT_ID=your-tenant-id

# =============================================================================
# Session
# =============================================================================
SESSION_SECRET=change-this-to-a-random-string

# =============================================================================
# Server
# =============================================================================
PORT=3000

# =============================================================================
# Azure SQL
# =============================================================================
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database-name

# =============================================================================
# Runtime tuning
# =============================================================================
RUN_CACHE_TTL_MS=30000
# How many minutes back the capacity scheduler looks for a schedule that came due
# while the app was restarting or idle (0 disables catch-up).
SCHEDULER_CATCHUP_MINUTES=20
# Longest a single throttled request may wait before retrying, in ms. Power BI can
# send a Retry-After of many minutes; this caps it so a run reports slow progress
# rather than appearing frozen.
API_MAX_RETRY_DELAY_MS=120000
# Seconds without any progress update before an analysis run is flagged as stalled.
ANALYSIS_STALL_SECONDS=90
# Collect per-artifact details during the analysis run so opening an artifact is a
# database read instead of a burst of API calls. Set to false to skip the phase.
ANALYSIS_COLLECT_DETAILS=true
# How many artifacts to read details for concurrently during a run.
ANALYSIS_DETAIL_CONCURRENCY=4
# Cap on how many artifacts a run collects details for (0 = no cap). Anything past
# the cap is still available; it loads on first view instead.
ANALYSIS_DETAIL_MAX_ITEMS=2000
