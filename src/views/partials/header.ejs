<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark' : 'light' %>" data-bs-theme="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark' : 'light' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Power BI Governance</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<%
  var pagePath = typeof currentPath !== 'undefined' ? currentPath : '';
  var breadcrumbItems = typeof breadcrumb !== 'undefined' ? breadcrumb : [];
%>

<div class="app-layout">
  <!-- Sidebar backdrop (mobile) -->
  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="appSidebar">
    <a href="/" class="sidebar-brand">
      <span class="brand-logo">G</span>
      <span class="brand-text">Power BI Governance<small>Admin Portal</small></span>
    </a>

    <nav class="sidebar-nav">
      <p class="nav-section-title">Main</p>
      <a href="/" class="sidebar-link <%= pagePath === '/' || pagePath === '/home' ? 'active' : '' %>" title="Home">
        <i class="bi bi-house"></i> <span>Home</span>
      </a>
      <a href="/workspaces" class="sidebar-link <%= pagePath.startsWith('/workspaces') ? 'active' : '' %>" title="Workspaces">
        <i class="bi bi-collection"></i> <span>Workspaces</span>
      </a>
      <a href="/governance" class="sidebar-link <%= pagePath.startsWith('/governance') ? 'active' : '' %>" title="Governance">
        <i class="bi bi-shield-check"></i> <span>Governance</span>
      </a>

      <p class="nav-section-title">Operations</p>
      <a href="/analysis" class="sidebar-link <%= pagePath.startsWith('/analysis') ? 'active' : '' %>" title="Run Analysis">
        <i class="bi bi-play-circle"></i> <span>Run Analysis</span>
      </a>
      <a href="/migrate" class="sidebar-link <%= pagePath.startsWith('/migrate') ? 'active' : '' %>" title="Migrate">
        <i class="bi bi-arrow-left-right"></i> <span>Migrate</span>
      </a>
      <a href="/capacities" class="sidebar-link <%= pagePath.startsWith('/capacities') ? 'active' : '' %>" title="Capacities">
        <i class="bi bi-lightning"></i> <span>Capacities</span>
      </a>

      <p class="nav-section-title">Settings</p>
      <a href="/settings" class="sidebar-link <%= pagePath.startsWith('/settings') ? 'active' : '' %>" title="Configuration">
        <i class="bi bi-gear"></i> <span>Configuration</span>
      </a>

      <!-- Collapse toggle -->
      <a href="#" class="sidebar-link mt-2" onclick="collapseSidebar(event)" title="Collapse sidebar" id="collapseLink">
        <i class="bi bi-layout-sidebar-inset" id="collapseIcon"></i> <span>Collapse</span>
      </a>
    </nav>

    <!-- Sidebar footer: user info -->
    <div class="sidebar-footer">
      <% if (currentUser) { %>
        <div class="sidebar-user">
          <div class="sidebar-user-avatar"><%= (currentUser.name || 'U').charAt(0).toUpperCase() %></div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name"><%= currentUser.name %></div>
            <div class="sidebar-user-email"><%= currentUser.email || '' %></div>
          </div>
        </div>
        <a href="/.auth/logout?post_logout_redirect_uri=/" class="sidebar-link mt-1" style="font-size:0.8rem;">
          <i class="bi bi-box-arrow-right"></i> <span>Sign Out</span>
        </a>
      <% } else { %>
        <a href="/.auth/login/aad?post_login_redirect_uri=<%= encodeURIComponent('/') %>" class="sidebar-link">
          <i class="bi bi-box-arrow-in-right"></i> <span>Sign In</span>
        </a>
      <% } %>
    </div>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <button class="btn btn-sm mobile-toggle" onclick="toggleSidebar()" style="border:1px solid var(--color-border);width:34px;height:34px;display:none;">
        <i class="bi bi-list"></i>
      </button>

      <!-- Breadcrumb -->
      <nav class="topbar-breadcrumb">
        <a href="/"><i class="bi bi-house-fill"></i></a>
        <% if (breadcrumbItems.length) { %>
          <% breadcrumbItems.forEach(function(item, idx) { %>
            <span class="separator">/</span>
            <% if (idx === breadcrumbItems.length - 1) { %>
              <span class="current"><%= item.label %></span>
            <% } else { %>
              <a href="<%= item.href %>"><%= item.label %></a>
            <% } %>
          <% }) %>
        <% } %>
      </nav>

      <!-- Top bar actions -->
      <div class="topbar-actions">
        <span class="topbar-timestamp" id="lastRefreshed"></span>
        <button class="btn-density-toggle" onclick="toggleDensity()" title="Toggle compact/comfortable view (Ctrl+D)">
          <i class="bi bi-distribute-vertical" id="densityIcon"></i>
        </button>
        <button class="btn-theme-toggle" onclick="toggleTheme()" title="Toggle dark/light mode (Ctrl+Shift+D)">
          <i class="bi bi-moon" id="themeIcon"></i>
        </button>
      </div>
    </header>

    <!-- Run selector -->
    <%
      // Pages that show one specific run (analysis results and anything reached from
      // them) lock the selector: switching scans there would silently contradict the
      // run whose data is on screen.
      var runSelectorLocked = typeof lockRunSelector !== 'undefined' && lockRunSelector;
      var lockedRunId = typeof lockedRun !== 'undefined' && lockedRun ? lockedRun.id : null;
      var runSelectorValue = runSelectorLocked && lockedRunId ? lockedRunId : (typeof selectedRunId !== 'undefined' ? selectedRunId : null);
    %>
    <% if (typeof availableRuns !== 'undefined' && availableRuns && availableRuns.length > 0) { %>
      <div class="run-selector-bar">
        <span class="fw-bold small text-nowrap" style="color: var(--color-primary);"><i class="bi bi-building me-1"></i>Service Principal / Scan:</span>
        <select class="form-select form-select-sm" style="max-width: 440px;" id="globalRunSelector" onchange="switchGlobalRun(this.value)" <%= runSelectorLocked ? 'disabled' : '' %>>
          <%
            var runsBySp = {};
            availableRuns.forEach(function(r) {
              var spName = r.sp_name || 'Unknown Service Principal';
              if (!runsBySp[spName]) runsBySp[spName] = [];
              runsBySp[spName].push(r);
            });
            Object.keys(runsBySp).sort(function(a, b) { return a.localeCompare(b); }).forEach(function(spName) {
              var spRuns = runsBySp[spName].slice().sort(function(a, b) {
                var aTs = a.started_at ? new Date(a.started_at).getTime() : 0;
                var bTs = b.started_at ? new Date(b.started_at).getTime() : 0;
                return bTs - aTs;
              });
          %>
            <optgroup label="<%= spName %>">
              <% spRuns.forEach(function(r) { %>
                <option value="<%= r.id %>" <%= (runSelectorValue === r.id) ? 'selected' : '' %>>
                  <%= spName %>: Run#<%= r.id %> &mdash; <%= r.started_at ? new Date(r.started_at).toLocaleString() : 'N/A' %>
                </option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
        <% if (runSelectorLocked) { %>
          <% var lockedInfo = (typeof lockedRun !== 'undefined' && lockedRun) ? lockedRun : null; %>
          <span class="badge bg-primary"><i class="bi bi-eye me-1"></i>Viewing Run #<%= lockedInfo ? lockedInfo.id : '-' %></span>
          <span class="small" style="color: var(--color-text-muted);">
            <i class="bi bi-lock me-1"></i>Scan switching is disabled while exploring this run.
          </span>
        <% } else if (typeof globalRun !== 'undefined' && globalRun) { %>
          <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>Run #<%= globalRun.id %></span>
          <span class="small" style="color: var(--color-text-muted);">Workspaces: <%= globalRun.total_workspaces || '-' %> | Reports: <%= globalRun.total_reports || '-' %></span>
        <% } %>
      </div>
    <% } %>

    <!-- Page content -->
    <div class="page-content">

<script>
function switchGlobalRun(runId) {
  if (typeof showPageReloading === 'function') {
    showPageReloading('Loading selected scan...');
  }
  fetch('/api/select-run', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ runId: parseInt(runId) })
  }).then(function() { window.location.reload(); }).catch(function(err) {
    var overlay = document.getElementById('reloadOverlay');
    if (overlay) overlay.classList.add('d-none');
    if (typeof showToast === 'function') showToast('Failed to switch scan: ' + err.message, 'error');
  });
}

function goBackOr(fallbackUrl) {
  if (document.referrer && document.referrer !== window.location.href) {
    window.history.back();
    return;
  }
  window.location.href = fallbackUrl || '/';
}

function toggleSidebar() {
  document.getElementById('appSidebar').classList.toggle('show');
  document.getElementById('sidebarBackdrop').classList.toggle('show');
}

function collapseSidebar(e) {
  if (e) e.preventDefault();
  var sidebar = document.getElementById('appSidebar');
  var isCollapsed = sidebar.classList.toggle('collapsed');
  document.body.classList.toggle('sidebar-collapsed', isCollapsed);
  localStorage.setItem('pbi-gov-sidebar', isCollapsed ? 'collapsed' : 'expanded');
  var icon = document.getElementById('collapseIcon');
  icon.className = isCollapsed ? 'bi bi-layout-sidebar-inset-reverse' : 'bi bi-layout-sidebar-inset';
}

// Theme
function toggleTheme() {
  var html = document.documentElement;
  var current = html.getAttribute('data-theme');
  var next = current === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  // Bootstrap components (list groups, tables, dropdowns, bg-body-*) read
  // data-bs-theme. Without it they stay light and their text becomes unreadable.
  html.setAttribute('data-bs-theme', next);
  localStorage.setItem('pbi-gov-theme', next);
  updateThemeIcon(next);
  showToast('Theme switched to ' + next + ' mode', 'info');
}
function updateThemeIcon(theme) {
  var icon = document.getElementById('themeIcon');
  icon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon';
}

// Density
function toggleDensity() {
  var body = document.body;
  var current = body.getAttribute('data-density');
  var next = current === 'compact' ? 'comfortable' : 'compact';
  body.setAttribute('data-density', next);
  localStorage.setItem('pbi-gov-density', next);
  var icon = document.getElementById('densityIcon');
  icon.className = next === 'compact' ? 'bi bi-distribute-horizontal' : 'bi bi-distribute-vertical';
  showToast('View: ' + next, 'info');
}

// Apply saved preferences
(function() {
  var savedTheme = localStorage.getItem('pbi-gov-theme');
  if (savedTheme) {
    document.documentElement.setAttribute('data-theme', savedTheme);
    document.documentElement.setAttribute('data-bs-theme', savedTheme);
    updateThemeIcon(savedTheme);
  } else {
    updateThemeIcon('light');
  }
  var savedDensity = localStorage.getItem('pbi-gov-density');
  if (savedDensity) {
    document.body.setAttribute('data-density', savedDensity);
    if (savedDensity === 'compact') {
      var icon = document.getElementById('densityIcon');
      if (icon) icon.className = 'bi bi-distribute-horizontal';
    }
  }
  // Sidebar: collapsed by default
  var savedSidebar = localStorage.getItem('pbi-gov-sidebar');
  if (savedSidebar === 'expanded') {
    // user explicitly expanded — keep it open
  } else {
    // default or saved as collapsed
    var sidebar = document.getElementById('appSidebar');
    if (sidebar) { sidebar.classList.add('collapsed'); document.body.classList.add('sidebar-collapsed'); }
    var ci = document.getElementById('collapseIcon');
    if (ci) ci.className = 'bi bi-layout-sidebar-inset-reverse';
  }
  // Last refreshed timestamp
  var ts = document.getElementById('lastRefreshed');
  if (ts) {
    var updateTopClock = function() { ts.textContent = new Date().toLocaleTimeString(); };
    updateTopClock();
    setInterval(updateTopClock, 1000);
  }
})();
</script>
