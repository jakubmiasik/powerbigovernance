<!DOCTYPE html>
<html lang="en" data-product="governance" data-pd-variant="enterprise" data-theme="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark' : 'light' %>" data-bs-theme="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark' : 'light' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Fabric Governance</title>
  <script>
    // Applied before first paint so a saved theme, density or collapsed sidebar does
    // not flash the default. Reads the Podavo keys, then the ones this app used before.
    (function () {
      var root = document.documentElement;
      function pref(a, b) { try { return localStorage.getItem(a) || localStorage.getItem(b); } catch (e) { return null; } }
      var theme = pref('pd-theme', 'pbi-gov-theme');
      if (theme === 'dark' || theme === 'light') { root.setAttribute('data-theme', theme); root.setAttribute('data-bs-theme', theme); }
      var density = pref('pd-density', 'pbi-gov-density');
      if (density === 'compact' || density === 'comfortable') root.setAttribute('data-density', density);
      if (pref('pd-sidebar', 'pbi-gov-sidebar') === 'collapsed') root.setAttribute('data-sidebar', 'collapsed');
    })();
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%# Bootstrap Icons stay loaded as the fallback while pages migrate to Lucide. %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/podavo-ui/css/podavo.css" rel="stylesheet">
  <link href="/podavo-ui/css/bootstrap-bridge.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<%
  function escapeFn(v) { return String(v === null || v === undefined ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  var pagePath = typeof currentPath !== 'undefined' ? currentPath : '';
  var breadcrumbItems = typeof breadcrumb !== 'undefined' ? breadcrumb : [];

  // ── Navigation ──
  // Built from the sections this user may actually reach: a link that leads to a
  // refusal is worse than no link. The menu is not the restriction — middleware in
  // front of every route is — but it defaults to showing nothing rather than
  // everything, so a missing local can never advertise more than it should.
  var navSections = typeof visibleSections !== 'undefined' && visibleSections ? visibleSections : [];
  var isAdminUser = Boolean(typeof permissions !== 'undefined' && permissions && permissions.isAdmin);
  var groupOrder = (typeof navGroups !== 'undefined' && navGroups && navGroups.length)
    ? navGroups.slice()
    : ['Overview', 'Governance', 'Operations', 'Data Quality', 'Configuration'];
  // Only the most specific section is active: /quality/security-groups lights up
  // Security Groups, not Quality Configuration as well.
  var activeSectionKey = null;
  var activePrefixLength = -1;
  navSections.forEach(function(section) {
    section.prefixes.forEach(function(prefix) {
      if ((pagePath === prefix || pagePath.indexOf(prefix + '/') === 0) && prefix.length > activePrefixLength) {
        activePrefixLength = prefix.length;
        activeSectionKey = section.key;
      }
    });
  });
  function navActive(section) {
    return section.key === activeSectionKey;
  }
  var navByGroup = {};
  function addEntry(group, entry) {
    if (groupOrder.indexOf(group) === -1) groupOrder.push(group);
    (navByGroup[group] = navByGroup[group] || []).push(entry);
  }
  // Getting Started sits above Home in the menu; Home is still where sign-in lands.
  addEntry('Overview', { href: '/getting-started', label: 'Getting Started', icon: 'clipboard-check', fallbackClass: 'bi bi-clipboard-check', active: pagePath === '/getting-started' });
  addEntry('Overview', { href: '/', label: 'Home', icon: 'house', fallbackClass: 'bi bi-house', active: pagePath === '/' || pagePath === '/home' });
  // Since the Last Scan lives under the Governance Overview grant (/governance/changes),
  // so it shows exactly when that section does and needs no grant of its own.
  var canSeeGovernance = navSections.some(function(s) { return s.key === 'governance' && !s.adminOnly; });
  var onChanges = pagePath === '/governance/changes' || pagePath.indexOf('/governance/changes/') === 0;
  if (canSeeGovernance) {
    addEntry('Overview', { href: '/governance/changes', label: 'Since Last Scan', icon: 'git-compare-arrows', fallbackClass: 'bi bi-clock-history', active: onChanges });
  }
  navSections.forEach(function(section) {
    if (section.adminOnly) return;
    addEntry(section.group, { href: section.href, label: section.label, icon: section.lucide || 'circle', fallbackClass: 'bi ' + section.icon, active: navActive(section) && !(section.key === 'governance' && onChanges) });
  });
  // Admin-only pages are not grantable sections; they show to administrators only,
  // and the routes behind them check the same thing.
  if (isAdminUser) {
    addEntry('Configuration', { href: '/settings', label: 'Configuration', icon: 'settings', fallbackClass: 'bi bi-gear', active: pagePath === '/settings' });
    addEntry('Configuration', { href: '/settings/permissions', label: 'Users & Access', icon: 'user-cog', fallbackClass: 'bi bi-person-badge', active: pagePath.indexOf('/settings/permissions') === 0 });
    addEntry('Configuration', { href: '/settings/access', label: 'Grant Access', icon: 'key-round', fallbackClass: 'bi bi-key', active: pagePath.indexOf('/settings/access') === 0 });
    addEntry('Configuration', { href: '/settings/governance', label: 'Governance Configuration', icon: 'ruler', fallbackClass: 'bi bi-rulers', active: pagePath.indexOf('/settings/governance') === 0 });
    addEntry('Configuration', { href: '/settings/audit', label: 'Audit Log', icon: 'scroll-text', fallbackClass: 'bi bi-journal-text', active: pagePath.indexOf('/settings/audit') === 0 });
  }
  var navGroupsForSidebar = groupOrder.map(function(group) { return { title: group, items: navByGroup[group] || [] }; });
  var canSearchWorkspaces = navSections.some(function(s) { return s.key === 'workspaces'; });

  // ── Scan context ──
  // Pages that show one specific run lock the selector: switching scans there would
  // silently contradict the run whose data is on screen. Pages with nothing to do
  // with a scan hide it rather than showing a control that does not affect them.
  var runSelectorLocked = typeof lockRunSelector !== 'undefined' && lockRunSelector;
  var lockedRunId = typeof lockedRun !== 'undefined' && lockedRun ? lockedRun.id : null;
  var runSelectorValue = runSelectorLocked && lockedRunId ? lockedRunId : (typeof selectedRunId !== 'undefined' ? selectedRunId : null);
  var suppressRunSelector = typeof hideRunSelector !== 'undefined' && hideRunSelector;
  var runList = typeof availableRuns !== 'undefined' && availableRuns ? availableRuns : [];
  var activeRun = typeof globalRun !== 'undefined' && globalRun ? globalRun : null;
  var storeDown = typeof runsLoadError !== 'undefined' && runsLoadError;
  var scanTime = activeRun ? (activeRun.completed_at || activeRun.started_at) : null;
  var scanIso = null;
  if (scanTime) { var parsedScan = new Date(scanTime); scanIso = isNaN(parsedScan.getTime()) ? null : parsedScan.toISOString(); }
  // What the data on screen rests on. Each state is a fact the server already knows.
  var dataStatus;
  if (storeDown) {
    dataStatus = { tone: 'danger', label: 'Data store unavailable', title: 'The application database could not be read. Scans cannot be listed until it is reachable.' };
  } else if (!runList.length) {
    dataStatus = { tone: 'warning', label: 'No completed scan', title: 'No completed analysis scan is available to you yet.' };
  } else if (runSelectorLocked) {
    dataStatus = { tone: 'info', label: 'Viewing a fixed scan', title: 'This page shows one specific run; scan switching is disabled here.' };
  } else {
    dataStatus = { tone: 'success', label: 'Scan data loaded', title: 'Pages show data from the selected completed scan.' };
  }
  var userName = typeof currentUser !== 'undefined' && currentUser ? (currentUser.name || 'User') : null;
  var initials = userName ? userName.split(/\s+/).filter(Boolean).slice(0, 2).map(function(w) { return w.charAt(0); }).join('').toUpperCase() : '';

  // ── Top bar actions ── only things that exist: there is no notification feed, so no bell.
  var pd = '../../../packages/podavo-ui/ejs/';
  var actionsHtml = include(pd + 'icon-button', { ui: { icon: 'keyboard', label: 'Keyboard shortcuts (?)', attrs: { 'data-bs-toggle': 'modal', 'data-bs-target': '#kbdModal' } } })
    + '<button type="button" class="pd-icon-btn" data-pd-density-toggle onclick="toggleDensity()" id="densityToggle" aria-pressed="false" aria-label="Switch to compact rows"><i data-lucide="rows-3" aria-hidden="true"></i></button>'
    + '<button type="button" class="pd-icon-btn" data-pd-theme-toggle onclick="toggleTheme()" id="themeToggle" aria-label="Switch to dark theme"><i data-lucide="moon" aria-hidden="true"></i></button>'
    + (isAdminUser ? include(pd + 'icon-button', { ui: { icon: 'settings', label: 'Configuration', href: '/settings' } }) : '');
  if (userName) {
    actionsHtml += '<div class="pd-popover-anchor">'
      + '<button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" data-pd-popover="accountMenu" aria-controls="accountMenu" aria-expanded="false" aria-haspopup="menu" aria-label="Account: ' + escapeFn(userName) + '">'
      + '<span class="pd-avatar pd-avatar--solid" aria-hidden="true">' + escapeFn(initials) + '</span><i data-lucide="chevron-down" aria-hidden="true"></i></button>'
      + '<div class="pd-popover pd-popover--end pd-menu" id="accountMenu" role="menu" hidden>'
      + '<div class="pd-person" style="padding:8px 12px"><span class="pd-avatar pd-avatar--lg" aria-hidden="true">' + escapeFn(initials) + '</span><span class="pd-min-w-0"><strong class="d-block">' + escapeFn(userName) + '</strong><span class="small text-muted">' + escapeFn((currentUser && currentUser.email) || '') + '</span></span></div>'
      + '<div class="pd-menu-sep" role="separator"></div>'
      + '<a class="pd-menu-item" role="menuitem" href="/.auth/logout?post_logout_redirect_uri=/"><i data-lucide="log-out" aria-hidden="true"></i>Sign out</a>'
      + '</div></div>';
  } else {
    actionsHtml += '<a class="pd-btn pd-btn--sm" href="/.auth/login/aad?post_login_redirect_uri=%2F"><i data-lucide="log-in" aria-hidden="true"></i><span>Sign in</span></a>';
  }

  // ── Scan context band: which tenant, which scan, whether the data is there ──
  var showSelector = !suppressRunSelector && runList.length > 0;
  var ctx = '<div class="gov-context" role="region" aria-label="Tenant and scan context">';
  if (showSelector) {
    ctx += '<label for="globalRunSelector" class="gov-context-label">Service Principal / Scan</label>';
    var runsBySp = {};
    runList.forEach(function(r) {
      var spName = r.sp_name || 'Unknown Service Principal';
      (runsBySp[spName] = runsBySp[spName] || []).push(r);
    });
    // Scans are named by principal and that principal's own number; the id is only
    // the value sent back to the server.
    var labelOf = typeof runLabel === 'function' ? runLabel : function(r) {
      return (r.sp_name || 'Unknown principal') + (r.sp_run_number ? ' #' + r.sp_run_number : ' (unnumbered, id ' + r.id + ')');
    };
    ctx += '<span class="gov-context-select"><span class="pd-dot pd-dot--' + dataStatus.tone + '" aria-hidden="true"></span>'
      + '<select class="pd-select pd-select--sm" id="globalRunSelector" onchange="switchGlobalRun(this.value)"' + (runSelectorLocked ? ' disabled' : '') + '>';
    Object.keys(runsBySp).sort(function(a, b) { return a.localeCompare(b); }).forEach(function(spName) {
      var spRuns = runsBySp[spName].slice().sort(function(a, b) {
        var aTs = a.started_at ? new Date(a.started_at).getTime() : 0;
        var bTs = b.started_at ? new Date(b.started_at).getTime() : 0;
        return bTs - aTs;
      });
      ctx += '<optgroup label="' + escapeFn(spName) + '">';
      spRuns.forEach(function(r) {
        ctx += '<option value="' + escapeFn(r.id) + '"' + (runSelectorValue === r.id ? ' selected' : '')
          + ' title="' + escapeFn(r.scopeTagTitle || '') + '">'
          + '[' + escapeFn(r.scopeTag || 'WT') + '] ' + escapeFn(labelOf(r)) + ' &mdash; '
          + escapeFn(r.started_at ? new Date(r.started_at).toLocaleString() : 'N/A') + '</option>';
      });
      ctx += '</optgroup>';
    });
    ctx += '</select></span>';
    if (activeRun && activeRun.scopeTag) {
      ctx += '<span class="pd-badge pd-badge--' + (activeRun.scopeTag === 'WT' ? 'neutral' : 'info') + '" title="' + escapeFn(activeRun.scopeTagTitle) + '">' + escapeFn(activeRun.scopeTag) + '</span>';
    }
    if (runSelectorLocked) {
      var lockedInfo = (typeof lockedRun !== 'undefined' && lockedRun) ? lockedRun : null;
      ctx += '<span class="pd-badge pd-badge--brand"><i data-lucide="eye" aria-hidden="true"></i>Viewing ' + escapeFn(lockedInfo ? labelOf(lockedInfo) : '-') + '</span>'
        + '<span class="gov-context-note"><i data-lucide="lock" aria-hidden="true"></i>Scan switching is disabled while exploring this run.</span>';
    } else if (activeRun) {
      ctx += '<span class="pd-badge pd-badge--brand"><i data-lucide="play" aria-hidden="true"></i>' + escapeFn(labelOf(activeRun)) + '</span>'
        + '<span class="gov-context-stats hide-below-1440">Workspaces: <strong>' + escapeFn(activeRun.total_workspaces || '-') + '</strong> <span aria-hidden="true">|</span> Reports: <strong>' + escapeFn(activeRun.total_reports || '-') + '</strong></span>';
    }
  } else {
    ctx += '<span class="gov-context-label">Tenant</span>' + (activeRun
      ? '<strong>' + escapeFn(activeRun.sp_name || 'Unnamed service principal') + '</strong>'
      : '<span class="pd-not-evaluated">Not selected</span>');
  }
  ctx += '<span class="gov-context-end">';
  if (activeRun && activeRun.tenant_id) {
    ctx += '<span class="gov-context-tenant" title="Tenant ID ' + escapeFn(activeRun.tenant_id) + '"><i data-lucide="building-2" aria-hidden="true"></i><span>' + escapeFn(activeRun.tenant_id) + '</span></span>';
  }
  ctx += '<span class="gov-context-status" title="' + escapeFn(dataStatus.title) + '"><span class="pd-dot pd-dot--' + dataStatus.tone + '" aria-hidden="true"></span>' + escapeFn(dataStatus.label) + '</span>';
  if (scanIso) {
    ctx += '<span class="gov-context-time"><i data-lucide="history" aria-hidden="true"></i>Scanned <time datetime="' + scanIso + '" data-local-time>' + scanIso.replace('T', ' ').slice(0, 16) + ' UTC</time></span>';
  }
  if (!storeDown && !runList.length && !suppressRunSelector) {
    ctx += '<a href="/analysis" class="pd-btn pd-btn--sm pd-btn--soft"><i data-lucide="circle-play" aria-hidden="true"></i><span>Run an analysis</span></a>';
  }
  if (showSelector) {
    ctx += '<button type="button" class="pd-icon-btn pd-icon-btn--outline pd-icon-btn--sm" onclick="reloadPageWithMessage(\'Refreshing…\')" aria-label="Refresh this page" title="Refresh"><i data-lucide="refresh-cw" aria-hidden="true"></i></button>';
  }
  ctx += '</span></div>';
%>
<%- include(pd + 'app-shell-start', { ui: {
  sidebar: {
    id: 'appSidebar',
    brand: { name: 'Fabric Governance', href: '/', mark: 'shield-check' },
    groups: navGroupsForSidebar
  },
  breadcrumb: breadcrumbItems,
  search: {
    id: 'globalSearch',
    placeholder: canSearchWorkspaces ? 'Search pages and workspaces…' : 'Search pages…',
    label: 'Search pages and workspaces',
    targets: canSearchWorkspaces ? [{ label: 'Workspaces matching “{q}”', href: '/workspaces?q={q}', hint: 'Workspace triage', icon: 'layers' }] : []
  },
  actionsHtml: actionsHtml,
  contextHtml: ctx
} }) %>

<script>
function switchGlobalRun(runId) {
  if (typeof showPageReloading === 'function') showPageReloading('Loading selected scan...');
  fetch('/api/select-run', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ runId: parseInt(runId) })
  }).then(function() { window.location.reload(); }).catch(function(err) {
    var overlay = document.getElementById('reloadOverlay');
    if (overlay) overlay.classList.add('d-none');
    if (typeof showToast === 'function') showToast('Failed to switch scan: ' + err.message, 'error');
  });
}
function goBackOr(fallbackUrl) {
  if (document.referrer && document.referrer !== window.location.href) { window.history.back(); return; }
  window.location.href = fallbackUrl || '/';
}
// Shell controls delegate to @podavo/ui; the names stay for the shortcuts and older pages.
function toggleSidebar() { if (window.Podavo) Podavo.shell.toggleNav(); }
function collapseSidebar(e) { if (e) e.preventDefault(); if (window.Podavo) Podavo.shell.toggleCollapse(); }
function toggleTheme() { if (window.Podavo) Podavo.shell.toggleTheme(); }
function toggleDensity() {
  if (!window.Podavo) return;
  var next = Podavo.shell.toggleDensity();
  if (typeof showToast === 'function') showToast(next === 'compact' ? 'Compact rows' : 'Comfortable rows', 'info');
}
</script>
