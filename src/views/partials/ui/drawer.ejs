<%
  // Shell for a contextual details panel. The page fills #<id>-body (and
  // optionally #<id>-footer) from its own data, then calls Drawer.open('<id>').
  //   include('partials/ui/drawer', { ui: { id, title, subtitle } })
  // It is a modal dialog while open: focus moves in, Tab stays in, Escape closes,
  // and focus returns to whatever opened it. Below 768 px it fills the screen.
  var d = (typeof ui !== 'undefined' && ui) ? ui : {};
%>
<div class="drawer" id="<%= d.id %>" role="dialog" aria-modal="true" aria-labelledby="<%= d.id %>-title" aria-hidden="true" tabindex="-1">
  <div class="drawer-header">
    <div class="min-w-0">
      <h2 class="drawer-title" id="<%= d.id %>-title"><%= d.title || 'Details' %></h2>
      <div class="drawer-subtitle" id="<%= d.id %>-subtitle"><%= d.subtitle || '' %></div>
    </div>
    <button type="button" class="btn-close drawer-close" data-drawer-close aria-label="Close details"></button>
  </div>
  <div class="drawer-body" id="<%= d.id %>-body"></div>
  <div class="drawer-footer" id="<%= d.id %>-footer"></div>
</div>
