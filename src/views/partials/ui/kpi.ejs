<%
  // One headline number. include('partials/ui/kpi', { ui: { label, value, hint, icon, tone, href, title } })
  // A value of null or undefined renders as "Not evaluated" — a number is never
  // made up to fill the tile.
  var k = (typeof ui !== 'undefined' && ui) ? ui : {};
  var missing = k.value === null || k.value === undefined;
  var tag = k.href ? 'a' : 'div';
%>
<<%= tag %> class="kpi tone-<%= k.tone || 'neutral' %>"<% if (k.href) { %> href="<%= k.href %>"<% } %><% if (k.title) { %> title="<%= k.title %>"<% } %>>
  <span class="kpi-label"><% if (k.icon) { %><i class="bi <%= k.icon %>" aria-hidden="true"></i><% } %><%= k.label %></span>
  <% if (missing) { %>
    <span class="kpi-value is-unavailable"><%= k.unavailableText || 'Not evaluated' %></span>
  <% } else { %>
    <span class="kpi-value"><%= k.value %></span>
  <% } %>
  <% if (k.hint) { %><span class="kpi-hint"><%= k.hint %></span><% } %>
</<%= tag %>>
