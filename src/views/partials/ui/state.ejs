<%
  // One way to say "there is nothing here", "this failed", "you may not see this"
  // or "this was not evaluated". Pass everything in a `ui` object:
  //   include('partials/ui/state', { ui: { kind, title, message, icon, actions, compact } })
  //   kind:    'empty' | 'error' | 'denied' | 'loading' | 'unavailable'
  //   actions: [{ href, label, icon, primary }]
  // The partial is namespaced because EJS includes inherit the page's locals, and
  // a bare `title` would silently pick up the page title.
  var s = (typeof ui !== 'undefined' && ui) ? ui : {};
  var kind = s.kind || 'empty';
  var defaultIcons = { empty: 'bi-inbox', error: 'bi-exclamation-octagon', denied: 'bi-shield-lock', loading: 'bi-hourglass-split', unavailable: 'bi-dash-circle' };
  var role = kind === 'error' ? 'alert' : 'status';
%>
<div class="state is-<%= kind %><%= s.compact ? ' is-compact' : '' %>" role="<%= role %>"<% if (kind === 'loading') { %> aria-busy="true"<% } %>>
  <div class="state-icon" aria-hidden="true">
    <% if (kind === 'loading') { %>
      <span class="spinner-border spinner-border-sm"></span>
    <% } else { %>
      <i class="bi <%= s.icon || defaultIcons[kind] || 'bi-info-circle' %>"></i>
    <% } %>
  </div>
  <% if (s.title) { %><p class="state-title"><%= s.title %></p><% } %>
  <% if (s.message) { %><p class="state-message"><%= s.message %></p><% } %>
  <% if (s.actions && s.actions.length) { %>
    <div class="state-actions">
      <% s.actions.forEach(function(action) { %>
        <a href="<%= action.href %>" class="btn btn-sm <%= action.primary ? 'btn-primary' : 'btn-outline-secondary' %>">
          <% if (action.icon) { %><i class="bi <%= action.icon %> me-1" aria-hidden="true"></i><% } %><%= action.label %>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
