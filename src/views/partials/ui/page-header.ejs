<%
  // Page title block. include('partials/ui/page-header', { ui: { title, subtitle, icon } })
  // Page-level actions go in a sibling .page-actions inside the same .page-header,
  // so this partial stays a title and nothing else.
  var h = (typeof ui !== 'undefined' && ui) ? ui : {};
%>
<div>
  <h1><% if (h.icon) { %><i class="bi <%= h.icon %>" aria-hidden="true"></i><% } %><%= h.title %></h1>
  <% if (h.subtitle) { %><p class="page-subtitle"><%= h.subtitle %></p><% } %>
</div>
