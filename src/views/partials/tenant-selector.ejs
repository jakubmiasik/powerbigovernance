<%
  // Expects: selectorType ('sp' or 'run'), items (array), selectedId, targetUrl
  // For 'sp': items = servicePrincipals, fields: id, name, tenant_id
  // For 'run': items = availableRuns, fields: id, sp_name, tenant_id, started_at
%>
<% if (typeof items !== 'undefined' && items && items.length > 0) { %>
  <div class="d-inline-flex align-items-center gap-2">
    <label class="form-label mb-0 text-nowrap small fw-bold"><i class="bi bi-building me-1"></i>Service Principal / Scan:</label>
    <select class="form-select form-select-sm" style="max-width: 380px;" onchange="window.location.href=this.value" <% if (items.length === 1) { %>disabled<% } %>>
      <% items.forEach(function(item) { %>
        <% if (selectorType === 'sp') { %>
          <option value="<%= targetUrl %>?spId=<%= item.id %>" <%= item.id === selectedId ? 'selected' : '' %>><%= item.name %></option>
        <% } else { %>
          <option value="<%= targetUrl %>?runId=<%= item.id %>" <%= item.id === selectedId ? 'selected' : '' %>><%= item.sp_name %>: Run#<%= item.id %> &mdash; <%= item.started_at ? new Date(item.started_at).toLocaleString() : 'N/A' %></option>
        <% } %>
      <% }) %>
    </select>
  </div>
<% } %>
