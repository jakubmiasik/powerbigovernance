<%
  // Expects: selectorType ('sp' or 'run'), items (array), selectedId, targetUrl
  // For 'sp': items = servicePrincipals, fields: id, name, tenant_id
  // For 'run': items = availableRuns, fields: id, sp_name, tenant_id, started_at
%>
<% if (typeof items !== 'undefined' && items && items.length > 1) { %>
  <div class="d-inline-flex align-items-center gap-2">
    <label class="form-label mb-0 text-nowrap small fw-bold"><i class="bi bi-building me-1"></i>Tenant:</label>
    <select class="form-select form-select-sm" style="max-width: 350px;" onchange="window.location.href=this.value">
      <% items.forEach(function(item) { %>
        <% if (selectorType === 'sp') { %>
          <option value="<%= targetUrl %>?spId=<%= item.id %>" <%= item.id === selectedId ? 'selected' : '' %>><%= item.name %> (<%= item.tenant_id %>)</option>
        <% } else { %>
          <option value="<%= targetUrl %>?runId=<%= item.id %>" <%= item.id === selectedId ? 'selected' : '' %>><%= item.sp_name %> (<%= item.tenant_id %>) - <%= item.started_at ? new Date(item.started_at).toLocaleDateString() : '' %></option>
        <% } %>
      <% }) %>
    </select>
  </div>
<% } else if (typeof items !== 'undefined' && items && items.length === 1) { %>
  <div class="d-inline-flex align-items-center gap-2">
    <span class="badge bg-secondary"><i class="bi bi-building me-1"></i>
      <% if (selectorType === 'sp') { %><%= items[0].name %> (<%= items[0].tenant_id %>)<% } else { %><%= items[0].sp_name %> (<%= items[0].tenant_id %>)<% } %>
    </span>
  </div>
<% } %>
