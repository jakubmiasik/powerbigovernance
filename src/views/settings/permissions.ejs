<%- include('../partials/header') %>
<%
  var tenantName = {};
  tenants.forEach(function(tenant) { tenantName[tenant.id] = tenant.name; });
  // Split by the section's own flag when the route did not pass the split, so the
  // page can never offer a tenant-bound section as application-wide or the reverse.
  var tenantDefs = typeof tenantSectionDefs !== 'undefined' && tenantSectionDefs ? tenantSectionDefs : sections.filter(function(section) { return section.tenantScoped; });
  var appDefs = typeof appSectionDefs !== 'undefined' && appSectionDefs ? appSectionDefs : sections.filter(function(section) { return !section.tenantScoped; });
  var tenantKeys = tenantDefs.map(function(section) { return section.key; });
  var sectionLabel = {};
  sections.forEach(function(section) { sectionLabel[section.key] = section.label; });
  // What a row grants in one tenant: its per-tenant sections plus any tenant-bound
  // section stored the older way (one list for every tenant), which still applies.
  function sectionsInTenant(row, spId) {
    var own = (row.tenantSections && (row.tenantSections[spId] || row.tenantSections[String(spId)])) || [];
    var legacy = (row.sectionKeys || []).filter(function(key) { return tenantKeys.indexOf(key) !== -1; });
    return own.concat(legacy).filter(function(key, i, all) { return all.indexOf(key) === i; });
  }
%>
<div class="row">
  <div class="col-xxl-10 mx-auto">
    <h2><i class="bi bi-person-badge me-2"></i>Users &amp; Access</h2>
    <p class="text-muted">
      Who may use this application, which tenants they may see, and what they may do in each
      tenant. Each tenant has its own sections, so the same person can, for example, run analysis
      in one tenant and only review workspaces in another. People and security groups are chosen
      from Entra ID — granting a group gives its access to everyone in it, including nested groups.
    </p>

    <div id="flash-messages">
      <% if (success && success.length) { %>
        <% success.forEach(function(message) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
      <% if (error && error.length) { %>
        <% error.forEach(function(message) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
    </div>

    <% if (bootstrap) { %>
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>No administrator has been configured yet.</strong>
        Until one exists, every signed-in user has full access — that is what makes this
        page reachable the first time. Add yourself as an <strong>Administrator</strong>
        below to switch restrictions on.
      </div>
    <% } %>

    <% if (!tenants.length) { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No tenants are configured yet, so there is nothing to grant.
        Add a service principal under <a href="/settings">Configuration</a> first.
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>Users &amp; groups (<%= users.length %>)</h5>
      <button class="btn btn-primary btn-sm" onclick="openUserForm()">
        <i class="bi bi-plus-lg me-1"></i>Add from Entra ID
      </button>
    </div>

    <% if (!users.length) { %>
      <div class="alert alert-secondary"><i class="bi bi-info-circle me-2"></i>No users configured yet.</div>
    <% } else { %>
      <div class="card mb-4">
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0 align-middle">
            <thead>
              <tr>
                <th>User</th>
                <th>Role</th>
                <th>Tenants and their sections</th>
                <th>Application-wide</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(row) { %>
                <tr>
                  <td>
                    <strong>
                      <i class="bi <%= row.principal_type === 'group' ? 'bi-people' : 'bi-person' %> me-1 text-muted"></i>
                      <%= row.display_name || row.email %>
                    </strong>
                    <% if (row.principal_type === 'group') { %>
                      <span class="badge bg-dark ms-1">Security group</span>
                      <div class="small text-muted">Everyone in this group inherits the access below</div>
                    <% } else { %>
                      <% if (String(row.email || '').includes('#EXT#')) { %>
                        <span class="badge bg-warning text-dark ms-1">Guest</span>
                      <% } %>
                      <% if (row.display_name && row.email) { %>
                        <div class="small text-muted"><%= row.email %></div>
                      <% } %>
                      <% if (!row.email && row.entra_object_id) { %>
                        <div class="small text-muted">Matched on their directory entry</div>
                      <% } %>
                    <% } %>
                    <% if (!row.is_active) { %><span class="badge bg-secondary">Deactivated</span><% } %>
                  </td>
                  <td>
                    <span class="badge bg-<%= row.role === 'admin' ? 'danger' : 'primary' %>">
                      <%= row.role === 'admin' ? 'Administrator' : 'User' %>
                    </span>
                  </td>
                  <td class="small">
                    <% if (row.role === 'admin') { %>
                      <span class="text-muted">All tenants</span>
                    <% } else if (!row.tenantIds.length) { %>
                      <span class="text-danger">None</span>
                    <% } else { %>
                      <% row.tenantIds.forEach(function(spId) { var keys = sectionsInTenant(row, spId); %>
                        <div class="mb-1">
                          <strong><%= tenantName[spId] || ('Tenant #' + spId) %>:</strong>
                          <% if (!keys.length) { %>
                            <span class="text-muted">scans only, no sections</span>
                          <% } else { %>
                            <% keys.forEach(function(key) { %><span class="badge bg-info me-1"><%= sectionLabel[key] || key %></span><% }) %>
                          <% } %>
                        </div>
                      <% }) %>
                    <% } %>
                  </td>
                  <td class="small">
                    <% var appKeys = (row.sectionKeys || []).filter(function(key) { return tenantKeys.indexOf(key) === -1; }); %>
                    <% if (row.role === 'admin') { %>
                      <span class="text-muted">All sections</span>
                    <% } else if (!appKeys.length) { %>
                      <span class="text-muted">None</span>
                    <% } else { %>
                      <% appKeys.forEach(function(key) { %>
                        <span class="badge bg-info me-1"><%= sectionLabel[key] || key %></span>
                      <% }) %>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <%# The escaping output tag encodes the JSON once, which is exactly what an attribute needs:
                        the browser decodes it back to the JSON the script parses. Escaping
                        it by hand as well left &quot; in the value and broke every Edit. %>
                    <button type="button" class="btn btn-sm btn-outline-primary js-edit-user"
                            data-user="<%= JSON.stringify(row) %>"
                            aria-label="Edit access for <%= row.display_name || row.email %>" title="Edit">
                      <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <%# The name travels as data and is read with textContent semantics:
                        inlined into onsubmit, an apostrophe (O'Neil) broke the script and the
                        form was submitted without asking. %>
                    <form method="POST" action="/settings/permissions/delete/<%= row.id %>" class="d-inline js-remove-user"
                          data-name="<%= row.display_name || row.email || 'this entry' %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger"
                              aria-label="Remove access for <%= row.display_name || row.email %>" title="Remove">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" action="/settings/permissions/save">
        <div class="modal-header">
          <h5 class="modal-title" id="userModalTitle">Add User</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="id" id="userId">
          <input type="hidden" name="principalType" id="userPrincipalType" value="user">
          <input type="hidden" name="entraObjectId" id="userObjectId">
          <input type="hidden" name="email" id="userEmail">
          <input type="hidden" name="displayName" id="userDisplayName">

          <div class="mb-3">
            <label class="form-label">Who <span class="text-danger">*</span></label>
            <div class="btn-group btn-group-sm d-block mb-2" role="group">
              <input type="radio" class="btn-check" name="lookupType" id="lookupUser" value="user" checked
                     onchange="onLookupTypeChange()">
              <label class="btn btn-outline-primary" for="lookupUser"><i class="bi bi-person me-1"></i>Person</label>
              <input type="radio" class="btn-check" name="lookupType" id="lookupGroup" value="group"
                     onchange="onLookupTypeChange()">
              <label class="btn btn-outline-primary" for="lookupGroup"><i class="bi bi-people me-1"></i>Security group</label>
            </div>

            <div id="chosenPrincipal" class="alert alert-secondary py-2 px-3 d-none d-flex justify-content-between align-items-center">
              <span><i class="bi bi-check-circle text-success me-2"></i><span id="chosenPrincipalText"></span></span>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearChosenPrincipal()">Change</button>
            </div>

            <div id="principalSearchWrap">
              <input type="text" class="form-control" id="principalSearch" autocomplete="off"
                     placeholder="Start typing a name to search Entra ID...">
              <div class="form-text" id="principalSearchHelp">
                Chosen from Entra ID, so a grant cannot be lost to a typo.
              </div>
              <div id="principalResults" class="list-group mt-2" style="max-height:200px;overflow-y:auto;"></div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label">Role</label>
              <select class="form-select" name="role" id="userRole" onchange="syncRoleState()">
                <option value="user">User — only what is ticked below</option>
                <option value="admin">Administrator — everything, including this page</option>
              </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" id="userActive" checked>
                <label class="form-check-label" for="userActive">Active</label>
              </div>
            </div>
          </div>

          <%
            // Tenants beside sections rather than beneath them. Stacked, with a
            // paragraph of explanation above each, the dialog was taller than the
            // screen and everything below the fold read as missing rather than
            // merely further down.
          %>
          <div id="grantFields">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-1">
              <h6 class="mb-0"><i class="bi bi-building me-1"></i>Tenant access</h6>
              <% if (tenants.length) { %>
                <button type="button" class="btn btn-link btn-sm p-0 js-all-tenants">Grant every tenant</button>
              <% } %>
            </div>
            <p class="text-muted small mb-2">
              Tick a tenant to show its scans, then tick what they may do there. Sections are granted
              per tenant; a section ticked in one tenant does not apply in another. Use a column header to
              tick that section in every granted tenant.
            </p>
            <% if (!tenants.length) { %>
              <p class="text-muted small fst-italic">No tenants configured.</p>
            <% } else { %>
              <style>
                /* The tenant column stays in view while the section columns scroll sideways. */
                .grant-matrix th[scope="row"], .grant-matrix thead th:first-child { position: sticky; left: 0; z-index: 1; background: var(--bs-body-bg); box-shadow: inset -1px 0 0 var(--bs-border-color); }
              </style>
              <div class="table-responsive border rounded mb-3">
                <table class="table table-sm align-middle mb-0 grant-matrix" data-no-sort>
                  <caption class="visually-hidden">Sections granted in each tenant</caption>
                  <thead>
                    <tr>
                      <th scope="col" style="min-width:190px;">Tenant</th>
                      <% tenantDefs.forEach(function(section) { %>
                        <th scope="col" class="text-center" style="min-width:92px;">
                          <button type="button" class="btn btn-link btn-sm p-0 js-col text-decoration-none" data-section="<%= section.key %>"
                                  title="Tick <%= section.label %> in every granted tenant">
                            <i class="bi <%= section.icon %> d-block mx-auto mb-1" aria-hidden="true"></i><span class="small"><%= section.label %></span>
                          </button>
                        </th>
                      <% }) %>
                      <th scope="col"><span class="visually-hidden">Row actions</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% tenants.forEach(function(tenant) { %>
                      <tr data-tenant="<%= tenant.id %>">
                        <th scope="row" class="fw-normal">
                          <div class="form-check mb-0">
                            <input class="form-check-input js-tenant" type="checkbox" name="tenantIds"
                                   value="<%= tenant.id %>" id="tenant-<%= tenant.id %>">
                            <label class="form-check-label" for="tenant-<%= tenant.id %>">
                              <strong><%= tenant.name %></strong>
                              <span class="d-block small text-muted text-truncate font-monospace" style="max-width:160px;" title="<%= tenant.tenant_id %>"><%= tenant.tenant_id %></span>
                            </label>
                          </div>
                        </th>
                        <% tenantDefs.forEach(function(section) { %>
                          <td class="text-center">
                            <input class="form-check-input js-cell" type="checkbox" name="ts_<%= tenant.id %>"
                                   value="<%= section.key %>" id="ts-<%= tenant.id %>-<%= section.key %>"
                                   data-section="<%= section.key %>" disabled
                                   aria-label="<%= section.label %> in <%= tenant.name %>">
                          </td>
                        <% }) %>
                        <td class="text-end text-nowrap">
                          <button type="button" class="btn btn-link btn-sm p-0 js-row">All</button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <h6 class="mb-1"><i class="bi bi-grid me-1"></i>Application-wide sections</h6>
            <p class="text-muted small mb-2">
              These configure the application itself rather than a tenant, so they are granted once.
            </p>
            <div class="d-flex flex-wrap gap-3">
              <% appDefs.forEach(function(section) { %>
                <div class="form-check">
                  <input class="form-check-input js-section" type="checkbox" name="sectionKeys"
                         value="<%= section.key %>" id="section-<%= section.key %>">
                  <label class="form-check-label" for="section-<%= section.key %>">
                    <i class="bi <%= section.icon %> me-1" aria-hidden="true"></i><%= section.label %>
                  </label>
                </div>
              <% }) %>
            </div>
            <div class="small text-muted mt-3" id="grantSummary" aria-live="polite"></div>
          </div>

          <div id="adminNotice" class="alert alert-info d-none mt-3">
            <i class="bi bi-info-circle me-2"></i>Administrators see every tenant and every section,
            so there is nothing to tick.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
var userModalInstance = null;

function userModal() {
  if (!userModalInstance) userModalInstance = new bootstrap.Modal(document.getElementById('userModal'));
  return userModalInstance;
}

// Administrators hold everything by role, so the tick boxes are hidden rather than
// left on screen suggesting a restriction that is not applied.
function syncRoleState() {
  var isAdmin = document.getElementById('userRole').value === 'admin';
  document.getElementById('grantFields').classList.toggle('d-none', isAdmin);
  document.getElementById('adminNotice').classList.toggle('d-none', !isAdmin);
}

var TENANT_SECTION_KEYS = <%- JSON.stringify(tenantKeys) %>;

function clearGrantBoxes() {
  document.querySelectorAll('.js-tenant, .js-section, .js-cell').forEach(function(box) { box.checked = false; });
  syncTenantRows();
}

// A section can only be ticked in a tenant that is granted: its row stays disabled
// (and is not submitted) until the tenant itself is ticked.
function syncTenantRows() {
  document.querySelectorAll('.grant-matrix tr[data-tenant]').forEach(function(row) {
    var granted = row.querySelector('.js-tenant').checked;
    row.querySelectorAll('.js-cell').forEach(function(cell) {
      cell.disabled = !granted;
      if (!granted) cell.checked = false;
    });
    row.classList.toggle('table-active', granted);
  });
  summariseGrant();
}

function summariseGrant() {
  var summary = document.getElementById('grantSummary');
  if (!summary) return;
  var rows = Array.prototype.filter.call(document.querySelectorAll('.grant-matrix tr[data-tenant]'), function(row) {
    return row.querySelector('.js-tenant').checked;
  });
  if (!rows.length) { summary.textContent = 'No tenant granted: this entry will see no scans.'; return; }
  summary.textContent = rows.map(function(row) {
    var name = row.querySelector('label strong').textContent;
    var count = row.querySelectorAll('.js-cell:checked').length;
    return name + ': ' + (count ? count + ' section' + (count === 1 ? '' : 's') : 'scans only');
  }).join(' · ');
}

document.addEventListener('change', function(event) {
  if (event.target.classList.contains('js-tenant')) syncTenantRows();
  if (event.target.classList.contains('js-cell')) summariseGrant();
});

// ── Choosing who from Entra ID ──

function lookupType() {
  return document.querySelector('input[name="lookupType"]:checked').value;
}

function setChosenPrincipal(entry) {
  document.getElementById('userPrincipalType').value = entry.principalType;
  document.getElementById('userObjectId').value = entry.objectId || '';
  document.getElementById('userEmail').value = entry.email || '';
  document.getElementById('userDisplayName').value = entry.displayName || '';

  document.getElementById('chosenPrincipalText').textContent =
    entry.displayName + (entry.detail ? ' — ' + entry.detail : '');
  document.getElementById('chosenPrincipal').classList.remove('d-none');
  document.getElementById('principalSearchWrap').classList.add('d-none');
}

function clearChosenPrincipal() {
  document.getElementById('userObjectId').value = '';
  document.getElementById('userEmail').value = '';
  document.getElementById('userDisplayName').value = '';
  document.getElementById('chosenPrincipal').classList.add('d-none');
  document.getElementById('principalSearchWrap').classList.remove('d-none');
  document.getElementById('principalResults').innerHTML = '';
  document.getElementById('principalSearch').value = '';
  document.getElementById('principalSearch').focus();
}

function onLookupTypeChange() {
  document.getElementById('userPrincipalType').value = lookupType();
  clearChosenPrincipal();
}

function renderDirectoryResults(results) {
  var list = document.getElementById('principalResults');
  if (!results.length) {
    list.innerHTML = '<div class="list-group-item text-muted small">Nobody in the directory matches that.</div>';
    return;
  }
  list.innerHTML = '';
  results.forEach(function(entry) {
    var item = document.createElement('button');
    item.type = 'button';
    item.className = 'list-group-item list-group-item-action';
    // Built as nodes rather than markup: a display name is directory data and may
    // contain anything, including quotes and angle brackets.
    var name = document.createElement('div');
    name.textContent = entry.displayName;
    if (entry.isGuest) {
      // Said plainly, because a guest's two addresses look like two different
      // people and an administrator needs to know which they are granting.
      var badge = document.createElement('span');
      badge.className = 'badge bg-warning text-dark ms-2';
      badge.textContent = 'Guest';
      name.appendChild(badge);
    }
    var detail = document.createElement('div');
    detail.className = 'small text-muted';
    detail.textContent = entry.detail || '';
    item.appendChild(name);
    item.appendChild(detail);
    item.addEventListener('click', function() { setChosenPrincipal(entry); });
    list.appendChild(item);
  });
}

var searchTimer = null;
var searchSequence = 0;

function searchDirectory() {
  var query = document.getElementById('principalSearch').value.trim();
  var list = document.getElementById('principalResults');
  if (query.length < 2) { list.innerHTML = ''; return; }

  list.innerHTML = '<div class="list-group-item text-muted small">Searching Entra ID...</div>';
  // Replies can arrive out of order, and an older one overwriting a newer would
  // show results for a query the user has already moved past.
  var sequence = ++searchSequence;

  fetch('/settings/permissions/directory/search?type=' + encodeURIComponent(lookupType())
        + '&q=' + encodeURIComponent(query))
    .then(function(response) { return response.json(); })
    .then(function(body) {
      if (sequence !== searchSequence) return;
      if (!body.success) {
        list.innerHTML = '';
        var problem = document.createElement('div');
        problem.className = 'list-group-item list-group-item-warning small';
        problem.textContent = body.message || 'The directory could not be searched.';
        list.appendChild(problem);
        return;
      }
      renderDirectoryResults(body.results || []);
    })
    .catch(function(err) {
      if (sequence !== searchSequence) return;
      list.innerHTML = '';
      var problem = document.createElement('div');
      problem.className = 'list-group-item list-group-item-warning small';
      problem.textContent = 'The directory could not be searched: ' + err.message;
      list.appendChild(problem);
    });
}

document.getElementById('principalSearch').addEventListener('input', function() {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(searchDirectory, 300);
});

// Bulk ticking in the grid: a whole row (one tenant, every section), a whole column
// (one section, every granted tenant), or every tenant at once. Each toggles: if
// anything in its reach is unticked it ticks everything, otherwise it clears.
document.addEventListener('click', function(event) {
  var rowBtn = event.target.closest('.js-row');
  var colBtn = event.target.closest('.js-col');
  var allBtn = event.target.closest('.js-all-tenants');
  if (!rowBtn && !colBtn && !allBtn) return;
  event.preventDefault();

  if (allBtn) {
    var tenantsBoxes = document.querySelectorAll('.js-tenant');
    var grantAll = Array.prototype.some.call(tenantsBoxes, function(box) { return !box.checked; });
    tenantsBoxes.forEach(function(box) { box.checked = grantAll; });
    syncTenantRows();
    return;
  }
  if (rowBtn) {
    var row = rowBtn.closest('tr');
    row.querySelector('.js-tenant').checked = true;
    syncTenantRows();
    var cells = row.querySelectorAll('.js-cell');
    var tickRow = Array.prototype.some.call(cells, function(cell) { return !cell.checked; });
    cells.forEach(function(cell) { cell.checked = tickRow; });
    summariseGrant();
    return;
  }
  var colCells = Array.prototype.filter.call(
    document.querySelectorAll('.js-cell[data-section="' + colBtn.dataset.section + '"]'),
    function(cell) { return !cell.disabled; }
  );
  if (!colCells.length) {
    if (typeof showToast === 'function') showToast('Tick at least one tenant first.', 'info');
    return;
  }
  var tickCol = colCells.some(function(cell) { return !cell.checked; });
  colCells.forEach(function(cell) { cell.checked = tickCol; });
  summariseGrant();
});

// Removing access asks first, naming the entry as text: built into an onsubmit
// attribute, a name with an apostrophe broke the script and skipped the question.
document.addEventListener('submit', function(event) {
  var form = event.target.closest('.js-remove-user');
  if (!form) return;
  if (!window.confirm('Remove access for ' + form.getAttribute('data-name') + '?')) event.preventDefault();
});

function openUserForm() {
  document.getElementById('userModalTitle').textContent = 'Add User or Group';
  document.getElementById('userId').value = '';
  document.getElementById('lookupUser').checked = true;
  document.getElementById('userPrincipalType').value = 'user';
  document.getElementById('userRole').value = 'user';
  document.getElementById('userActive').checked = true;
  clearChosenPrincipal();
  clearGrantBoxes();
  syncRoleState();
  userModal().show();
}

function openUserFormWith(row) {
  document.getElementById('userModalTitle').textContent = 'Edit ' + (row.display_name || row.email);
  document.getElementById('userId').value = row.id;
  var isGroup = row.principal_type === 'group';
  document.getElementById(isGroup ? 'lookupGroup' : 'lookupUser').checked = true;
  document.getElementById('userRole').value = row.role === 'admin' ? 'admin' : 'user';
  document.getElementById('userActive').checked = row.is_active !== false;
  setChosenPrincipal({
    principalType: isGroup ? 'group' : 'user',
    objectId: row.entra_object_id || '',
    email: row.email || '',
    displayName: row.display_name || row.email || '',
    detail: isGroup ? 'Security group' : (row.email || ''),
  });
  clearGrantBoxes();
  (row.tenantIds || []).forEach(function(spId) {
    var box = document.getElementById('tenant-' + spId);
    if (box) box.checked = true;
  });
  syncTenantRows();
  // Tenant-bound sections stored the older way (one list for every tenant) are
  // shown ticked in every granted tenant, which is how they apply today. Saving
  // records them per tenant from then on.
  var legacyTenantKeys = (row.sectionKeys || []).filter(function(key) { return TENANT_SECTION_KEYS.indexOf(key) !== -1; });
  (row.tenantIds || []).forEach(function(spId) {
    var own = (row.tenantSections && (row.tenantSections[spId] || row.tenantSections[String(spId)])) || [];
    own.concat(legacyTenantKeys).forEach(function(key) {
      var cell = document.getElementById('ts-' + spId + '-' + key);
      if (cell) cell.checked = true;
    });
  });
  (row.sectionKeys || []).forEach(function(key) {
    var box = document.getElementById('section-' + key);
    if (box) box.checked = true;
  });
  summariseGrant();
  syncRoleState();
  userModal().show();
}

// The row carries its own data, bound here rather than inlined into an onclick:
// a display name containing a quote would end the attribute and kill the button.
document.addEventListener('click', function(event) {
  var btn = event.target.closest('.js-edit-user');
  if (!btn) return;
  event.preventDefault();
  openUserFormWith(JSON.parse(btn.getAttribute('data-user')));
});
</script>
