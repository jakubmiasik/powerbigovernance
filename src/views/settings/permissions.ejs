<%- include('../partials/header') %>
<%
  var sectionsByGroup = {};
  sections.forEach(function(section) {
    (sectionsByGroup[section.group] = sectionsByGroup[section.group] || []).push(section);
  });
  var tenantName = {};
  tenants.forEach(function(tenant) { tenantName[tenant.id] = tenant.name; });
%>
<div class="row">
  <div class="col-xxl-10 mx-auto">
    <h2><i class="bi bi-person-badge me-2"></i>Users &amp; Access</h2>
    <p class="text-muted">
      Who may use this application, which tenants they may see and run scans for, and which
      sections are available to them. People and security groups are chosen from Entra ID —
      granting a group gives its access to everyone in it, including nested groups.
    </p>

    <div id="flash-messages">
      <% if (success && success.length) { %>
        <% success.forEach(function(message) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
      <% if (error && error.length) { %>
        <% error.forEach(function(message) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
    </div>

    <% if (bootstrap) { %>
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>No administrator has been configured yet.</strong>
        Until one exists, every signed-in user has full access — that is what makes this
        page reachable the first time. Add yourself as an <strong>Administrator</strong>
        below to switch restrictions on.
      </div>
    <% } %>

    <% if (!tenants.length) { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No tenants are configured yet, so there is nothing to grant.
        Add a service principal under <a href="/settings">Configuration</a> first.
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>Users &amp; groups (<%= users.length %>)</h5>
      <button class="btn btn-primary btn-sm" onclick="openUserForm()">
        <i class="bi bi-plus-lg me-1"></i>Add from Entra ID
      </button>
    </div>

    <% if (!users.length) { %>
      <div class="alert alert-secondary"><i class="bi bi-info-circle me-2"></i>No users configured yet.</div>
    <% } else { %>
      <div class="card mb-4">
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0 align-middle">
            <thead>
              <tr>
                <th>User</th>
                <th>Role</th>
                <th>Tenants</th>
                <th>Sections</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(row) { %>
                <tr>
                  <td>
                    <strong>
                      <i class="bi <%= row.principal_type === 'group' ? 'bi-people' : 'bi-person' %> me-1 text-muted"></i>
                      <%= row.display_name || row.email %>
                    </strong>
                    <% if (row.principal_type === 'group') { %>
                      <span class="badge bg-dark ms-1">Security group</span>
                      <div class="small text-muted">Everyone in this group inherits the access below</div>
                    <% } else { %>
                      <% if (String(row.email || '').includes('#EXT#')) { %>
                        <span class="badge bg-warning text-dark ms-1">Guest</span>
                      <% } %>
                      <% if (row.display_name && row.email) { %>
                        <div class="small text-muted"><%= row.email %></div>
                      <% } %>
                      <% if (!row.email && row.entra_object_id) { %>
                        <div class="small text-muted">Matched on their directory entry</div>
                      <% } %>
                    <% } %>
                    <% if (!row.is_active) { %><span class="badge bg-secondary">Deactivated</span><% } %>
                  </td>
                  <td>
                    <span class="badge bg-<%= row.role === 'admin' ? 'danger' : 'primary' %>">
                      <%= row.role === 'admin' ? 'Administrator' : 'User' %>
                    </span>
                  </td>
                  <td class="small">
                    <% if (row.role === 'admin') { %>
                      <span class="text-muted">All tenants</span>
                    <% } else if (!row.tenantIds.length) { %>
                      <span class="text-danger">None</span>
                    <% } else { %>
                      <% row.tenantIds.forEach(function(spId) { %>
                        <span class="badge bg-secondary me-1"><%= tenantName[spId] || ('Tenant #' + spId) %></span>
                      <% }) %>
                    <% } %>
                  </td>
                  <td class="small">
                    <% if (row.role === 'admin') { %>
                      <span class="text-muted">All sections</span>
                    <% } else if (!row.sectionKeys.length) { %>
                      <span class="text-danger">None</span>
                    <% } else { %>
                      <% row.sectionKeys.forEach(function(key) { %>
                        <span class="badge bg-info text-dark me-1"><%= key %></span>
                      <% }) %>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-primary js-edit-user"
                            data-user="<%= JSON.stringify(row).replace(/"/g, '&quot;') %>">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form method="POST" action="/settings/permissions/delete/<%= row.id %>" class="d-inline"
                          onsubmit="return confirm('Remove access for <%= row.display_name || row.email %>?');">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" action="/settings/permissions/save">
        <div class="modal-header">
          <h5 class="modal-title" id="userModalTitle">Add User</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="id" id="userId">
          <input type="hidden" name="principalType" id="userPrincipalType" value="user">
          <input type="hidden" name="entraObjectId" id="userObjectId">
          <input type="hidden" name="email" id="userEmail">
          <input type="hidden" name="displayName" id="userDisplayName">

          <div class="mb-3">
            <label class="form-label">Who <span class="text-danger">*</span></label>
            <div class="btn-group btn-group-sm d-block mb-2" role="group">
              <input type="radio" class="btn-check" name="lookupType" id="lookupUser" value="user" checked
                     onchange="onLookupTypeChange()">
              <label class="btn btn-outline-primary" for="lookupUser"><i class="bi bi-person me-1"></i>Person</label>
              <input type="radio" class="btn-check" name="lookupType" id="lookupGroup" value="group"
                     onchange="onLookupTypeChange()">
              <label class="btn btn-outline-primary" for="lookupGroup"><i class="bi bi-people me-1"></i>Security group</label>
            </div>

            <div id="chosenPrincipal" class="alert alert-secondary py-2 px-3 d-none d-flex justify-content-between align-items-center">
              <span><i class="bi bi-check-circle text-success me-2"></i><span id="chosenPrincipalText"></span></span>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearChosenPrincipal()">Change</button>
            </div>

            <div id="principalSearchWrap">
              <input type="text" class="form-control" id="principalSearch" autocomplete="off"
                     placeholder="Start typing a name to search Entra ID...">
              <div class="form-text" id="principalSearchHelp">
                Chosen from Entra ID, so a grant cannot be lost to a typo.
              </div>
              <div id="principalResults" class="list-group mt-2" style="max-height:200px;overflow-y:auto;"></div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label">Role</label>
              <select class="form-select" name="role" id="userRole" onchange="syncRoleState()">
                <option value="user">User — only what is ticked below</option>
                <option value="admin">Administrator — everything, including this page</option>
              </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" id="userActive" checked>
                <label class="form-check-label" for="userActive">Active</label>
              </div>
            </div>
          </div>

          <%
            // Tenants beside sections rather than beneath them. Stacked, with a
            // paragraph of explanation above each, the dialog was taller than the
            // screen and everything below the fold read as missing rather than
            // merely further down.
          %>
          <div id="grantFields" class="row g-3">
            <div class="col-lg-4">
              <h6 class="d-flex justify-content-between align-items-center">
                <span><i class="bi bi-building me-1"></i>Tenants</span>
                <% if (tenants.length) { %>
                  <button type="button" class="btn btn-link btn-sm p-0 js-toggle-tenants">Select all</button>
                <% } %>
              </h6>
              <p class="text-muted small mb-2">
                Which tenants they may see and scan. Other tenants' scans are hidden everywhere,
                including the scan selector.
              </p>
              <% if (!tenants.length) { %>
                <p class="text-muted small fst-italic">No tenants configured.</p>
              <% } else { %>
                <div class="border rounded p-2" style="max-height:260px;overflow-y:auto;">
                  <% tenants.forEach(function(tenant) { %>
                    <div class="form-check">
                      <input class="form-check-input js-tenant" type="checkbox" name="tenantIds"
                             value="<%= tenant.id %>" id="tenant-<%= tenant.id %>">
                      <label class="form-check-label" for="tenant-<%= tenant.id %>">
                        <%= tenant.name %>
                        <span class="d-block small text-muted"><%= tenant.tenant_id %></span>
                      </label>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <div class="col-lg-8">
              <h6><i class="bi bi-grid me-1"></i>Sections</h6>
              <p class="text-muted small mb-2">
                Which parts of the application appear for them. Anything not ticked is hidden from
                the menu and refused if its address is opened directly.
              </p>
              <div class="row g-2 row-cols-1 row-cols-md-2">
                <% Object.keys(sectionsByGroup).forEach(function(group) { %>
                  <div class="col">
                    <div class="border rounded h-100 p-2">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-muted text-uppercase"><%= group %></span>
                        <button type="button" class="btn btn-link btn-sm p-0 js-toggle-group"
                                data-group="<%= group %>">Select all</button>
                      </div>
                      <% sectionsByGroup[group].forEach(function(section) { %>
                        <div class="form-check">
                          <input class="form-check-input js-section" type="checkbox" name="sectionKeys"
                                 data-group="<%= group %>"
                                 value="<%= section.key %>" id="section-<%= section.key %>">
                          <label class="form-check-label" for="section-<%= section.key %>">
                            <i class="bi <%= section.icon %> me-1"></i><%= section.label %>
                          </label>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div id="adminNotice" class="alert alert-info d-none mt-3">
            <i class="bi bi-info-circle me-2"></i>Administrators see every tenant and every section,
            so there is nothing to tick.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
var userModalInstance = null;

function userModal() {
  if (!userModalInstance) userModalInstance = new bootstrap.Modal(document.getElementById('userModal'));
  return userModalInstance;
}

// Administrators hold everything by role, so the tick boxes are hidden rather than
// left on screen suggesting a restriction that is not applied.
function syncRoleState() {
  var isAdmin = document.getElementById('userRole').value === 'admin';
  document.getElementById('grantFields').classList.toggle('d-none', isAdmin);
  document.getElementById('adminNotice').classList.toggle('d-none', !isAdmin);
}

function clearGrantBoxes() {
  document.querySelectorAll('.js-tenant, .js-section').forEach(function(box) { box.checked = false; });
  resetToggleLabels();
}

// ── Choosing who from Entra ID ──

function lookupType() {
  return document.querySelector('input[name="lookupType"]:checked').value;
}

function setChosenPrincipal(entry) {
  document.getElementById('userPrincipalType').value = entry.principalType;
  document.getElementById('userObjectId').value = entry.objectId || '';
  document.getElementById('userEmail').value = entry.email || '';
  document.getElementById('userDisplayName').value = entry.displayName || '';

  document.getElementById('chosenPrincipalText').textContent =
    entry.displayName + (entry.detail ? ' — ' + entry.detail : '');
  document.getElementById('chosenPrincipal').classList.remove('d-none');
  document.getElementById('principalSearchWrap').classList.add('d-none');
}

function clearChosenPrincipal() {
  document.getElementById('userObjectId').value = '';
  document.getElementById('userEmail').value = '';
  document.getElementById('userDisplayName').value = '';
  document.getElementById('chosenPrincipal').classList.add('d-none');
  document.getElementById('principalSearchWrap').classList.remove('d-none');
  document.getElementById('principalResults').innerHTML = '';
  document.getElementById('principalSearch').value = '';
  document.getElementById('principalSearch').focus();
}

function onLookupTypeChange() {
  document.getElementById('userPrincipalType').value = lookupType();
  clearChosenPrincipal();
}

function renderDirectoryResults(results) {
  var list = document.getElementById('principalResults');
  if (!results.length) {
    list.innerHTML = '<div class="list-group-item text-muted small">Nobody in the directory matches that.</div>';
    return;
  }
  list.innerHTML = '';
  results.forEach(function(entry) {
    var item = document.createElement('button');
    item.type = 'button';
    item.className = 'list-group-item list-group-item-action';
    // Built as nodes rather than markup: a display name is directory data and may
    // contain anything, including quotes and angle brackets.
    var name = document.createElement('div');
    name.textContent = entry.displayName;
    if (entry.isGuest) {
      // Said plainly, because a guest's two addresses look like two different
      // people and an administrator needs to know which they are granting.
      var badge = document.createElement('span');
      badge.className = 'badge bg-warning text-dark ms-2';
      badge.textContent = 'Guest';
      name.appendChild(badge);
    }
    var detail = document.createElement('div');
    detail.className = 'small text-muted';
    detail.textContent = entry.detail || '';
    item.appendChild(name);
    item.appendChild(detail);
    item.addEventListener('click', function() { setChosenPrincipal(entry); });
    list.appendChild(item);
  });
}

var searchTimer = null;
var searchSequence = 0;

function searchDirectory() {
  var query = document.getElementById('principalSearch').value.trim();
  var list = document.getElementById('principalResults');
  if (query.length < 2) { list.innerHTML = ''; return; }

  list.innerHTML = '<div class="list-group-item text-muted small">Searching Entra ID...</div>';
  // Replies can arrive out of order, and an older one overwriting a newer would
  // show results for a query the user has already moved past.
  var sequence = ++searchSequence;

  fetch('/settings/permissions/directory/search?type=' + encodeURIComponent(lookupType())
        + '&q=' + encodeURIComponent(query))
    .then(function(response) { return response.json(); })
    .then(function(body) {
      if (sequence !== searchSequence) return;
      if (!body.success) {
        list.innerHTML = '';
        var problem = document.createElement('div');
        problem.className = 'list-group-item list-group-item-warning small';
        problem.textContent = body.message || 'The directory could not be searched.';
        list.appendChild(problem);
        return;
      }
      renderDirectoryResults(body.results || []);
    })
    .catch(function(err) {
      if (sequence !== searchSequence) return;
      list.innerHTML = '';
      var problem = document.createElement('div');
      problem.className = 'list-group-item list-group-item-warning small';
      problem.textContent = 'The directory could not be searched: ' + err.message;
      list.appendChild(problem);
    });
}

document.getElementById('principalSearch').addEventListener('input', function() {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(searchDirectory, 300);
});

// Ticking a whole group at once, because the common case is "everything under
// Quality" rather than three of its four entries.
document.addEventListener('click', function(event) {
  var toggle = event.target.closest('.js-toggle-group, .js-toggle-tenants');
  if (!toggle) return;
  event.preventDefault();
  var selector = toggle.classList.contains('js-toggle-tenants')
    ? '.js-tenant'
    : '.js-section[data-group="' + toggle.dataset.group + '"]';
  var boxes = document.querySelectorAll(selector);
  var turnOn = Array.prototype.some.call(boxes, function(box) { return !box.checked; });
  boxes.forEach(function(box) { box.checked = turnOn; });
  toggle.textContent = turnOn ? 'Clear all' : 'Select all';
});

function resetToggleLabels() {
  // The boxes have just been cleared, so a button still reading "Clear all" from
  // the previous time the dialog was open would be describing the wrong state.
  document.querySelectorAll('.js-toggle-group, .js-toggle-tenants').forEach(function(toggle) {
    toggle.textContent = 'Select all';
  });
}

function openUserForm() {
  document.getElementById('userModalTitle').textContent = 'Add User or Group';
  document.getElementById('userId').value = '';
  document.getElementById('lookupUser').checked = true;
  document.getElementById('userPrincipalType').value = 'user';
  document.getElementById('userRole').value = 'user';
  document.getElementById('userActive').checked = true;
  clearChosenPrincipal();
  clearGrantBoxes();
  syncRoleState();
  userModal().show();
}

function openUserFormWith(row) {
  document.getElementById('userModalTitle').textContent = 'Edit ' + (row.display_name || row.email);
  document.getElementById('userId').value = row.id;
  var isGroup = row.principal_type === 'group';
  document.getElementById(isGroup ? 'lookupGroup' : 'lookupUser').checked = true;
  document.getElementById('userRole').value = row.role === 'admin' ? 'admin' : 'user';
  document.getElementById('userActive').checked = row.is_active !== false;
  setChosenPrincipal({
    principalType: isGroup ? 'group' : 'user',
    objectId: row.entra_object_id || '',
    email: row.email || '',
    displayName: row.display_name || row.email || '',
    detail: isGroup ? 'Security group' : (row.email || ''),
  });
  clearGrantBoxes();
  (row.tenantIds || []).forEach(function(spId) {
    var box = document.getElementById('tenant-' + spId);
    if (box) box.checked = true;
  });
  (row.sectionKeys || []).forEach(function(key) {
    var box = document.getElementById('section-' + key);
    if (box) box.checked = true;
  });
  syncRoleState();
  userModal().show();
}

// The row carries its own data, bound here rather than inlined into an onclick:
// a display name containing a quote would end the attribute and kill the button.
document.addEventListener('click', function(event) {
  var btn = event.target.closest('.js-edit-user');
  if (!btn) return;
  event.preventDefault();
  openUserFormWith(JSON.parse(btn.getAttribute('data-user')));
});
</script>
<%- include('../partials/footer') %>
