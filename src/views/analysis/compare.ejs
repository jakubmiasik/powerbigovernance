<%- include('../partials/header') %>
<%
  // Only one tenant's scans are ever listed: comparing two tenants would compare
  // two different estates. Within the tenant, scans are grouped by principal.
  var tenantList = typeof tenants !== 'undefined' && tenants ? tenants : [];
  var currentTenant = typeof tenantId !== 'undefined' ? tenantId : null;
  var runsByPrincipal = {};
  (runs || []).forEach(function(r) {
    var key = r.sp_name || 'Managed identity';
    if (!runsByPrincipal[key]) runsByPrincipal[key] = [];
    runsByPrincipal[key].push(r);
  });
  var principalKeys = Object.keys(runsByPrincipal).sort();
  var keyOf = typeof scopeKeyOf === 'function' ? scopeKeyOf : function(r) { return scopeTag(r) + ':' + describeScope(scopeFromRow(r)); };
  var pd = '../../../packages/podavo-ui/ejs/';
  var confirmState = typeof scopeConfirm !== 'undefined' && scopeConfirm ? scopeConfirm : null;
  // Shown both as Run Analysis → Compare Runs and as Overview → Since Last Scan.
  var cmp = typeof compare !== 'undefined' && compare ? compare : {
    basePath: '/analysis/compare', detailsPath: '/analysis/compare/details', title: 'Compare Runs',
    subtitle: 'Summary totals are compared instantly; the detailed diff is loaded on demand.', backHref: '/analysis'
  };
  // A scan is its principal and that principal's own number.
  function scanName(r) {
    if (typeof runLabel === 'function') return runLabel(r);
    return (r.sp_name || 'Unknown principal') + (r.sp_run_number ? ' #' + r.sp_run_number : ' (unnumbered, id ' + r.id + ')');
  }
  function optionLabel(r) {
    // The coverage leads, because comparing a one-workspace scan with a
    // whole-tenant one reads as the estate having shrunk by 47 workspaces.
    return '[' + scopeTag(r) + '] ' + scanName(r) + ' — ' + (r.started_at ? new Date(r.started_at).toLocaleString() : 'N/A');
  }

  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
  }

  function formatValue(value, format) {
    return format === 'bytes' ? formatBytes(value) : Number(value || 0).toLocaleString();
  }

  var changedMetrics = (metrics || []).filter(function(m) { return m.changed; });
%>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h2><i class="bi bi-arrow-left-right me-2"></i><%= cmp.title %></h2>
    <p class="text-muted mb-0"><%= cmp.subtitle %></p>
  </div>
  <% if (cmp.backHref) { %><a href="<%= cmp.backHref %>" class="btn btn-outline-secondary btn-sm" onclick="goBackOr('<%= cmp.backHref %>'); return false;"><i class="bi bi-arrow-left me-1"></i>Back</a><% } %>
</div>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-sliders me-2"></i>Select scans</div>
  <div class="card-body">
    <% if (!tenantList.length) { %>
      <p class="text-muted mb-0">No completed scans you can see yet. <a href="/analysis">Run an analysis</a> first.</p>
    <% } else { %>
      <form method="get" action="<%= cmp.basePath %>" class="row g-2 align-items-end" id="compareForm">
        <div class="col-12">
          <label class="form-label small" for="tenantSelect">Tenant</label>
          <select class="form-select form-select-sm" id="tenantSelect" name="tenant"<%= tenantList.length === 1 ? ' disabled' : '' %>>
            <% tenantList.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= t.id === currentTenant ? 'selected' : '' %>><%= t.label %> (<%= t.scans %> scan<%= t.scans === 1 ? '' : 's' %>)</option>
            <% }) %>
          </select>
          <% if (tenantList.length === 1) { %><input type="hidden" name="tenant" value="<%= currentTenant %>"><% } %>
        </div>
        <% ['from', 'to'].forEach(function(side) { var chosen = side === 'from' ? fromRun : toRun; %>
          <div class="col-md-5">
            <label class="form-label small" for="<%= side %>RunSelect"><%= side === 'from' ? 'Baseline scan' : 'Compare with' %></label>
            <select class="form-select form-select-sm js-scan-select" id="<%= side %>RunSelect" name="<%= side %>">
              <% principalKeys.forEach(function(principal) { %>
                <optgroup label="<%= principal %>">
                  <% runsByPrincipal[principal].forEach(function(r) { %>
                    <option value="<%= r.id %>" data-scope-key="<%= keyOf(r) %>" data-scope-tag="<%= scopeTag(r) %>" data-scope="<%= typeof coverageText === 'function' ? coverageText(r) : describeScope(scopeFromRow(r)) %>" data-name="<%= scanName(r) %>" <%= chosen && chosen.id === r.id ? 'selected' : '' %>><%= optionLabel(r) %></option>
                  <% }) %>
                </optgroup>
              <% }) %>
            </select>
          </div>
        <% }) %>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary btn-sm w-100" id="compareBtn"><i class="bi bi-arrow-left-right me-1"></i>Compare</button>
        </div>
        <input type="hidden" name="confirm" id="confirmField" value="" disabled>
      </form>
      <div class="form-text mt-2" id="compareHint"><i class="bi bi-info-circle me-1"></i>Only scans of one tenant are listed, named by service principal and that principal's own scan number. Choose another tenant to compare its scans.</div>
    <% } %>
  </div>
</div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i><%= notice %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
<% } %>

<%
  // Two scans of different coverage produce differences that are about the scans,
  // not about the estate. Nothing is shown until the reader confirms in the dialog;
  // once they have, this banner stays above the numbers.
  var scopesDiffer = fromRun && toRun && metrics && metrics.length && keyOf(fromRun) !== keyOf(toRun);
%>
<% if (confirmState) { %>
  <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2" id="confirmPending">
    <i class="bi bi-shield-exclamation me-1"></i>
    <span class="flex-grow-1">Not compared yet: <%= confirmState.from.label %> and <%= confirmState.to.label %> cover different workspaces.</span>
    <button type="button" class="btn btn-sm btn-outline-primary" data-pd-dialog-open="scopeMismatchDialog">Review</button>
  </div>
<% } %>
<% if (scopesDiffer) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    These two scans did not cover the same thing — <%= scanName(fromRun) %> covered
    <strong><%= describeScope(scopeFromRow(fromRun)) %></strong> and <%= scanName(toRun) %> covered
    <strong><%= describeScope(scopeFromRow(toRun)) %></strong>. Every difference below is at least partly
    the difference between the two scopes, not a change in the estate.
  </div>
<% } %>
<% if (fromRun && toRun && metrics.length) { %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-graph-up me-2"></i>Summary Comparison</span>
      <span class="small text-muted">
        <span title="<%= scopeTagTitle(fromRun) %>">[<%= scopeTag(fromRun) %>]</span>
        <%= scanName(fromRun) %> (<%= fromRun.started_at ? new Date(fromRun.started_at).toLocaleString() : '-' %>)
        &rarr;
        <span title="<%= scopeTagTitle(toRun) %>">[<%= scopeTag(toRun) %>]</span>
        <%= scanName(toRun) %> (<%= toRun.started_at ? new Date(toRun.started_at).toLocaleString() : '-' %>)
      </span>
    </div>
    <div class="card-body py-3">
      <% if (!changedMetrics.length) { %>
        <div class="alert alert-success small mb-3"><i class="bi bi-check-circle me-2"></i>No change in any summary total between these two scans.</div>
      <% } %>
      <% if (typeof tenantSettingsComparable !== 'undefined' && !tenantSettingsComparable) { %>
        <div class="alert alert-info small mb-3">
          <i class="bi bi-info-circle me-2"></i>Tenant settings are excluded: at least one of these runs was created before
          tenant settings were captured with a run, so there is nothing to compare them against.
        </div>
      <% } %>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0" id="compare-metrics-table">
          <thead>
            <tr>
              <th>Metric</th>
              <th class="text-end"><%= scanName(fromRun) %></th>
              <th class="text-end"><%= scanName(toRun) %></th>
              <th class="text-end">Change</th>
              <th class="text-end">%</th>
            </tr>
          </thead>
          <tbody>
            <% metrics.forEach(function(metric) {
              var color = metric.delta === 0 ? 'secondary' : metric.delta > 0 ? 'success' : 'danger';
              var sign = metric.delta > 0 ? '+' : '';
            %>
              <tr class="<%= metric.changed ? '' : 'text-muted' %>">
                <td><%= metric.label %></td>
                <td class="text-end"><%= formatValue(metric.from, metric.format) %></td>
                <td class="text-end fw-bold"><%= formatValue(metric.to, metric.format) %></td>
                <td class="text-end">
                  <% if (metric.delta === 0) { %>
                    <span class="text-muted">—</span>
                  <% } else { %>
                    <span class="badge bg-<%= color %>"><%= sign %><%= metric.format === 'bytes' ? formatBytes(Math.abs(metric.delta)) : metric.delta.toLocaleString() %></span>
                  <% } %>
                </td>
                <td class="text-end small">
                  <%= metric.percent === null ? 'new' : (metric.percent === 0 ? '—' : (metric.percent > 0 ? '+' : '') + metric.percent + '%') %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-search me-2"></i>Detailed Comparison</span>
      <button class="btn btn-sm btn-outline-primary" id="detailsBtn" onclick="loadDetails()">
        <i class="bi bi-download me-1"></i>Load detailed diff
      </button>
    </div>
    <div class="card-body py-3" id="detailsPanel">
      <p class="text-muted small mb-0">
        The detailed diff walks every workspace, item, and access assignment in both runs.
        It is not loaded automatically because it reads the full stored results of both runs.
      </p>
    </div>
  </div>
<% } %>

<%
  var dlgFrom = confirmState ? confirmState.from : { label: '', tag: '', scope: '' };
  var dlgTo = confirmState ? confirmState.to : { label: '', tag: '', scope: '' };
  function esc(v) { return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  var dialogBody = '<p class="mb-2"><strong id="dlgFromName">' + esc(dlgFrom.label) + '</strong> <span class="pd-badge pd-badge--neutral" id="dlgFromTag">' + esc(dlgFrom.tag) + '</span> covered <strong id="dlgFromScope">' + esc(dlgFrom.scope) + '</strong>,'
    + ' and <strong id="dlgToName">' + esc(dlgTo.label) + '</strong> <span class="pd-badge pd-badge--neutral" id="dlgToTag">' + esc(dlgTo.tag) + '</span> covered <strong id="dlgToScope">' + esc(dlgTo.scope) + '</strong>.</p>'
    + '<p class="mb-0" style="color:var(--pd-text-muted)">Most of the difference between them will be what each scan looked at, not a change in the tenant: a scoped scan shows far fewer workspaces, items and users than a whole-tenant scan. For a like-for-like comparison, pick two scans with the same coverage.</p>';
  var dialogFooter = '<button type="button" class="pd-btn" data-pd-dialog-close>Pick other scans</button>'
    + '<button type="button" class="pd-btn pd-btn--primary" id="scopeConfirmBtn">Compare anyway</button>';
%>
<%- include(pd + 'dialog', { ui: { id: 'scopeMismatchDialog', title: confirmState ? confirmState.title : 'Compare scans with different coverage?', bodyHtml: dialogBody, footerHtml: dialogFooter } }) %>

<script>
var compareFrom = <%= fromRun ? fromRun.id : 'null' %>;
var compareTo = <%= toRun ? toRun.id : 'null' %>;

var scopeConfirmed = <%= (typeof scopeConfirmed !== 'undefined' && scopeConfirmed) ? 'true' : 'false' %>;

(function () {
  var form = document.getElementById('compareForm');
  if (!form) return;
  var tenantSelect = document.getElementById('tenantSelect');
  var fromSel = document.getElementById('fromRunSelect');
  var toSel = document.getElementById('toRunSelect');
  var confirmField = document.getElementById('confirmField');
  var dialog = document.getElementById('scopeMismatchDialog');

  // Another tenant: reload with that tenant's scans only; nothing of the previous
  // tenant is carried over.
  if (tenantSelect) tenantSelect.addEventListener('change', function () {
    window.location.href = form.getAttribute('action') + '?tenant=' + encodeURIComponent(tenantSelect.value);
  });

  function chosen(sel) { return sel && sel.options[sel.selectedIndex]; }
  function setText(id, value) { var el = document.getElementById(id); if (el) el.textContent = value; }

  function openMismatch(a, b) {
    var aTag = a.getAttribute('data-scope-tag'), bTag = b.getAttribute('data-scope-tag');
    var title = dialog.querySelector('.pd-dialog-title');
    if (title) title.textContent = (aTag === 'WT' || bTag === 'WT') ? 'Compare a whole-tenant scan with a scoped scan?' : 'Compare scans of different workspaces?';
    setText('dlgFromName', a.getAttribute('data-name')); setText('dlgFromTag', aTag); setText('dlgFromScope', a.getAttribute('data-scope'));
    setText('dlgToName', b.getAttribute('data-name')); setText('dlgToTag', bTag); setText('dlgToScope', b.getAttribute('data-scope'));
    if (window.Podavo && Podavo.dialog) Podavo.dialog.open(dialog, document.getElementById('compareBtn'));
    else if (dialog.showModal) dialog.showModal();
  }

  form.addEventListener('submit', function (e) {
    var a = chosen(fromSel), b = chosen(toSel);
    if (!a || !b) return;
    if (a.value === b.value) {
      e.preventDefault();
      var hint = document.getElementById('compareHint');
      if (hint) { hint.textContent = 'Pick two different scans of this tenant.'; hint.setAttribute('role', 'alert'); }
      return;
    }
    if (confirmField.disabled && a.getAttribute('data-scope-key') !== b.getAttribute('data-scope-key')) {
      e.preventDefault();
      openMismatch(a, b);
    }
  });

  document.getElementById('scopeConfirmBtn').addEventListener('click', function () {
    confirmField.disabled = false;
    confirmField.value = '1';
    if (window.Podavo && Podavo.dialog) Podavo.dialog.close(dialog); else dialog.close();
    form.submit();
  });

  // Asked for by link (or by Since Last Scan) with different coverage: the server
  // computed nothing and asks here first.
  <% if (confirmState) { %>
  window.addEventListener('load', function () {
    if (window.Podavo && Podavo.dialog) Podavo.dialog.open(dialog, document.getElementById('compareBtn'));
    else if (dialog.showModal) dialog.showModal();
  });
  <% } %>
})();

function escapeHtml(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function workspaceTable(title, rows, color, icon) {
  if (!rows.length) return '';
  var body = rows.map(function(w) {
    return '<tr><td>' + escapeHtml(w.name) + '</td><td>' + escapeHtml(w.state) + '</td>' +
      '<td>' + escapeHtml(w.licenseType) + '</td><td>' + w.totalItems + '</td></tr>';
  }).join('');
  return '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-' + icon + ' me-1 text-' + color + '"></i>' +
    title + ' (' + rows.length + ')</h6>' +
    '<div class="table-responsive" style="max-height:320px;"><table class="table table-sm table-hover mb-0">' +
    '<thead><tr><th>Workspace</th><th>State</th><th>License</th><th>Items</th></tr></thead><tbody>' +
    body + '</tbody></table></div></div>';
}

function changedTable(rows) {
  if (!rows.length) return '';
  var body = rows.map(function(w) {
    var changes = w.changes.map(function(c) {
      var delta = c.delta === null ? '' : ' (' + (c.delta > 0 ? '+' : '') + c.delta + ')';
      return '<span class="badge bg-light text-dark border me-1 mb-1">' + escapeHtml(c.field) + ': ' +
        escapeHtml(c.from) + ' &rarr; ' + escapeHtml(c.to) + delta + '</span>';
    }).join('');
    return '<tr><td>' + escapeHtml(w.name) + '</td><td>' + changes + '</td></tr>';
  }).join('');
  return '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-pencil-square me-1 text-warning"></i>Changed Workspaces (' + rows.length + ')</h6>' +
    '<div class="table-responsive" style="max-height:320px;"><table class="table table-sm table-hover mb-0">' +
    '<thead><tr><th style="width:30%;">Workspace</th><th>Changes</th></tr></thead><tbody>' + body + '</tbody></table></div></div>';
}

function capacityTable(rows) {
  if (!rows.length) return '';
  var body = rows.map(function(m) {
    return '<tr><td>' + escapeHtml(m.name) + '</td>' +
      '<td><code>' + escapeHtml(m.fromSku) + '</code> &rarr; <code>' + escapeHtml(m.toSku) + '</code></td>' +
      '<td>' + escapeHtml(m.fromLicense) + ' &rarr; ' + escapeHtml(m.toLicense) + '</td></tr>';
  }).join('');
  return '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-lightning me-1 text-info"></i>Capacity / License Moves (' + rows.length + ')</h6>' +
    '<div class="table-responsive" style="max-height:320px;"><table class="table table-sm table-hover mb-0">' +
    '<thead><tr><th>Workspace</th><th>SKU</th><th>License</th></tr></thead><tbody>' + body + '</tbody></table></div></div>';
}

function accessTable(rows) {
  if (!rows.length) return '';
  var body = rows.map(function(w) {
    var parts = [];
    w.added.forEach(function(u) {
      parts.push('<span class="badge bg-success me-1 mb-1">+ ' + escapeHtml(u.name) + ' (' + escapeHtml(u.role) + ')</span>');
    });
    w.removed.forEach(function(u) {
      parts.push('<span class="badge bg-danger me-1 mb-1">− ' + escapeHtml(u.name) + ' (' + escapeHtml(u.role) + ')</span>');
    });
    w.roleChanged.forEach(function(u) {
      parts.push('<span class="badge bg-warning text-dark me-1 mb-1">' + escapeHtml(u.name) + ': ' + escapeHtml(u.from) + ' &rarr; ' + escapeHtml(u.to) + '</span>');
    });
    return '<tr><td>' + escapeHtml(w.name) + '</td><td>' + parts.join('') + '</td></tr>';
  }).join('');
  return '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-people me-1 text-primary"></i>Access Changes (' + rows.length + ' workspaces)</h6>' +
    '<div class="table-responsive" style="max-height:320px;"><table class="table table-sm table-hover mb-0">' +
    '<thead><tr><th style="width:30%;">Workspace</th><th>Users</th></tr></thead><tbody>' + body + '</tbody></table></div></div>';
}

function tenantSettingsSection(ts) {
  if (!ts) return '';
  if (!ts.available) {
    return '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-sliders me-1 text-secondary"></i>Tenant Settings</h6>' +
      '<div class="alert alert-info small mb-0"><i class="bi bi-info-circle me-1"></i>' + escapeHtml(ts.reason) + '</div></div>';
  }

  var total = ts.added.length + ts.removed.length + ts.enabledChanged.length + ts.scopeChanged.length;
  if (!total) {
    return '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-sliders me-1 text-success"></i>Tenant Settings</h6>' +
      '<div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>No tenant setting was added, removed, toggled, or re-scoped between these runs.</div></div>';
  }

  var html = '<div class="mb-4"><h6 class="mb-2"><i class="bi bi-sliders me-1 text-warning"></i>Tenant Settings (' + total + ' change' + (total === 1 ? '' : 's') + ')</h6>';

  if (ts.enabledChanged.length) {
    var toggles = ts.enabledChanged.map(function(s) {
      var badge = s.to
        ? '<span class="badge bg-danger">Disabled</span> &rarr; <span class="badge bg-success">Enabled</span>'
        : '<span class="badge bg-success">Enabled</span> &rarr; <span class="badge bg-danger">Disabled</span>';
      return '<tr><td>' + escapeHtml(s.label) + '<div class="text-muted" style="font-size:0.7rem;"><code>' + escapeHtml(s.name) + '</code></div></td>' +
        '<td><span class="badge bg-secondary">' + escapeHtml(s.group) + '</span></td><td>' + badge + '</td></tr>';
    }).join('');
    html += '<div class="text-warning small fw-bold mb-1">Toggled</div>' +
      '<div class="table-responsive mb-3" style="max-height:300px;"><table class="table table-sm table-hover mb-0">' +
      '<thead><tr><th>Setting</th><th>Group</th><th>Change</th></tr></thead><tbody>' + toggles + '</tbody></table></div>';
  }

  if (ts.scopeChanged.length) {
    var scopes = ts.scopeChanged.map(function(s) {
      return '<tr><td>' + escapeHtml(s.label) + '</td><td><span class="badge bg-secondary">' + escapeHtml(s.group) + '</span></td>' +
        '<td class="small text-muted">' + escapeHtml(s.from) + '</td><td class="small">' + escapeHtml(s.to) + '</td></tr>';
    }).join('');
    html += '<div class="text-info small fw-bold mb-1">Scope or delegation changed</div>' +
      '<div class="table-responsive mb-3" style="max-height:300px;"><table class="table table-sm table-hover mb-0">' +
      '<thead><tr><th>Setting</th><th>Group</th><th>Before</th><th>After</th></tr></thead><tbody>' + scopes + '</tbody></table></div>';
  }

  function simpleList(rows, label, color) {
    if (!rows.length) return '';
    var body = rows.map(function(s) {
      return '<tr><td>' + escapeHtml(s.label) + '</td><td><span class="badge bg-secondary">' + escapeHtml(s.group) + '</span></td>' +
        '<td><span class="badge bg-' + (s.enabled ? 'success' : 'secondary') + '">' + (s.enabled ? 'Enabled' : 'Disabled') + '</span></td></tr>';
    }).join('');
    return '<div class="col-lg-6"><div class="text-' + color + ' small fw-bold mb-1">' + label + '</div>' +
      '<div class="table-responsive" style="max-height:260px;"><table class="table table-sm mb-0">' +
      '<thead><tr><th>Setting</th><th>Group</th><th>State</th></tr></thead><tbody>' + body + '</tbody></table></div></div>';
  }
  if (ts.added.length || ts.removed.length) {
    html += '<div class="row g-3">' + simpleList(ts.added, 'New settings', 'success') + simpleList(ts.removed, 'No longer present', 'danger') + '</div>';
  }

  return html + '</div>';
}

function itemsSection(items) {
  if (!items.addedCount && !items.removedCount) return '';
  function list(rows, label, color) {
    if (!rows.length) return '';
    var body = rows.map(function(i) {
      return '<tr><td>' + escapeHtml(i.workspace) + '</td><td>' + escapeHtml(i.name) + '</td><td><span class="badge bg-secondary">' + escapeHtml(i.type) + '</span></td></tr>';
    }).join('');
    return '<div class="col-lg-6"><div class="text-' + color + ' small fw-bold mb-1">' + label + '</div>' +
      '<div class="table-responsive" style="max-height:300px;"><table class="table table-sm mb-0">' +
      '<thead><tr><th>Workspace</th><th>Item</th><th>Type</th></tr></thead><tbody>' + body + '</tbody></table></div></div>';
  }
  return '<div class="mb-2"><h6 class="mb-2"><i class="bi bi-boxes me-1 text-dark"></i>Item Churn — ' +
    items.addedCount + ' added, ' + items.removedCount + ' removed</h6>' +
    (items.truncated ? '<div class="alert alert-info small py-1 px-2">Showing the first ' + items.added.length + ' added and ' + items.removed.length + ' removed items. Counts above are exact.</div>' : '') +
    '<div class="row g-3">' + list(items.added, 'Added', 'success') + list(items.removed, 'Removed', 'danger') + '</div></div>';
}

async function loadDetails() {
  var btn = document.getElementById('detailsBtn');
  var panel = document.getElementById('detailsPanel');
  btn.disabled = true;
  panel.innerHTML = '<div class="text-muted small d-flex align-items-center gap-2"><span class="spinner-border spinner-border-sm"></span> Comparing full run contents...</div>';

  try {
    var resp = await fetch(<%- JSON.stringify(cmp.detailsPath) %> + '?from=' + compareFrom + '&to=' + compareTo + (scopeConfirmed ? '&confirm=1' : ''));
    var data = await resp.json();
    if (!data.success) {
      panel.innerHTML = '<div class="alert alert-warning small mb-0"><i class="bi bi-exclamation-triangle me-1"></i>' + escapeHtml(data.message) + '</div>';
      btn.disabled = false;
      return;
    }

    var d = data.details;
    var html = tenantSettingsSection(d.tenantSettings) +
      workspaceTable('Added Workspaces', d.workspaces.added, 'success', 'plus-circle') +
      workspaceTable('Removed Workspaces', d.workspaces.removed, 'danger', 'dash-circle') +
      changedTable(d.workspaces.changed) +
      capacityTable(d.capacityMoves) +
      accessTable(d.accessChanges) +
      itemsSection(d.items);

    panel.innerHTML = html || '<div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>No workspace, capacity, access, or item differences between these runs.</div>';
    btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Reload detailed diff';
    btn.disabled = false;
  } catch (e) {
    panel.innerHTML = '<div class="alert alert-danger small mb-0">' + escapeHtml(e.message) + '</div>';
    btn.disabled = false;
  }
}
</script>

<%- include('../partials/footer') %>
