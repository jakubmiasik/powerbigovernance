<%- include('../partials/header') %>
<div class="row">
  <div class="col-lg-10 mx-auto">
    <h2><i class="bi bi-play-circle me-2"></i>Run Analysis</h2>
    <p class="text-muted">Scan your Power BI tenant and save results to the database.</p>

    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-rocket me-2"></i>New Analysis</span>
        <a href="/analysis/compare" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-arrow-left-right me-1"></i>Compare Runs</a>
      </div>
      <div class="card-body">
        <% if (!servicePrincipals.length) { %>
          <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-2"></i>No service principals configured. <a href="/settings">Add one in Settings</a> first.</div>
        <% } else { %>
          <div class="row align-items-end g-3">
            <div class="col-md-8">
              <label for="spSelect" class="form-label">Select Tenant / Service Principal</label>
              <select class="form-select" id="spSelect">
                <% servicePrincipals.forEach(function(sp) { %>
                  <option value="<%= sp.id %>" data-eaoid="<%= sp.enterprise_app_object_id || '' %>"><%= sp.name %> (<%= sp.tenant_id %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <button class="btn btn-primary w-100" onclick="startAnalysis()">
                <i class="bi bi-play-fill me-1"></i>Run Analysis&hellip;
              </button>
              <div class="form-text text-center">You choose the scope next</div>
            </div>
          </div>
          <div class="small text-muted mt-2">
            <i class="bi bi-info-circle me-1"></i>The scan sees every workspace through the admin APIs, but reading a
            lakehouse or warehouse SQL endpoint needs the principal to be a member of the workspace.
            <a href="/settings/access">Grant Access</a> shows who can reach what and adds the principal where it is missing.
          </div>
        <% } %>
      </div>
    </div>

    <div class="alert alert-info alert-dismissible d-none" id="backgroundNote">
      <i class="bi bi-box-arrow-down me-2"></i><span id="backgroundNoteText"></span>
      <button type="button" class="btn-close" aria-label="Dismiss"
              onclick="document.getElementById('backgroundNote').classList.add('d-none')"></button>
    </div>

    <!-- ── Scheduled scans ── -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-calendar-check me-2"></i>Scheduled Scans (<%= (schedules || []).length %>)</span>
        <button class="btn btn-sm btn-outline-primary" onclick="openScheduleForm()"
                <%= servicePrincipals.length ? '' : 'disabled' %>>
          <i class="bi bi-plus me-1"></i>New schedule
        </button>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0" id="analysis-schedules-table">
          <thead><tr>
            <th>Name</th><th>Scope</th><th>When</th><th>Tenant</th><th>Status</th><th>Last run</th><th></th>
          </tr></thead>
          <tbody>
            <% if (!(schedules || []).length) { %>
              <tr><td colspan="7" class="text-muted small py-3">
                No scheduled scans. A governance picture is only worth trusting if it refreshes without
                somebody remembering to press a button — and a scan scoped to the workspaces that matter is
                short enough to run nightly.
              </td></tr>
            <% } %>
            <% (schedules || []).forEach(function(sched) {
                 var spName = (servicePrincipals.find(function(sp) { return String(sp.id) === String(sched.sp_id); }) || {}).name;
            %>
              <tr class="<%= sched.enabled ? '' : 'text-muted' %>">
                <td class="small"><strong><%= sched.name %></strong></td>
                <td class="small">
                  <% if (sched.scope.kind === 'workspaces') { %>
                    <span class="badge bg-info text-dark" title="<%= sched.scopeLabel %>">
                      <i class="bi bi-funnel me-1"></i><%= sched.scope.workspaces.length %> workspace<%= sched.scope.workspaces.length === 1 ? '' : 's' %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border">Whole tenant</span>
                  <% } %>
                </td>
                <td class="small"><%= sched.timingLabel %></td>
                <td class="small"><%= spName || (sched.sp_id ? 'SP #' + sched.sp_id : 'first configured') %></td>
                <td>
                  <span class="badge bg-<%= sched.enabled ? 'success' : 'secondary' %>">
                    <%= sched.enabled ? 'enabled' : 'paused' %>
                  </span>
                </td>
                <td class="small text-muted" data-schedule-last="<%= sched.id %>">—</td>
                <td class="text-nowrap">
                  <button class="btn btn-sm btn-outline-primary p-0 px-1" title="Run now"
                          onclick="runScheduleNow(<%= sched.id %>)"><i class="bi bi-play-fill"></i></button>
                  <button class="btn btn-sm btn-outline-secondary p-0 px-1" title="<%= sched.enabled ? 'Pause' : 'Enable' %>"
                          onclick="toggleSchedule(<%= sched.id %>, <%= sched.enabled ? 'false' : 'true' %>)">
                    <i class="bi bi-<%= sched.enabled ? 'pause' : 'play' %>"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-secondary p-0 px-1" title="History"
                          onclick="showScheduleHistory(<%= sched.id %>, '<%= sched.name.replace(/'/g, "\\'") %>')"><i class="bi bi-clock-history"></i></button>
                  <button class="btn btn-sm btn-outline-danger p-0 px-1" title="Delete"
                          onclick="deleteSchedule(<%= sched.id %>, '<%= sched.name.replace(/'/g, "\\'") %>')"><i class="bi bi-trash"></i></button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer small text-muted">
        Schedules fire in their own timezone and are caught up for up to
        <code>SCHEDULER_CATCHUP_MINUTES</code> if the worker was asleep at the minute they were due. A schedule
        never stacks a scan on one of its own that is still running — it records the skip instead.
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-clock-history me-2"></i>Previous Runs (<%= runs.length %>)</span>
        <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter runs..." oninput="filterTable(this, 'analysis-runs-table')">
      </div>
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0" id="analysis-runs-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Tenant</th>
              <th>Status</th>
              <th>Workspaces</th>
              <th>Reports</th>
              <th>Datasets</th>
              <th>Dashboards</th>
              <th>Users</th>
              <th>Date</th>
              <th>By</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!runs.length) { %>
              <tr data-filter="no runs"><td colspan="11" class="text-center text-muted py-3">No analysis runs yet</td></tr>
            <% } %>
            <% runs.forEach(function(runItem) {
                 var live = (typeof liveProgress !== 'undefined' && liveProgress) ? liveProgress[runItem.id] : null;
                 // A run the process no longer heartbeats is shown as interrupted even
                 // if its row still says running — the row is only updated by the
                 // worker that owned it.
                 var effectiveStatus = live && live.status ? live.status : runItem.status;
                 var statusColor = effectiveStatus === 'completed' ? 'success'
                   : effectiveStatus === 'running' || effectiveStatus === 'cancelling' ? 'primary'
                   : effectiveStatus === 'cancelled' ? 'secondary'
                   : effectiveStatus === 'interrupted' ? 'warning' : 'danger';
                 var isLive = effectiveStatus === 'running' || effectiveStatus === 'cancelling';
            %>
              <tr data-filter="<%= [runItem.id, runItem.sp_name || '', runItem.status || '', runItem.run_by || '', runItem.tenant_id || '', runItem.scopeLabel || ''].join(' ').toLowerCase() %>" data-run-id="<%= runItem.id %>">
                <td><%= runItem.id %></td>
                <td style="min-width: 180px;">
                  <strong><%= runItem.sp_name || '-' %></strong>
                  <div class="text-nowrap" style="font-size: 0.7rem;">
                    <% if (runItem.scope && runItem.scope.kind === 'workspaces') { %>
                      <span class="text-info" title="<%= runItem.scopeLabel %>">
                        <i class="bi bi-funnel"></i> Scoped · <%= runItem.scope.workspaces.length %> workspace<%= runItem.scope.workspaces.length === 1 ? '' : 's' %>
                      </span>
                    <% } else { %>
                      <span class="text-muted">Whole tenant</span>
                    <% } %>
                    <% if (runItem.schedule_id) { %>
                      <span class="text-muted" title="Started by a schedule">· <i class="bi bi-clock"></i> scheduled</span>
                    <% } %>
                  </div>
                </td>
                <td style="min-width: 190px;">
                  <button class="badge bg-<%= statusColor %> border-0 run-status-badge"
                          data-run-status-for="<%= runItem.id %>"
                          data-run-last-status="<%= effectiveStatus %>"
                          title="Show progress for this run"
                          onclick="showRunProgress(<%= runItem.id %>)">
                    <% if (isLive) { %><span class="spinner-border spinner-border-sm me-1" style="width:.6rem;height:.6rem;"></span><% } %><%= effectiveStatus %><% if (isLive && live) { %> <%= live.progress %>%<% } %>
                  </button>
                  <div class="progress mt-1 run-status-bar<%= isLive ? '' : ' d-none' %>" data-run-bar-for="<%= runItem.id %>" style="height: 4px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: <%= live ? live.progress : 0 %>%"></div>
                  </div>
                  <div class="text-muted run-status-note<%= isLive ? '' : ' d-none' %>" data-run-note-for="<%= runItem.id %>" style="font-size: 0.7rem;">
                    <%= live && live.phase ? live.phase : '' %>
                  </div>
                </td>
                <td><%= runItem.total_workspaces || 0 %></td>
                <td><%= runItem.total_reports || 0 %></td>
                <td><%= runItem.total_datasets || 0 %></td>
                <td><%= runItem.total_dashboards || 0 %></td>
                <td><%= runItem.total_users || 0 %></td>
                <td><small><%= runItem.started_at ? new Date(runItem.started_at).toLocaleString() : '-' %></small></td>
                <td><small><%= runItem.run_by || '-' %></small></td>
                <td class="text-nowrap">
                  <% if (runItem.status === 'completed') { %>
                    <a href="/analysis/results/<%= runItem.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>View</a>
                  <% } %>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteRun(<%= runItem.id %>)"><i class="bi bi-trash"></i></button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="progressModal" tabindex="-1" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-hourglass-split me-2"></i>Analysis in Progress</h5>
      </div>
      <div class="modal-body">
        <div class="text-center">
          <div class="spinner-border text-primary mb-3" role="status" id="analysisSpinner">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="badge bg-primary" id="progressPhase">Starting</span>
          <span class="small text-muted" id="progressElapsed"></span>
        </div>
        <div class="progress mb-2" style="height: 25px;">
          <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" id="progressBar" style="width: 0%">0%</div>
        </div>
        <div class="d-flex justify-content-between align-items-center small mb-2">
          <span id="progressWork" class="text-muted"></span>
          <span id="progressEta" class="text-muted"></span>
        </div>
        <p class="text-muted mb-1" id="progressMessage">Starting analysis...</p>
        <p class="small text-muted mb-2" id="progressDetail"></p>

        <!-- What has been finished and what is still to come -->
        <div class="mb-2" id="phaseListWrap" style="display:none;">
          <div class="small text-muted mb-1">Steps</div>
          <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
            <table class="table table-sm mb-0" id="phaseList"><tbody></tbody></table>
          </div>
        </div>

        <!-- Why nothing appears to be happening -->
        <div class="alert alert-warning py-2 px-3 small d-none" id="throttleAlert">
          <i class="bi bi-hourglass-split me-1"></i>
          <strong>Waiting on API rate limits.</strong>
          <span id="throttleText"></span>
        </div>
        <div class="alert alert-danger py-2 px-3 small d-none" id="stallAlert">
          <i class="bi bi-exclamation-triangle me-1"></i>
          <strong>No progress for <span id="stallSeconds"></span>s.</strong>
          The run may be blocked on a slow request. Check the activity log below, or cancel and retry.
        </div>
        <div class="alert alert-warning py-2 px-3 small d-none" id="remoteAlert">
          <i class="bi bi-hdd-network me-1"></i>
          This run is being executed by another application instance. Progress is read from its last saved
          checkpoint, so it may be a few seconds behind, and it cannot be cancelled from here.
        </div>

        <div class="row g-2 text-center mb-2" id="progressCounters" style="display:none;">
          <div class="col-3"><div class="fw-bold" id="counterApiCalls">0</div><div class="text-muted" style="font-size:0.7rem;">API calls</div></div>
          <div class="col-3"><div class="fw-bold text-warning" id="counterThrottled">0</div><div class="text-muted" style="font-size:0.7rem;">Throttled</div></div>
          <div class="col-3"><div class="fw-bold text-warning" id="counterRetries">0</div><div class="text-muted" style="font-size:0.7rem;">Retries</div></div>
          <div class="col-3"><div class="fw-bold text-danger" id="counterFailures">0</div><div class="text-muted" style="font-size:0.7rem;">Failures</div></div>
        </div>

        <details id="activityLogWrap" style="display:none;">
          <summary class="small text-muted" style="cursor:pointer;">Activity log</summary>
          <div class="mt-2" style="max-height:180px; overflow-y:auto;" id="activityLog"></div>
        </details>
      </div>
      <div class="modal-footer justify-content-between flex-wrap gap-2">
        <button class="btn btn-outline-danger" id="cancelAnalysisBtn" style="display:none;" onclick="cancelAnalysis()"><i class="bi bi-x-circle me-1"></i>Cancel</button>
        <button class="btn btn-primary" id="hideProgressBtn" style="display:none;" onclick="sendToBackground()"
                title="The scan keeps running on the server. Come back to it by clicking its Status in the table.">
          <i class="bi bi-box-arrow-down me-1"></i>Continue in background
        </button>
        <div class="ms-auto d-flex gap-2" id="progressFooterActions" style="display:none;">
          <a href="#" class="btn btn-primary" id="viewResultsBtn"><i class="bi bi-eye me-1"></i>View Results</a>
          <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function escapeHtml(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

// ── Choosing what to scan ──
//
// One picker, opened as a modal from two places: the Run Analysis button and the
// schedule form. They were two copies of the same list, the same filter and the
// same selection handling, which is two places for the behaviour to drift and two
// places to fix a bug in.
//
// The workspace list comes from the last tenant-wide scan by default, which costs
// nothing. Reading it live is one API call and is the only way to see a workspace
// created since — or to choose one at all before the first scan has ever run.
var scopePicker = {
  workspaces: [],
  selected: new Set(),
  source: null,
  spId: null,
  onConfirm: null,
  // The modal this was opened from, re-shown afterwards. Bootstrap does not
  // support overlapping modals, so the schedule form is hidden while the picker is
  // up and brought back when it closes.
  returnTo: null,
};

/**
 * Asks what to scan, then calls back with the answer.
 *
 * `scope` seeds the dialog, so reopening it from the schedule form shows what was
 * already chosen rather than starting again.
 */
function openScopePicker(options) {
  options = options || {};
  scopePicker.onConfirm = typeof options.onConfirm === 'function' ? options.onConfirm : null;
  scopePicker.returnTo = options.returnTo || null;

  var scope = options.scope || { kind: 'tenant', workspaces: [] };
  scopePicker.selected = new Set((scope.workspaces || []).map(function(ws) { return ws.id; }));

  document.getElementById('scopeModalTitle').textContent = options.title || 'What should this scan cover?';
  var confirmBtn = document.getElementById('scopeConfirmBtn');
  confirmBtn.innerHTML = options.confirmIcon || '<i class="bi bi-play-fill me-1"></i>';
  // Appended as text rather than concatenated into innerHTML: the label is a
  // caller's string and has no business being parsed as markup.
  confirmBtn.append(options.confirmLabel || 'Run Analysis');

  var kind = scope.kind === 'workspaces' ? 'workspaces' : 'tenant';
  document.getElementById('scopeKindTenant').checked = kind === 'tenant';
  document.getElementById('scopeKindWorkspaces').checked = kind === 'workspaces';

  // Names chosen earlier are shown until the live list arrives, so a saved scope
  // never briefly reads as empty.
  scopePicker.workspaces = (scope.workspaces || []).map(function(ws) {
    return { id: ws.id, name: ws.name || ws.id, state: 'Active' };
  });
  scopePicker.source = null;
  document.getElementById('scopeFilter').value = '';

  scopePicker.spId = options.spId;
  onScopeKindChanged();
  // Always re-read: a workspace may have appeared since the dialog was last opened,
  // and the list is either a cheap database read or one API call.
  loadScopeWorkspaces(false);

  var picker = document.getElementById('scopeModal');
  var parent = scopePicker.returnTo ? document.getElementById(scopePicker.returnTo) : null;
  var parentModal = parent ? bootstrap.Modal.getInstance(parent) : null;
  if (!parentModal) {
    bootstrap.Modal.getOrCreateInstance(picker).show();
    return;
  }

  // Bootstrap does not support overlapping modals: showing this one while the
  // schedule form is still animating out leaves the two sharing a backdrop, and
  // the one that finishes hiding takes it — and `body.modal-open` — with it. So
  // the picker waits until the form is fully hidden.
  parent.addEventListener('hidden.bs.modal', function once() {
    parent.removeEventListener('hidden.bs.modal', once);
    bootstrap.Modal.getOrCreateInstance(picker).show();
  });
  parentModal.hide();
}

function onScopeKindChanged() {
  var scoped = document.getElementById('scopeKindWorkspaces').checked;
  document.getElementById('scopeWorkspacePanel').classList.toggle('d-none', !scoped);
  updateScopeConfirmState();
}

async function loadScopeWorkspaces(live) {
  var list = document.getElementById('scopeWorkspaceList');
  list.innerHTML = '<div class="text-center py-3 small text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Loading workspaces...</div>';
  try {
    var params = new URLSearchParams({ spId: scopePicker.spId });
    if (live) params.set('refresh', '1');
    var resp = await fetch('/analysis/workspaces?' + params.toString());
    var data = await resp.json();
    if (!data.success) {
      list.innerHTML = '<div class="alert alert-warning py-2 small mb-0">' + escapeHtml(data.message) + '</div>';
      return;
    }
    // Anything already selected but absent from this list is kept and marked, so a
    // saved scope naming a workspace the last scan missed is never silently dropped
    // from the selection just by opening the dialog.
    var known = {};
    (data.workspaces || []).forEach(function(ws) { known[ws.id] = true; });
    var carried = scopePicker.workspaces.filter(function(ws) {
      return scopePicker.selected.has(ws.id) && !known[ws.id];
    }).map(function(ws) { return { id: ws.id, name: ws.name, state: ws.state, notListed: true }; });

    scopePicker.workspaces = carried.concat(data.workspaces || []);
    scopePicker.source = data;
    renderScopeWorkspaces();
  } catch (e) {
    list.innerHTML = '<div class="alert alert-danger py-2 small mb-0">' + escapeHtml(e.message) + '</div>';
  }
}

function renderScopeWorkspaces() {
  var list = document.getElementById('scopeWorkspaceList');
  var needle = (document.getElementById('scopeFilter').value || '').trim().toLowerCase();
  var shown = scopePicker.workspaces.filter(function(ws) {
    return !needle || (ws.name || '').toLowerCase().indexOf(needle) !== -1;
  });

  if (!scopePicker.workspaces.length) {
    list.innerHTML = '<div class="small text-muted py-2">' +
      escapeHtml((scopePicker.source && scopePicker.source.message) || 'No workspaces to choose from yet.') + '</div>';
  } else {
    list.innerHTML = shown.map(function(ws) {
      return '<div class="form-check">' +
        '<input class="form-check-input scope-ws" type="checkbox" value="' + escapeHtml(ws.id) + '" id="scopews-' + escapeHtml(ws.id) + '"' +
        (scopePicker.selected.has(ws.id) ? ' checked' : '') + ' onchange="onScopeWorkspaceToggled(this)">' +
        '<label class="form-check-label small" for="scopews-' + escapeHtml(ws.id) + '">' + escapeHtml(ws.name) +
        (ws.state && ws.state !== 'Active' ? ' <span class="text-muted">(' + escapeHtml(ws.state) + ')</span>' : '') +
        (ws.notListed ? ' <span class="badge bg-warning text-dark">not in the last scan</span>' : '') +
        '</label></div>';
    }).join('') || '<div class="small text-muted py-2">Nothing matches that filter.</div>';
  }

  var source = document.getElementById('scopeSource');
  if (scopePicker.source && scopePicker.source.source === 'scan') {
    source.textContent = 'From scan #' + scopePicker.source.runId +
      (scopePicker.source.scannedAt ? ' on ' + new Date(scopePicker.source.scannedAt).toLocaleDateString() : '') +
      ' — refresh to include workspaces created since.';
  } else if (scopePicker.source && scopePicker.source.source === 'live') {
    source.textContent = 'Read from the tenant just now.';
  } else {
    source.textContent = '';
  }
  updateScopeConfirmState();
}

function onScopeWorkspaceToggled(input) {
  // Held in a Set rather than read off the DOM, so a selection survives filtering
  // the list — ticking three, searching, and ticking a fourth must keep all four.
  if (input.checked) scopePicker.selected.add(input.value);
  else scopePicker.selected.delete(input.value);
  updateScopeConfirmState();
}

function toggleAllScopeWorkspaces(checked) {
  // Only the rows the filter is showing, so "select all" cannot quietly include
  // workspaces that are not on screen.
  document.querySelectorAll('.scope-ws').forEach(function(box) {
    box.checked = checked;
    if (checked) scopePicker.selected.add(box.value);
    else scopePicker.selected.delete(box.value);
  });
  updateScopeConfirmState();
}

function updateScopeConfirmState() {
  var scoped = document.getElementById('scopeKindWorkspaces').checked;
  document.getElementById('scopeCount').textContent = scopePicker.selected.size + ' selected';
  // Confirming a scoped scan with nothing ticked would be refused by the server
  // anyway; disabling the button says so before the round trip.
  document.getElementById('scopeConfirmBtn').disabled = scoped && scopePicker.selected.size === 0;
}

/** The chosen scope, in the shape the API and the schedule form both take. */
function currentScopeSelection() {
  if (!document.getElementById('scopeKindWorkspaces').checked) return { kind: 'tenant', workspaces: [] };
  var byId = {};
  scopePicker.workspaces.forEach(function(ws) { byId[ws.id] = ws.name; });
  return {
    kind: 'workspaces',
    workspaces: Array.from(scopePicker.selected).map(function(id) { return { id: id, name: byId[id] || null }; }),
  };
}

function confirmScopePicker() {
  var scope = currentScopeSelection();
  var callback = scopePicker.onConfirm;
  scopePicker.onConfirm = null;
  bootstrap.Modal.getOrCreateInstance(document.getElementById('scopeModal')).hide();
  if (callback) callback(scope);
}

document.addEventListener('DOMContentLoaded', function() {
  var modal = document.getElementById('scopeModal');
  if (!modal) return;
  // Whether it was confirmed or dismissed, the form it came from comes back.
  modal.addEventListener('hidden.bs.modal', function() {
    if (!scopePicker.returnTo) return;
    var parent = document.getElementById(scopePicker.returnTo);
    scopePicker.returnTo = null;
    // By now this modal is fully gone, so the form can safely take the backdrop.
    if (parent) bootstrap.Modal.getOrCreateInstance(parent).show();
  });
});

var progressInterval = null;
var activeRunId = null;
var progressModal = null;
// Ticks whether or not the modal is open, so the Status column stays live for runs
// that were sent to the background.
var runListInterval = null;

function getProgressModal() {
  if (!progressModal) {
    progressModal = new bootstrap.Modal(document.getElementById('progressModal'));
    // Dismissing the modal by any route — the button, Escape, the backdrop — only
    // stops watching. The scan itself is server-side and carries on.
    document.getElementById('progressModal').addEventListener('hidden.bs.modal', stopWatching);
  }
  return progressModal;
}

function stopWatching() {
  if (progressInterval) clearInterval(progressInterval);
  progressInterval = null;
  activeRunId = null;
}

function sendToBackground() {
  var runId = activeRunId;
  getProgressModal().hide();
  if (!runId) return;

  // A run started from this page has no row in the table yet, so there would be
  // nothing to click. Reload so it appears — already showing its live progress.
  if (!document.querySelector('[data-run-status-for="' + runId + '"]')) {
    reloadPageWithMessage('Run #' + runId + ' continues in the background. Reloading...');
    return;
  }
  showBackgroundNote('Run #' + runId + ' is still running. Click its Status in the table below to come back to it.');
  pollRunList();
}

function showBackgroundNote(text) {
  var note = document.getElementById('backgroundNote');
  if (!note) return;
  document.getElementById('backgroundNoteText').textContent = text;
  note.classList.remove('d-none');
}

// Put the modal back into its "in flight" state. Shared by a new run and by
// reattaching to a run that is already going.
function resetProgressUi(message) {
  document.getElementById('progressBar').style.width = '0%';
  document.getElementById('progressBar').textContent = '0%';
  document.getElementById('progressBar').classList.add('progress-bar-animated');
  document.getElementById('progressMessage').textContent = message;
  document.getElementById('progressDetail').textContent = '';
  document.getElementById('progressWork').textContent = '';
  document.getElementById('progressEta').textContent = '';
  document.getElementById('phaseListWrap').style.display = 'none';
  document.getElementById('remoteAlert').classList.add('d-none');
  document.getElementById('progressFooterActions').style.display = 'none';
  document.getElementById('cancelAnalysisBtn').style.display = 'none';
  document.getElementById('cancelAnalysisBtn').disabled = false;
  document.getElementById('hideProgressBtn').style.display = 'none';
  document.getElementById('analysisSpinner').style.display = '';
}

function startPolling(runId) {
  if (progressInterval) clearInterval(progressInterval);
  activeRunId = runId;
  pollProgress(runId);
  progressInterval = setInterval(function() { pollProgress(runId); }, 2000);
  startRunListPolling();
}

/**
 * Reopen the progress modal for a run that is already in flight — for example after
 * the modal was closed, or after the page was reloaded while the run continued on
 * the server.
 */
function showRunProgress(runId) {
  if (!runId) return;
  resetProgressUi('Reading progress for run #' + runId + '...');
  getProgressModal().show();
  // The buttons that only make sense for a run in flight are revealed by the first
  // poll, so opening a finished run does not flash a Cancel it cannot honour.
  startPolling(runId);
}

/**
 * Asks what to scan before starting anything.
 *
 * The choice used to sit on the page above the button, where it was easy to press
 * Run Analysis without having read it — and on a large tenant the difference
 * between the two answers is hours.
 */
function startAnalysis() {
  openScopePicker({
    title: 'What should this scan cover?',
    spId: document.getElementById('spSelect').value,
    scope: lastScanScope,
    confirmLabel: 'Run Analysis',
    onConfirm: function(scope) {
      lastScanScope = scope;
      runAnalysisWithScope(scope);
    },
  });
}

// Remembered between presses, so someone scanning the same four workspaces twice
// does not tick them twice.
var lastScanScope = { kind: 'tenant', workspaces: [] };

async function runAnalysisWithScope(scope) {
  var spId = document.getElementById('spSelect').value;

  getProgressModal().show();

  activeRunId = null;
  resetProgressUi('Starting analysis...');

  try {
    var response = await fetch('/analysis/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spId: spId, scope: scope.kind, workspaces: scope.workspaces })
    });
    var data = await response.json();

    if (!data.success) {
      document.getElementById('progressMessage').textContent = 'Error: ' + data.message;
      document.getElementById('analysisSpinner').style.display = 'none';
      document.getElementById('progressFooterActions').style.display = '';
      return;
    }

    document.getElementById('cancelAnalysisBtn').style.display = '';
    document.getElementById('hideProgressBtn').style.display = '';
    startPolling(data.runId);
  } catch (err) {
    document.getElementById('progressMessage').textContent = 'Error: ' + err.message;
    document.getElementById('analysisSpinner').style.display = 'none';
    document.getElementById('progressFooterActions').style.display = '';
  }
}

function formatDuration(totalSeconds) {
  var s = Math.max(0, Math.floor(totalSeconds || 0));
  if (s < 60) return s + 's';
  var m = Math.floor(s / 60);
  if (m < 60) return m + 'm ' + (s % 60) + 's';
  return Math.floor(m / 60) + 'h ' + (m % 60) + 'm';
}

var PHASE_STATE_ICON = {
  done: '<i class="bi bi-check-circle-fill text-success"></i>',
  active: '<span class="spinner-border spinner-border-sm text-primary" style="width:.75rem;height:.75rem;"></span>',
  skipped: '<i class="bi bi-dash-circle text-muted"></i>',
  pending: '<i class="bi bi-circle text-muted"></i>'
};

// The step list is what answers "how much is done and how much is left" in terms a
// person can act on — a percentage alone does not say which part is slow.
function renderPhases(phases) {
  var wrap = document.getElementById('phaseListWrap');
  if (!phases || !phases.length) { wrap.style.display = 'none'; return; }
  wrap.style.display = '';

  var body = document.querySelector('#phaseList tbody');
  body.innerHTML = phases.map(function(phase) {
    var counts = '';
    if (phase.total === null || phase.total === undefined) {
      counts = phase.state === 'done' ? 'done' : phase.state === 'skipped' ? 'skipped' : '';
    } else if (phase.state === 'skipped') {
      counts = 'skipped';
    } else {
      counts = phase.done + ' / ' + phase.total;
      if (phase.state === 'active' && phase.total > phase.done) {
        counts += ' <span class="text-muted">(' + (phase.total - phase.done) + ' left)</span>';
      }
    }
    var note = phase.note ? ' <span class="text-muted">— ' + escapeHtml(phase.note) + '</span>' : '';
    var muted = phase.state === 'pending' || phase.state === 'skipped' ? ' text-muted' : '';
    return '<tr class="' + (phase.state === 'active' ? 'table-active' : '') + '">' +
      '<td style="width:1.5rem;">' + (PHASE_STATE_ICON[phase.state] || '') + '</td>' +
      '<td class="small' + muted + '">' + escapeHtml(phase.label) + note + '</td>' +
      '<td class="small text-end' + muted + '">' + counts + '</td>' +
      '</tr>';
  }).join('');
}

function renderActivityLog(events) {
  var wrap = document.getElementById('activityLogWrap');
  var log = document.getElementById('activityLog');
  if (!events.length) { wrap.style.display = 'none'; return; }
  wrap.style.display = '';

  log.innerHTML = events.slice().reverse().map(function(evt) {
    var color = evt.level === 'error' ? 'danger' : evt.level === 'warning' ? 'warning' : 'secondary';
    var time = new Date(evt.at).toLocaleTimeString();
    return '<div class="small mb-1"><span class="badge bg-' + color + ' me-1">' + time + '</span>' +
      String(evt.message)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') +
      '</div>';
  }).join('');
}

async function pollProgress(runId) {
  try {
    var response = await fetch('/analysis/progress/' + runId);
    var data = await response.json();

    var percent = Number(data.progress) || 0;
    document.getElementById('progressBar').style.width = percent + '%';
    document.getElementById('progressBar').textContent = percent + '%';
    document.getElementById('progressMessage').textContent = data.message || '';

    if (data.phase) document.getElementById('progressPhase').textContent = data.phase;
    if (typeof data.elapsedSeconds === 'number') {
      document.getElementById('progressElapsed').textContent = 'Elapsed ' + formatDuration(data.elapsedSeconds);
    }

    // Prefer the live detail (which workspace/item is being read) over the phase count.
    var detailEl = document.getElementById('progressDetail');
    if (data.detail) {
      detailEl.textContent = data.detail;
    } else if (data.phaseTotal) {
      detailEl.textContent = data.phaseDone + ' / ' + data.phaseTotal + ' in this step';
    } else {
      detailEl.textContent = '';
    }

    // Throttling and stalling are the two reasons a run looks frozen; say which.
    var throttleAlert = document.getElementById('throttleAlert');
    if (data.throttleRemainingSeconds > 0) {
      throttleAlert.classList.remove('d-none');
      document.getElementById('throttleText').textContent =
        'The Power BI API asked us to wait — resuming in about ' + data.throttleRemainingSeconds + 's.';
    } else {
      throttleAlert.classList.add('d-none');
    }

    var stallAlert = document.getElementById('stallAlert');
    if (data.stalled) {
      stallAlert.classList.remove('d-none');
      document.getElementById('stallSeconds').textContent = data.secondsSinceUpdate;
    } else {
      stallAlert.classList.add('d-none');
    }

    // How much of the run's countable work is done, and what is left of it.
    var workEl = document.getElementById('progressWork');
    if (data.unitsTotal) {
      workEl.textContent = data.unitsDone + ' of ' + data.unitsTotal + ' steps done · ' +
        data.unitsRemaining + ' remaining';
    } else {
      workEl.textContent = '';
    }
    document.getElementById('progressEta').textContent =
      typeof data.etaSeconds === 'number' ? 'About ' + formatDuration(data.etaSeconds) + ' left' : '';

    renderPhases(data.phases);

    // A run executed by another worker is answered from its saved checkpoint, which
    // changes what this modal can offer — say so rather than showing a Cancel button
    // that would not work.
    var remoteAlert = document.getElementById('remoteAlert');
    if (data.live) {
      document.getElementById('hideProgressBtn').style.display = '';
      document.getElementById('cancelAnalysisBtn').style.display = data.fromSnapshot ? 'none' : '';
      remoteAlert.classList.toggle('d-none', !data.fromSnapshot);
    } else {
      remoteAlert.classList.add('d-none');
    }

    if (data.counters) {
      document.getElementById('progressCounters').style.display = '';
      document.getElementById('counterApiCalls').textContent = data.counters.apiCalls;
      document.getElementById('counterThrottled').textContent = data.counters.throttled;
      document.getElementById('counterRetries').textContent = data.counters.retries;
      document.getElementById('counterFailures').textContent = data.counters.failures;
    }

    renderActivityLog(data.events || []);

    if (!data.live) {
      finishWatching(runId, data);
    }
  } catch (err) {
    document.getElementById('progressDetail').textContent = err.message;
  }
}

// Puts the modal into its resting state once the run is no longer in flight — done,
// failed, cancelled, abandoned, or simply not tracked.
function finishWatching(runId, data) {
  if (progressInterval) clearInterval(progressInterval);
  progressInterval = null;
  document.getElementById('analysisSpinner').style.display = 'none';
  document.getElementById('cancelAnalysisBtn').style.display = 'none';
  document.getElementById('hideProgressBtn').style.display = 'none';
  document.getElementById('progressFooterActions').style.display = '';
  document.getElementById('progressBar').classList.remove('progress-bar-animated');
  document.getElementById('progressEta').textContent = '';

  var showResults = data.status === 'completed';
  document.getElementById('viewResultsBtn').style.display = showResults ? '' : 'none';
  if (showResults) document.getElementById('viewResultsBtn').href = '/analysis/results/' + runId;

  if (data.status === 'unknown') {
    document.getElementById('progressMessage').textContent =
      'No progress is being reported for run #' + runId + '.';
  }
  pollRunList();
}

// ── Runs table ──
// Keeps the Status column current for every run still going, whether or not the
// modal is open, so a backgrounded scan is visible at a glance.
async function pollRunList() {
  var badges = document.querySelectorAll('[data-run-status-for]');
  if (!badges.length) return;

  try {
    var response = await fetch('/analysis/progress');
    var data = await response.json();
    var live = {};
    (data.runs || []).forEach(function(run) { live[run.runId] = run; });

    var anyLive = false;
    badges.forEach(function(badge) {
      var runId = Number(badge.getAttribute('data-run-status-for'));
      var run = live[runId];
      if (!run) return;

      var bar = document.querySelector('[data-run-bar-for="' + runId + '"]');
      var note = document.querySelector('[data-run-note-for="' + runId + '"]');
      var isLive = !!run.live;
      var wasLive = ['running', 'cancelling'].indexOf(badge.getAttribute('data-run-last-status')) !== -1;
      badge.setAttribute('data-run-last-status', run.status);
      if (isLive) anyLive = true;

      badge.className = 'badge border-0 run-status-badge bg-' + statusColorFor(run.status);
      badge.innerHTML = (isLive
        ? '<span class="spinner-border spinner-border-sm me-1" style="width:.6rem;height:.6rem;"></span>'
        : '') + escapeHtml(run.status) + (isLive ? ' ' + run.progress + '%' : '');

      if (bar) {
        bar.classList.toggle('d-none', !isLive);
        bar.firstElementChild.style.width = run.progress + '%';
      }
      if (note) {
        note.classList.toggle('d-none', !isLive);
        note.textContent = isLive
          ? run.phase + (run.phaseTotal ? ' ' + run.phaseDone + '/' + run.phaseTotal : '')
          : '';
      }

      // A run that finished while the page was open leaves stale zeroes in the
      // totals columns, so the page is reloaded once — only on the transition out
      // of a live state, and never while the user is reading the modal.
      if (wasLive && !isLive && !isProgressModalOpen()) {
        reloadPageWithMessage('Analysis run #' + runId + ' finished (' + run.status + '). Reloading...');
      }
    });

    // Nothing left to watch: stop asking.
    if (!anyLive && runListInterval) {
      clearInterval(runListInterval);
      runListInterval = null;
    }
  } catch (err) {
    // A transient failure here is not worth surfacing — the next tick retries.
  }
}

function isProgressModalOpen() {
  var el = document.getElementById('progressModal');
  return !!el && el.classList.contains('show');
}

function statusColorFor(status) {
  if (status === 'completed') return 'success';
  if (status === 'running' || status === 'cancelling') return 'primary';
  if (status === 'cancelled') return 'secondary';
  if (status === 'interrupted') return 'warning';
  return 'danger';
}

function startRunListPolling() {
  if (runListInterval) return;
  pollRunList();
  runListInterval = setInterval(pollRunList, 5000);
}

if (document.querySelector('.run-status-bar:not(.d-none)')) startRunListPolling();

async function cancelAnalysis() {
  if (!activeRunId) return;
  document.getElementById('cancelAnalysisBtn').disabled = true;
  document.getElementById('progressMessage').textContent = 'Cancellation requested...';
  try {
    await fetch('/analysis/cancel/' + activeRunId, { method: 'POST' });
  } catch (err) {
    document.getElementById('progressDetail').textContent = err.message;
  }
}

async function deleteRun(runId) {
  showConfirmAction({
    title: 'Delete Analysis Run',
    message: 'Delete this analysis run? This cannot be undone.',
    confirmText: 'Delete',
    confirmClass: 'btn-danger',
    onConfirm: async function() {
      try {
        await fetch('/analysis/delete/' + runId, { method: 'POST' });
        reloadPageWithMessage('Analysis run deleted. Reloading...');
      } catch (err) {
        console.error(err);
      }
    }
  });
}


// ── Scheduled scans ──
// A local read-only modal: the shared footer has a toast and a confirm, but no
// "here is a table, look at it" dialog.
function showInfoModal(title, html) {
  document.getElementById('infoModalTitle').innerHTML = title;
  document.getElementById('infoModalBody').innerHTML = html;
  bootstrap.Modal.getOrCreateInstance(document.getElementById('infoModal')).show();
}

// The scope a schedule is being given, held here rather than read off the form:
// it is chosen in the shared picker, which is a different dialog.
var scheduleScope = { kind: 'tenant', workspaces: [] };

function openScheduleForm() {
  document.getElementById('schedName').value = '';
  document.getElementById('schedType').value = 'daily';
  document.getElementById('schedHour').value = 2;
  document.getElementById('schedMinute').value = 0;
  document.getElementById('schedDay').value = 'Monday';
  document.getElementById('schedResult').innerHTML = '';
  scheduleScope = { kind: 'tenant', workspaces: [] };
  onScheduleTypeChanged();
  renderScheduleScope();
  new bootstrap.Modal(document.getElementById('scheduleModal')).show();
}

function onScheduleTypeChanged() {
  var type = document.getElementById('schedType').value;
  // Hourly has no hour to set, and only a weekly schedule needs a day.
  document.getElementById('schedHourWrap').classList.toggle('d-none', type === 'hourly');
  document.getElementById('schedDayWrap').classList.toggle('d-none', type !== 'weekly');
}

/** The chosen scope, in words, on the schedule form. */
function renderScheduleScope() {
  var target = document.getElementById('schedScopeSummary');
  if (scheduleScope.kind !== 'workspaces') {
    target.innerHTML = '<span class="badge bg-light text-dark border">Whole tenant</span>';
    return;
  }
  var names = scheduleScope.workspaces.map(function(ws) { return ws.name || ws.id; });
  target.innerHTML = '<span class="badge bg-info text-dark"><i class="bi bi-funnel me-1"></i>' +
    scheduleScope.workspaces.length + ' workspace' + (scheduleScope.workspaces.length === 1 ? '' : 's') + '</span>' +
    '<span class="small text-muted ms-2">' + escapeHtml(names.slice(0, 4).join(', ')) +
    (names.length > 4 ? ' and ' + (names.length - 4) + ' more' : '') + '</span>';
}

// The same dialog the Run Analysis button uses. Bootstrap does not support
// overlapping modals, so the schedule form is hidden while the picker is up and
// brought back when it closes — confirmed or not.
function chooseScheduleScope() {
  openScopePicker({
    title: 'What should this schedule scan?',
    spId: document.getElementById('schedSp').value,
    scope: scheduleScope,
    confirmLabel: 'Use this scope',
    confirmIcon: '<i class="bi bi-check-lg me-1"></i>',
    returnTo: 'scheduleModal',
    onConfirm: function(scope) {
      scheduleScope = scope;
      renderScheduleScope();
    },
  });
}

function onScheduleSpChanged() {
  // A different tenant has different workspaces; keeping the old selection would
  // store ids that mean nothing to the principal now chosen.
  if (scheduleScope.kind === 'workspaces') {
    scheduleScope = { kind: 'tenant', workspaces: [] };
    renderScheduleScope();
    showToast('The tenant changed, so the workspace selection was cleared.', 'info');
  }
}

async function saveSchedule() {
  var body = {
    name: document.getElementById('schedName').value.trim(),
    spId: document.getElementById('schedSp').value,
    scope: scheduleScope.kind,
    workspaces: scheduleScope.workspaces,
    scheduleType: document.getElementById('schedType').value,
    hour: parseInt(document.getElementById('schedHour').value, 10) || 0,
    minute: parseInt(document.getElementById('schedMinute').value, 10) || 0,
    day: document.getElementById('schedDay').value,
    timezone: document.getElementById('schedTimezone').value
  };

  var result = document.getElementById('schedResult');
  result.innerHTML = '<div class="small text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Saving...</div>';
  try {
    var resp = await fetch('/analysis/schedules', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    var data = await resp.json();
    if (!data.success) {
      result.innerHTML = '<div class="alert alert-danger py-2 small mb-0">' + escapeHtml(data.message) + '</div>';
      return;
    }
    // The scheduler works in the schedule's own timezone, but "which minute will
    // this land on" is a different question and worth answering here.
    result.innerHTML = '<div class="alert alert-success py-2 small mb-0">Saved.' +
      (data.utc ? ' Fires at <strong>' + escapeHtml(data.utc) + '</strong>.' : '') + ' Reloading...</div>';
    setTimeout(function() { window.location.reload(); }, 900);
  } catch (e) {
    result.innerHTML = '<div class="alert alert-danger py-2 small mb-0">' + escapeHtml(e.message) + '</div>';
  }
}

async function toggleSchedule(id, enabled) {
  try {
    var resp = await fetch('/analysis/schedules/' + id + '/toggle', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled: enabled })
    });
    var data = await resp.json();
    if (!data.success) { showToast(data.message, 'error'); return; }
    window.location.reload();
  } catch (e) { showToast(e.message, 'error'); }
}

function deleteSchedule(id, name) {
  showConfirmAction({
    title: 'Delete this schedule?',
    message: '"' + name + '" will stop running. Scans it has already produced are kept.',
    confirmText: 'Delete',
    onConfirm: async function() {
      try {
        var resp = await fetch('/analysis/schedules/' + id, { method: 'DELETE' });
        var data = await resp.json();
        if (!data.success) { showToast(data.message, 'error'); return; }
        window.location.reload();
      } catch (e) { showToast(e.message, 'error'); }
    }
  });
}

async function runScheduleNow(id) {
  showToast('Starting the scan this schedule would run...', 'info');
  try {
    var resp = await fetch('/analysis/schedules/' + id + '/run', { method: 'POST' });
    var data = await resp.json();
    if (!data.success) { showToast(data.message, 'error'); return; }
    // A skip is a real, correct outcome here — one of its own scans is still going.
    showToast(data.message, data.status === 'skipped' ? 'info' : 'success');
    if (data.runId) setTimeout(function() { window.location.reload(); }, 1200);
  } catch (e) { showToast(e.message, 'error'); }
}

async function showScheduleHistory(id, name) {
  showInfoModal('Schedule History', '<div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading...</p>');
  try {
    var resp = await fetch('/analysis/schedules/' + id + '/history');
    var data = await resp.json();
    if (!data.success) { showInfoModal('Schedule History', '<div class="alert alert-danger mb-0">' + escapeHtml(data.message) + '</div>'); return; }
    if (!data.history.length) {
      showInfoModal('Schedule History', '<p class="text-muted mb-0">' + escapeHtml(name) + ' has not run yet.</p>');
      return;
    }
    var rows = data.history.map(function(entry) {
      var color = entry.status === 'started' ? 'success' : entry.status === 'skipped' ? 'secondary' : 'danger';
      return '<tr><td class="small">' + new Date(entry.executed_at).toLocaleString() + '</td>' +
        '<td><span class="badge bg-' + color + '">' + escapeHtml(entry.status) + '</span></td>' +
        '<td class="small">' + (entry.run_id ? '<a href="/analysis/results/' + entry.run_id + '">#' + entry.run_id + '</a>' : '-') + '</td>' +
        '<td class="small">' + escapeHtml(entry.message || '') + '</td></tr>';
    }).join('');
    showInfoModal('History — ' + escapeHtml(name),
      '<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>When</th><th>Outcome</th><th>Run</th><th>Detail</th></tr></thead><tbody>' +
      rows + '</tbody></table></div>');
  } catch (e) {
    showInfoModal('Schedule History', '<div class="alert alert-danger mb-0">' + escapeHtml(e.message) + '</div>');
  }
}

// Each schedule's most recent outcome, filled in after the page renders so the
// list itself stays one query.
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-schedule-last]').forEach(async function(cell) {
    try {
      var resp = await fetch('/analysis/schedules/' + cell.getAttribute('data-schedule-last') + '/history?limit=1');
      var data = await resp.json();
      if (!data.success || !data.history.length) { cell.textContent = 'never run'; return; }
      var last = data.history[0];
      cell.textContent = new Date(last.executed_at).toLocaleString() + ' — ' + last.status;
    } catch (e) { cell.textContent = '—'; }
  });
});
</script>

<!-- What to scan: one dialog, opened from the Run Analysis button and the schedule form -->
<div class="modal fade" id="scopeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scopeModalTitle">What should this scan cover?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="form-check mb-2">
          <input class="form-check-input" type="radio" name="scopeKind" id="scopeKindTenant" checked onchange="onScopeKindChanged()">
          <label class="form-check-label" for="scopeKindTenant">
            <strong>The whole tenant</strong>
            <div class="small text-muted">
              Everything the service principal can see. The complete picture, and the only kind of scan the
              tenant-wide pages will read — but on a large tenant it is hours of API calls.
            </div>
          </label>
        </div>
        <div class="form-check mb-2">
          <input class="form-check-input" type="radio" name="scopeKind" id="scopeKindWorkspaces" onchange="onScopeKindChanged()">
          <label class="form-check-label" for="scopeKindWorkspaces">
            <strong>Selected workspaces only</strong>
            <div class="small text-muted">
              Much faster, and enough to answer a question about a few workspaces. Governance and Grant Access
              will keep reading the most recent whole-tenant scan rather than this one.
            </div>
          </label>
        </div>

        <div class="d-none" id="scopeWorkspacePanel">
          <hr class="my-2">
          <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
            <input type="text" class="form-control form-control-sm" style="max-width:220px;"
                   id="scopeFilter" placeholder="Filter workspaces..." oninput="renderScopeWorkspaces()">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAllScopeWorkspaces(true)">Select all shown</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAllScopeWorkspaces(false)">Clear</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="loadScopeWorkspaces(true)"
                    title="Read the workspace list from the tenant instead of the last scan">
              <i class="bi bi-arrow-clockwise me-1"></i>Refresh from tenant
            </button>
            <span class="small text-muted ms-auto" id="scopeCount">0 selected</span>
          </div>
          <div class="border rounded p-2" style="max-height:300px; overflow-y:auto;" id="scopeWorkspaceList"></div>
          <div class="form-text" id="scopeSource"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="scopeConfirmBtn" onclick="confirmScopePicker()"></button>
      </div>
    </div>
  </div>
</div>

<!-- Schedule editor -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-calendar-plus me-2"></i>New Scheduled Scan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2">
          <div class="col-md-7">
            <label class="form-label small" for="schedName">Name</label>
            <input type="text" class="form-control form-control-sm" id="schedName" placeholder="Nightly finance workspaces">
          </div>
          <div class="col-md-5">
            <label class="form-label small" for="schedSp">Tenant / service principal</label>
            <select class="form-select form-select-sm" id="schedSp" onchange="onScheduleSpChanged()">
              <% servicePrincipals.forEach(function(sp) { %>
                <option value="<%= sp.id %>"><%= sp.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label small" for="schedType">How often</label>
            <select class="form-select form-select-sm" id="schedType" onchange="onScheduleTypeChanged()">
              <% (scheduleTypes || []).forEach(function(type) { %>
                <option value="<%= type.key %>"><%= type.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2 d-none" id="schedHourWrap">
            <label class="form-label small" for="schedHour">Hour</label>
            <input type="number" min="0" max="23" class="form-control form-control-sm" id="schedHour" value="2">
          </div>
          <div class="col-md-2">
            <label class="form-label small" for="schedMinute">Minute</label>
            <input type="number" min="0" max="59" class="form-control form-control-sm" id="schedMinute" value="0">
          </div>
          <div class="col-md-3 d-none" id="schedDayWrap">
            <label class="form-label small" for="schedDay">Day</label>
            <select class="form-select form-select-sm" id="schedDay">
              <% ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].forEach(function(day) { %>
                <option value="<%= day %>"><%= day %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small" for="schedTimezone">Timezone</label>
            <select class="form-select form-select-sm" id="schedTimezone">
              <option value="UTC">UTC</option>
              <option value="Europe/London">Europe/London</option>
              <option value="Europe/Paris">Europe/Paris (CET)</option>
              <option value="Europe/Berlin">Europe/Berlin (CET)</option>
              <option value="Europe/Warsaw">Europe/Warsaw (CET)</option>
              <option value="Europe/Amsterdam">Europe/Amsterdam (CET)</option>
              <option value="Europe/Helsinki">Europe/Helsinki (EET)</option>
              <option value="Asia/Dubai">Asia/Dubai (GST)</option>
              <option value="Asia/Kolkata">Asia/Kolkata (IST)</option>
              <option value="Asia/Singapore">Asia/Singapore (SGT)</option>
              <option value="Asia/Tokyo">Asia/Tokyo (JST)</option>
              <option value="Australia/Sydney">Australia/Sydney (AEST)</option>
              <option value="America/New_York">America/New_York (ET)</option>
              <option value="America/Chicago">America/Chicago (CT)</option>
              <option value="America/Denver">America/Denver (MT)</option>
              <option value="America/Los_Angeles">America/Los_Angeles (PT)</option>
            </select>
          </div>
        </div>

        <div class="mt-3 p-2 border rounded d-flex align-items-center gap-2 flex-wrap">
          <span class="small fw-bold">What to scan</span>
          <span id="schedScopeSummary"></span>
          <button type="button" class="btn btn-sm btn-outline-primary ms-auto" onclick="chooseScheduleScope()">
            <i class="bi bi-funnel me-1"></i>Change
          </button>
        </div>

        <div class="form-text mt-2">
          <i class="bi bi-info-circle me-1"></i>A scoped scan covers only the workspaces you choose, so it is much
          faster — but anything reading the tenant as a whole (Governance, Grant Access) will keep using the most
          recent whole-tenant scan rather than this one.
        </div>
        <div class="mt-2" id="schedResult"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveSchedule()"><i class="bi bi-save me-1"></i>Create schedule</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="infoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="infoModalTitle"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body" id="infoModalBody"></div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
