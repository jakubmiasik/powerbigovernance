<%- include('partials/header') %>
<div class="row">
  <div class="col-lg-10 mx-auto">
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold">
        <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Power BI Governance
      </h1>
      <p class="lead text-muted">Investigate and govern your Power BI tenant — workspaces, reports, datasets, and more.</p>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <a href="/analysis" class="text-decoration-none text-reset">
          <div class="card h-100 border-primary shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-play-circle display-4 text-primary"></i>
              <h5 class="card-title mt-3">Run Analysis</h5>
              <p class="card-text text-muted">Scan your tenant and persist governance data for review.</p>
            </div>
          </div>
        </a>
      </div>
      <div class="col-md-6 col-xl-3">
        <a href="/workspaces" class="text-decoration-none text-reset">
          <div class="card h-100 border-info shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-collection display-4 text-info"></i>
              <h5 class="card-title mt-3">Workspaces</h5>
              <p class="card-text text-muted">Explore workspaces, items, dashboards, users, and Fabric assets.</p>
            </div>
          </div>
        </a>
      </div>
      <div class="col-md-6 col-xl-3">
        <a href="/governance" class="text-decoration-none text-reset">
          <div class="card h-100 border-success shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-shield-check display-4 text-success"></i>
              <h5 class="card-title mt-3">Governance</h5>
              <p class="card-text text-muted">Review tenant-wide health, distribution, users, and artifacts.</p>
            </div>
          </div>
        </a>
      </div>
      <div class="col-md-6 col-xl-3">
        <a href="/settings" class="text-decoration-none text-reset">
          <div class="card h-100 border-secondary shadow-sm">
            <div class="card-body text-center">
              <i class="bi bi-gear display-4 text-secondary"></i>
              <h5 class="card-title mt-3">Settings</h5>
              <p class="card-text text-muted">Manage service principals used for Power BI API access.</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
