<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-clock-history me-2"></i>Master Data Runs</h2>
    <p class="text-muted mb-0">Every run is kept: which model version produced which golden records, and whether it was published.</p>
  </div>
  <a href="/mdm" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<% if (error) { %><div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div><% } %>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-table me-2"></i>Run History (<%= runs.length %>)</span>
    <input type="text" class="form-control form-control-sm" style="max-width:260px;" placeholder="Filter runs..." oninput="filterTable(this, 'mdm-runs-table')">
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-hover mb-0" id="mdm-runs-table">
      <thead><tr>
        <th>Run</th><th>Model</th><th>Version</th><th>Mode</th><th>Status</th>
        <th class="text-end">Raw</th><th class="text-end">Golden</th><th class="text-end">Collapsed</th>
        <th class="text-end">Review</th><th class="text-end">Written</th><th>Started</th><th>By</th>
      </tr></thead>
      <tbody>
        <% if (!runs.length) { %>
          <tr data-filter="none"><td colspan="12" class="text-muted small py-3">No runs yet. Preview a model from the <a href="/mdm">Master Data</a> page.</td></tr>
        <% } %>
        <% runs.forEach(function(run) { %>
          <tr data-filter="<%= [run.model_name || '', run.status, run.mode, run.run_by || ''].join(' ').toLowerCase() %>">
            <td><a href="/mdm/runs/<%= run.id %>">#<%= run.id %></a></td>
            <td class="small"><%= run.model_name || ('Model #' + run.model_id) %></td>
            <td class="small">v<%= run.model_version %></td>
            <td><span class="badge bg-<%= run.mode === 'publish' ? 'success' : 'secondary' %>"><%= run.mode %></span></td>
            <td><span class="badge bg-<%= run.status === 'completed' ? 'success' : run.status === 'failed' ? 'danger' : 'secondary' %>"><%= run.status %></span></td>
            <td class="text-end small"><%= run.raw_records === null ? '-' : run.raw_records %></td>
            <td class="text-end small"><%= run.golden_records === null ? '-' : run.golden_records %></td>
            <td class="text-end small"><%= run.duplicates_removed === null ? '-' : run.duplicates_removed %></td>
            <td class="text-end small"><%= run.review_pairs === null ? '-' : run.review_pairs %></td>
            <td class="text-end small"><%= run.written_rows === null ? '-' : run.written_rows %></td>
            <td class="small"><%= run.started_at ? new Date(run.started_at).toLocaleString() : '-' %></td>
            <td class="small"><%= run.run_by || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
