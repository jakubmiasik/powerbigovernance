<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-database me-2"></i>Reconciliation Sources</h2>
    <p class="text-muted mb-0">The business systems available for reconciliation, and the datasets and fields each one exposes.</p>
  </div>
  <a href="/reconciliation" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<% if (error) { %><div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div><% } %>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-plus-circle me-2"></i>Register a Source</div>
  <div class="card-body py-3">
    <% if (!candidates.length) { %>
      <p class="text-muted small mb-0">
        No lakehouses or warehouses found in the selected scan. Select a scan in the top bar, or
        <a href="/analysis">run an analysis</a> so its SQL endpoints are discovered.
      </p>
    <% } else { %>
      <div class="row g-2 align-items-end">
        <div class="col-md-6">
          <label class="form-label small" for="candidateSelect">Fabric item</label>
          <select class="form-select form-select-sm" id="candidateSelect">
            <% candidates.forEach(function(c, i) { %>
              <option value="<%= i %>"><%= c.workspaceName %> → <%= c.itemName %> (<%= c.itemType %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small" for="systemLabel">Business system label</label>
          <input type="text" class="form-control form-control-sm" id="systemLabel" placeholder="e.g. ERP, Reporting Platform">
        </div>
        <div class="col-md-2">
          <button class="btn btn-sm btn-primary w-100" onclick="registerSource()"><i class="bi bi-plus me-1"></i>Register</button>
        </div>
      </div>
      <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Registering resolves the SQL analytics endpoint once, so reconciliation runs do not have to rediscover it.</div>
    <% } %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-list me-2"></i>Registered Sources (<%= sources.length %>)</div>
  <% if (!sources.length) { %>
    <div class="card-body text-muted small">No sources registered yet.</div>
  <% } else { %>
    <div class="card-body py-2">
      <% sources.forEach(function(source, si) { var datasets = datasetsBySource[source.id] || []; %>
        <div class="border rounded mb-2">
          <div class="d-flex align-items-center justify-content-between px-3 py-2">
            <button class="btn btn-sm text-start flex-grow-1 d-flex align-items-center p-0" type="button" data-bs-toggle="collapse" data-bs-target="#src-<%= si %>">
              <i class="bi bi-chevron-right me-2"></i>
              <span class="fw-bold"><%= source.name %></span>
              <% if (source.system_label) { %><span class="badge bg-primary ms-2"><%= source.system_label %></span><% } %>
              <span class="text-muted small ms-2"><%= source.workspace_name || '' %> · <%= datasets.length %> dataset(s)</span>
            </button>
            <button class="btn btn-sm btn-outline-danger p-0 px-1" onclick="removeSource(<%= source.id %>)" title="Remove"><i class="bi bi-trash"></i></button>
          </div>
          <div class="collapse" id="src-<%= si %>">
            <div class="px-3 pb-2">
              <div class="small text-muted mb-2"><code><%= source.connection_string || '-' %></code> · database <code><%= source.database_name || '-' %></code></div>
              <% if (!datasets.length) { %>
                <p class="small text-muted mb-2">No schema captured yet. Run an analysis so this item's SQL endpoint is read.</p>
              <% } else { %>
                <div class="table-responsive" style="max-height:320px;">
                  <table class="table table-sm mb-0">
                    <thead><tr><th>Dataset</th><th>Kind</th><th>Fields</th></tr></thead>
                    <tbody>
                      <% datasets.forEach(function(ds) { %>
                        <tr>
                          <td class="small"><strong><%= ds.name %></strong></td>
                          <td><span class="badge bg-secondary"><%= ds.kind %></span></td>
                          <td class="small text-muted"><%= ds.fields.map(function(f) { return f.name + ' (' + f.dataType + ')'; }).join(', ') %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
var candidates = <%- JSON.stringify(candidates) %>;

async function registerSource() {
  var idx = document.getElementById('candidateSelect').value;
  var candidate = candidates[Number(idx)];
  if (!candidate) return;
  var body = Object.assign({}, candidate, { systemLabel: document.getElementById('systemLabel').value.trim() });
  try {
    var resp = await fetch('/reconciliation/sources', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    var data = await resp.json();
    if (data.success) { showToast('Source registered', 'success'); setTimeout(function() { window.location.reload(); }, 600); }
    else showToast(data.message || 'Could not register the source', 'error');
  } catch (e) { showToast(e.message, 'error'); }
}

async function removeSource(id) {
  showConfirmAction({
    title: 'Remove source', message: 'Rules using this source will no longer run. Continue?',
    confirmText: 'Remove', confirmClass: 'btn-danger',
    onConfirm: async function() {
      var resp = await fetch('/reconciliation/sources/' + id, { method: 'DELETE' });
      var data = await resp.json();
      if (data.success) window.location.reload(); else showToast(data.message, 'error');
    }
  });
}
</script>
<%- include('../partials/footer') %>
