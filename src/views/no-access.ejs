<%- include('partials/header') %>
<%
  var deniedMessage;
  if (typeof message !== 'undefined' && message) {
    deniedMessage = message;
  } else if (typeof section !== 'undefined' && section) {
    deniedMessage = 'You have not been granted access to ' + section.label + '.';
  } else {
    deniedMessage = 'You have not been granted access to this part of the application.';
  }
  var notConfigured = !(typeof message !== 'undefined' && message) && typeof permissions !== 'undefined' && permissions && !permissions.isKnown;
%>
<div class="pd-card">
  <%- include('../../packages/podavo-ui/ejs/state', { ui: {
    kind: 'denied',
    title: 'No access to this section',
    message: deniedMessage,
    actions: (typeof switchTo !== 'undefined' && switchTo && switchTo.length
      ? switchTo.map(function(link, i) { return { href: link.href, label: link.label, icon: 'arrow-left-right', primary: i === 0 }; })
      : []).concat([{ href: '/', label: 'Back to Home', icon: 'house', primary: !(typeof switchTo !== 'undefined' && switchTo && switchTo.length) }])
  } }) %>
  <% if (notConfigured) { %>
    <p class="pd-help text-center px-4 pb-4 mb-0">
      Your account<%= permissions.email ? ' (' + permissions.email + ')' : '' %> is not configured in this
      application yet. An administrator can grant you tenants and sections under
      Configuration &rsaquo; Users &amp; Access.
    </p>
  <% } %>
</div>
<%- include('partials/footer') %>
