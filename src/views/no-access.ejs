<%- include('partials/header') %>
<div class="row">
  <div class="col-lg-7 mx-auto text-center py-5">
    <i class="bi bi-shield-lock display-1 text-warning"></i>
    <h2 class="mt-3">No access to this section</h2>
    <% if (typeof message !== 'undefined' && message) { %>
      <p class="text-muted"><%= message %></p>
    <% } else { %>
      <p class="text-muted">
        <% if (section) { %>
          You have not been granted access to <strong><%= section.label %></strong>.
        <% } else { %>
          You have not been granted access to this part of the application.
        <% } %>
      </p>
      <% if (permissions && !permissions.isKnown) { %>
        <p class="text-muted small">
          Your account<%= permissions.email ? ' (' + permissions.email + ')' : '' %> is not configured in this
          application yet. An administrator can grant you tenants and sections under
          Configuration &rsaquo; Users &amp; Access.
        </p>
      <% } %>
    <% } %>
    <a href="/" class="btn btn-primary mt-3"><i class="bi bi-house me-1"></i>Back to Home</a>
  </div>
</div>
<%- include('partials/footer') %>
