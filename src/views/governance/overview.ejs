<%- include('../partials/header') %>
<%
  var pd = '../../../packages/podavo-ui/ejs/';
  var governanceSummary = governance || {};
  var runId = run && run.id ? run.id : '';
  var runQuery = runId ? 'runId=' + runId : '';
  var activeWs = (governanceSummary.workspacesByState || {})['Active'] || 0;
  var inactiveWs = (governanceSummary.totalWorkspaces || 0) - activeWs;
  var data = typeof insights !== 'undefined' && insights ? insights : null;
  var defs = typeof findingDefs !== 'undefined' && findingDefs ? findingDefs : [];
  var sectionKeys = (typeof visibleSections !== 'undefined' && visibleSections ? visibleSections : []).map(function(s) { return s.key; });
  function canOpen(key) { return sectionKeys.indexOf(key) !== -1; }
  function formatBytesEjs(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
  }
  function triageHref(extra) {
    var params = [];
    if (runQuery) params.push(runQuery);
    if (extra) params.push(extra);
    return '/workspaces' + (params.length ? '?' + params.join('&') : '');
  }
  function pct(n, total) { return total ? (n / total * 100).toFixed(1) + '%' : '0%'; }
  var BAND_TONE = { critical: 'danger', high: 'orange', medium: 'warning', low: 'info', clean: 'success' };
  var SEV_TONE = { high: 'danger', medium: 'orange', low: 'neutral' };
  var FINDING_ICON = { ownerless: 'user-x', orphanedAdmin: 'bot', singleAdmin: 'user-round', staleContent: 'hourglass', orphanedContent: 'file-x',
    capacityRisk: 'zap', personalAccess: 'users', overShared: 'network', namingConvention: 'type', emptyWorkspace: 'inbox' };

  // Findings, worst first. A check that could not run is "Not evaluated", never a
  // zero: a zero would read as "clean" when nothing was looked at.
  var findingRows = [];
  var bandCounts = {};
  var attention = [];
  var highRiskCount = 0;
  if (data) {
    defs.forEach(function(def) {
      var evaluated = true, reason = '';
      if (def.key === 'namingConvention' && !data.namingConventionEnabled) { evaluated = false; reason = 'No naming convention is enforced.'; }
      if (def.key === 'orphanedContent' && !data.orphanDetectionAvailable) { evaluated = false; reason = 'This scan captured no workspace users to compare creators against.'; }
      findingRows.push({ def: def, count: (data.byFinding || {})[def.key] || 0, evaluated: evaluated, reason: reason });
    });
    (data.workspaces || []).forEach(function(ws) {
      var key = ws.band ? ws.band.key : (ws.score > 0 ? 'low' : 'clean');
      bandCounts[key] = (bandCounts[key] || 0) + 1;
      if (key === 'critical' || key === 'high') highRiskCount++;
      if (ws.findings && ws.findings.length && ws.state !== 'Deleted') attention.push(ws);
    });
  }
  var actionable = findingRows.filter(function(r) { return r.evaluated && r.count > 0; });
  var quiet = findingRows.filter(function(r) { return r.evaluated && r.count === 0; });
  var notEvaluated = findingRows.filter(function(r) { return !r.evaluated; });
  var inventory = [
    { label: 'Total items', count: governanceSummary.totalItems || 0, icon: 'boxes', type: 'all' },
    { label: 'Reports', count: governanceSummary.totalReports || 0, icon: 'file-text', type: 'Report' },
    { label: 'Semantic models', count: governanceSummary.totalDatasets || 0, icon: 'database', type: 'SemanticModel' },
    { label: 'Dashboards', count: governanceSummary.totalDashboards || 0, icon: 'layout-dashboard', type: 'Dashboard' },
    { label: 'Dataflows', count: governanceSummary.totalDataflows || 0, icon: 'workflow', type: 'Dataflow' },
    { label: 'Lakehouses', count: governanceSummary.totalLakehouses || 0, icon: 'hard-drive', type: 'Lakehouse' },
    { label: 'Notebooks', count: governanceSummary.totalNotebooks || 0, icon: 'book-open', type: 'Notebook' },
    { label: 'Pipelines', count: governanceSummary.totalPipelines || 0, icon: 'arrow-left-right', type: 'DataPipeline' },
    { label: 'Warehouses', count: governanceSummary.totalWarehouses || 0, icon: 'building-2', type: 'Warehouse' }
  ];
  var allCaps = governanceSummary.capacities || [];
  var activeCaps = allCaps.filter(function(c) { return c.state === 'Active'; });
  var suspendedCaps = allCaps.filter(function(c) { return c.state !== 'Active'; });
%>

<%- include(pd + 'page-header', { ui: {
  title: 'Governance Overview', icon: 'shield-check',
  subtitle: noData ? 'Tenant-wide governance findings and inventory.' : 'What needs attention across the tenant, worst first, followed by the inventory it was found in.',
  actionsHtml: noData ? '' :
    include(pd + 'button', { ui: { label: 'Since last scan', icon: 'git-compare-arrows', href: '/governance/changes' + (runQuery ? '?' + runQuery : ''), size: 'sm' } }) +
    (canOpen('analysis') ? include(pd + 'button', { ui: { label: 'Run analysis', icon: 'circle-play', href: '/analysis', size: 'sm' } }) : '') +
    (canOpen('workspaces') ? include(pd + 'button', { ui: { label: 'Open workspace triage', icon: 'layers', href: triageHref(), size: 'sm', variant: 'primary' } }) : '')
} }) %>

<% if (noData) { %>
  <div class="pd-card">
    <%- include(pd + 'state', { ui: {
      kind: 'empty', icon: 'clipboard-list',
      title: 'No analysis data available',
      message: 'Governance findings are computed from a completed analysis scan. Select a scan in the bar above, or run an analysis first.',
      actions: canOpen('analysis') ? [{ href: '/analysis', label: 'Run an analysis', icon: 'circle-play', primary: true }] : []
    } }) %>
  </div>
<% } else { %>

<div class="gov-summary">
  <%- include(pd + 'metric-card', { ui: { label: 'Workspaces scanned', value: (governanceSummary.totalWorkspaces || 0).toLocaleString(), hint: activeWs + ' active' + (inactiveWs > 0 ? ' · ' + inactiveWs + ' other' : ''), icon: 'layers' } }) %>
  <%- include(pd + 'metric-card', { ui: { label: 'Need attention', value: data ? data.flaggedCount : null, hint: data ? pct(data.flaggedCount, data.totalCount) : null, icon: 'triangle-alert', tone: 'warning', href: data && canOpen('workspaces') ? triageHref() : null } }) %>
  <%- include(pd + 'metric-card', { ui: { label: 'High or critical risk', value: data ? highRiskCount : null, hint: data ? 'score 80 or more' : null, icon: 'shield-alert', tone: 'danger', href: data && canOpen('workspaces') ? triageHref() : null } }) %>
  <div class="pd-card gov-dist">
    <p class="gov-dist-title"><span>Risk distribution</span><% if (data) { %><span class="pd-card-meta"><%= data.totalCount %> workspaces</span><% } %></p>
    <% if (!data) { %>
      <span class="pd-not-evaluated">Not evaluated</span>
    <% } else { %>
      <div class="pd-dist-bar" role="img" aria-label="Workspaces by risk level: <%= (data.riskBands || []).map(function(b) { return b.label + ' ' + (bandCounts[b.key] || 0); }).join(', ') %>">
        <% (data.riskBands || []).forEach(function(b) { var n = bandCounts[b.key] || 0; if (!n || !data.totalCount) return; %>
          <span class="pd-fill-<%= BAND_TONE[b.key] || 'neutral' %>" style="width:<%= (n / data.totalCount * 100).toFixed(2) %>%"></span>
        <% }) %>
      </div>
      <ul class="pd-dist-legend">
        <% (data.riskBands || []).forEach(function(b) { %><li title="<%= b.description %>"><span class="pd-dot pd-dot--<%= BAND_TONE[b.key] || 'neutral' %>" aria-hidden="true"></span><%= b.label %> <strong><%= bandCounts[b.key] || 0 %></strong></li><% }) %>
      </ul>
    <% } %>
  </div>
</div>

<div class="gov-overview-grid">
  <div class="pd-min-w-0 gov-stack">

    <section class="pd-card" aria-labelledby="findingsHeading">
      <div class="pd-card-header">
        <h2 class="pd-card-title" id="findingsHeading"><i data-lucide="list-checks" aria-hidden="true"></i>Prioritized findings</h2>
        <% if (data) { %><span class="pd-card-meta">Ordered by the weight each check adds to a workspace's risk score</span><% } %>
      </div>
      <% if (!data) { %>
        <%- include(pd + 'state', { ui: { kind: 'unavailable', compact: true, title: 'Not evaluated', message: 'The governance checks could not be evaluated for this scan. The inventory below is unaffected.' } }) %>
      <% } else if (!actionable.length) { %>
        <%- include(pd + 'state', { ui: { kind: 'empty', icon: 'circle-check-big', compact: true, title: 'No findings', message: 'None of the evaluated checks fired on any workspace in this scan.' } }) %>
      <% } else { %>
        <div>
          <% actionable.forEach(function(row) { var def = row.def; %>
            <div class="gov-finding-row">
              <span class="gov-finding-icon sev-<%= def.severity %>" aria-hidden="true"><i data-lucide="<%= FINDING_ICON[def.key] || 'circle-alert' %>"></i></span>
              <div class="pd-min-w-0">
                <div class="gov-finding-title"><%= def.label %></div>
                <div class="gov-finding-desc"><%= def.description %></div>
              </div>
              <div class="gov-row-meta">
                <span class="pd-badge pd-badge--<%= SEV_TONE[def.severity] %>"><%= def.severity %></span>
                <span class="gov-finding-count" aria-label="<%= row.count %> workspaces"><%= row.count %></span>
                <% if (canOpen('workspaces')) { %>
                  <a class="pd-btn pd-btn--sm" href="<%= triageHref('finding=' + encodeURIComponent(def.key)) %>" aria-label="Review <%= row.count %> workspaces: <%= def.label %>"><span>Review</span><i data-lucide="arrow-right" aria-hidden="true"></i></a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
        <% if (quiet.length || notEvaluated.length) { %>
          <div class="pd-card-footer">
            <% if (quiet.length) { %><div><strong>No workspaces affected:</strong> <%= quiet.map(function(r) { return r.def.label; }).join(', ') %>.</div><% } %>
            <% notEvaluated.forEach(function(r) { %>
              <div><strong><%= r.def.label %>:</strong> <span class="pd-not-evaluated">Not evaluated</span> — <%= r.reason %>
                <% if (r.def.key === 'namingConvention' && typeof permissions !== 'undefined' && permissions && permissions.isAdmin) { %><a href="/settings/governance">Define a convention</a>.<% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% } %>
    </section>

    <% if (data) { %>
      <section class="pd-card" aria-labelledby="attentionHeading">
        <div class="pd-card-header">
          <h2 class="pd-card-title" id="attentionHeading"><i data-lucide="arrow-down-wide-narrow" aria-hidden="true"></i>Workspaces to address first</h2>
          <% if (canOpen('workspaces') && attention.length) { %><a href="<%= triageHref() %>" class="small">View all <%= attention.length %> in triage</a><% } %>
        </div>
        <% if (!attention.length) { %>
          <%- include(pd + 'state', { ui: { kind: 'empty', icon: 'circle-check-big', compact: true, title: 'Nothing to address', message: 'No workspace in this scan has a finding.' } }) %>
        <% } else { %>
          <div class="pd-grid-scroll" style="max-height:none;">
            <table class="pd-table" data-no-sort>
              <thead><tr><th scope="col">Workspace</th><th scope="col" class="is-num">Risk score</th><th scope="col">Risk level</th><th scope="col">Top findings</th><th scope="col" class="is-num hide-below-1440">Users</th><th scope="col" class="hide-below-1440">Last activity</th></tr></thead>
              <tbody>
                <% attention.slice(0, 8).forEach(function(ws) {
                     var band = ws.band || { key: 'low', label: 'Low' };
                     var tone = BAND_TONE[band.key] || 'neutral';
                     var sum = ws.findings.map(function(f) { return f.label + ' +' + f.weight; }).join(', ');
                %>
                  <tr>
                    <td class="pd-cell-truncate"><% if (canOpen('workspaces')) { %><a class="gov-ws-name" href="/workspaces/<%= ws.id %><%= runQuery ? '?' + runQuery : '' %>"><i data-lucide="layers" aria-hidden="true"></i><span><%= ws.name %></span></a><% } else { %><strong><%= ws.name %></strong><% } %>
                      <div class="pd-cell-sub"><%= ws.licenseType %><% if (ws.capacitySku) { %> · <%= ws.capacitySku %><% } %></div></td>
                    <td class="is-num"><span class="gov-score gov-score--<%= tone %>" title="<%= band.label %> risk — <%= ws.score %> = <%= sum %>"><%= ws.score %></span></td>
                    <td><span class="pd-badge pd-badge--<%= tone %>"><%= band.label %></span></td>
                    <td><% ws.findings.slice(0, 2).forEach(function(f) { %><span class="pd-badge pd-badge--<%= SEV_TONE[f.severity] %> me-1" title="<%= f.detail %>"><%= f.label %></span><% }) %><% if (ws.findings.length > 2) { %><span class="pd-cell-sub">+<%= ws.findings.length - 2 %></span><% } %></td>
                    <td class="is-num hide-below-1440"><%= ws.userCount %></td>
                    <td class="hide-below-1440"><%= ws.lastActivityDays === null ? '—' : ws.lastActivityDays + 'd ago' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <div>
      <h2 class="gov-section-title" id="inventoryHeading">Inventory · <%- include('../partials/scan-name', { run: run }).trim() %></h2>
      <div class="gov-inventory" aria-labelledby="inventoryHeading">
        <% inventory.forEach(function(entry) { %>
          <%- include(pd + 'metric-card', { ui: { label: entry.label, value: Number(entry.count).toLocaleString(), icon: entry.icon, tone: 'neutral', href: '/governance/artifacts?type=' + entry.type + (runQuery ? '&' + runQuery : '') } }) %>
        <% }) %>
        <%- include(pd + 'metric-card', { ui: { label: 'Unique users', value: Number(governanceSummary.totalUsers || 0).toLocaleString(), hint: (typeof creatorCount !== 'undefined' ? creatorCount : 0) + ' creators', icon: 'users', tone: 'neutral', href: '/governance/users' + (runQuery ? '?' + runQuery : '') } }) %>
      </div>
    </div>

    <div class="gov-panels">
      <section class="pd-card" aria-labelledby="statesHeading">
        <div class="pd-card-header"><h3 class="pd-card-title" id="statesHeading"><i data-lucide="chart-pie" aria-hidden="true"></i>Workspace states</h3></div>
        <div class="pd-grid-scroll" style="max-height:280px;">
          <table class="pd-table" id="governance-states-table">
            <thead><tr><th scope="col">State</th><th scope="col" class="is-num">Count</th><th scope="col" class="is-num">%</th></tr></thead>
            <tbody>
              <% Object.entries(governanceSummary.workspacesByState || {}).forEach(function(entry) { var state = entry[0]; var count = entry[1]; %>
                <tr><td><span class="pd-badge pd-badge--<%= state === 'Active' ? 'success' : state === 'Deleted' ? 'danger' : 'warning' %>"><%= state %></span></td>
                  <td class="is-num"><%= count %></td><td class="is-num"><%= governanceSummary.totalWorkspaces ? Math.round((count / governanceSummary.totalWorkspaces) * 100) : 0 %>%</td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
      <section class="pd-card" aria-labelledby="licenseHeading">
        <div class="pd-card-header"><h3 class="pd-card-title" id="licenseHeading"><i data-lucide="network" aria-hidden="true"></i>License types</h3></div>
        <div class="pd-grid-scroll" style="max-height:280px;">
          <table class="pd-table" id="governance-types-table">
            <thead><tr><th scope="col">License</th><th scope="col">SKU</th><th scope="col" class="is-num">Count</th><th scope="col" class="is-num">%</th></tr></thead>
            <tbody>
              <% Object.entries(governanceSummary.workspacesBySku || {}).sort(function(a,b){ return b[1]-a[1]; }).forEach(function(entry) { var sku = entry[0]; var count = entry[1]; var s = sku.toUpperCase(); var licType = s.startsWith('F') && s !== 'FREE' && s !== 'SHARED (PRO)' ? 'Fabric' : s === 'PPU' ? 'PPU' : s.startsWith('P') || s.startsWith('EM') || s.startsWith('A') ? 'Premium' : 'Pro'; var licTone = licType === 'Fabric' ? 'success' : licType === 'Premium' ? 'warning' : licType === 'PPU' ? 'info' : 'neutral'; %>
                <tr><td><span class="pd-badge pd-badge--<%= licTone %>"><%= licType %></span></td><td><code><%= sku %></code></td>
                  <td class="is-num"><%= count %></td><td class="is-num"><%= governanceSummary.totalWorkspaces ? Math.round((count / governanceSummary.totalWorkspaces) * 100) : 0 %>%</td></tr>
              <% }) %>
              <% if (!governanceSummary.workspacesBySku || Object.keys(governanceSummary.workspacesBySku).length === 0) { Object.entries(governanceSummary.workspacesByLicense || governanceSummary.workspacesByType || {}).forEach(function(entry) { var license = entry[0]; var count = entry[1]; var licTone = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'neutral'; %>
                <tr><td><span class="pd-badge pd-badge--<%= licTone %>"><%= license %></span></td><td>—</td>
                  <td class="is-num"><%= count %></td><td class="is-num"><%= governanceSummary.totalWorkspaces ? Math.round((count / governanceSummary.totalWorkspaces) * 100) : 0 %>%</td></tr>
              <% }) } %>
            </tbody>
          </table>
        </div>
      </section>
      <section class="pd-card" aria-labelledby="capacityHeading">
        <div class="pd-card-header"><h3 class="pd-card-title" id="capacityHeading"><i data-lucide="zap" aria-hidden="true"></i>Capacities</h3><% if (canOpen('capacities')) { %><a href="/capacities" class="small">Manage</a><% } %></div>
        <div class="pd-card-body">
          <dl class="pd-meta">
            <dt>Total</dt><dd><strong><%= allCaps.length %></strong></dd>
            <dt>Active</dt><dd><span class="pd-badge pd-badge--success"><%= activeCaps.length %></span></dd>
            <dt>Suspended</dt><dd><span class="pd-badge <%= suspendedCaps.length ? 'pd-badge--warning' : '' %>"><%= suspendedCaps.length %></span></dd>
            <dt>On dedicated</dt><dd><%= governanceSummary.workspacesOnCapacity || 0 %> workspaces</dd>
            <dt>On shared</dt><dd><%= governanceSummary.workspacesOnSharedCapacity || 0 %> workspaces</dd>
          </dl>
        </div>
      </section>
    </div>

    <section class="pd-card" id="tenant-storage-card" aria-labelledby="storageHeading">
      <div class="pd-card-header"><h3 class="pd-card-title" id="storageHeading"><i data-lucide="hard-drive" aria-hidden="true"></i>OneLake storage</h3></div>
      <% if (governanceSummary.totalStorageSize) { %>
        <div class="pd-card-body">
          <dl class="pd-meta">
            <dt>Total tenant storage</dt><dd><strong><%= formatBytesEjs(governanceSummary.totalStorageSize) %></strong></dd>
            <dt>Files</dt><dd><%= (governanceSummary.totalStorageFiles || 0).toLocaleString() %></dd>
            <dt>Workspaces with data</dt><dd><%= governanceSummary.storageScannedCount || 0 %> of <%= governanceSummary.totalWorkspaces || 0 %> scanned</dd>
          </dl>
        </div>
        <% var storageWs = workspaces.filter(function(w) { return w.storageSize > 0; }).sort(function(a, b) { return (b.storageSize || 0) - (a.storageSize || 0); }); %>
        <% if (storageWs.length) { %>
          <div class="pd-grid-scroll" style="max-height:300px;">
            <table class="pd-table">
              <thead><tr><th scope="col">Workspace</th><th scope="col" class="is-num">Files</th><th scope="col" class="is-num">Size</th><th scope="col">% of total</th></tr></thead>
              <tbody>
                <% storageWs.forEach(function(ws) { var share = governanceSummary.totalStorageSize > 0 ? ((ws.storageSize / governanceSummary.totalStorageSize) * 100).toFixed(1) : '0'; %>
                  <tr><td><a href="/workspaces/<%= ws.id %>"><%= ws.name %></a></td><td class="is-num"><%= (ws.storageFiles || 0).toLocaleString() %></td>
                    <td class="is-num" data-sort-value="<%= ws.storageSize %>"><strong><%= formatBytesEjs(ws.storageSize) %></strong></td>
                    <td data-sort-value="<%= share %>"><div class="d-flex align-items-center gap-2"><div class="pd-dist-bar flex-grow-1" aria-hidden="true" style="min-width:80px;"><span class="pd-fill-info" style="width:<%= share %>%"></span></div><span class="pd-num small" style="min-width:4ch;"><%= share %>%</span></div></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else { %>
        <%- include(pd + 'state', { ui: { kind: 'unavailable', icon: 'hard-drive', compact: true, title: 'Not calculated', message: 'Storage is calculated during the next analysis run, or with Calculate Storage on an individual workspace page.' } }) %>
      <% } %>
    </section>

    <section class="pd-card" id="tenant-settings-summary-card" aria-labelledby="tenantSettingsHeading">
      <div class="pd-card-header">
        <h3 class="pd-card-title" id="tenantSettingsHeading"><i data-lucide="sliders-horizontal" aria-hidden="true"></i>Tenant settings</h3>
        <span class="pd-card-meta">Snapshot from this run · <a href="/governance/tenant-settings">View all settings</a></span>
      </div>
      <div class="pd-card-body" id="tenantSettingsPanel" aria-live="polite">
        <div class="d-flex align-items-center gap-2 pd-help" id="tenantSettingsLoading"><span class="pd-spinner" aria-hidden="true"></span> Reading tenant settings captured with this scan…</div>
      </div>
    </section>

    <section class="pd-card pd-grid" id="workspace-governance-card" aria-labelledby="allWorkspacesHeading">
      <div class="pd-card-header"><h3 class="pd-card-title" id="allWorkspacesHeading"><i data-lucide="table" aria-hidden="true"></i>All workspaces</h3><span class="pd-card-meta"><%= workspaces.length %></span></div>
      <div class="pd-grid-scroll">
        <table class="pd-table" id="governance-workspaces-table"
               data-grid data-grid-label="workspaces" data-grid-search-placeholder="Search workspaces…"
               data-grid-empty="This scan contains no workspaces." data-grid-export-name="workspace-inventory">
          <thead>
            <tr>
              <th scope="col" data-col="name" data-col-required>Workspace</th>
              <th scope="col" data-col="license" data-filter-col>License</th>
              <th scope="col" data-col="state" data-filter-col>State</th>
              <th scope="col" class="is-num" data-col="size">Size</th>
              <th scope="col" class="is-num" data-col="items">Items</th>
              <th scope="col" class="is-num" data-col="reports">Reports</th>
              <th scope="col" class="is-num" data-col="models">Models</th>
              <th scope="col" class="is-num" data-col="dashboards" data-col-default="wide">Dashboards</th>
              <th scope="col" class="is-num" data-col="dataflows" data-col-default="wide">Dataflows</th>
              <th scope="col" class="is-num" data-col="lakehouses" data-col-default="wide">Lakehouses</th>
              <th scope="col" class="is-num" data-col="notebooks" data-col-default="wide">Notebooks</th>
              <th scope="col" class="is-num" data-col="pipelines" data-col-default="wide">Pipelines</th>
              <th scope="col" class="is-num" data-col="warehouses" data-col-default="wide">Warehouses</th>
              <th scope="col" class="is-num" data-col="users">Users</th>
              <th scope="col" data-col-required data-no-export><span class="pd-visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% workspaces.forEach(function(ws) { var license = ws.licenseType || 'Pro'; var licTone = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'neutral'; %>
              <tr data-filter="<%= [ws.name || '', license, ws.state || ''].join(' ').toLowerCase() %>">
                <td class="pd-cell-truncate"><a class="gov-ws-name" href="/workspaces/<%= ws.id %>"><i data-lucide="layers" aria-hidden="true"></i><span><%= ws.name || 'Unnamed' %></span></a></td>
                <td data-filter-value="<%= license %>"><span class="pd-badge pd-badge--<%= licTone %>"><%= license %></span></td>
                <td data-filter-value="<%= ws.state || 'Unknown' %>"><span class="pd-badge pd-badge--<%= ws.state === 'Active' ? 'success' : 'warning' %>"><%= ws.state || '—' %></span></td>
                <td class="is-num" data-sort-value="<%= ws.storageSize || 0 %>"><%= ws.storageSize ? formatBytesEjs(ws.storageSize) : '—' %></td>
                <td class="is-num"><%= ws.totalItems || 0 %></td>
                <td class="is-num"><%= ws.reportCount || 0 %></td>
                <td class="is-num"><%= ws.datasetCount || 0 %></td>
                <td class="is-num"><%= ws.dashboardCount || 0 %></td>
                <td class="is-num"><%= ws.dataflowCount || 0 %></td>
                <td class="is-num"><%= ws.lakehouseCount || 0 %></td>
                <td class="is-num"><%= ws.notebookCount || 0 %></td>
                <td class="is-num"><%= ws.pipelineCount || 0 %></td>
                <td class="is-num"><%= ws.warehouseCount || 0 %></td>
                <td class="is-num"><%= ws.userCount || 0 %></td>
                <td><a href="/workspaces/<%= ws.id %>" class="pd-icon-btn pd-icon-btn--sm" aria-label="Open <%= ws.name || 'workspace' %>" title="Open workspace"><i data-lucide="external-link" aria-hidden="true"></i></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <aside class="gov-aside" aria-label="Scan context">
    <section class="pd-card" aria-labelledby="scanContextHeading">
      <div class="pd-card-header"><h2 class="pd-card-title" id="scanContextHeading"><i data-lucide="info" aria-hidden="true"></i>Scan context</h2></div>
      <div class="pd-card-body">
        <dl class="pd-meta">
          <dt>Scan</dt><dd><%- include('../partials/scan-name', { run: run }).trim() %></dd>
          <dt>Service principal</dt><dd><%= run.sp_name || '—' %></dd>
          <dt>Tenant ID</dt><dd><%= run.tenant_id || '—' %></dd>
          <dt>Started</dt><dd><% if (run.started_at) { %><time datetime="<%= new Date(run.started_at).toISOString() %>" data-local-time><%= new Date(run.started_at).toISOString().replace('T', ' ').slice(0, 16) %> UTC</time><% } else { %><span class="pd-not-evaluated">Not available</span><% } %></dd>
          <dt>Completed</dt><dd><% if (run.completed_at) { %><time datetime="<%= new Date(run.completed_at).toISOString() %>" data-local-time><%= new Date(run.completed_at).toISOString().replace('T', ' ').slice(0, 16) %> UTC</time><% } else { %><span class="pd-not-evaluated">Not available</span><% } %></dd>
          <% if (data) { %>
            <dt>Stale after</dt><dd><%= data.thresholds.staleDays %> days</dd>
            <dt>Broadly shared at</dt><dd><%= data.thresholds.overSharedUsers %> principals</dd>
            <dt>Naming checks</dt><dd><%= data.namingConventionEnabled ? 'Enforced' : 'Not configured' %></dd>
          <% } %>
        </dl>
        <p class="pd-help mt-3 mb-0">Findings describe the tenant as it was when this scan ran. Staleness is measured against the scan date, not today.
          <% if (canOpen('analysis')) { %><a href="/analysis">Run a new analysis</a> to refresh.<% } %></p>
      </div>
    </section>
    <section class="pd-card" aria-labelledby="quickLinksHeading">
      <div class="pd-card-header"><h2 class="pd-card-title" id="quickLinksHeading"><i data-lucide="signpost" aria-hidden="true"></i>Go to</h2></div>
      <div class="pd-menu" style="min-width:0">
        <% if (canOpen('workspaces')) { %><a class="pd-menu-item" href="<%= triageHref() %>"><i data-lucide="layers" aria-hidden="true"></i>Workspace triage</a><% } %>
        <a class="pd-menu-item" href="/governance/users<%= runQuery ? '?' + runQuery : '' %>"><i data-lucide="contact" aria-hidden="true"></i>User 360</a>
        <a class="pd-menu-item" href="/governance/artifacts?type=all<%= runQuery ? '&' + runQuery : '' %>"><i data-lucide="boxes" aria-hidden="true"></i>All artifacts</a>
        <% if (canOpen('tenant-settings')) { %><a class="pd-menu-item" href="/tenant-settings"><i data-lucide="sliders-horizontal" aria-hidden="true"></i>Tenant settings (live)</a><% } %>
        <% if (canOpen('security-groups')) { %><a class="pd-menu-item" href="/quality/security-groups"><i data-lucide="users" aria-hidden="true"></i>Security groups</a><% } %>
      </div>
    </section>
  </aside>
</div>

  <script>
  (function loadTenantSettings() {
    var panel = document.getElementById('tenantSettingsPanel');
    if (!panel) return;
    function esc(value) {
      return String(value === null || value === undefined ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function fail(message) {
      panel.innerHTML = '<div class="alert alert-warning small mb-0" role="alert">' +
        '<strong>Tenant settings unavailable.</strong> <span class="js-reason"></span><hr class="my-2">' +
        '<div class="small mb-0">The service principal needs <code>Tenant.Read.All</code> and must be in the security group ' +
        'allowed under <strong>Admin Portal → Tenant settings → Service principals can use Fabric APIs</strong>.</div></div>';
      panel.querySelector('.js-reason').textContent = message || 'Unknown error';
    }

    fetch('/governance/tenant-settings/data')
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (!data.success) return fail(data.message);

        var tiles = [
          { label: 'Total settings', value: data.total },
          { label: 'Enabled', value: data.enabled },
          { label: 'Disabled', value: data.disabled },
          { label: 'Scoped to groups', value: data.securityGroupScoped },
          { label: 'Delegated', value: data.delegated }
        ];
        var tileHtml = tiles.map(function(t) {
          return '<div class="pd-metric"><span class="pd-metric-body"><span class="pd-metric-label">' + esc(t.label) + '</span>' +
            '<span class="pd-metric-value" style="font-size:1.125rem;">' + esc(t.value) + '</span></span></div>';
        }).join('');

        var rows = (data.groups || []).map(function(g) {
          var pct = g.total ? Math.round((g.enabled / g.total) * 100) : 0;
          return '<tr><td>' + esc(g.name) + '</td>' +
            '<td class="text-end"><strong>' + esc(g.total) + '</strong></td><td class="text-end">' + esc(g.enabled) + '</td>' +
            '<td class="text-end">' + esc(g.total - g.enabled) + '</td>' +
            '<td><div class="d-flex align-items-center gap-2"><div class="pd-dist-bar flex-grow-1" style="min-width:80px;" aria-hidden="true"><span class="pd-fill-success" style="width:' + pct + '%"></span></div><span class="small" style="min-width:4ch;">' + pct + '%</span></div></td></tr>';
        }).join('');

        panel.innerHTML =
          '<div class="gov-inventory">' + tileHtml + '</div>' +
          (rows ? '<div class="pd-grid-scroll" style="max-height:300px;">' +
            '<table class="pd-table"><thead><tr><th scope="col">Group</th><th scope="col" class="text-end">Total</th><th scope="col" class="text-end">Enabled</th><th scope="col" class="text-end">Disabled</th><th scope="col" style="width:160px;">Enabled %</th></tr></thead>' +
            '<tbody>' + rows + '</tbody></table></div>' : '');
      })
      .catch(function(err) { fail(err.message); });
  })();
  </script>
<% } %>

<%- include('../partials/footer') %>
