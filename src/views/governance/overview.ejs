<%- include('../partials/header') %>
<%
  var governanceSummary = governance || {};
  var runId = run && run.id ? run.id : '';
  var activeWs = (governanceSummary.workspacesByState || {})['Active'] || 0;
  var inactiveWs = (governanceSummary.totalWorkspaces || 0) - activeWs;
  var cards = [
    { label: 'Workspaces', count: governanceSummary.totalWorkspaces || 0, color: 'primary', icon: 'collection', href: '#workspace-governance-card', sub: activeWs + ' Active' + (inactiveWs > 0 ? ' / ' + inactiveWs + ' Inactive' : '') },
    { label: 'Total Items', count: governanceSummary.totalItems || 0, color: 'dark', icon: 'boxes', href: '/governance/artifacts?type=all' + (runId ? '&runId=' + runId : '') },
    { label: 'Reports', count: governanceSummary.totalReports || 0, color: 'primary', icon: 'file-earmark-bar-graph', href: '/governance/artifacts?type=Report' + (runId ? '&runId=' + runId : '') },
    { label: 'Semantic Models', count: governanceSummary.totalDatasets || 0, color: 'success', icon: 'database', href: '/governance/artifacts?type=SemanticModel' + (runId ? '&runId=' + runId : '') },
    { label: 'Dashboards', count: governanceSummary.totalDashboards || 0, color: 'info', icon: 'grid-1x2', href: '/governance/artifacts?type=Dashboard' + (runId ? '&runId=' + runId : '') },
    { label: 'Dataflows', count: governanceSummary.totalDataflows || 0, color: 'warning', icon: 'diagram-3', href: '/governance/artifacts?type=Dataflow' + (runId ? '&runId=' + runId : '') },
    { label: 'Lakehouses', count: governanceSummary.totalLakehouses || 0, color: 'secondary', icon: 'boxes', href: '/governance/artifacts?type=Lakehouse' + (runId ? '&runId=' + runId : '') },
    { label: 'Notebooks', count: governanceSummary.totalNotebooks || 0, color: 'secondary', icon: 'journal-code', href: '/governance/artifacts?type=Notebook' + (runId ? '&runId=' + runId : '') },
    { label: 'Pipelines', count: governanceSummary.totalPipelines || 0, color: 'secondary', icon: 'arrow-left-right', href: '/governance/artifacts?type=DataPipeline' + (runId ? '&runId=' + runId : '') },
    { label: 'Warehouses', count: governanceSummary.totalWarehouses || 0, color: 'secondary', icon: 'building', href: '/governance/artifacts?type=Warehouse' + (runId ? '&runId=' + runId : '') },
    { label: 'Unique Users', count: governanceSummary.totalUsers || 0, color: 'secondary', icon: 'people', href: '/governance/users' + (runId ? '?runId=' + runId : ''), sub: '(' + (typeof creatorCount !== 'undefined' ? creatorCount : 0) + ' Creators / ' + (typeof explorerCount !== 'undefined' ? explorerCount : 0) + ' Explorers)' }
  ];
%>
<div class="mb-3">
  <h2><i class="bi bi-shield-check me-2"></i>Governance Overview</h2>
  <p class="text-muted mb-0">Tenant-wide Power BI governance metrics.</p>
</div>

<% if (noData) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No analysis data available. <a href="/analysis">Run an analysis</a> first to see governance metrics.
  </div>
<% } else { %>
  <div class="row g-3 mb-4">
    <% cards.forEach(function(card) { %>
      <div class="col-sm-6 col-md-4 col-xl-2">
        <a href="<%= card.href %>" class="text-decoration-none text-reset">
          <div class="card text-center h-100 stat-card">
            <div class="card-body py-3">
              <div class="text-<%= card.color %> mb-2"><i class="bi bi-<%= card.icon %>"></i></div>
              <div class="fs-3 fw-bold text-<%= card.color %>"><%= card.count %></div>
              <div class="small"><%= card.label %></div>
              <% if (card.sub) { %><div class="text-muted" style="font-size: 0.7rem;"><%= card.sub %></div><% } %>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span><i class="bi bi-pie-chart me-2"></i>Workspace States</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 220px;" placeholder="Filter states..." oninput="filterTable(this, 'governance-states-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-sm mb-0" id="governance-states-table">
            <thead><tr><th>State</th><th>Count</th><th>%</th></tr></thead>
            <tbody>
              <% Object.entries(governanceSummary.workspacesByState || {}).forEach(function(entry) { var state = entry[0]; var count = entry[1]; %>
                <tr data-filter="<%= [state, count].join(' ').toLowerCase() %>">
                  <td><span class="badge bg-<%= state === 'Active' ? 'success' : state === 'Deleted' ? 'danger' : 'warning' %>"><%= state %></span></td>
                  <td><%= count %></td>
                  <td><%= governanceSummary.totalWorkspaces ? Math.round((count / governanceSummary.totalWorkspaces) * 100) : 0 %>%</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span><i class="bi bi-diagram-2 me-2"></i>License Types</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 220px;" placeholder="Filter..." oninput="filterTable(this, 'governance-types-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-sm mb-0" id="governance-types-table">
            <thead><tr><th>License</th><th>SKU</th><th>Count</th><th>%</th></tr></thead>
            <tbody>
              <% Object.entries(governanceSummary.workspacesBySku || {}).sort(function(a,b){ return b[1]-a[1]; }).forEach(function(entry) { var sku = entry[0]; var count = entry[1]; var s = sku.toUpperCase(); var licType = s.startsWith('F') && s !== 'FREE' && s !== 'SHARED (PRO)' ? 'Fabric' : s === 'PPU' ? 'PPU' : s.startsWith('P') || s.startsWith('EM') || s.startsWith('A') ? 'Premium' : 'Pro'; var licColor = licType === 'Fabric' ? 'success' : licType === 'Premium' ? 'warning' : licType === 'PPU' ? 'info' : 'secondary'; %>
                <tr data-filter="<%= [sku, licType, count].join(' ').toLowerCase() %>">
                  <td><span class="badge bg-<%= licColor %>"><%= licType %></span></td>
                  <td><code><%= sku %></code></td>
                  <td><%= count %></td>
                  <td><%= governanceSummary.totalWorkspaces ? Math.round((count / governanceSummary.totalWorkspaces) * 100) : 0 %>%</td>
                </tr>
              <% }) %>
              <% if (!governanceSummary.workspacesBySku || Object.keys(governanceSummary.workspacesBySku).length === 0) { Object.entries(governanceSummary.workspacesByLicense || governanceSummary.workspacesByType || {}).forEach(function(entry) { var license = entry[0]; var count = entry[1]; var licColor = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'secondary'; %>
                <tr data-filter="<%= [license, count].join(' ').toLowerCase() %>">
                  <td><span class="badge bg-<%= licColor %>"><%= license %></span></td>
                  <td>-</td>
                  <td><%= count %></td>
                  <td><%= governanceSummary.totalWorkspaces ? Math.round((count / governanceSummary.totalWorkspaces) * 100) : 0 %>%</td>
                </tr>
              <% }) } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span><i class="bi bi-lightning me-2"></i>Capacities</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 180px;" placeholder="Filter..." oninput="filterCapacities(this)">
        </div>
        <%
          var allCaps = governanceSummary.capacities || [];
          var capStates = {};
          allCaps.forEach(function(c) { var s = c.state || 'Unknown'; if (!capStates[s]) capStates[s] = []; capStates[s].push(c); });
          var capStateKeys = Object.keys(capStates).sort(function(a,b){ return a === 'Active' ? -1 : b === 'Active' ? 1 : a.localeCompare(b); });
        %>
        <% if (allCaps.length) { %>
          <ul class="nav nav-tabs px-3 pt-2" role="tablist" style="border-bottom: none;">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#cap-tab-all" type="button" style="font-size:0.8rem;">All (<%= allCaps.length %>)</button>
            </li>
            <% capStateKeys.forEach(function(state, si) { var stateColor = state === 'Active' ? 'success' : 'warning'; %>
              <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#cap-tab-<%= si %>" type="button" style="font-size:0.8rem;">
                  <span class="badge bg-<%= stateColor %> me-1"><%= capStates[state].length %></span><%= state %>
                </button>
              </li>
            <% }) %>
          </ul>
          <div class="tab-content">
            <%
              var capTabSets = [{ id: 'all', caps: allCaps }];
              capStateKeys.forEach(function(state, si) { capTabSets.push({ id: String(si), caps: capStates[state] }); });
            %>
            <% capTabSets.forEach(function(tabSet, ti) { %>
              <div class="tab-pane fade <%= ti === 0 ? 'show active' : '' %>" id="cap-tab-<%= tabSet.id %>" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 cap-filter-table">
                    <thead><tr><th>Name</th><th>SKU</th><th>License</th><th>State</th><th>Region</th></tr></thead>
                    <tbody>
                      <% tabSet.caps.forEach(function(cap) { var sku = (cap.sku || '').toUpperCase(); var licType = sku.startsWith('F') && sku !== 'FREE' ? 'Fabric' : sku === 'PPU' ? 'PPU' : sku.startsWith('P') || sku.startsWith('EM') || sku.startsWith('A') ? 'Premium' : 'Shared'; var licColor = licType === 'Fabric' ? 'success' : licType === 'Premium' ? 'warning' : licType === 'PPU' ? 'info' : 'secondary'; %>
                        <tr data-filter="<%= [cap.displayName || '', cap.sku || '', licType, cap.state || '', cap.region || ''].join(' ').toLowerCase() %>">
                          <td class="small"><%= cap.displayName || 'Unnamed' %></td>
                          <td><code><%= cap.sku || '-' %></code></td>
                          <td><span class="badge bg-<%= licColor %>"><%= licType %></span></td>
                          <td><span class="badge bg-<%= cap.state === 'Active' ? 'success' : 'warning' %>"><%= cap.state || '-' %></span></td>
                          <td class="small"><%= cap.region || '-' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="card-body text-muted small">No dedicated capacities found.</div>
        <% } %>
        <div class="card-footer small" style="background: var(--color-surface-offset);">
          Dedicated: <strong><%= governanceSummary.workspacesOnCapacity || 0 %></strong> workspaces | Shared: <strong><%= governanceSummary.workspacesOnSharedCapacity || 0 %></strong> workspaces
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4" id="workspace-governance-card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-table me-2"></i>All Workspaces (<%= workspaces.length %>)</span>
      <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter workspaces..." oninput="filterTable(this, 'governance-workspaces-table')">
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0" id="governance-workspaces-table">
        <thead>
          <tr>
            <th>Workspace</th>
            <th>License</th>
            <th>State</th>
            <th>Items</th>
            <th>Reports</th>
            <th>Models</th>
            <th>Dashboards</th>
            <th>Dataflows</th>
            <th>Lakehouses</th>
            <th>Notebooks</th>
            <th>Pipelines</th>
            <th>Warehouses</th>
            <th>Users</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% workspaces.forEach(function(ws) { var license = ws.licenseType || 'Pro'; var licColor = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'secondary'; %>
            <tr data-filter="<%= [ws.name || '', license, ws.state || ''].join(' ').toLowerCase() %>">
              <td class="small"><%= ws.name || 'Unnamed' %></td>
              <td><span class="badge bg-<%= licColor %>"><%= license %></span></td>
              <td><span class="badge bg-<%= ws.state === 'Active' ? 'success' : 'warning' %>"><%= ws.state || '-' %></span></td>
              <td><%= ws.totalItems || 0 %></td>
              <td><%= ws.reportCount || 0 %></td>
              <td><%= ws.datasetCount || 0 %></td>
              <td><%= ws.dashboardCount || 0 %></td>
              <td><%= ws.dataflowCount || 0 %></td>
              <td><%= ws.lakehouseCount || 0 %></td>
              <td><%= ws.notebookCount || 0 %></td>
              <td><%= ws.pipelineCount || 0 %></td>
              <td><%= ws.warehouseCount || 0 %></td>
              <td><%= ws.userCount || 0 %></td>
              <td><a href="/workspaces/<%= ws.id %>" class="btn btn-sm btn-outline-primary">Details</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="alert alert-info small">
    <i class="bi bi-info-circle me-2"></i>
    Data from analysis run #<%= run.id %> on <%= run.started_at ? new Date(run.started_at).toLocaleString() : '-' %>. <a href="/analysis">Run a new analysis</a> to refresh.
  </div>
<% } %>
<%- include('../partials/footer') %>
