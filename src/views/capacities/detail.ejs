<%- include('../partials/header') %>
<%
  var cap = capacity || {};
  var arm = armDetail || null;
  var armError = arm && arm.error ? arm.error : null;
  var armProps = arm && arm.properties ? arm.properties : null;
  var capName = cap.displayName || 'Unknown';
  var capState = cap.state || 'Unknown';
  var stateColor = capState === 'Active' ? 'success' : capState === 'Paused' || capState === 'Suspended' ? 'warning' : 'secondary';
  var sku = (cap.sku || '').toUpperCase();
  var licType = sku.startsWith('F') && sku !== 'FREE' ? 'Fabric' : sku === 'PPU' ? 'PPU' : sku.startsWith('P') || sku.startsWith('EM') || sku.startsWith('A') ? 'Premium' : 'Shared';

  var armRg = '';
  var armSub = subscriptionId || '';
  if (arm && arm.id) {
    var parts = arm.id.split('/');
    var rgIdx = parts.indexOf('resourceGroups');
    if (rgIdx >= 0) armRg = parts[rgIdx + 1] || '';
  }
%>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h2><i class="bi bi-lightning me-2"></i><%= capName %></h2>
    <p class="text-muted mb-0">Capacity details and management</p>
  </div>
  <a href="/governance" class="btn btn-outline-secondary btn-sm" onclick="goBackOr('/governance'); return false;"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<!-- Status cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">State</div>
        <span class="badge bg-<%= stateColor %> fs-6" id="cap-state-badge"><%= capState %></span>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">SKU</div>
        <code class="fs-5"><%= sku || '-' %></code>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">License</div>
        <span class="badge bg-<%= licType === 'Fabric' ? 'success' : licType === 'Premium' ? 'warning' : 'secondary' %> fs-6"><%= licType %></span>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">Region</div>
        <span class="fs-6"><%= cap.region || '-' %></span>
      </div>
    </div>
  </div>
</div>

<!-- Details -->
<div class="row g-4 mb-4">
  <!-- Power BI Metadata -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-info-circle me-2"></i>Power BI Metadata</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><td class="text-muted ps-3" style="width:160px;">Capacity ID</td><td><code class="small"><%= cap.id %></code></td></tr>
            <tr><td class="text-muted ps-3">Display Name</td><td><%= capName %></td></tr>
            <tr><td class="text-muted ps-3">SKU</td><td><code><%= cap.sku || '-' %></code></td></tr>
            <tr><td class="text-muted ps-3">State</td><td><%= cap.state || '-' %></td></tr>
            <tr><td class="text-muted ps-3">Region</td><td><%= cap.region || '-' %></td></tr>
            <% if (cap.admins && cap.admins.length) { %>
              <tr><td class="text-muted ps-3">Admins</td><td><%= cap.admins.join(', ') %></td></tr>
            <% } %>
            <% if (cap.capacityUserAccessRight) { %>
              <tr><td class="text-muted ps-3">Your Access</td><td><%= cap.capacityUserAccessRight %></td></tr>
            <% } %>
            <% if (cap.tenantKeyId) { %>
              <tr><td class="text-muted ps-3">Tenant Key ID</td><td><code class="small"><%= cap.tenantKeyId %></code></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ARM Details -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-cloud me-2"></i>Azure Resource Details</div>
      <% if (armProps) { %>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <tr><td class="text-muted ps-3" style="width:160px;">Subscription</td><td><code class="small"><%= armSub %></code></td></tr>
              <tr><td class="text-muted ps-3">Resource Group</td><td><strong><%= armRg %></strong></td></tr>
              <tr><td class="text-muted ps-3">Location</td><td><%= arm.location || '-' %></td></tr>
              <tr><td class="text-muted ps-3">Provisioning</td><td><%= armProps.provisioningState || '-' %></td></tr>
              <tr><td class="text-muted ps-3">State</td><td><span class="badge bg-<%= armProps.state === 'Active' ? 'success' : 'warning' %>"><%= armProps.state || '-' %></span></td></tr>
              <% if (armProps.administration && armProps.administration.members) { %>
                <tr><td class="text-muted ps-3">Capacity Admins</td><td class="small"><%= armProps.administration.members.join(', ') %></td></tr>
              <% } %>
              <% if (arm.sku) { %>
                <tr><td class="text-muted ps-3">ARM SKU</td><td><code><%= arm.sku.name %></code> (<%= arm.sku.tier || '-' %>)</td></tr>
              <% } %>
              <tr><td class="text-muted ps-3">Resource ID</td><td><code class="small" style="word-break:break-all;"><%= arm.id %></code></td></tr>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="alert alert-warning small mb-0">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>Azure Resource details unavailable.</strong><br>
            <% if (armError) { %>
              <span class="text-muted"><%= armError %></span><br>
            <% } %>
            The service principal needs at least <strong>Reader</strong> role on the Fabric capacity resource or its resource group/subscription to view ARM details.
            <hr class="my-2">
            <small>Ensure:</small>
            <ul class="small mb-0 mt-1">
              <li><code>AZURE_SUBSCRIPTION_ID</code> is set in App Settings</li>
              <li>The SP has <strong>Reader</strong> role on the subscription or resource group containing the capacity</li>
              <li>For Pause/Resume: SP needs <strong>Contributor</strong> role on the capacity resource</li>
            </ul>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Pause / Resume Actions -->
<div class="card mb-4">
  <div class="card-header"><i class="bi bi-gear me-2"></i>Pause / Resume</div>
  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small">Subscription ID</label>
        <input type="text" class="form-control form-control-sm" id="armSubscription" value="<%= armSub %>" style="width:300px;" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx">
      </div>
      <div class="col-auto">
        <label class="form-label small">Resource Group</label>
        <input type="text" class="form-control form-control-sm" id="armResourceGroup" value="<%= armRg %>" style="width:200px;" placeholder="rg-my-fabric">
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-success" onclick="doAction('resume')">
          <i class="bi bi-play-fill me-1"></i>Resume
        </button>
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-warning" onclick="doAction('suspend')">
          <i class="bi bi-pause-fill me-1"></i>Pause
        </button>
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-outline-primary" onclick="doAction('refresh')">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Schedules -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-calendar-event me-2"></i>Pause / Resume Schedules</span>
  </div>
  <div class="card-body">
    <div class="row g-2 align-items-end mb-3">
      <div class="col-auto">
        <label class="form-label small">Action</label>
        <select class="form-select form-select-sm" id="schedAction" style="width:120px;">
          <option value="suspend">Pause</option>
          <option value="resume">Resume</option>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small">Frequency</label>
        <select class="form-select form-select-sm" id="schedType" style="width:120px;" onchange="toggleSchedFields('schedType','schedHourCol','schedMinCol','schedDayCol')">
          <option value="daily">Daily</option>
          <option value="hourly">Hourly</option>
          <option value="weekdays">Weekdays (Mon–Fri)</option>
          <option value="weekly">Weekly</option>
        </select>
      </div>
      <div class="col-auto" id="schedHourCol">
        <label class="form-label small">Hour</label>
        <input type="number" class="form-control form-control-sm" id="schedHour" min="0" max="23" value="18" style="width:70px;">
      </div>
      <div class="col-auto" id="schedMinCol">
        <label class="form-label small">Minute</label>
        <input type="number" class="form-control form-control-sm" id="schedMin" min="0" max="59" value="0" style="width:70px;">
      </div>
      <div class="col-auto d-none" id="schedDayCol">
        <label class="form-label small">Day</label>
        <select class="form-select form-select-sm" id="schedDay" style="width:120px;">
          <option value="Monday">Monday</option>
          <option value="Tuesday">Tuesday</option>
          <option value="Wednesday">Wednesday</option>
          <option value="Thursday">Thursday</option>
          <option value="Friday">Friday</option>
          <option value="Saturday">Saturday</option>
          <option value="Sunday">Sunday</option>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small">Timezone</label>
        <select class="form-select form-select-sm" id="schedTimezone" style="width:200px;">
          <option value="UTC">UTC</option>
          <option value="Europe/London">Europe/London</option>
          <option value="Europe/Paris">Europe/Paris (CET)</option>
          <option value="Europe/Berlin">Europe/Berlin (CET)</option>
          <option value="Europe/Warsaw">Europe/Warsaw (CET)</option>
          <option value="Europe/Amsterdam">Europe/Amsterdam (CET)</option>
          <option value="Europe/Zurich">Europe/Zurich (CET)</option>
          <option value="Europe/Stockholm">Europe/Stockholm (CET)</option>
          <option value="Europe/Oslo">Europe/Oslo (CET)</option>
          <option value="Europe/Helsinki">Europe/Helsinki (EET)</option>
          <option value="Europe/Athens">Europe/Athens (EET)</option>
          <option value="Europe/Istanbul">Europe/Istanbul</option>
          <option value="Asia/Dubai">Asia/Dubai (GST)</option>
          <option value="Asia/Kolkata">Asia/Kolkata (IST)</option>
          <option value="Asia/Singapore">Asia/Singapore (SGT)</option>
          <option value="Asia/Tokyo">Asia/Tokyo (JST)</option>
          <option value="Asia/Shanghai">Asia/Shanghai (CST)</option>
          <option value="Asia/Seoul">Asia/Seoul (KST)</option>
          <option value="Australia/Sydney">Australia/Sydney (AEST)</option>
          <option value="Australia/Melbourne">Australia/Melbourne (AEST)</option>
          <option value="America/New_York">America/New_York (ET)</option>
          <option value="America/Chicago">America/Chicago (CT)</option>
          <option value="America/Denver">America/Denver (MT)</option>
          <option value="America/Los_Angeles">America/Los_Angeles (PT)</option>
          <option value="America/Sao_Paulo">America/Sao_Paulo (BRT)</option>
          <option value="America/Toronto">America/Toronto (ET)</option>
          <option value="Africa/Johannesburg">Africa/Johannesburg (SAST)</option>
        </select>
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-primary" onclick="addSchedule()"><i class="bi bi-plus me-1"></i>Add</button>
      </div>
    </div>

    <% if (schedules.length) { %>
      <table class="table table-sm table-hover mb-0">
        <thead><tr><th>Action</th><th>Frequency</th><th>Time (Local)</th><th>Timezone</th><th>Time (UTC)</th><th>Days</th><th>Enabled</th><th>Actions</th></tr></thead>
        <tbody>
          <% schedules.forEach(function(s) {
            var dayLabel = '-';
            if (s.schedule_type === 'daily') dayLabel = 'Mon–Sun';
            else if (s.schedule_type === 'weekdays') dayLabel = 'Mon–Fri';
            else if (s.schedule_type === 'weekly') dayLabel = s.schedule_day || '-';
            else if (s.schedule_type === 'hourly') dayLabel = 'Every hour';
          %>
            <tr>
              <td><span class="badge bg-<%= s.action === 'resume' ? 'success' : 'warning' %>"><%= s.action === 'resume' ? 'Resume' : 'Pause' %></span></td>
              <td><%= s.schedule_type %></td>
              <td><%= s.schedule_type === 'hourly' ? 'Every hour at :' + String(s.schedule_minute || 0).padStart(2, '0') : (s.schedule_hour != null ? String(s.schedule_hour).padStart(2, '0') + ':' + String(s.schedule_minute || 0).padStart(2, '0') : '-') %></td>
              <td><span class="badge bg-light text-dark"><%= s.timezone || 'UTC' %></span></td>
              <td><%= s.schedule_minute_utc != null ? (s.schedule_type === 'hourly' ? 'Every hour at :' + String(s.schedule_minute_utc || 0).padStart(2, '0') : (s.schedule_hour_utc != null ? String(s.schedule_hour_utc).padStart(2, '0') + ':' + String(s.schedule_minute_utc || 0).padStart(2, '0') : '-')) : '-' %></td>
              <td><%= dayLabel %></td>
              <td><div class="form-check form-switch"><input class="form-check-input" type="checkbox" <%= s.enabled ? 'checked' : '' %> onchange="toggleSchedule(<%= s.id %>, this.checked)"></div></td>
              <td>
                <button class="btn btn-sm btn-outline-primary p-0 px-1 me-1" onclick="openEditSchedule(<%= s.id %>, '<%= s.action %>', '<%= s.schedule_type %>', <%= s.schedule_hour != null ? s.schedule_hour : 'null' %>, <%= s.schedule_minute != null ? s.schedule_minute : 0 %>, '<%= s.schedule_day || '' %>', '<%= s.timezone || 'UTC' %>')" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-sm btn-outline-danger p-0 px-1" onclick="deleteSchedule(<%= s.id %>)" title="Delete"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-muted small mb-0">No schedules configured yet.</p>
    <% } %>
  </div>
</div>

<!-- Scheduler health -->
<% var sched = typeof schedulerStatus !== 'undefined' && schedulerStatus ? schedulerStatus : null; %>
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-activity me-2"></i>Scheduler Health</span>
    <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="runSchedulerNow()">
      <i class="bi bi-play-circle me-1"></i>Run scheduler now
    </button>
  </div>
  <div class="card-body small" id="schedulerHealthBody">
    <% if (!sched || !sched.started) { %>
      <span class="badge bg-danger">Not running</span>
      <span class="text-muted ms-2">
        No scheduler is active in the process serving this request, so no pause/resume
        will fire. Usual causes: the App Service worker was recycled before startup
        completed, or startup failed. Click <strong>Run scheduler now</strong> to start
        it on this instance, then reload.
      </span>
    <% } else { %>
      <span class="badge bg-success">Running</span>
      <span class="text-muted ms-2">
        Last tick: <%= sched.lastTickAt || 'never' %> (<%= sched.lastTickSource || '-' %>) ·
        Ticks: <%= sched.tickCount %> ·
        Enabled schedules: <%= sched.enabledSchedules %>/<%= sched.schedulesLoaded %> ·
        Catch-up window: <%= sched.catchUpWindowMinutes %> min
      </span>
      <% if (sched.lastActionSummary) { %>
        <div class="mt-2">Last action: <%= sched.lastActionAt %> — <%= sched.lastActionSummary %></div>
      <% } %>
      <% if (sched.lastError) { %>
        <div class="mt-2 text-danger">Last error (<%= sched.lastErrorAt %>): <%= sched.lastError %></div>
      <% } %>
    <% } %>
  </div>
</div>

<!-- Execution History (last 30 days) -->
<div class="card mb-4">
  <div class="card-header"><i class="bi bi-clock-history me-2"></i>Schedule Execution History (Last 30 Days)</div>
  <% var hist = typeof history !== 'undefined' ? history : []; %>
  <% if (hist.length) { %>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height:300px; overflow-y:auto;">
        <table class="table table-sm mb-0">
          <thead><tr><th>Time (UTC)</th><th>Action</th><th>Status</th><th>Message</th></tr></thead>
          <tbody>
            <% hist.forEach(function(h) { %>
              <% var statusClass = h.status === 'success' ? 'success' : (h.status === 'error' ? 'danger' : 'secondary'); %>
              <tr>
                <td class="small"><%= h.executed_at ? new Date(h.executed_at).toLocaleString() : '-' %></td>
                <td><span class="badge bg-<%= h.action === 'resume' ? 'success' : 'warning' %>"><%= h.action === 'resume' ? 'Resume' : 'Pause' %></span></td>
                <td><span class="badge bg-<%= statusClass %>"><%= h.status %></span></td>
                <td class="small"><%= h.message || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card-body text-muted small">No executions recorded yet. History appears after scheduled actions run.</div>
  <% } %>
</div>

<!-- Action Status Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="actionModalTitle">Capacity Action</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center py-4" id="actionModalBody"></div>
    </div>
  </div>
</div>

<!-- Edit Schedule Modal -->
<div class="modal fade" id="editSchedModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Edit Schedule</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="editSchedId">
        <div class="row g-2 mb-2">
          <div class="col-6">
            <label class="form-label small">Action</label>
            <select class="form-select form-select-sm" id="editSchedAction">
              <option value="suspend">Pause</option>
              <option value="resume">Resume</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small">Frequency</label>
            <select class="form-select form-select-sm" id="editSchedType" onchange="toggleSchedFields('editSchedType','editHourCol','editMinCol','editDayCol')">
              <option value="daily">Daily</option>
              <option value="hourly">Hourly</option>
              <option value="weekdays">Weekdays (Mon–Fri)</option>
              <option value="weekly">Weekly</option>
            </select>
          </div>
        </div>
        <div class="row g-2">
          <div class="col-4" id="editHourCol">
            <label class="form-label small">Hour</label>
            <input type="number" class="form-control form-control-sm" id="editSchedHour" min="0" max="23" value="18">
          </div>
          <div class="col-4" id="editMinCol">
            <label class="form-label small">Minute</label>
            <input type="number" class="form-control form-control-sm" id="editSchedMin" min="0" max="59" value="0">
          </div>
          <div class="col-4 d-none" id="editDayCol">
            <label class="form-label small">Day</label>
            <select class="form-select form-select-sm" id="editSchedDay">
              <option value="Monday">Monday</option>
              <option value="Tuesday">Tuesday</option>
              <option value="Wednesday">Wednesday</option>
              <option value="Thursday">Thursday</option>
              <option value="Friday">Friday</option>
              <option value="Saturday">Saturday</option>
              <option value="Sunday">Sunday</option>
            </select>
          </div>
        </div>
        <div class="row g-2 mt-2">
          <div class="col-12">
            <label class="form-label small">Timezone</label>
            <select class="form-select form-select-sm" id="editSchedTimezone">
              <option value="UTC">UTC</option>
              <option value="Europe/London">Europe/London</option>
              <option value="Europe/Paris">Europe/Paris (CET)</option>
              <option value="Europe/Berlin">Europe/Berlin (CET)</option>
              <option value="Europe/Warsaw">Europe/Warsaw (CET)</option>
              <option value="Europe/Amsterdam">Europe/Amsterdam (CET)</option>
              <option value="Europe/Zurich">Europe/Zurich (CET)</option>
              <option value="Europe/Stockholm">Europe/Stockholm (CET)</option>
              <option value="Europe/Oslo">Europe/Oslo (CET)</option>
              <option value="Europe/Helsinki">Europe/Helsinki (EET)</option>
              <option value="Europe/Athens">Europe/Athens (EET)</option>
              <option value="Europe/Istanbul">Europe/Istanbul</option>
              <option value="Asia/Dubai">Asia/Dubai (GST)</option>
              <option value="Asia/Kolkata">Asia/Kolkata (IST)</option>
              <option value="Asia/Singapore">Asia/Singapore (SGT)</option>
              <option value="Asia/Tokyo">Asia/Tokyo (JST)</option>
              <option value="Asia/Shanghai">Asia/Shanghai (CST)</option>
              <option value="Asia/Seoul">Asia/Seoul (KST)</option>
              <option value="Australia/Sydney">Australia/Sydney (AEST)</option>
              <option value="Australia/Melbourne">Australia/Melbourne (AEST)</option>
              <option value="America/New_York">America/New_York (ET)</option>
              <option value="America/Chicago">America/Chicago (CT)</option>
              <option value="America/Denver">America/Denver (MT)</option>
              <option value="America/Los_Angeles">America/Los_Angeles (PT)</option>
              <option value="America/Sao_Paulo">America/Sao_Paulo (BRT)</option>
              <option value="America/Toronto">America/Toronto (ET)</option>
              <option value="Africa/Johannesburg">Africa/Johannesburg (SAST)</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-sm btn-primary" onclick="saveEditSchedule()">Save</button>
      </div>
    </div>
  </div>
</div>

<script>
var capName = '<%= capName.replace(/'/g, "\\'") %>';
var actionModal, editSchedModal;

document.addEventListener('DOMContentLoaded', function() {
  actionModal = new bootstrap.Modal(document.getElementById('actionModal'));
  editSchedModal = new bootstrap.Modal(document.getElementById('editSchedModal'));
});

function getArmParams() {
  return {
    subscriptionId: document.getElementById('armSubscription').value.trim(),
    resourceGroup: document.getElementById('armResourceGroup').value.trim(),
  };
}

function showModal(title, html) {
  document.getElementById('actionModalTitle').textContent = title;
  document.getElementById('actionModalBody').innerHTML = html;
  actionModal.show();
}

async function doAction(action) {
  var params = getArmParams();

  if (action === 'refresh') {
    showModal('Refreshing State', '<div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Checking capacity state...</p>');
    try {
      var resp = await fetch('/capacities/refresh');
      var data = await resp.json();
      if (data.success) {
        var cap = (data.capacities || []).find(function(c) { return (c.displayName || '').toLowerCase() === capName.toLowerCase(); });
        if (cap) {
          var badge = document.getElementById('cap-state-badge');
          badge.textContent = cap.state || 'Unknown';
          badge.className = 'badge fs-6 bg-' + (cap.state === 'Active' ? 'success' : 'warning');
          showModal('State Refreshed', '<i class="bi bi-check-circle text-success fs-1"></i><p class="mt-2">Current state: <span class="badge bg-' + (cap.state === 'Active' ? 'success' : 'warning') + '">' + cap.state + '</span></p>');
        } else {
          showModal('Refresh', '<i class="bi bi-exclamation-triangle text-warning fs-2"></i><p class="mt-2">Capacity not found in response.</p>');
        }
      } else {
        showModal('Refresh Failed', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + (data.message || 'Unknown error') + '</p>');
      }
    } catch (e) {
      showModal('Error', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + e.message + '</p>');
    }
    return;
  }

  if (!params.subscriptionId || !params.resourceGroup) {
    showModal('Missing Info', '<i class="bi bi-exclamation-triangle text-warning fs-2"></i><p class="mt-2">Please fill in <strong>Subscription ID</strong> and <strong>Resource Group</strong>.</p>');
    return;
  }

  var actionLabel = action === 'resume' ? 'Resuming' : 'Pausing';
  showModal(actionLabel + ' Capacity', '<div class="spinner-border text-' + (action === 'resume' ? 'success' : 'warning') + '"></div><p class="mt-2 text-muted">' + actionLabel + ' <strong>' + capName + '</strong>...</p><p class="text-muted small">This may take a minute.</p>');

  try {
    var resp = await fetch('/capacities/' + encodeURIComponent(capName) + '/' + action, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(params)
    });
    var data = await resp.json();
    if (data.success) {
      showModal(action === 'resume' ? 'Resume Initiated' : 'Pause Initiated',
        '<i class="bi bi-check-circle text-success fs-1"></i><p class="mt-2">' + (data.message || 'Action completed successfully.') + '</p><p class="text-muted small">Click Refresh to check the new state.</p>');
    } else {
      showModal('Action Failed',
        '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + (data.message || 'Unknown error') + '</p>' +
        '<p class="text-muted small mt-2">Ensure the service principal has <strong>Contributor</strong> role on the capacity resource.</p>');
    }
  } catch (e) {
    showModal('Error', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + e.message + '</p>');
  }
}

function toggleSchedFields(typeId, hourColId, minColId, dayColId) {
  var type = document.getElementById(typeId).value;
  document.getElementById(dayColId).classList.toggle('d-none', type !== 'weekly');
  document.getElementById(hourColId).classList.toggle('d-none', type === 'hourly');
}

async function addSchedule() {
  var params = getArmParams();
  if (!params.subscriptionId || !params.resourceGroup) {
    showModal('Missing Info', '<i class="bi bi-exclamation-triangle text-warning fs-2"></i><p class="mt-2">Fill in Subscription ID and Resource Group first.</p>');
    return;
  }
  var body = {
    subscriptionId: params.subscriptionId,
    resourceGroup: params.resourceGroup,
    action: document.getElementById('schedAction').value,
    scheduleType: document.getElementById('schedType').value,
    hour: parseInt(document.getElementById('schedHour').value) || 0,
    minute: parseInt(document.getElementById('schedMin').value) || 0,
    day: document.getElementById('schedDay').value,
    timezone: document.getElementById('schedTimezone').value,
  };
  showModal('Adding Schedule', '<div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Creating schedule...</p>');
  try {
    var resp = await fetch('/capacities/' + encodeURIComponent(capName) + '/schedule', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    var data = await resp.json();
    if (data.success) {
      var utcLabel = data.utcSchedule && data.utcSchedule.label ? data.utcSchedule.label : 'UTC time will be shown after reload';
      showModal('Schedule Added', '<i class="bi bi-check-circle text-success fs-1"></i><p class="mt-2">Schedule created successfully.</p><p class="text-muted small mb-1">Local: ' + body.action + ' — ' + body.scheduleType + ' at ' + String(body.hour).padStart(2,'0') + ':' + String(body.minute).padStart(2,'0') + ' ' + body.timezone + '</p><p class="text-muted small">Scheduler UTC: <strong>' + utcLabel + '</strong></p>');
      reloadPageWithMessage('Schedule created. Reloading...', 1500);
    } else {
      showModal('Error', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + data.message + '</p>');
    }
  } catch (e) { showModal('Error', '<p>' + e.message + '</p>'); }
}

function openEditSchedule(id, action, type, hour, minute, day, timezone) {
  document.getElementById('editSchedId').value = id;
  document.getElementById('editSchedAction').value = action;
  document.getElementById('editSchedType').value = type;
  document.getElementById('editSchedHour').value = hour != null ? hour : 18;
  document.getElementById('editSchedMin').value = minute || 0;
  if (day) document.getElementById('editSchedDay').value = day;
  document.getElementById('editSchedTimezone').value = timezone || 'UTC';
  toggleSchedFields('editSchedType', 'editHourCol', 'editMinCol', 'editDayCol');
  editSchedModal.show();
}

async function saveEditSchedule() {
  var id = document.getElementById('editSchedId').value;
  var body = {
    action: document.getElementById('editSchedAction').value,
    scheduleType: document.getElementById('editSchedType').value,
    hour: parseInt(document.getElementById('editSchedHour').value) || 0,
    minute: parseInt(document.getElementById('editSchedMin').value) || 0,
    day: document.getElementById('editSchedDay').value,
    timezone: document.getElementById('editSchedTimezone').value,
  };
  try {
    var resp = await fetch('/capacities/schedule/' + id, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    var data = await resp.json();
    if (data.success) {
      editSchedModal.hide();
      showToast('Schedule updated', 'success');
      reloadPageWithMessage('Schedule updated. Reloading...', 800);
    } else {
      showToast(data.message || 'Update failed', 'error');
      showModal('Update failed', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + (data.message || 'Update failed') + '</p>');
    }
  } catch (e) { showToast(e.message, 'error'); }
}

async function deleteSchedule(id) {
  showConfirmAction({
    title: 'Delete Schedule',
    message: 'Delete this schedule? This cannot be undone.',
    confirmText: 'Delete',
    confirmClass: 'btn-danger',
    onConfirm: async function() {
      try {
        var resp = await fetch('/capacities/schedule/' + id, { method: 'DELETE' });
        var data = await resp.json();
        if (data.success) {
          reloadPageWithMessage('Schedule deleted. Reloading...');
        } else {
          showToast(data.message || 'Delete failed', 'error');
        }
      } catch (e) { console.error(e); }
    }
  });
}

async function toggleSchedule(id, enabled) {
  try {
    await fetch('/capacities/schedule/' + id + '/toggle', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: enabled })
    });
    showToast('Schedule ' + (enabled ? 'enabled' : 'disabled'), 'success');
  } catch (e) { showToast(e.message, 'error'); }
}

async function runSchedulerNow() {
  try {
    const res = await fetch('/capacities/scheduler/run', { method: 'POST' });
    const data = await res.json();
    if (!data.success) throw new Error(data.message || 'Scheduler run failed');
    const s = data.status || {};
    showToast('Scheduler ran. Enabled schedules: ' + (s.enabledSchedules || 0) +
      (s.lastActionSummary ? ' · ' + s.lastActionSummary : ' · nothing due right now'), 'success');
    setTimeout(function () { window.location.reload(); }, 1500);
  } catch (e) { showToast(e.message, 'error'); }
}
</script>

