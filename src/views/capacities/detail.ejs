<%- include('../partials/header') %>
<%
  var cap = capacity || {};
  var arm = armDetail || null;
  var armError = arm && arm.error ? arm.error : null;
  var armProps = arm && arm.properties ? arm.properties : null;
  var capName = cap.displayName || 'Unknown';
  var capState = cap.state || 'Unknown';
  var stateColor = capState === 'Active' ? 'success' : capState === 'Paused' || capState === 'Suspended' ? 'warning' : 'secondary';
  var sku = (cap.sku || '').toUpperCase();
  var licType = sku.startsWith('F') && sku !== 'FREE' ? 'Fabric' : sku === 'PPU' ? 'PPU' : sku.startsWith('P') || sku.startsWith('EM') || sku.startsWith('A') ? 'Premium' : 'Shared';

  var armRg = '';
  var armSub = subscriptionId || '';
  if (arm && arm.id) {
    var parts = arm.id.split('/');
    var rgIdx = parts.indexOf('resourceGroups');
    if (rgIdx >= 0) armRg = parts[rgIdx + 1] || '';
  }
%>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h2><i class="bi bi-lightning me-2"></i><%= capName %></h2>
    <p class="text-muted mb-0">Capacity details and management</p>
  </div>
  <a href="/governance" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<!-- Status cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">State</div>
        <span class="badge bg-<%= stateColor %> fs-6" id="cap-state-badge"><%= capState %></span>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">SKU</div>
        <code class="fs-5"><%= sku || '-' %></code>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">License</div>
        <span class="badge bg-<%= licType === 'Fabric' ? 'success' : licType === 'Premium' ? 'warning' : 'secondary' %> fs-6"><%= licType %></span>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card text-center h-100 stat-card">
      <div class="card-body py-3">
        <div class="text-muted small mb-1">Region</div>
        <span class="fs-6"><%= cap.region || '-' %></span>
      </div>
    </div>
  </div>
</div>

<!-- Details -->
<div class="row g-4 mb-4">
  <!-- Power BI Metadata -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-info-circle me-2"></i>Power BI Metadata</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><td class="text-muted ps-3" style="width:160px;">Capacity ID</td><td><code class="small"><%= cap.id %></code></td></tr>
            <tr><td class="text-muted ps-3">Display Name</td><td><%= capName %></td></tr>
            <tr><td class="text-muted ps-3">SKU</td><td><code><%= cap.sku || '-' %></code></td></tr>
            <tr><td class="text-muted ps-3">State</td><td><%= cap.state || '-' %></td></tr>
            <tr><td class="text-muted ps-3">Region</td><td><%= cap.region || '-' %></td></tr>
            <% if (cap.admins && cap.admins.length) { %>
              <tr><td class="text-muted ps-3">Admins</td><td><%= cap.admins.join(', ') %></td></tr>
            <% } %>
            <% if (cap.capacityUserAccessRight) { %>
              <tr><td class="text-muted ps-3">Your Access</td><td><%= cap.capacityUserAccessRight %></td></tr>
            <% } %>
            <% if (cap.tenantKeyId) { %>
              <tr><td class="text-muted ps-3">Tenant Key ID</td><td><code class="small"><%= cap.tenantKeyId %></code></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ARM Details -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-cloud me-2"></i>Azure Resource Details</div>
      <% if (armProps) { %>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <tr><td class="text-muted ps-3" style="width:160px;">Subscription</td><td><code class="small"><%= armSub %></code></td></tr>
              <tr><td class="text-muted ps-3">Resource Group</td><td><strong><%= armRg %></strong></td></tr>
              <tr><td class="text-muted ps-3">Location</td><td><%= arm.location || '-' %></td></tr>
              <tr><td class="text-muted ps-3">Provisioning</td><td><%= armProps.provisioningState || '-' %></td></tr>
              <tr><td class="text-muted ps-3">State</td><td><span class="badge bg-<%= armProps.state === 'Active' ? 'success' : 'warning' %>"><%= armProps.state || '-' %></span></td></tr>
              <% if (armProps.administration && armProps.administration.members) { %>
                <tr><td class="text-muted ps-3">Capacity Admins</td><td class="small"><%= armProps.administration.members.join(', ') %></td></tr>
              <% } %>
              <% if (arm.sku) { %>
                <tr><td class="text-muted ps-3">ARM SKU</td><td><code><%= arm.sku.name %></code> (<%= arm.sku.tier || '-' %>)</td></tr>
              <% } %>
              <tr><td class="text-muted ps-3">Resource ID</td><td><code class="small" style="word-break:break-all;"><%= arm.id %></code></td></tr>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="alert alert-warning small mb-0">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>Azure Resource details unavailable.</strong><br>
            <% if (armError) { %>
              <span class="text-muted"><%= armError %></span><br>
            <% } %>
            The service principal needs at least <strong>Reader</strong> role on the Fabric capacity resource or its resource group/subscription to view ARM details.
            <hr class="my-2">
            <small>Ensure:</small>
            <ul class="small mb-0 mt-1">
              <li><code>AZURE_SUBSCRIPTION_ID</code> is set in App Settings</li>
              <li>The SP has <strong>Reader</strong> role on the subscription or resource group containing the capacity</li>
              <li>For Pause/Resume: SP needs <strong>Contributor</strong> role on the capacity resource</li>
            </ul>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Pause / Resume Actions -->
<div class="card mb-4">
  <div class="card-header"><i class="bi bi-gear me-2"></i>Pause / Resume</div>
  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small">Subscription ID</label>
        <input type="text" class="form-control form-control-sm" id="armSubscription" value="<%= armSub %>" style="width:300px;" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx">
      </div>
      <div class="col-auto">
        <label class="form-label small">Resource Group</label>
        <input type="text" class="form-control form-control-sm" id="armResourceGroup" value="<%= armRg %>" style="width:200px;" placeholder="rg-my-fabric">
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-success" onclick="doAction('resume')">
          <i class="bi bi-play-fill me-1"></i>Resume
        </button>
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-warning" onclick="doAction('suspend')">
          <i class="bi bi-pause-fill me-1"></i>Pause
        </button>
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-outline-primary" onclick="doAction('refresh')">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Schedules -->
<div class="card mb-4">
  <div class="card-header"><i class="bi bi-calendar-event me-2"></i>Pause / Resume Schedules</div>
  <div class="card-body">
    <div class="row g-2 align-items-end mb-3">
      <div class="col-auto">
        <label class="form-label small">Action</label>
        <select class="form-select form-select-sm" id="schedAction" style="width:120px;">
          <option value="suspend">Pause</option>
          <option value="resume">Resume</option>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small">Frequency</label>
        <select class="form-select form-select-sm" id="schedType" style="width:120px;" onchange="toggleSchedFields()">
          <option value="daily">Daily</option>
          <option value="hourly">Hourly</option>
          <option value="weekdays">Weekdays</option>
          <option value="weekly">Weekly</option>
        </select>
      </div>
      <div class="col-auto" id="schedHourCol">
        <label class="form-label small">Hour (UTC)</label>
        <input type="number" class="form-control form-control-sm" id="schedHour" min="0" max="23" value="18" style="width:70px;">
      </div>
      <div class="col-auto" id="schedMinCol">
        <label class="form-label small">Minute</label>
        <input type="number" class="form-control form-control-sm" id="schedMin" min="0" max="59" value="0" style="width:70px;">
      </div>
      <div class="col-auto d-none" id="schedDayCol">
        <label class="form-label small">Day</label>
        <select class="form-select form-select-sm" id="schedDay" style="width:120px;">
          <option value="Monday">Monday</option>
          <option value="Tuesday">Tuesday</option>
          <option value="Wednesday">Wednesday</option>
          <option value="Thursday">Thursday</option>
          <option value="Friday">Friday</option>
          <option value="Saturday">Saturday</option>
          <option value="Sunday">Sunday</option>
        </select>
      </div>
      <div class="col-auto">
        <button class="btn btn-sm btn-primary" onclick="addSchedule()"><i class="bi bi-plus me-1"></i>Add</button>
      </div>
    </div>

    <% if (schedules.length) { %>
      <table class="table table-sm table-hover mb-0">
        <thead><tr><th>Action</th><th>Frequency</th><th>Time (UTC)</th><th>Day</th><th>Enabled</th><th></th></tr></thead>
        <tbody>
          <% schedules.forEach(function(s) { %>
            <tr>
              <td><span class="badge bg-<%= s.action === 'resume' ? 'success' : 'warning' %>"><%= s.action === 'resume' ? 'Resume' : 'Pause' %></span></td>
              <td><%= s.schedule_type %></td>
              <td><%= s.schedule_hour != null ? String(s.schedule_hour).padStart(2, '0') + ':' + String(s.schedule_minute || 0).padStart(2, '0') : '-' %></td>
              <td><%= s.schedule_day || '-' %></td>
              <td><div class="form-check form-switch"><input class="form-check-input" type="checkbox" <%= s.enabled ? 'checked' : '' %> onchange="toggleSchedule(<%= s.id %>, this.checked)"></div></td>
              <td><button class="btn btn-sm btn-outline-danger p-0 px-1" onclick="deleteSchedule(<%= s.id %>)"><i class="bi bi-trash"></i></button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-muted small mb-0">No schedules configured yet.</p>
    <% } %>
  </div>
</div>

<!-- Action Status Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="actionModalTitle">Capacity Action</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center py-4" id="actionModalBody"></div>
    </div>
  </div>
</div>

<script>
var capName = '<%= capName.replace(/'/g, "\\'") %>';
var actionModal;

document.addEventListener('DOMContentLoaded', function() {
  actionModal = new bootstrap.Modal(document.getElementById('actionModal'));
});

function getArmParams() {
  return {
    subscriptionId: document.getElementById('armSubscription').value.trim(),
    resourceGroup: document.getElementById('armResourceGroup').value.trim(),
  };
}

function showModal(title, html) {
  document.getElementById('actionModalTitle').textContent = title;
  document.getElementById('actionModalBody').innerHTML = html;
  actionModal.show();
}

async function doAction(action) {
  var params = getArmParams();

  if (action === 'refresh') {
    showModal('Refreshing State', '<div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Checking capacity state...</p>');
    try {
      var resp = await fetch('/capacities/refresh');
      var data = await resp.json();
      if (data.success) {
        var cap = (data.capacities || []).find(function(c) { return (c.displayName || '').toLowerCase() === capName.toLowerCase(); });
        if (cap) {
          var badge = document.getElementById('cap-state-badge');
          badge.textContent = cap.state || 'Unknown';
          badge.className = 'badge fs-6 bg-' + (cap.state === 'Active' ? 'success' : 'warning');
          showModal('State Refreshed', '<i class="bi bi-check-circle text-success fs-1"></i><p class="mt-2">Current state: <span class="badge bg-' + (cap.state === 'Active' ? 'success' : 'warning') + '">' + cap.state + '</span></p>');
        } else {
          showModal('Refresh', '<i class="bi bi-exclamation-triangle text-warning fs-2"></i><p class="mt-2">Capacity not found in response.</p>');
        }
      } else {
        showModal('Refresh Failed', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + (data.message || 'Unknown error') + '</p>');
      }
    } catch (e) {
      showModal('Error', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + e.message + '</p>');
    }
    return;
  }

  // Pause or Resume
  if (!params.subscriptionId || !params.resourceGroup) {
    showModal('Missing Info', '<i class="bi bi-exclamation-triangle text-warning fs-2"></i><p class="mt-2">Please fill in <strong>Subscription ID</strong> and <strong>Resource Group</strong> first.</p>');
    return;
  }

  var actionLabel = action === 'resume' ? 'Resuming' : 'Pausing';
  showModal(actionLabel + ' Capacity', '<div class="spinner-border text-' + (action === 'resume' ? 'success' : 'warning') + '"></div><p class="mt-2 text-muted">' + actionLabel + ' <strong>' + capName + '</strong>...</p><p class="text-muted small">This may take a minute.</p>');

  try {
    var resp = await fetch('/capacities/' + encodeURIComponent(capName) + '/' + action, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(params)
    });
    var data = await resp.json();
    if (data.success) {
      showModal(action === 'resume' ? 'Resume Initiated' : 'Pause Initiated',
        '<i class="bi bi-check-circle text-success fs-1"></i><p class="mt-2">' + (data.message || 'Action completed successfully.') + '</p><p class="text-muted small">Click Refresh to check the new state.</p>');
    } else {
      showModal('Action Failed',
        '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + (data.message || 'Unknown error') + '</p>' +
        '<p class="text-muted small mt-2">Ensure the service principal has <strong>Contributor</strong> role on the capacity resource.</p>');
    }
  } catch (e) {
    showModal('Error', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + e.message + '</p>');
  }
}

function toggleSchedFields() {
  var type = document.getElementById('schedType').value;
  document.getElementById('schedDayCol').classList.toggle('d-none', type !== 'weekly');
  document.getElementById('schedHourCol').classList.toggle('d-none', type === 'hourly');
}

async function addSchedule() {
  var params = getArmParams();
  if (!params.subscriptionId || !params.resourceGroup) {
    showModal('Missing Info', '<i class="bi bi-exclamation-triangle text-warning fs-2"></i><p class="mt-2">Fill in Subscription ID and Resource Group first.</p>');
    return;
  }
  var body = {
    subscriptionId: params.subscriptionId,
    resourceGroup: params.resourceGroup,
    action: document.getElementById('schedAction').value,
    scheduleType: document.getElementById('schedType').value,
    hour: parseInt(document.getElementById('schedHour').value) || 0,
    minute: parseInt(document.getElementById('schedMin').value) || 0,
    day: document.getElementById('schedDay').value,
  };
  try {
    var resp = await fetch('/capacities/' + encodeURIComponent(capName) + '/schedule', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    var data = await resp.json();
    if (data.success) location.reload();
    else showModal('Error', '<i class="bi bi-x-circle text-danger fs-2"></i><p class="mt-2">' + data.message + '</p>');
  } catch (e) { showModal('Error', '<p>' + e.message + '</p>'); }
}

async function deleteSchedule(id) {
  if (!confirm('Delete this schedule?')) return;
  try {
    var resp = await fetch('/capacities/schedule/' + id, { method: 'DELETE' });
    var data = await resp.json();
    if (data.success) location.reload();
  } catch (e) { console.error(e); }
}

async function toggleSchedule(id, enabled) {
  try {
    await fetch('/capacities/schedule/' + id + '/toggle', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: enabled })
    });
  } catch (e) { console.error(e); }
}
</script>

<%- include('../partials/footer') %>
