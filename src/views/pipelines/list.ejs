<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-diagram-3 me-2"></i>Deployment Pipelines</h2>
    <p class="text-muted mb-0">
      Every deployment pipeline in the tenant, the workspaces assigned to each stage, and whether
      <% if (spName) { %><strong><%= spName %></strong><% } else { %>the service principal<% } %>
      has access to it.
    </p>
  </div>
  <button class="btn btn-outline-primary" id="refreshBtn" onclick="loadPipelines()">
    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
  </button>
</div>

<% if (configError) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i><%= configError %>
  </div>
<% } else { %>

  <% if (grantAuth === 'success') { %>
    <div class="alert alert-success alert-dismissible fade show">
      <i class="bi bi-check-circle me-2"></i>Signed in as a Fabric administrator. A pending access grant will be retried automatically.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (grantError) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <i class="bi bi-exclamation-octagon me-2"></i>Could not start the Fabric administrator sign-in: <%= grantError %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row g-3 mb-4" id="summaryCards" style="display:none;">
    <div class="col-6 col-lg-3">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Pipelines</div>
        <div class="h4 mb-0" id="statTotal">0</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Accessible</div>
        <div class="h4 mb-0 text-success" id="statGranted">0</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">No access</div>
        <div class="h4 mb-0 text-warning" id="statNone">0</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Assigned workspaces</div>
        <div class="h4 mb-0" id="statWorkspaces">0</div>
      </div></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-list-ul me-2"></i>Pipelines</span>
      <div class="d-flex align-items-center gap-2">
        <span class="text-muted small" id="selectionInfo"></span>
        <button class="btn btn-sm btn-danger" id="deleteSelectedBtn" onclick="confirmDeleteSelected()" disabled>
          <i class="bi bi-trash me-1"></i>Delete selected
        </button>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th style="width:36px;">
              <input type="checkbox" class="form-check-input" id="selectAllPipelines" onchange="toggleSelectAll(this.checked)">
            </th>
            <th>Pipeline</th>
            <th>Stages &amp; workspaces</th>
            <th style="width:150px;">Service principal</th>
            <th style="width:220px;" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody id="pipelineTableBody">
          <tr><td colspan="5" class="text-center text-muted py-4">
            <span class="spinner-border spinner-border-sm me-2"></span>Loading deployment pipelines...
          </td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Delete confirmation -->
  <div class="modal fade" id="deletePipelineModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete deployment pipelines</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">This permanently deletes the following deployment pipeline(s). This cannot be undone.</p>
          <ul class="small mb-3" id="deletePipelineList"></ul>
          <p class="text-muted small mb-2">
            The workspaces assigned to the stages are <strong>not</strong> deleted &mdash; only the pipeline and its
            stage assignments are removed.
          </p>
          <label class="form-label small" for="deletePipelineConfirm">Type <strong>DELETE</strong> to confirm</label>
          <input type="text" class="form-control form-control-sm" id="deletePipelineConfirm" autocomplete="off" oninput="onDeleteConfirmInput()">
        </div>
        <div class="modal-footer">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-sm btn-danger" id="deletePipelineConfirmBtn" onclick="performDelete()" disabled>
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Failure details with an explanation of the status code -->
  <div class="modal fade" id="pipelineErrorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title"><i class="bi bi-exclamation-octagon text-danger me-2"></i>Pipeline errors</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="pipelineErrorBody"></div>
        <div class="modal-footer">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Fabric administrator authorization prompt -->
  <div class="modal fade" id="pipelineAdminAuthModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title"><i class="bi bi-shield-lock text-warning me-2"></i>Fabric administrator sign-in required</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-3" id="pipelineAdminAuthMessage"></p>
          <p class="text-muted small mb-0">
            Granting pipeline access uses a tenant admin API that this tenant will not accept from an application
            token. Signing in as a Fabric administrator lets the application perform the grant on your behalf, then
            the grant is retried automatically.
          </p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-sm btn-primary" id="pipelineAdminAuthConfirmBtn">
            <i class="bi bi-box-arrow-in-right me-1"></i>Authorize as Fabric Admin
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
  var pipelineRows = [];
  var pendingPipelineDeletion = [];

  function escapePipelineHtml(value) {
    return String(value === null || value === undefined ? '' : value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function notify(message, type) {
    if (typeof showToast === 'function') showToast(message, type);
  }

  // ── Loading ──
  function loadPipelines() {
    var body = document.getElementById('pipelineTableBody');
    body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">'
      + '<span class="spinner-border spinner-border-sm me-2"></span>Loading deployment pipelines...</td></tr>';
    document.getElementById('refreshBtn').disabled = true;

    fetch('/pipelines/data')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        document.getElementById('refreshBtn').disabled = false;
        if (data.error) {
          body.innerHTML = '<tr><td colspan="5" class="text-danger py-4">'
            + escapePipelineHtml(data.error)
            + (data.explanation ? '<div class="text-muted small mt-1">' + escapePipelineHtml(data.explanation) + '</div>' : '')
            + '</td></tr>';
          return;
        }
        pipelineRows = data.pipelines || [];
        renderPipelines();
        renderPipelineSummary();
        retryPendingGrant();
      })
      .catch(function(err) {
        document.getElementById('refreshBtn').disabled = false;
        body.innerHTML = '<tr><td colspan="5" class="text-danger py-4">' + escapePipelineHtml(err.message) + '</td></tr>';
      });
  }

  function renderPipelineSummary() {
    var granted = pipelineRows.filter(function(p) { return p.access === 'granted'; }).length;
    var none = pipelineRows.filter(function(p) { return p.access === 'none'; }).length;
    var workspaces = pipelineRows.reduce(function(sum, p) { return sum + (p.workspaceCount || 0); }, 0);
    document.getElementById('statTotal').textContent = pipelineRows.length;
    document.getElementById('statGranted').textContent = granted;
    document.getElementById('statNone').textContent = none;
    document.getElementById('statWorkspaces').textContent = workspaces;
    document.getElementById('summaryCards').style.display = '';
  }

  function accessBadge(pipeline) {
    if (pipeline.access === 'granted') {
      return '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Has access</span>';
    }
    if (pipeline.access === 'none') {
      return '<span class="badge bg-warning text-dark"><i class="bi bi-x-circle me-1"></i>No access</span>';
    }
    var title = pipeline.accessError ? ' title="' + escapePipelineHtml(pipeline.accessError) + '"' : '';
    return '<span class="badge bg-secondary"' + title + '><i class="bi bi-question-circle me-1"></i>Unknown</span>';
  }

  function stagesCell(pipeline) {
    var stages = pipeline.stages || [];
    if (stages.length === 0) return '<span class="text-muted small">No stages</span>';
    return stages.map(function(s) {
      var ws = s.workspaceId
        ? '<a href="/workspaces/' + encodeURIComponent(s.workspaceId) + '">'
          + escapePipelineHtml(s.workspaceName || s.workspaceId) + '</a>'
        : '<span class="text-muted">unassigned</span>';
      return '<div class="small mb-1"><span class="badge bg-light text-dark border me-2">'
        + escapePipelineHtml(s.stageName || 'Stage') + '</span>' + ws + '</div>';
    }).join('');
  }

  function renderPipelines() {
    var body = document.getElementById('pipelineTableBody');
    if (pipelineRows.length === 0) {
      body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">'
        + 'No deployment pipelines found in this tenant.</td></tr>';
      updateSelectionState();
      return;
    }

    body.innerHTML = pipelineRows.map(function(p) {
      // Delete is only offered when the principal is an Admin on the pipeline:
      // the delete endpoint has no tenant-admin equivalent, so anything else
      // would just produce a 403.
      var canDelete = p.access === 'granted';
      var id = escapePipelineHtml(p.id);
      var grantBtn = canDelete ? '' :
        '<button class="btn btn-sm btn-outline-primary me-1" onclick="grantAccess(&quot;' + id + '&quot;)">'
        + '<i class="bi bi-key me-1"></i>Grant access</button>';
      var deleteBtn = '<button class="btn btn-sm btn-outline-danger pipeline-delete-btn"'
        + ' onclick="confirmDeleteOne(&quot;' + id + '&quot;)"'
        + (canDelete ? '' : ' disabled title="The service principal must be an Admin on this pipeline to delete it."')
        + '><i class="bi bi-trash"></i></button>';

      return '<tr>'
        + '<td><input type="checkbox" class="form-check-input pipeline-select" value="' + id + '"'
          + (canDelete ? '' : ' disabled title="No access to this pipeline"')
          + ' onchange="updateSelectionState()"></td>'
        + '<td><div class="fw-semibold">' + escapePipelineHtml(p.name || p.id) + '</div>'
          + (p.description ? '<div class="text-muted small">' + escapePipelineHtml(p.description) + '</div>' : '')
          + '<div class="text-muted small font-monospace">' + id + '</div></td>'
        + '<td>' + stagesCell(p) + '</td>'
        + '<td>' + accessBadge(p) + '</td>'
        + '<td class="text-end">' + grantBtn + deleteBtn + '</td>'
        + '</tr>';
    }).join('');

    document.getElementById('selectAllPipelines').checked = false;
    updateSelectionState();
  }

  // ── Selection ──
  function selectedPipelineIds() {
    return Array.prototype.slice
      .call(document.querySelectorAll('.pipeline-select:checked'))
      .map(function(cb) { return cb.value; });
  }

  function toggleSelectAll(checked) {
    Array.prototype.slice.call(document.querySelectorAll('.pipeline-select:not([disabled])'))
      .forEach(function(cb) { cb.checked = checked; });
    updateSelectionState();
  }

  function updateSelectionState() {
    var count = selectedPipelineIds().length;
    document.getElementById('deleteSelectedBtn').disabled = count === 0;
    document.getElementById('selectionInfo').textContent = count > 0 ? count + ' selected' : '';
  }

  // ── Granting access ──
  function grantAccess(pipelineId) {
    fetch('/pipelines/grant', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pipelineId: pipelineId }),
    })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.requiresAdminAuth) {
          sessionStorage.setItem('pendingPipelineGrant', pipelineId);
          showAdminAuthPrompt(data.message || data.error, data.authUrl);
          return;
        }
        if (!data.success) {
          showPipelineErrors([{ name: pipelineId, error: data.error, status: data.status,
            statusTitle: data.statusTitle, explanation: data.explanation, hint: data.hint }],
            'The access grant failed.');
          return;
        }
        notify('Access granted. Refreshing...', 'success');
        loadPipelines();
      })
      .catch(function(err) { notify(err.message, 'error'); });
  }

  // After the Fabric admin sign-in round trip, finish the grant that triggered it.
  function retryPendingGrant() {
    var pending = sessionStorage.getItem('pendingPipelineGrant');
    if (!pending) return;
    sessionStorage.removeItem('pendingPipelineGrant');
    var target = pipelineRows.filter(function(p) { return p.id === pending; })[0];
    if (target && target.access !== 'granted') grantAccess(pending);
  }

  function showAdminAuthPrompt(message, authUrl) {
    document.getElementById('pipelineAdminAuthMessage').textContent = message
      || 'A Fabric administrator sign-in is required to grant this access.';
    var btn = document.getElementById('pipelineAdminAuthConfirmBtn');
    btn.onclick = function() { window.location.href = authUrl; };
    new bootstrap.Modal(document.getElementById('pipelineAdminAuthModal')).show();
  }

  // ── Deleting ──
  function confirmDeleteOne(pipelineId) {
    var target = pipelineRows.filter(function(p) { return p.id === pipelineId; })[0];
    if (target) openDeleteModal([target]);
  }

  function confirmDeleteSelected() {
    var ids = selectedPipelineIds();
    var targets = pipelineRows.filter(function(p) { return ids.indexOf(p.id) !== -1; });
    if (targets.length > 0) openDeleteModal(targets);
  }

  function openDeleteModal(targets) {
    pendingPipelineDeletion = targets.map(function(p) { return { id: p.id, name: p.name || p.id }; });
    document.getElementById('deletePipelineList').innerHTML = pendingPipelineDeletion
      .map(function(p) { return '<li>' + escapePipelineHtml(p.name) + '</li>'; }).join('');
    document.getElementById('deletePipelineConfirm').value = '';
    document.getElementById('deletePipelineConfirmBtn').disabled = true;
    new bootstrap.Modal(document.getElementById('deletePipelineModal')).show();
  }

  function onDeleteConfirmInput() {
    var value = document.getElementById('deletePipelineConfirm').value.trim();
    document.getElementById('deletePipelineConfirmBtn').disabled = value !== 'DELETE';
  }

  function performDelete() {
    var btn = document.getElementById('deletePipelineConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...';

    fetch('/pipelines/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pipelines: pendingPipelineDeletion }),
    })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        btn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
        var modal = bootstrap.Modal.getInstance(document.getElementById('deletePipelineModal'));
        if (modal) modal.hide();

        if (data.error) {
          showPipelineErrors([{ name: 'Request', error: data.error, status: data.status,
            statusTitle: data.statusTitle, explanation: data.explanation, hint: data.hint }],
            'The deletion request failed.');
          return;
        }
        var failures = (data.results || []).filter(function(r) { return !r.success; });
        if (failures.length > 0) {
          showPipelineErrors(failures, data.deleted + ' deleted, ' + failures.length + ' failed.');
        } else {
          notify(data.deleted + ' pipeline(s) deleted.', 'success');
        }
        loadPipelines();
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
        notify(err.message, 'error');
      });
  }

  // ── Error explanations ──
  function showPipelineErrors(failures, summary) {
    var html = summary ? '<p class="mb-3">' + escapePipelineHtml(summary) + '</p>' : '';
    html += (failures || []).map(function(f) {
      var parts = '<div class="border rounded p-2 mb-2">';
      parts += '<div class="fw-semibold">' + escapePipelineHtml(f.name || f.id || 'Pipeline') + '</div>';
      if (f.status) {
        parts += '<div class="small text-danger">' + escapePipelineHtml(f.status)
          + (f.statusTitle ? ' ' + escapePipelineHtml(f.statusTitle) : '') + '</div>';
      }
      if (f.explanation) parts += '<div class="small mt-1">' + escapePipelineHtml(f.explanation) + '</div>';
      if (f.hint) parts += '<div class="small text-muted mt-1"><i class="bi bi-lightbulb me-1"></i>'
        + escapePipelineHtml(f.hint) + '</div>';
      if (f.error) parts += '<div class="small text-muted mt-1 font-monospace">' + escapePipelineHtml(f.error) + '</div>';
      return parts + '</div>';
    }).join('');
    document.getElementById('pipelineErrorBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('pipelineErrorModal')).show();
  }

  document.addEventListener('DOMContentLoaded', loadPipelines);
  </script>
<% } %>

<%- include('../partials/footer') %>
