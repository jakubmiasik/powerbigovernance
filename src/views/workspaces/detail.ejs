<%- include('../partials/header') %>
<%
  // Helper to get creator display name - handles both raw API (creatorPrincipal) and saved analysis (creator) formats
  function getCreator(item) {
    if (item.creatorPrincipal) {
      return item.creatorPrincipal.displayName || (item.creatorPrincipal.userDetails && item.creatorPrincipal.userDetails.userPrincipalName) || '-';
    }
    if (item.creator) {
      if (typeof item.creator === 'string') return item.creator;
      return item.creator.name || item.creator.upn || '-';
    }
    return '-';
  }
  // Helper to get last updated date - handles both raw API and saved analysis formats
  function getLastUpdated(item) {
    var d = item.lastUpdatedDate || item.lastUpdated;
    if (!d) return '-';
    try { return new Date(d).toLocaleString(); } catch(e) { return d; }
  }

  // Helper to get Fabric SVG icon path for artifact type
  function getTypeIcon(type) {
    var t = (type || '').toLowerCase();
    var iconMap = {
      'report': 'report_20_item.svg',
      'paginatedreport': 'paginated_report_20_item.svg',
      'semanticmodel': 'semantic_model_20_item.svg',
      'dataset': 'semantic_model_20_item.svg',
      'dashboard': 'dashboard_20_item.svg',
      'dataflow': 'dataflow_20_item.svg',
      'dataflowgen2': 'dataflow_gen2_20_item.svg',
      'datagen2': 'dataflow_gen2_20_item.svg',
      'lakehouse': 'lakehouse_20_item.svg',
      'notebook': 'notebook_20_item.svg',
      'datapipeline': 'pipeline_20_item.svg',
      'pipeline': 'pipeline_20_item.svg',
      'warehouse': 'data_warehouse_20_item.svg',
      'sqldatabase': 'sql_database_20_item.svg',
      'kqldatabase': 'kql_database_20_item.svg',
      'kqlqueryset': 'kql_queryset_20_item.svg',
      'eventstream': 'eventstream_20_item.svg',
      'environment': 'environment_20_item.svg',
      'sparkjobdefinition': 'spark_job_direction_20_item.svg',
      'app': 'apps_20_item.svg',
      'mobilereport': 'mobile_report_20_item.svg',
      'activator': 'activator_20_item.svg',
      'reflex': 'activator_20_item.svg',
      'variablelibrary': 'variable_library_item.svg',
      'mlexperiment': 'experimentsitem.svg',
      'mlmodel': 'modelitem.svg',
      'copyjob': 'copyjobitem.svg',
      'eventhouse': 'event_houseitem.svg',
      'kqldashboard': 'dashboard_20_item.svg',
      'sqlendpoint': 'endpointregular.svg',
      'sqlaccesspolicy': 'endpointregular.svg',
      'dataagent': 'data_agent_item.svg',
    };
    return iconMap[t] || null;
  }

  var summaryCards = [
    { key: 'total', label: 'Total Items', count: items.length, color: 'dark', icon: 'collection', always: true },
    { key: 'reports', label: 'Reports', count: reports.length, color: 'primary', icon: 'file-earmark-bar-graph' },
    { key: 'datasets', label: 'Semantic Models', count: datasets.length, color: 'success', icon: 'database' },
    { key: 'dashboards', label: 'Dashboards', count: dashboards.length, color: 'info', icon: 'grid-1x2' },
    { key: 'dataflows', label: 'Dataflows', count: dataflows.length, color: 'warning', icon: 'diagram-3' },
    { key: 'lakehouses', label: 'Lakehouses', count: lakehouses.length, color: 'secondary', icon: 'boxes' },
    { key: 'notebooks', label: 'Notebooks', count: notebooks.length, color: 'secondary', icon: 'journal-code' },
    { key: 'pipelines', label: 'Pipelines', count: pipelines.length, color: 'secondary', icon: 'arrow-left-right' },
    { key: 'warehouses', label: 'Warehouses', count: warehouses.length, color: 'secondary', icon: 'building' },
    { key: 'others', label: 'Other', count: others.length, color: 'secondary', icon: 'question-circle' },
    { key: 'users', label: 'Users', count: users.length, color: 'secondary', icon: 'people', always: true }
  ].filter(function(card) { return card.always || card.count > 0; });
  var hasFabricItems = dataflows.length + lakehouses.length + notebooks.length + pipelines.length + warehouses.length + others.length > 0;
  var workspaceName = workspace.name || 'Workspace Details';
%>
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/workspaces">Workspaces</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= workspaceName %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-folder2-open me-2"></i><%= workspaceName %></h2>
    <% var detailRun = typeof sourceRun !== 'undefined' ? sourceRun : null; %>
    <% if (detailRun) { %>
      <p class="text-muted small mb-1">
        <i class="bi bi-clock-history me-1"></i>From analysis run
        <a href="/analysis/results/<%= detailRun.id %>">#<%= detailRun.id %></a>
        <% if (detailRun.started_at) { %> — <%= new Date(detailRun.started_at).toLocaleString() %><% } %>
      </p>
    <% } %>
    <p class="text-muted small mb-0">
      ID: <code><%= workspace.id %></code>
      <% if (workspace.licenseType) { var licColor = workspace.licenseType === 'Fabric' ? 'success' : workspace.licenseType === 'Premium' ? 'warning' : workspace.licenseType === 'Premium Per User' ? 'info' : 'secondary'; %>
        &bull; License: <span class="badge bg-<%= licColor %>"><%= workspace.licenseType %></span>
        <% if (workspace.capacitySku) { %> (<code><%= workspace.capacitySku %></code>)<% } %>
      <% } %>
      <% if (workspace.capacityId) { %>
        &bull; Capacity: <code><%= workspace.capacityId %></code>
      <% } %>
      <% if (workspace.state) { %>
        &bull; State: <span class="badge bg-<%= workspace.state === 'Active' ? 'success' : 'warning' %>"><%= workspace.state %></span>
      <% } %>
    </p>
  </div>
  <a href="/workspaces" class="btn btn-outline-secondary" onclick="goBackOr('/workspaces'); return false;"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-3 mb-4">
  <% summaryCards.forEach(function(card) { %>
    <div class="col-sm-6 col-md-4 col-xl-2">
      <div class="card h-100">
        <div class="card-body text-center py-3">
          <div class="text-<%= card.color %> mb-2"><i class="bi bi-<%= card.icon %>"></i></div>
          <div class="fs-4 fw-bold text-<%= card.color %>"><%= card.count %></div>
          <div class="text-muted small"><%= card.label %></div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<!-- Storage Size Card -->
<%
  // Check if storage data is available from analysis
  var wsStorageSize = workspace.storageSize || 0;
  var wsStorageFiles = workspace.storageFiles || 0;
  var wsStorageItems = workspace.storageItems || {};
  var hasStorageData = wsStorageSize > 0;

  function formatBytesWs(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 2 : 0) + ' ' + units[i];
  }
%>
<div class="card mb-4" id="storageCard">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-hdd me-1"></i>OneLake Storage<% if (hasStorageData) { %> — <strong><%= formatBytesWs(wsStorageSize) %></strong><% } %></span>
    <button class="btn btn-sm btn-outline-primary" onclick="calculateStorage()" id="calcStorageBtn"><i class="bi bi-arrow-clockwise me-1"></i><%= hasStorageData ? 'Recalculate' : 'Calculate Storage' %></button>
  </div>
  <div class="card-body py-3" id="storageCardBody">
    <% if (hasStorageData) { %>
      <div id="storagePlaceholder" class="d-none"></div>
      <div class="d-none" id="storageLoading">
        <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-primary"></div><span class="ms-2">Scanning OneLake storage...</span></div>
      </div>
      <div class="d-none" id="storageError"><div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-1"></i><span id="storageErrorMsg"></span></div></div>
      <div id="storageResults">
        <div class="row g-3 text-center mb-3">
          <div class="col-sm-4">
            <div class="fs-4 fw-bold text-primary" id="storageTotalSize"><%= formatBytesWs(wsStorageSize) %></div>
            <div class="text-muted small">Total Storage</div>
          </div>
          <div class="col-sm-4">
            <div class="fs-4 fw-bold text-success" id="storageTotalFiles"><%= wsStorageFiles.toLocaleString() %></div>
            <div class="text-muted small">Total Files</div>
          </div>
          <div class="col-sm-4">
            <div class="fs-4 fw-bold text-info" id="storageItemCount"><%= Object.keys(wsStorageItems).length %></div>
            <div class="text-muted small">Items with Data</div>
          </div>
        </div>
        <div class="table-responsive" style="max-height: 300px;">
          <table class="table table-sm table-hover mb-0">
            <thead><tr><th>Item</th><th>Type</th><th>Files</th><th>Size</th></tr></thead>
            <tbody id="storageItemsBody">
              <% Object.entries(wsStorageItems).sort(function(a,b){ return (b[1].size||0) - (a[1].size||0); }).forEach(function(entry) { var item = entry[1]; %>
                <tr>
                  <td><%= item.name || entry[0] %></td>
                  <td><span class="badge bg-secondary"><%= item.type || '-' %></span></td>
                  <td><%= (item.files || 0).toLocaleString() %></td>
                  <td class="fw-bold"><%= formatBytesWs(item.size || 0) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="text-muted text-center" id="storagePlaceholder">
        <i class="bi bi-hdd fs-3"></i>
        <p class="mt-1 mb-0 small">Click <strong>Calculate Storage</strong> to scan OneLake and compute item sizes, or run a new analysis to include storage data.<br>
        <span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>This operation reads from OneLake and may consume capacity units.</span></p>
      </div>
      <div class="d-none" id="storageLoading">
        <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-primary"></div><span class="ms-2">Scanning OneLake storage... This may take a while for large workspaces.</span></div>
      </div>
      <div class="d-none" id="storageError"><div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-1"></i><span id="storageErrorMsg"></span></div></div>
      <div class="d-none" id="storageResults">
        <div class="row g-3 text-center mb-3">
          <div class="col-sm-4">
            <div class="fs-4 fw-bold text-primary" id="storageTotalSize">-</div>
            <div class="text-muted small">Total Storage</div>
          </div>
          <div class="col-sm-4">
            <div class="fs-4 fw-bold text-success" id="storageTotalFiles">-</div>
            <div class="text-muted small">Total Files</div>
          </div>
          <div class="col-sm-4">
            <div class="fs-4 fw-bold text-info" id="storageItemCount">-</div>
            <div class="text-muted small">Items with Data</div>
          </div>
        </div>
        <div class="table-responsive" style="max-height: 300px;">
          <table class="table table-sm table-hover mb-0">
            <thead><tr><th>Item</th><th>Type</th><th>Files</th><th>Size</th></tr></thead>
            <tbody id="storageItemsBody"></tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<ul class="nav nav-tabs" role="tablist">
  <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-all" type="button">All Items (<%= items.length %>)</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reports" type="button">Reports (<%= reports.length %>)</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-datasets" type="button">Semantic Models (<%= datasets.length %>)</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-dashboards" type="button">Dashboards (<%= dashboards.length %>)</button></li>
  <% if (hasFabricItems) { %>
    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-fabric" type="button">Fabric Items</button></li>
  <% } %>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-users" type="button">Users (<%= users.length %>)</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-security" type="button"><i class="bi bi-shield-lock me-1"></i>Security</button></li>
</ul>

<div class="tab-content mt-3">
  <div class="tab-pane fade show active" id="tab-all" role="tabpanel">
    <% if (!items.length) { %>
      <p class="text-muted">No items in this workspace.</p>
    <% } else { %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>All Items</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter items..." oninput="filterTable(this, 'all-items-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0" id="all-items-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>State</th>
                <th>Creator</th>
                <th>Last Updated</th>
                <th style="width:80px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function(item) { var name = item.name || item.displayName || 'Unnamed'; var creator = getCreator(item); %>
                <tr data-filter="<%= [name, item.type || '', item.state || '', creator, item.description || ''].join(' ').toLowerCase() %>">
                  <td><strong><%= name %></strong></td>
                  <td><% var typeIcon = getTypeIcon(item.type); %><% if (typeIcon) { %><img src="/img/icons/<%= typeIcon %>" width="18" height="18" class="me-1" alt=""><% } %><span class="badge item-type-badge" data-type="<%= item.type || '' %>"><%= item.type || '-' %></span></td>
                  <td><%= item.state || '-' %></td>
                  <td><%= creator %></td>
                  <td><small><%= getLastUpdated(item) %></small></td>
                  <td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" onclick="showItemDetails('<%= workspace.id %>', '<%= item.id %>', '<%= (item.name || item.displayName || 'Unnamed').replace(/'/g, "\\'") %>', '<%= item.type || '' %>')" title="View details"><i class="bi bi-info-circle"></i></button><button class="btn btn-sm btn-outline-primary p-0 px-1" onclick="showLineage('<%= item.id %>', '<%= (item.name || item.displayName || 'Unnamed').replace(/'/g, "\\'") %>', '<%= item.type || '' %>')" title="View lineage"><i class="bi bi-diagram-3"></i></button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <div class="tab-pane fade" id="tab-reports" role="tabpanel">
    <% if (!reports.length) { %>
      <p class="text-muted">No reports in this workspace.</p>
    <% } else { %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>Reports</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter reports..." oninput="filterTable(this, 'reports-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0" id="reports-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Creator</th>
                <th>Last Updated</th>
                <th>Description</th>
                <th style="width:80px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% reports.forEach(function(report) { var creator = getCreator(report); %>
                <tr data-filter="<%= [report.name || '', report.type || '', creator, report.description || ''].join(' ').toLowerCase() %>">
                  <td><i class="bi bi-file-earmark-bar-graph text-primary me-1"></i><strong><%= report.name || 'Unnamed' %></strong></td>
                  <td><span class="badge item-type-badge" data-type="<%= report.type || 'Report' %>"><%= report.type || 'Report' %></span></td>
                  <td><%= creator %></td>
                  <td><small><%= getLastUpdated(report) %></small></td>
                  <td class="text-muted small"><%= report.description || '-' %></td>
                  <td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" onclick="showItemDetails('<%= workspace.id %>', '<%= report.id %>', '<%= (report.name || 'Unnamed').replace(/'/g, "\\'") %>', 'Report')" title="View details"><i class="bi bi-info-circle"></i></button><button class="btn btn-sm btn-outline-primary p-0 px-1" onclick="showLineage('<%= report.id %>', '<%= (report.name || 'Unnamed').replace(/'/g, "\\'") %>', 'Report')" title="View lineage"><i class="bi bi-diagram-3"></i></button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <div class="tab-pane fade" id="tab-datasets" role="tabpanel">
    <% if (!datasets.length) { %>
      <p class="text-muted">No semantic models in this workspace.</p>
    <% } else { %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>Semantic Models</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter semantic models..." oninput="filterTable(this, 'datasets-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0" id="datasets-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Creator</th>
                <th>Last Updated</th>
                <th>Description</th>
                <th>Details</th>
                <th style="width:80px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% datasets.forEach(function(dataset) { var creator = getCreator(dataset); %>
                <tr data-filter="<%= [dataset.name || '', creator, dataset.description || '', dataset.type || ''].join(' ').toLowerCase() %>">
                  <td><i class="bi bi-database text-success me-1"></i><strong><%= dataset.name || 'Unnamed' %></strong></td>
                  <td><%= creator %></td>
                  <td><small><%= getLastUpdated(dataset) %></small></td>
                  <td class="text-muted small"><%= dataset.description || '-' %></td>
                  <td><a href="/workspaces/<%= workspace.id %>/datasets/<%= dataset.id %>" class="btn btn-sm btn-outline-success"><i class="bi bi-search"></i></a></td>
                  <td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" onclick="showItemDetails('<%= workspace.id %>', '<%= dataset.id %>', '<%= (dataset.name || 'Unnamed').replace(/'/g, "\\'") %>', 'SemanticModel')" title="View details"><i class="bi bi-info-circle"></i></button><button class="btn btn-sm btn-outline-primary p-0 px-1" onclick="showLineage('<%= dataset.id %>', '<%= (dataset.name || 'Unnamed').replace(/'/g, "\\'") %>', 'SemanticModel')" title="View lineage"><i class="bi bi-diagram-3"></i></button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <div class="tab-pane fade" id="tab-dashboards" role="tabpanel">
    <% if (!dashboards.length) { %>
      <p class="text-muted">No dashboards in this workspace.</p>
    <% } else { %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>Dashboards</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter dashboards..." oninput="filterTable(this, 'dashboards-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0" id="dashboards-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Creator</th>
                <th>Last Updated</th>
                <th>Tiles</th>
                <th style="width:80px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% dashboards.forEach(function(dashboard) { var creator = getCreator(dashboard); %>
                <tr data-filter="<%= [dashboard.name || dashboard.displayName || '', creator, dashboard.type || 'Dashboard'].join(' ').toLowerCase() %>">
                  <td><i class="bi bi-grid-1x2 text-info me-1"></i><strong><%= dashboard.name || dashboard.displayName || 'Unnamed' %></strong></td>
                  <td><%= creator %></td>
                  <td><small><%= getLastUpdated(dashboard) %></small></td>
                  <td><a href="/workspaces/<%= workspace.id %>/dashboards/<%= dashboard.id %>" class="btn btn-sm btn-outline-info"><i class="bi bi-search"></i></a></td>
                  <td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" onclick="showItemDetails('<%= workspace.id %>', '<%= dashboard.id %>', '<%= (dashboard.name || dashboard.displayName || 'Unnamed').replace(/'/g, "\\'") %>', 'Dashboard')" title="View details"><i class="bi bi-info-circle"></i></button><button class="btn btn-sm btn-outline-primary p-0 px-1" onclick="showLineage('<%= dashboard.id %>', '<%= (dashboard.name || dashboard.displayName || 'Unnamed').replace(/'/g, "\\'") %>', 'Dashboard')" title="View lineage"><i class="bi bi-diagram-3"></i></button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <% if (hasFabricItems) { %>
    <div class="tab-pane fade" id="tab-fabric" role="tabpanel">
      <% [
        { key: 'dataflows', label: 'Dataflows', icon: 'diagram-3', items: dataflows },
        { key: 'lakehouses', label: 'Lakehouses', icon: 'boxes', items: lakehouses },
        { key: 'notebooks', label: 'Notebooks', icon: 'journal-code', items: notebooks },
        { key: 'pipelines', label: 'Data Pipelines', icon: 'arrow-left-right', items: pipelines },
        { key: 'warehouses', label: 'Warehouses', icon: 'building', items: warehouses },
        { key: 'others', label: 'Other', icon: 'question-circle', items: others }
      ].forEach(function(group) { %>
        <% if (group.items.length) { %>
          <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span><i class="bi bi-<%= group.icon %> me-1"></i><%= group.label %> (<%= group.items.length %>)</span>
              <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter <%= group.label.toLowerCase() %>..." oninput="filterTable(this, '<%= group.key %>-table')">
            </div>
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0" id="<%= group.key %>-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Creator</th>
                    <th>Last Updated</th>
                    <th style="width:80px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% group.items.forEach(function(item) { var creator = getCreator(item); %>
                    <tr data-filter="<%= [item.name || '', item.type || '', creator, item.description || ''].join(' ').toLowerCase() %>">
                      <td><strong><%= item.name || 'Unnamed' %></strong></td>
                      <td><% var fTypeIcon = getTypeIcon(item.type); %><% if (fTypeIcon) { %><img src="/img/icons/<%= fTypeIcon %>" width="18" height="18" class="me-1" alt=""><% } %><span class="badge item-type-badge" data-type="<%= item.type || '' %>"><%= item.type || '-' %></span></td>
                      <td><%= creator %></td>
                      <td><small><%= getLastUpdated(item) %></small></td>
                      <td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" onclick="showItemDetails('<%= workspace.id %>', '<%= item.id %>', '<%= (item.name || 'Unnamed').replace(/'/g, "\\'") %>', '<%= item.type || '' %>')" title="View details"><i class="bi bi-info-circle"></i></button><button class="btn btn-sm btn-outline-primary p-0 px-1" onclick="showLineage('<%= item.id %>', '<%= (item.name || 'Unnamed').replace(/'/g, "\\'") %>', '<%= item.type || '' %>')" title="View lineage"><i class="bi bi-diagram-3"></i></button></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>

  <div class="tab-pane fade" id="tab-users" role="tabpanel">
    <% if (!users.length) { %>
      <p class="text-muted">No users found for this workspace.</p>
    <% } else { %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>Workspace Users (<%= users.length %>)</span>
          <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter users..." oninput="filterTable(this, 'workspace-users-table')">
        </div>
        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0" id="workspace-users-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email / UPN</th>
                <th>Principal Type</th>
                <th>Access Level</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { var uName = u.displayName || u.name || u.identifier || 'Unknown'; var uEmail = u.emailAddress || u.email || u.identifier || '-'; var uType = u.principalType || u.type || '-'; var uAccess = u.groupUserAccessRight || u.role || '-'; %>
                <tr data-filter="<%= [uName, uEmail, uType, uAccess].join(' ').toLowerCase() %>">
                  <td>
                    <i class="bi bi-<%= uType === 'Group' ? 'people-fill' : uType === 'App' || uType === 'ServicePrincipal' ? 'gear-fill' : 'person-fill' %> me-1"></i>
                    <%= uName %>
                  </td>
                  <td><%= uEmail %></td>
                  <td><span class="badge bg-<%= uType === 'Group' ? 'info' : uType === 'App' || uType === 'ServicePrincipal' ? 'dark' : 'secondary' %>"><%= uType %></span></td>
                  <td>
                    <span class="badge bg-<%= uAccess === 'Admin' ? 'danger' : uAccess === 'Member' ? 'primary' : uAccess === 'Contributor' ? 'success' : uAccess === 'Viewer' ? 'warning' : 'secondary' %>"><%= uAccess %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <div class="tab-pane fade" id="tab-security" role="tabpanel">
    <%
      var secUsers = [], secGroups = [], secApps = [];
      users.forEach(function(u) {
        var uType = (u.principalType || u.type || '').toLowerCase();
        if (uType === 'group') secGroups.push(u);
        else if (uType === 'app' || uType === 'serviceprincipal' || uType === 'service') secApps.push(u);
        else secUsers.push(u);
      });
    %>
    <div class="row g-3 mb-3">
      <div class="col-sm-4">
        <div class="card text-center stat-card">
          <div class="card-body py-3">
            <i class="bi bi-person-fill text-primary fs-4"></i>
            <div class="fs-4 fw-bold text-primary"><%= secUsers.length %></div>
            <div class="text-muted small">Individual Accounts</div>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="card text-center stat-card">
          <div class="card-body py-3">
            <i class="bi bi-people-fill text-info fs-4"></i>
            <div class="fs-4 fw-bold text-info"><%= secGroups.length %></div>
            <div class="text-muted small">Security Groups</div>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="card text-center stat-card">
          <div class="card-body py-3">
            <i class="bi bi-gear-fill text-dark fs-4"></i>
            <div class="fs-4 fw-bold"><%= secApps.length %></div>
            <div class="text-muted small">Service Principals / Apps</div>
          </div>
        </div>
      </div>
    </div>

    <% var secAccessCounts = {}; users.forEach(function(u) { var a = u.groupUserAccessRight || u.role || 'Unknown'; secAccessCounts[a] = (secAccessCounts[a] || 0) + 1; }); %>
    <div class="row g-3 mb-3">
      <% Object.keys(secAccessCounts).forEach(function(role) { %>
        <div class="col-sm-3">
          <div class="card text-center">
            <div class="card-body py-2">
              <div class="fw-bold"><%= secAccessCounts[role] %></div>
              <div class="small"><span class="badge bg-<%= role === 'Admin' ? 'danger' : role === 'Member' ? 'primary' : role === 'Contributor' ? 'success' : role === 'Viewer' ? 'warning' : 'secondary' %>"><%= role %></span></div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Role Management Section -->
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield-lock me-1"></i>Manage Role Assignments</span>
        <div>
          <button class="btn btn-sm btn-outline-primary me-1" onclick="loadFabricRoles()"><i class="bi bi-arrow-clockwise me-1"></i>Refresh from Fabric API</button>
          <button class="btn btn-sm btn-primary" onclick="showAddRoleModal()"><i class="bi bi-person-plus me-1"></i>Add Assignment</button>
        </div>
      </div>
      <div id="fabricRolesSection">
        <div class="text-center py-3 text-muted" id="fabricRolesPlaceholder">
          <i class="bi bi-arrow-down-circle fs-4"></i>
          <p class="mt-1 mb-0 small">Click <strong>Refresh from Fabric API</strong> to load current role assignments</p>
        </div>
        <div class="d-none" id="fabricRolesLoading">
          <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div><span class="ms-2">Loading role assignments...</span></div>
        </div>
        <div class="d-none" id="fabricRolesError">
          <div class="alert alert-warning m-3 mb-0"><i class="bi bi-exclamation-triangle me-1"></i><span id="fabricRolesErrorMsg"></span></div>
        </div>
        <div class="table-responsive d-none" id="fabricRolesTable">
          <table class="table table-hover table-sm mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Detail</th>
                <th>Role</th>
                <th style="width: 120px;">Actions</th>
              </tr>
            </thead>
            <tbody id="fabricRolesBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <% [
      { label: 'Individual Accounts', icon: 'person-fill', color: 'primary', list: secUsers },
      { label: 'Security Groups', icon: 'people-fill', color: 'info', list: secGroups },
      { label: 'Service Principals / Apps', icon: 'gear-fill', color: 'dark', list: secApps }
    ].forEach(function(section) { %>
      <% if (section.list.length) { %>
        <div class="card mb-3">
          <div class="card-header section-toggle d-flex justify-content-between align-items-center flex-wrap gap-2" data-bs-toggle="collapse" data-bs-target="#sec-<%= section.label.toLowerCase().replace(/[^a-z]/g, '') %>-body">
            <span><i class="bi bi-<%= section.icon %> text-<%= section.color %> me-1"></i><%= section.label %> (<%= section.list.length %>) <small class="text-muted">(from saved analysis)</small></span>
            <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter..." oninput="filterTable(this, 'sec-<%= section.label.toLowerCase().replace(/[^a-z]/g, '') %>-table')" onclick="event.stopPropagation()">
          </div>
          <div class="collapse show" id="sec-<%= section.label.toLowerCase().replace(/[^a-z]/g, '') %>-body">
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0" id="sec-<%= section.label.toLowerCase().replace(/[^a-z]/g, '') %>-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email / Identifier</th>
                    <th>Access Level</th>
                  </tr>
                </thead>
                <tbody>
                  <% section.list.forEach(function(u) { var uName = u.displayName || u.name || u.identifier || 'Unknown'; var uEmail = u.emailAddress || u.email || u.identifier || '-'; var uAccess = u.groupUserAccessRight || u.role || '-'; %>
                    <tr data-filter="<%= [uName, uEmail, uAccess].join(' ').toLowerCase() %>">
                      <td><i class="bi bi-<%= section.icon %> text-<%= section.color %> me-1"></i><%= uName %></td>
                      <td><%= uEmail %></td>
                      <td><span class="badge bg-<%= uAccess === 'Admin' ? 'danger' : uAccess === 'Member' ? 'primary' : uAccess === 'Contributor' ? 'success' : uAccess === 'Viewer' ? 'warning' : 'secondary' %>"><%= uAccess %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    <% }) %>

    <% if (!users.length) { %>
      <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No security information available from saved analysis. Click <strong>Refresh from Fabric API</strong> to load live data.</div>
    <% } %>
  </div>

<!-- Add Role Assignment Modal -->
<div class="modal fade" id="addRoleModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add Role Assignment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Principal Type</label>
          <select class="form-select" id="addRolePrincipalType" onchange="clearEntraSearch()">
            <option value="User">User</option>
            <option value="ServicePrincipal">Service Principal</option>
            <option value="Group">Group</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Search Entra ID</label>
          <input type="text" class="form-control" id="addRoleSearch" placeholder="Start typing to search..." oninput="debouncedEntraSearch(this.value)">
          <div id="entraSearchResults" class="list-group mt-1" style="max-height:200px; overflow-y:auto;"></div>
          <div id="entraSearchError" class="text-danger small mt-1 d-none"></div>
        </div>
        <div class="mb-3 d-none" id="selectedPrincipalCard">
          <label class="form-label">Selected</label>
          <div class="card">
            <div class="card-body py-2 d-flex justify-content-between align-items-center">
              <div>
                <strong id="selectedPrincipalName"></strong>
                <div class="text-muted small" id="selectedPrincipalDetail"></div>
              </div>
              <button class="btn btn-sm btn-outline-danger" onclick="clearSelectedPrincipal()"><i class="bi bi-x"></i></button>
            </div>
          </div>
          <input type="hidden" id="selectedPrincipalId">
        </div>
        <div class="mb-3">
          <label class="form-label">Role</label>
          <select class="form-select" id="addRoleRole">
            <option value="Viewer">Viewer</option>
            <option value="Contributor">Contributor</option>
            <option value="Member">Member</option>
            <option value="Admin">Admin</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" id="addRoleSubmitBtn" onclick="submitAddRole()"><i class="bi bi-plus-circle me-1"></i>Add</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Update Role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Updating role for: <strong id="editRoleName"></strong></p>
        <input type="hidden" id="editRoleAssignmentId">
        <select class="form-select" id="editRoleSelect">
          <option value="Viewer">Viewer</option>
          <option value="Contributor">Contributor</option>
          <option value="Member">Member</option>
          <option value="Admin">Admin</option>
        </select>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" onclick="submitUpdateRole()">Update</button>
      </div>
    </div>
  </div>
</div>

<!-- Status Modal (for role operations) -->
<div class="modal fade" id="roleStatusModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content text-center">
      <div class="modal-body py-4">
        <div class="spinner-border text-primary mb-2" id="roleStatusSpinner"></div>
        <div id="roleStatusIcon" class="d-none fs-1 mb-2"></div>
        <p id="roleStatusMsg" class="mb-0">Processing...</p>
      </div>
    </div>
  </div>
</div>
</div><!-- end tab-content -->

<script>
function getTypeBadge(type) {
  var normalized = (type || '').toLowerCase();
  if (normalized === 'report' || normalized === 'paginatedreport') return 'primary';
  if (normalized === 'semanticmodel' || normalized === 'dataset') return 'success';
  if (normalized === 'dashboard') return 'info';
  if (normalized.indexOf('dataflow') !== -1 || normalized === 'datagen2') return 'warning';
  if (normalized === 'lakehouse' || normalized === 'notebook' || normalized === 'datapipeline' || normalized === 'warehouse' || normalized === 'sqldatabase') return 'secondary';
  return 'dark';
}

document.querySelectorAll('.item-type-badge').forEach(function(badge) {
  badge.classList.add('bg-' + getTypeBadge(badge.getAttribute('data-type')));
});
</script>

<!-- Role Management JS -->
<script>
var '<%= workspace.id %>' = '<%= workspace.id %>';
var currentRoles = [];

function roleBadgeColor(role) {
  return role === 'Admin' ? 'danger' : role === 'Member' ? 'primary' : role === 'Contributor' ? 'success' : role === 'Viewer' ? 'warning' : 'secondary';
}

function principalIcon(type) {
  var t = (type || '').toLowerCase();
  if (t === 'user') return 'person-fill';
  if (t === 'group') return 'people-fill';
  if (t === 'serviceprincipal') return 'gear-fill';
  return 'question-circle';
}

function principalDetail(p) {
  if (p.userDetails && p.userDetails.userPrincipalName) return p.userDetails.userPrincipalName;
  if (p.servicePrincipalDetails && p.servicePrincipalDetails.aadAppId) return 'App: ' + p.servicePrincipalDetails.aadAppId;
  return p.id;
}

async function loadFabricRoles() {
  document.getElementById('fabricRolesPlaceholder').classList.add('d-none');
  document.getElementById('fabricRolesLoading').classList.remove('d-none');
  document.getElementById('fabricRolesError').classList.add('d-none');
  document.getElementById('fabricRolesTable').classList.add('d-none');

  try {
    var resp = await fetch('/workspaces/' + '<%= workspace.id %>' + '/roles');
    var data = await resp.json();
    document.getElementById('fabricRolesLoading').classList.add('d-none');
    if (!data.success) {
      document.getElementById('fabricRolesError').classList.remove('d-none');
      document.getElementById('fabricRolesErrorMsg').textContent = data.message || 'Failed to load roles.';
      if (data.message && data.message.indexOf('Graph') !== -1) {
        document.getElementById('fabricRolesErrorMsg').textContent += ' — Ensure the SP has User.Read.All and Application.Read.All permissions in Entra ID.';
      }
      return;
    }
    currentRoles = data.roles;
    renderRolesTable(currentRoles);
  } catch (e) {
    document.getElementById('fabricRolesLoading').classList.add('d-none');
    document.getElementById('fabricRolesError').classList.remove('d-none');
    document.getElementById('fabricRolesErrorMsg').textContent = e.message;
  }
}

function renderRolesTable(roles) {
  var tbody = document.getElementById('fabricRolesBody');
  tbody.innerHTML = '';
  if (!roles.length) {
    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No role assignments found</td></tr>';
  }
  roles.forEach(function(r) {
    var p = r.principal || {};
    var name = p.displayName || 'Unknown';
    var type = p.type || '-';
    var detail = principalDetail(p);
    var role = r.role || '-';
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><i class="bi bi-' + principalIcon(type) + ' me-1"></i>' + escapeHtml(name) + '</td>' +
      '<td><span class="badge bg-secondary">' + escapeHtml(type) + '</span></td>' +
      '<td class="text-muted small">' + escapeHtml(detail) + '</td>' +
      '<td><span class="badge bg-' + roleBadgeColor(role) + '">' + role + '</span></td>' +
      '<td>' +
        '<button class="btn btn-sm btn-outline-primary me-1" title="Edit Role" onclick="showEditRoleModal(\'' + r.id + '\',\'' + escapeHtml(name) + '\',\'' + role + '\')"><i class="bi bi-pencil"></i></button>' +
        '<button class="btn btn-sm btn-outline-danger" title="Remove" onclick="confirmDeleteRole(\'' + r.id + '\',\'' + escapeHtml(name) + '\')"><i class="bi bi-trash"></i></button>' +
      '</td>';
    tbody.appendChild(tr);
  });
  document.getElementById('fabricRolesTable').classList.remove('d-none');
}

function escapeHtml(s) {
  var div = document.createElement('div');
  div.textContent = s || '';
  return div.innerHTML;
}

// ── Add Role ──
function showAddRoleModal() {
  clearEntraSearch();
  clearSelectedPrincipal();
  document.getElementById('addRoleSearch').value = '';
  document.getElementById('addRolePrincipalType').value = 'User';
  document.getElementById('addRoleRole').value = 'Viewer';
  new bootstrap.Modal(document.getElementById('addRoleModal')).show();
}

var entraSearchTimer = null;
function debouncedEntraSearch(query) {
  clearTimeout(entraSearchTimer);
  entraSearchTimer = setTimeout(function() { searchEntra(query); }, 350);
}

function clearEntraSearch() {
  document.getElementById('entraSearchResults').innerHTML = '';
  document.getElementById('entraSearchError').classList.add('d-none');
}

async function searchEntra(query) {
  if (!query || query.length < 2) { clearEntraSearch(); return; }
  var type = document.getElementById('addRolePrincipalType').value;
  var resultsEl = document.getElementById('entraSearchResults');
  var errorEl = document.getElementById('entraSearchError');
  errorEl.classList.add('d-none');
  resultsEl.innerHTML = '<div class="list-group-item text-center py-2"><div class="spinner-border spinner-border-sm text-primary"></div></div>';

  try {
    var resp = await fetch('/workspaces/' + '<%= workspace.id %>' + '/entra/search?q=' + encodeURIComponent(query) + '&type=' + type);
    var data = await resp.json();
    if (!data.success) {
      resultsEl.innerHTML = '';
      errorEl.classList.remove('d-none');
      errorEl.textContent = data.message;
      return;
    }
    if (!data.results.length) {
      resultsEl.innerHTML = '<div class="list-group-item text-muted">No results found</div>';
      return;
    }
    resultsEl.innerHTML = '';
    data.results.forEach(function(r) {
      var item = document.createElement('button');
      item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
      item.type = 'button';
      item.innerHTML = '<div><strong>' + escapeHtml(r.displayName) + '</strong><br><small class="text-muted">' + escapeHtml(r.detail || '') + '</small></div>' +
        '<span class="badge bg-secondary">' + escapeHtml(r.type) + '</span>';
      item.onclick = function() { selectPrincipal(r); };
      resultsEl.appendChild(item);
    });
  } catch (e) {
    resultsEl.innerHTML = '';
    errorEl.classList.remove('d-none');
    errorEl.textContent = e.message;
  }
}

function selectPrincipal(r) {
  document.getElementById('selectedPrincipalId').value = r.id;
  document.getElementById('selectedPrincipalName').textContent = r.displayName;
  document.getElementById('selectedPrincipalDetail').textContent = (r.type || '') + (r.detail ? ' — ' + r.detail : '');
  document.getElementById('selectedPrincipalCard').classList.remove('d-none');
  document.getElementById('entraSearchResults').innerHTML = '';
  document.getElementById('addRoleSearch').value = r.displayName;
}

function clearSelectedPrincipal() {
  document.getElementById('selectedPrincipalId').value = '';
  document.getElementById('selectedPrincipalName').textContent = '';
  document.getElementById('selectedPrincipalDetail').textContent = '';
  document.getElementById('selectedPrincipalCard').classList.add('d-none');
}

function showRoleStatus(msg) {
  document.getElementById('roleStatusSpinner').classList.remove('d-none');
  document.getElementById('roleStatusIcon').classList.add('d-none');
  document.getElementById('roleStatusMsg').textContent = msg;
  var m = bootstrap.Modal.getOrCreateInstance(document.getElementById('roleStatusModal'));
  m.show();
}

function showRoleStatusResult(success, msg) {
  document.getElementById('roleStatusSpinner').classList.add('d-none');
  var icon = document.getElementById('roleStatusIcon');
  icon.classList.remove('d-none');
  icon.innerHTML = success ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>';
  document.getElementById('roleStatusMsg').textContent = msg;
  setTimeout(function() { bootstrap.Modal.getInstance(document.getElementById('roleStatusModal'))?.hide(); }, success ? 1500 : 3000);
}

async function submitAddRole() {
  var principalId = document.getElementById('selectedPrincipalId').value;
  var principalType = document.getElementById('addRolePrincipalType').value;
  var role = document.getElementById('addRoleRole').value;
  if (!principalId) { alert('Please search and select a user/SP/group first.'); return; }

  bootstrap.Modal.getInstance(document.getElementById('addRoleModal')).hide();
  showRoleStatus('Adding role assignment...');

  try {
    var resp = await fetch('/workspaces/' + '<%= workspace.id %>' + '/roles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ principalId, principalType, role }),
    });
    var data = await resp.json();
    if (!data.success) throw new Error(data.message);
    showRoleStatusResult(true, 'Role assignment added successfully');
    loadFabricRoles();
  } catch (e) {
    showRoleStatusResult(false, 'Error: ' + e.message);
  }
}

// ── Edit Role ──
function showEditRoleModal(assignmentId, name, currentRole) {
  document.getElementById('editRoleAssignmentId').value = assignmentId;
  document.getElementById('editRoleName').textContent = name;
  document.getElementById('editRoleSelect').value = currentRole;
  new bootstrap.Modal(document.getElementById('editRoleModal')).show();
}

async function submitUpdateRole() {
  var id = document.getElementById('editRoleAssignmentId').value;
  var role = document.getElementById('editRoleSelect').value;
  bootstrap.Modal.getInstance(document.getElementById('editRoleModal')).hide();
  showRoleStatus('Updating role...');

  try {
    var resp = await fetch('/workspaces/' + '<%= workspace.id %>' + '/roles/' + id, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ role }),
    });
    var data = await resp.json();
    if (!data.success) throw new Error(data.message);
    showRoleStatusResult(true, 'Role updated successfully');
    loadFabricRoles();
  } catch (e) {
    showRoleStatusResult(false, 'Error: ' + e.message);
  }
}

// ── Delete Role ──
var pendingDeleteId = null;
var pendingDeleteName = '';
function confirmDeleteRole(assignmentId, name) {
  pendingDeleteId = assignmentId;
  pendingDeleteName = name;
  document.getElementById('deleteRoleName').textContent = name;
  var modal = new bootstrap.Modal(document.getElementById('deleteRoleModal'));
  modal.show();
}
async function executeDeleteRole() {
  if (!pendingDeleteId) return;
  bootstrap.Modal.getInstance(document.getElementById('deleteRoleModal')).hide();
  showRoleStatus('Removing role assignment for "' + pendingDeleteName + '"...');

  try {
    var resp = await fetch('/workspaces/' + '<%= workspace.id %>' + '/roles/' + pendingDeleteId, { method: 'DELETE' });
    var data = await resp.json();
    if (!data.success) throw new Error(data.message);
    showRoleStatusResult(true, 'Role assignment removed');
    loadFabricRoles();
  } catch (e) {
    showRoleStatusResult(false, 'Error: ' + e.message);
  }
}

// ── OneLake Storage Size ──
function formatBytes(bytes) {
  if (bytes === 0) return '0 B';
  var units = ['B', 'KB', 'MB', 'GB', 'TB'];
  var i = Math.floor(Math.log(bytes) / Math.log(1024));
  return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 2 : 0) + ' ' + units[i];
}

async function calculateStorage() {
  document.getElementById('storagePlaceholder').classList.add('d-none');
  document.getElementById('storageLoading').classList.remove('d-none');
  document.getElementById('storageError').classList.add('d-none');
  document.getElementById('storageResults').classList.add('d-none');
  document.getElementById('calcStorageBtn').disabled = true;

  try {
    var resp = await fetch('/workspaces/' + '<%= workspace.id %>' + '/storage');
    var data = await resp.json();
    document.getElementById('storageLoading').classList.add('d-none');
    document.getElementById('calcStorageBtn').disabled = false;

    if (!data.success) {
      document.getElementById('storageError').classList.remove('d-none');
      document.getElementById('storageErrorMsg').textContent = data.message || 'Failed to calculate storage.';
      if (data.message && data.message.indexOf('403') !== -1) {
        document.getElementById('storageErrorMsg').textContent += ' — Ensure the SP has at least Viewer access to the workspace in Fabric.';
      }
      return;
    }

    document.getElementById('storageTotalSize').textContent = formatBytes(data.totalSize);
    document.getElementById('storageTotalFiles').textContent = data.totalFiles.toLocaleString();
    var itemKeys = Object.keys(data.items || {});
    document.getElementById('storageItemCount').textContent = itemKeys.length;

    // Sort items by size descending
    itemKeys.sort(function(a, b) { return (data.items[b].size || 0) - (data.items[a].size || 0); });

    var tbody = document.getElementById('storageItemsBody');
    tbody.innerHTML = '';
    itemKeys.forEach(function(key) {
      var item = data.items[key];
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + escapeHtml(item.name || key) + '</td>' +
        '<td><span class="badge bg-secondary">' + escapeHtml(item.type || '-') + '</span></td>' +
        '<td>' + (item.files || 0).toLocaleString() + '</td>' +
        '<td class="fw-bold">' + formatBytes(item.size || 0) + '</td>';
      tbody.appendChild(tr);
    });

    document.getElementById('storageResults').classList.remove('d-none');
  } catch (e) {
    document.getElementById('storageLoading').classList.add('d-none');
    document.getElementById('calcStorageBtn').disabled = false;
    document.getElementById('storageError').classList.remove('d-none');
    document.getElementById('storageErrorMsg').textContent = e.message;
  }
}
</script>
<!-- Delete Role Confirmation Modal -->
