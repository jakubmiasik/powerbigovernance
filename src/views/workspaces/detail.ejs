<div class="modal fade" id="lineageModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="lineageModalTitle">Item Lineage</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="lineageLoading" class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading lineage...</p></div>
        <div id="lineageEmpty" class="text-center py-4 d-none"><i class="bi bi-diagram-3 fs-1 text-muted"></i><p class="mt-2 text-muted">No lineage connections found for this item. Lineage is built from dataset-to-report, dataset-to-dashboard, and dataflow-to-dataset relationships.</p></div>
        <div id="lineageGraph" class="d-none"></div>
      </div>
    </div>
  </div>
</div>

<script>
// Lineage is rendered as columns of real Fabric icons rather than a generated
// diagram: the graph is always upstream → this item → downstream, and an <img>
// shows the actual artifact icon where a diagram could only draw a box.
function lineageNodeHtml(node, isCurrent) {
  var name = node.name || node.id || 'Unknown';
  var cls = isCurrent ? 'border-primary bg-body-tertiary' : '';
  var clickable = node.workspaceId && node.id && !isCurrent;
  var onclick = clickable
    ? ' onclick="showItemDetails(\'' + node.workspaceId + '\', \'' + node.id + '\', \'' + String(name).replace(/'/g, "\\'") + '\', \'' + (node.type || '') + '\')" style="cursor:pointer;"'
    : '';

  // Artifact name leads; workspace and type are supporting detail underneath.
  return '<div class="card mb-2 ' + cls + '"' + onclick + '>' +
    '<div class="card-body py-2 px-3 d-flex align-items-center gap-2">' +
    '<span>' + fabricIconImg(node.type, 20) + '</span>' +
    '<div class="flex-grow-1" style="min-width:0;">' +
      '<div class="fw-bold text-truncate" title="' + escapeItemHtml(name) + '">' + escapeItemHtml(name) + '</div>' +
      '<div class="text-muted text-truncate" style="font-size:0.72rem;">' +
        '<i class="bi bi-folder2-open me-1"></i>' + escapeItemHtml(node.workspaceName || 'Workspace unknown') +
      '</div>' +
      '<div class="text-muted" style="font-size:0.72rem;">' +
        '<i class="bi bi-tag me-1"></i>' + escapeItemHtml(node.type || 'Unknown type') +
        (node.resolved === false ? ' · <span class="text-warning">name unavailable</span>' : '') +
      '</div>' +
    '</div>' +
    (clickable ? '<i class="bi bi-chevron-right text-muted"></i>' : '') +
    '</div></div>';
}

function lineageColumnHtml(title, icon, nodes, emptyText) {
  var body = nodes.length
    ? nodes.map(function(n) { return lineageNodeHtml(n, false); }).join('')
    : '<p class="text-muted small mb-0">' + escapeItemHtml(emptyText) + '</p>';
  return '<div class="col-md-4">' +
    '<div class="text-muted small fw-bold mb-2"><i class="bi bi-' + icon + ' me-1"></i>' + escapeItemHtml(title) + ' (' + nodes.length + ')</div>' +
    body + '</div>';
}

async function showLineage(itemId, itemName, itemType) {
  var modal = new bootstrap.Modal(document.getElementById('lineageModal'));
  document.getElementById('lineageModalTitle').textContent = 'Lineage: ' + itemName;
  document.getElementById('lineageLoading').classList.remove('d-none');
  document.getElementById('lineageEmpty').classList.add('d-none');
  document.getElementById('lineageGraph').classList.add('d-none');
  document.getElementById('lineageGraph').innerHTML = '';
  modal.show();

  try {
    var workspaceId = '<%= workspace.id %>';
    var resp = await fetch('/workspaces/' + workspaceId + '/lineage/' + itemId);
    var data = await resp.json();
    document.getElementById('lineageLoading').classList.add('d-none');

    if (!data.success || !data.connections || data.connections.length === 0) {
      document.getElementById('lineageEmpty').classList.remove('d-none');
      return;
    }

    // Split into what feeds this item and what depends on it, de-duplicated by id.
    var upstream = new Map();
    var downstream = new Map();
    data.connections.forEach(function(conn) {
      var source = conn.source || { id: conn.sourceItemId, name: conn.sourceItemDisplayName, type: conn.sourceItemType };
      var target = conn.target || { id: conn.targetItemId, name: conn.targetItemDisplayName, type: conn.targetItemType };
      if (target.id === itemId && !upstream.has(source.id)) upstream.set(source.id, source);
      if (source.id === itemId && !downstream.has(target.id)) downstream.set(target.id, target);
    });

    var current = null;
    data.connections.forEach(function(conn) {
      if (conn.source && conn.source.id === itemId) current = conn.source;
      if (conn.target && conn.target.id === itemId) current = conn.target;
    });
    if (!current) current = { id: itemId, name: itemName, type: itemType };

    var html = '<div class="row g-3 align-items-start">' +
      lineageColumnHtml('Upstream', 'arrow-right-circle', [...upstream.values()], 'Nothing feeds this item.') +
      '<div class="col-md-4">' +
        '<div class="text-muted small fw-bold mb-2"><i class="bi bi-record-circle me-1"></i>This item</div>' +
        lineageNodeHtml(current, true) +
      '</div>' +
      lineageColumnHtml('Downstream', 'arrow-down-right-circle', [...downstream.values()], 'Nothing depends on this item.') +
      '</div>';

    var graphEl = document.getElementById('lineageGraph');
    graphEl.classList.remove('d-none');
    graphEl.innerHTML = html;
  } catch (e) {
    document.getElementById('lineageLoading').classList.add('d-none');
    document.getElementById('lineageEmpty').classList.remove('d-none');
    document.getElementById('lineageEmpty').querySelector('p').textContent = 'Error: ' + e.message;
  }
}
</script>

