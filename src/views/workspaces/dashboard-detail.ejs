<%- include('../layout', { body: `
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/workspaces">Workspaces</a></li>
    <li class="breadcrumb-item"><a href="/workspaces/${workspaceId}">Workspace</a></li>
    <li class="breadcrumb-item active">Dashboard Tiles</li>
  </ol>
</nav>

<h3><i class="bi bi-grid-1x2 me-2"></i>Dashboard Tiles</h3>
<p class="text-muted small">Dashboard ID: <code>${dashboardId}</code></p>

${tiles.length === 0 ? '<p class="text-muted">No tiles found in this dashboard.</p>' :
'<div class="row g-3">' +
tiles.map(tile =>
  '<div class="col-md-4">' +
  '<div class="card h-100">' +
  '<div class="card-body">' +
  '<h6 class="card-title">' + (tile.title || 'Untitled Tile') + '</h6>' +
  '<p class="small text-muted mb-1">Type: ' + (tile.embedUrl ? 'Embedded' : 'Static') + '</p>' +
  (tile.reportId ? '<p class="small mb-1">Report: <code>' + tile.reportId + '</code></p>' : '') +
  (tile.datasetId ? '<p class="small mb-1">Dataset: <code>' + tile.datasetId + '</code></p>' : '') +
  '</div></div></div>'
).join('') +
'</div>'}
` }) %>
