<%- include('../partials/header') %>
<%
  var data = insights || { workspaces: [], byFinding: {}, thresholds: {}, flaggedCount: 0, healthyCount: 0, totalCount: 0 };
  var rows = data.workspaces || [];
  var thresholds = data.thresholds || {};
  var runId = run && run.id ? run.id : null;

  function formatBytesWs(bytes) {
    if (!bytes || bytes === 0) return '-';
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
  }
  function severityColor(severity) {
    return severity === 'high' ? 'danger' : severity === 'medium' ? 'warning' : 'secondary';
  }
%>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-clipboard-check me-2"></i>Workspace Triage</h2>
    <p class="text-muted mb-0">Workspaces ranked by what needs attention. For the full inventory see <a href="/governance">Governance Overview</a>.</p>
  </div>
</div>

<% if (!fromSavedData) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No workspace data available. Select a scan from the top bar or <a href="/analysis">run an analysis</a> first.
  </div>
<% } else { %>

  <!-- Finding counts: each card filters the table below -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4 col-xl-2">
      <a href="#triage-table-card" class="text-decoration-none text-reset" onclick="setFindingFilter(''); return false;">
        <div class="card text-center h-100 stat-card">
          <div class="card-body py-3">
            <div class="text-primary mb-2"><i class="bi bi-collection"></i></div>
            <div class="fs-3 fw-bold text-primary"><%= data.flaggedCount %></div>
            <div class="small">Need Attention</div>
            <div class="text-muted" style="font-size:0.7rem;"><%= data.healthyCount %> of <%= data.totalCount %> clean</div>
          </div>
        </div>
      </a>
    </div>
    <% findingDefs.forEach(function(def) { var count = (data.byFinding || {})[def.key] || 0; %>
      <div class="col-sm-6 col-md-4 col-xl-2">
        <a href="#triage-table-card" class="text-decoration-none text-reset" onclick="setFindingFilter('<%= def.key %>'); return false;" title="<%= def.description %>">
          <div class="card text-center h-100 stat-card <%= count === 0 ? 'opacity-50' : '' %>">
            <div class="card-body py-3">
              <div class="text-<%= severityColor(def.severity) %> mb-2"><i class="bi bi-<%= def.icon %>"></i></div>
              <div class="fs-3 fw-bold text-<%= severityColor(def.severity) %>"><%= count %></div>
              <div class="small"><%= def.label %></div>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>

  <div class="card mb-4">
    <div class="card-header"><i class="bi bi-sliders me-2"></i>Thresholds</div>
    <div class="card-body py-3">
      <form method="get" action="/workspaces" class="row g-2 align-items-end">
        <% if (runId) { %><input type="hidden" name="runId" value="<%= runId %>"><% } %>
        <div class="col-auto">
          <label class="form-label small" for="staleDaysInput">Stale after (days)</label>
          <input type="number" min="1" max="3650" class="form-control form-control-sm" style="width:120px;" id="staleDaysInput" name="staleDays" value="<%= thresholds.staleDays %>">
        </div>
        <div class="col-auto">
          <label class="form-label small" for="overSharedInput">Broadly shared at (principals)</label>
          <input type="number" min="1" max="10000" class="form-control form-control-sm" style="width:160px;" id="overSharedInput" name="overSharedUsers" value="<%= thresholds.overSharedUsers %>">
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Apply</button>
        </div>
        <div class="col-12">
          <div class="form-text">
            <i class="bi bi-info-circle me-1"></i>Staleness is measured against the scan date<% if (data.referenceDate) { %> (<%= new Date(data.referenceDate).toLocaleDateString() %>)<% } %>,
            not today, so re-opening an older scan gives the same answer it gave then.
            <% if (!data.orphanDetectionAvailable) { %>
              <br><i class="bi bi-exclamation-triangle me-1 text-warning"></i>Orphaned-content detection is off: this scan captured no workspace users to compare creators against.
            <% } %>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="card mb-4" id="triage-table-card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <span><i class="bi bi-list-ol me-2"></i>Ranked Workspaces</span>
        <span class="badge bg-light text-dark border ms-2" id="triageFilterLabel">Showing workspaces needing attention</span>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" id="showAllBtn" onclick="toggleShowClean()">Include clean workspaces</button>
        <input type="text" class="form-control form-control-sm" style="max-width:280px;" placeholder="Filter workspaces..." id="triageSearch" oninput="applyTriageFilter()">
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0" id="triage-table">
        <thead>
          <tr>
            <th style="width:70px;">Risk</th>
            <th>Workspace</th>
            <th>Findings</th>
            <th>Items</th>
            <th>Users</th>
            <th>Admins</th>
            <th>Last activity</th>
            <th>Storage</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(ws, idx) { %>
            <tr data-filter="<%= (ws.name || '').toLowerCase() %>"
                data-findings="<%= ws.findings.map(function(f) { return f.key; }).join(' ') %>"
                data-clean="<%= ws.findings.length ? 'false' : 'true' %>">
              <td>
                <% if (ws.score > 0) { %>
                  <span class="badge bg-<%= severityColor(ws.highestSeverity) %>"><%= ws.score %></span>
                <% } else { %>
                  <span class="badge bg-success"><i class="bi bi-check"></i></span>
                <% } %>
              </td>
              <td>
                <a href="/workspaces/<%= ws.id %><%= runId ? '?runId=' + runId : '' %>"><strong><%= ws.name %></strong></a>
                <div class="text-muted" style="font-size:0.7rem;">
                  <%= ws.licenseType %><% if (ws.capacitySku) { %> &middot; <code><%= ws.capacitySku %></code><% } %>
                  <% if (ws.state && ws.state !== 'Active') { %> &middot; <span class="badge bg-warning"><%= ws.state %></span><% } %>
                </div>
              </td>
              <td>
                <% if (!ws.findings.length) { %>
                  <span class="text-muted small">&mdash;</span>
                <% } else { %>
                  <% ws.findings.forEach(function(finding) { %>
                    <span class="badge bg-<%= severityColor(finding.severity) %> me-1 mb-1" title="<%= finding.detail %>">
                      <i class="bi bi-<%= finding.icon %> me-1"></i><%= finding.label %>
                    </span>
                  <% }) %>
                <% } %>
              </td>
              <td><%= ws.totalItems %></td>
              <td><%= ws.userCount %></td>
              <td>
                <%= ws.adminCount %>
                <% if (ws.adminCount && ws.humanAdminCount !== ws.adminCount) { %>
                  <span class="text-muted" style="font-size:0.7rem;">(<%= ws.humanAdminCount %> user)</span>
                <% } %>
              </td>
              <td class="small">
                <% if (ws.lastActivityDays === null) { %>
                  <span class="text-muted">-</span>
                <% } else { %>
                  <%= ws.lastActivityDays %>d ago
                <% } %>
              </td>
              <td class="small"><%= formatBytesWs(ws.storageSize) %></td>
              <td>
                <% if (ws.findings.length) { %>
                  <button class="btn btn-sm btn-outline-primary p-0 px-1" onclick="showWorkspaceFindings(<%= idx %>)" title="Why is this flagged?"><i class="bi bi-info-circle"></i></button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Findings detail modal -->
  <div class="modal fade" id="findingsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title" id="findingsModalTitle">Findings</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="findingsModalBody"></div>
        <div class="modal-footer">
          <a href="#" class="btn btn-sm btn-primary" id="findingsModalLink"><i class="bi bi-box-arrow-up-right me-1"></i>Open workspace</a>
        </div>
      </div>
    </div>
  </div>

  <script>
  var triageRows = <%- JSON.stringify(rows.map(function(w) { return { id: w.id, name: w.name, findings: w.findings }; })) %>;
  var findingLabels = <%- JSON.stringify(findingDefs.reduce(function(acc, d) { acc[d.key] = d.label; return acc; }, {})) %>;
  var triageRunId = <%= runId ? runId : 'null' %>;
  var activeFinding = '';
  var showClean = false;
  var findingsModal;

  document.addEventListener('DOMContentLoaded', function() {
    findingsModal = new bootstrap.Modal(document.getElementById('findingsModal'));
    applyTriageFilter();
  });

  function setFindingFilter(key) {
    activeFinding = key;
    if (key) showClean = false;
    applyTriageFilter();
  }

  function toggleShowClean() {
    showClean = !showClean;
    document.getElementById('showAllBtn').textContent = showClean ? 'Hide clean workspaces' : 'Include clean workspaces';
    applyTriageFilter();
  }

  function applyTriageFilter() {
    var term = (document.getElementById('triageSearch').value || '').toLowerCase().trim();
    var shown = 0;
    document.querySelectorAll('#triage-table tbody tr').forEach(function(row) {
      var isClean = row.getAttribute('data-clean') === 'true';
      var matchesText = !term || (row.getAttribute('data-filter') || '').includes(term);
      var matchesFinding = !activeFinding || (row.getAttribute('data-findings') || '').split(' ').indexOf(activeFinding) !== -1;
      var matchesClean = showClean || !isClean;
      var visible = matchesText && matchesFinding && matchesClean;
      row.style.display = visible ? '' : 'none';
      if (visible) shown++;
    });

    var label = 'Showing ' + shown + ' workspace' + (shown === 1 ? '' : 's');
    if (activeFinding) {
      label += ' — ' + (findingLabels[activeFinding] || activeFinding);
    } else if (!showClean) {
      label += ' needing attention';
    }
    document.getElementById('triageFilterLabel').textContent = label;
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function showWorkspaceFindings(index) {
    var ws = triageRows[index];
    if (!ws) return;
    document.getElementById('findingsModalTitle').textContent = ws.name;
    document.getElementById('findingsModalLink').href = '/workspaces/' + ws.id + (triageRunId ? '?runId=' + triageRunId : '');

    var html = ws.findings.map(function(f) {
      var color = f.severity === 'high' ? 'danger' : f.severity === 'medium' ? 'warning' : 'secondary';
      return '<div class="mb-3">' +
        '<div class="d-flex align-items-center gap-2 mb-1">' +
        '<span class="badge bg-' + color + '"><i class="bi bi-' + f.icon + ' me-1"></i>' + escapeHtml(f.label) + '</span>' +
        '<span class="text-muted small">' + escapeHtml(f.severity) + '</span></div>' +
        '<div class="small mb-1">' + escapeHtml(f.detail) + '</div>' +
        '<div class="text-muted" style="font-size:0.75rem;">' + escapeHtml(f.description) + '</div>' +
        '</div>';
    }).join('');
    document.getElementById('findingsModalBody').innerHTML = html || '<p class="text-muted mb-0">No findings.</p>';
    findingsModal.show();
  }
  </script>
<% } %>

<%- include('../partials/footer') %>
