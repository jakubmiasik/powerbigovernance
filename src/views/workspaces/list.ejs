<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-collection me-2"></i>Workspaces</h2>
    <p class="text-muted mb-0">Browse all Power BI and Fabric workspaces.</p>
  </div>
</div>

<% if (!workspaces.length) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No workspace data available. Select a scan from the top bar or <a href="/analysis">run an analysis</a> first.
  </div>
<% } else { %>
  <%
    var activeCount = (stats.byState || {})['Active'] || 0;
    var otherStates = [];
    Object.entries(stats.byState || {}).forEach(function(e) { if (e[0] !== 'Active') otherStates.push(e); });
    var totalStorageSizeWs = workspaces.reduce(function(acc, ws) { return acc + (ws.storageSize || 0); }, 0);
    function formatBytesListPage(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      var units = ['B', 'KB', 'MB', 'GB', 'TB'];
      var i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }
  %>
  <div class="row g-3 mb-4">
    <div class="col-sm-3 col-lg-2">
      <div class="card text-center h-100 stat-card">
        <div class="card-body py-3">
          <div class="fs-3 fw-bold" style="color: var(--color-primary);"><%= stats.total %></div>
          <div class="text-muted small">Total Workspaces</div>
          <div style="font-size: 0.75rem; color: var(--color-text-muted); margin-top: 0.25rem;">
            <span class="badge bg-success"><%= activeCount %> Active</span>
            <% otherStates.forEach(function(e) { %>
              <span class="badge bg-secondary ms-1"><%= e[1] %> <%= e[0] %></span>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <% if (totalStorageSizeWs > 0) { %>
      <div class="col-sm-3 col-lg-2">
        <div class="card text-center h-100 stat-card">
          <div class="card-body py-3">
            <div class="fs-3 fw-bold" style="color: var(--color-teal);"><%= formatBytesListPage(totalStorageSizeWs) %></div>
            <div class="text-muted small">Total Storage</div>
            <div style="font-size: 0.75rem; color: var(--color-text-muted); margin-top: 0.25rem;">
              <span class="badge bg-info"><%= workspaces.filter(function(w) { return w.storageSize > 0; }).length %> workspaces with data</span>
            </div>
          </div>
        </div>
      </div>
    <% } %>
    <% Object.entries(stats.byLicense || {}).forEach(function(entry) { var license = entry[0]; var count = entry[1]; var color = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'secondary'; %>
      <div class="col-sm-3 col-lg-2">
        <div class="card text-center h-100 stat-card">
          <div class="card-body py-3">
            <div class="fs-3 fw-bold text-<%= color %>"><%= count %></div>
            <div class="text-muted small"><%= license %></div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (Object.keys(stats.bySku || {}).length > 0) { %>
    <div class="row g-3 mb-4">
      <% Object.entries(stats.bySku || {}).sort(function(a,b) { return b[1] - a[1]; }).forEach(function(entry) { var sku = entry[0]; var count = entry[1]; %>
        <div class="col-sm-3 col-lg-2">
          <div class="card text-center h-100 stat-card">
            <div class="card-body py-2">
              <div class="fs-4 fw-bold"><%= count %></div>
              <div class="text-muted small"><code><%= sku %></code></div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="card" id="workspace-inventory-card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-table me-2"></i>Workspace Inventory (<%= stats.total %>)</span>
      <div class="d-flex gap-2 align-items-center flex-wrap">
        <select class="form-select form-select-sm" id="sortMetric" style="max-width: 180px;" onchange="renderWorkspaceInventory()">
          <option value="name">Sort: Name</option>
          <option value="state">Sort: State</option>
          <option value="license">Sort: License</option>
          <option value="storage">Sort: Storage</option>
          <option value="reports">Sort: Reports</option>
          <option value="datasets">Sort: Datasets</option>
          <option value="items">Sort: Total Items</option>
        </select>
        <input type="text" class="form-control form-control-sm" style="max-width: 280px;" placeholder="Filter by workspace, state, license, or SKU..." id="inventoryFilter" oninput="renderWorkspaceInventory()">
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height: 620px;">
        <table class="table table-hover table-sm mb-0" id="workspaceInventoryTable">
          <thead>
            <tr>
              <th>Workspace</th>
              <th>State</th>
              <th>License</th>
              <th>SKU</th>
              <th>Reports</th>
              <th>Datasets</th>
              <th>Total Items</th>
              <th>Storage</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="workspaceInventoryBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    var workspacesData = <%- JSON.stringify(workspaces) %>;

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatStorage(bytes) {
      if (!bytes || bytes <= 0) return '0 B';
      var units = ['B', 'KB', 'MB', 'GB', 'TB'];
      var i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }

    function getLicenseBadgeClass(license) {
      if (license === 'Fabric') return 'bg-success';
      if (license === 'Premium') return 'bg-warning';
      if (license === 'Premium Per User') return 'bg-info';
      return 'bg-secondary';
    }

    function getStateBadgeClass(state) {
      if (state === 'Active') return 'bg-success';
      if (state === 'Deleted') return 'bg-danger';
      return 'bg-secondary';
    }

    function getFilteredSortedWorkspaces() {
      var filterText = (document.getElementById('inventoryFilter').value || '').toLowerCase();
      var sortMetric = document.getElementById('sortMetric').value;

      var filtered = workspacesData.filter(function(ws) {
        var name = (ws.displayName || ws.name || 'Unnamed');
        var state = ws.state || '-';
        var license = ws.licenseType || 'Pro';
        var sku = ws.capacitySku || '-';
        var searchable = [name, state, license, sku].join(' ').toLowerCase();
        return searchable.indexOf(filterText) !== -1;
      });

      filtered.sort(function(a, b) {
        var aName = a.displayName || a.name || '';
        var bName = b.displayName || b.name || '';
        if (sortMetric === 'name') return aName.localeCompare(bName);
        if (sortMetric === 'state') return (a.state || '').localeCompare(b.state || '');
        if (sortMetric === 'license') return (a.licenseType || '').localeCompare(b.licenseType || '');
        if (sortMetric === 'storage') return (b.storageSize || 0) - (a.storageSize || 0);
        if (sortMetric === 'reports') return (b.reportCount || 0) - (a.reportCount || 0);
        if (sortMetric === 'datasets') return (b.datasetCount || 0) - (a.datasetCount || 0);
        if (sortMetric === 'items') return (b.totalItems || 0) - (a.totalItems || 0);
        return 0;
      });

      return filtered;
    }

    function renderWorkspaceInventory() {
      var rows = getFilteredSortedWorkspaces();
      var tbody = document.getElementById('workspaceInventoryBody');

      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-3">No workspaces match the current filter.</td></tr>';
        return;
      }

      var html = rows.map(function(ws) {
        var name = ws.displayName || ws.name || 'Unnamed';
        var state = ws.state || 'Unknown';
        var license = ws.licenseType || 'Pro';
        var sku = ws.capacitySku || '-';
        var reports = ws.reportCount || 0;
        var datasets = ws.datasetCount || 0;
        var items = ws.totalItems || 0;
        var storage = ws.storageSize || 0;
        var stateBadge = getStateBadgeClass(state);
        var licenseBadge = getLicenseBadgeClass(license);
        return ''
          + '<tr>'
          + '<td><strong>' + escapeHtml(name) + '</strong></td>'
          + '<td><span class="badge ' + stateBadge + '">' + escapeHtml(state) + '</span></td>'
          + '<td><span class="badge ' + licenseBadge + '">' + escapeHtml(license) + '</span></td>'
          + '<td><code>' + escapeHtml(sku) + '</code></td>'
          + '<td>' + reports + '</td>'
          + '<td>' + datasets + '</td>'
          + '<td>' + items + '</td>'
          + '<td class="fw-semibold">' + formatStorage(storage) + '</td>'
          + '<td><a href="/workspaces/' + encodeURIComponent(ws.id) + '" class="btn btn-sm btn-outline-primary">Details</a></td>'
          + '</tr>';
      }).join('');

      tbody.innerHTML = html;
    }

    document.addEventListener('DOMContentLoaded', function() {
      renderWorkspaceInventory();
    });
  </script>
<% } %>
<%- include('../partials/footer') %>
