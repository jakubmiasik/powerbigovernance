<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-collection me-2"></i>Workspaces</h2>
    <p class="text-muted mb-0">Browse all Power BI and Fabric workspaces.</p>
  </div>
</div>

<% if (!workspaces.length) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No workspace data available. Select a scan from the top bar or <a href="/analysis">run an analysis</a> first.
  </div>
<% } else { %>
  <div class="row g-3 mb-4">
    <div class="col-sm-3 col-lg-2">
      <div class="card text-center h-100">
        <div class="card-body py-3">
          <div class="fs-3 fw-bold text-primary"><%= stats.total %></div>
          <div class="text-muted small">Total</div>
        </div>
      </div>
    </div>
    <% Object.entries(stats.byLicense || {}).forEach(function(entry) { var license = entry[0]; var count = entry[1]; var color = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'secondary'; %>
      <div class="col-sm-3 col-lg-2">
        <div class="card text-center h-100 border-<%= color %>">
          <div class="card-body py-3">
            <div class="fs-3 fw-bold text-<%= color %>"><%= count %></div>
            <div class="text-muted small"><%= license %></div>
          </div>
        </div>
      </div>
    <% }) %>
    <% Object.entries(stats.byState || {}).forEach(function(entry) { var state = entry[0]; var count = entry[1]; %>
      <div class="col-sm-3 col-lg-2">
        <div class="card text-center h-100">
          <div class="card-body py-3">
            <div class="fs-3 fw-bold"><%= count %></div>
            <div class="text-muted small"><%= state %></div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-table me-2"></i>Workspace Inventory (<%= stats.total %>)</span>
      <input type="text" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Filter workspaces..." oninput="filterTable(this, 'workspace-list-table')">
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-striped mb-0" id="workspace-list-table">
        <thead class="table-dark">
          <tr>
            <th>Name</th>
            <th>License Type</th>
            <th>State</th>
            <th>Items</th>
            <th>Reports</th>
            <th>Models</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% workspaces.forEach(function(ws) { var wsName = ws.displayName || ws.name || 'Unnamed'; var license = ws.licenseType || 'Pro'; var licColor = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'secondary'; %>
            <tr data-filter="<%= [wsName, license, ws.state || '', ws.type || ''].join(' ').toLowerCase() %>">
              <td><i class="bi bi-folder2 me-2 text-primary"></i><strong><%= wsName %></strong></td>
              <td><span class="badge bg-<%= licColor %>"><%= license %></span></td>
              <td>
                <span class="badge bg-<%= ws.state === 'Active' ? 'success' : ws.state === 'Deleted' ? 'danger' : 'warning' %>"><%= ws.state || 'Unknown' %></span>
              </td>
              <td data-sort-value="<%= ws.totalItems || 0 %>"><%= ws.totalItems || 0 %></td>
              <td data-sort-value="<%= ws.reportCount || 0 %>"><%= ws.reportCount || 0 %></td>
              <td data-sort-value="<%= ws.datasetCount || 0 %>"><%= ws.datasetCount || 0 %></td>
              <td><a href="/workspaces/<%= ws.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Details</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
<%- include('../partials/footer') %>
