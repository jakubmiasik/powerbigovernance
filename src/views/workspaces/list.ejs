<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-collection me-2"></i>Workspaces</h2>
    <p class="text-muted mb-0">Browse all Power BI and Fabric workspaces.</p>
  </div>
</div>

<% if (!workspaces.length) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No workspace data available. Select a scan from the top bar or <a href="/analysis">run an analysis</a> first.
  </div>
<% } else { %>
  <%
    var activeCount = (stats.byState || {})['Active'] || 0;
    var otherStates = [];
    Object.entries(stats.byState || {}).forEach(function(e) { if (e[0] !== 'Active') otherStates.push(e); });
    var totalStorageSizeWs = workspaces.reduce(function(acc, ws) { return acc + (ws.storageSize || 0); }, 0);
    function formatBytesListPage(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      var units = ['B', 'KB', 'MB', 'GB', 'TB'];
      var i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }
  %>
  <div class="row g-3 mb-4">
    <div class="col-sm-3 col-lg-2">
      <div class="card text-center h-100 stat-card">
        <div class="card-body py-3">
          <div class="fs-3 fw-bold" style="color: var(--color-primary);"><%= stats.total %></div>
          <div class="text-muted small">Total Workspaces</div>
          <div style="font-size: 0.75rem; color: var(--color-text-muted); margin-top: 0.25rem;">
            <span class="badge bg-success"><%= activeCount %> Active</span>
            <% otherStates.forEach(function(e) { %>
              <span class="badge bg-secondary ms-1"><%= e[1] %> <%= e[0] %></span>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <% if (totalStorageSizeWs > 0) { %>
      <div class="col-sm-3 col-lg-2">
        <div class="card text-center h-100 stat-card">
          <div class="card-body py-3">
            <div class="fs-3 fw-bold" style="color: var(--color-teal);"><%= formatBytesListPage(totalStorageSizeWs) %></div>
            <div class="text-muted small">Total Storage</div>
            <div style="font-size: 0.75rem; color: var(--color-text-muted); margin-top: 0.25rem;">
              <span class="badge bg-info"><%= workspaces.filter(function(w) { return w.storageSize > 0; }).length %> workspaces with data</span>
            </div>
          </div>
        </div>
      </div>
    <% } %>
    <% Object.entries(stats.byLicense || {}).forEach(function(entry) { var license = entry[0]; var count = entry[1]; var color = license === 'Fabric' ? 'success' : license === 'Premium' ? 'warning' : license === 'Premium Per User' ? 'info' : 'secondary'; %>
      <div class="col-sm-3 col-lg-2">
        <div class="card text-center h-100 stat-card">
          <div class="card-body py-3">
            <div class="fs-3 fw-bold text-<%= color %>"><%= count %></div>
            <div class="text-muted small"><%= license %></div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (Object.keys(stats.bySku || {}).length > 0) { %>
    <div class="row g-3 mb-4">
      <% Object.entries(stats.bySku || {}).sort(function(a,b) { return b[1] - a[1]; }).forEach(function(entry) { var sku = entry[0]; var count = entry[1]; %>
        <div class="col-sm-3 col-lg-2">
          <div class="card text-center h-100 stat-card">
            <div class="card-body py-2">
              <div class="fs-4 fw-bold"><%= count %></div>
              <div class="text-muted small"><code><%= sku %></code></div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-bar-chart me-2"></i>Workspace Inventory (<%= stats.total %>)</span>
      <div class="d-flex gap-2 align-items-center flex-wrap">
        <select class="form-select form-select-sm" id="sortMetric" style="max-width: 160px;" onchange="updateChart()">
          <option value="name">Sort by Name</option>
          <option value="storage">Sort by Storage</option>
          <option value="reports">Sort by Reports</option>
          <option value="datasets">Sort by Datasets</option>
          <option value="items">Sort by Items</option>
        </select>
        <input type="text" class="form-control form-control-sm" style="max-width: 240px;" placeholder="Filter workspaces..." id="chartFilter" oninput="updateChart()">
      </div>
    </div>
    <div class="card-body" style="position: relative; min-height: 600px;">
      <canvas id="workspaceChart"></canvas>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
  <script>
    var workspacesData = <%- JSON.stringify(workspaces) %>;
    var chartInstance = null;

    function getFilteredData() {
      var filterText = (document.getElementById('chartFilter').value || '').toLowerCase();
      var sortMetric = document.getElementById('sortMetric').value;
      
      var filtered = workspacesData.filter(function(ws) {
        var wsName = (ws.displayName || ws.name || 'Unnamed').toLowerCase();
        var license = (ws.licenseType || 'Pro').toLowerCase();
        var sku = (ws.capacitySku || '-').toLowerCase();
        var searchText = [wsName, license, sku].join(' ');
        return searchText.includes(filterText);
      });

      // Sort by selected metric
      filtered.sort(function(a, b) {
        if (sortMetric === 'name') {
          return (a.displayName || a.name || '').localeCompare(b.displayName || b.name || '');
        }
        if (sortMetric === 'storage') return (b.storageSize || 0) - (a.storageSize || 0);
        if (sortMetric === 'reports') return (b.reportCount || 0) - (a.reportCount || 0);
        if (sortMetric === 'datasets') return (b.datasetCount || 0) - (a.datasetCount || 0);
        if (sortMetric === 'items') return (b.totalItems || 0) - (a.totalItems || 0);
        return 0;
      });

      return filtered;
    }

    function formatStorageGB(bytes) {
      if (!bytes || bytes === 0) return 0;
      return (bytes / (1024 * 1024 * 1024)).toFixed(1);
    }

    function updateChart() {
      var filteredData = getFilteredData();
      
      var labels = filteredData.map(function(ws) {
        return (ws.displayName || ws.name || 'Unnamed').substring(0, 30);
      });
      
      var storageData = filteredData.map(function(ws) {
        return formatStorageGB(ws.storageSize || 0);
      });
      
      var reportsData = filteredData.map(function(ws) {
        return ws.reportCount || 0;
      });
      
      var datasetsData = filteredData.map(function(ws) {
        return ws.datasetCount || 0;
      });
      
      var itemsData = filteredData.map(function(ws) {
        return ws.totalItems || 0;
      });

      var ctx = document.getElementById('workspaceChart').getContext('2d');
      
      if (chartInstance) {
        chartInstance.destroy();
      }

      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Storage (GB)',
              data: storageData,
              backgroundColor: '#06B6D4',
              borderColor: '#0891B2',
              borderWidth: 1,
              borderRadius: 3,
              yAxisID: 'y'
            },
            {
              label: 'Reports',
              data: reportsData,
              backgroundColor: '#F59E0B',
              borderColor: '#D97706',
              borderWidth: 1,
              borderRadius: 3,
              yAxisID: 'y1'
            },
            {
              label: 'Datasets',
              data: datasetsData,
              backgroundColor: '#8B5CF6',
              borderColor: '#7C3AED',
              borderWidth: 1,
              borderRadius: 3,
              yAxisID: 'y1'
            },
            {
              label: 'Total Items',
              data: itemsData,
              backgroundColor: '#10B981',
              borderColor: '#059669',
              borderWidth: 1,
              borderRadius: 3,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { 
              display: true,
              position: 'top',
              labels: { usePointStyle: true, padding: 15 }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  var label = context.dataset.label || '';
                  var value = context.raw;
                  if (label.includes('Storage')) {
                    return label + ': ' + value + ' GB';
                  }
                  return label + ': ' + value;
                }
              }
            }
          },
          scales: {
            y: {
              type: 'category',
              title: { display: true, text: 'Workspaces' }
            },
            y1: {
              type: 'linear',
              position: 'left',
              title: { display: true, text: 'Counts' },
              beginAtZero: true
            }
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      updateChart();
    });
  </script>
<% } %>
<%- include('../partials/footer') %>
