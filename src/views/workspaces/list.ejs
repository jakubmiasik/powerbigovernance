<%- include('../partials/header') %>
<%
  var pd = '../../../packages/podavo-ui/ejs/';
  var data = insights || { workspaces: [], byFinding: {}, thresholds: {}, flaggedCount: 0, healthyCount: 0, totalCount: 0 };
  var rows = data.workspaces || [];
  var thresholds = data.thresholds || {};
  var runId = run && run.id ? run.id : null;
  var ctxById = typeof workspaceContext !== 'undefined' && workspaceContext ? workspaceContext : {};
  var reportsTotal = typeof reportCount !== 'undefined' ? reportCount : null;

  function formatBytesWs(bytes) {
    if (!bytes || bytes === 0) return '-';
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
  }
  function severityColor(severity) {
    return severity === 'high' ? 'danger' : severity === 'medium' ? 'warning' : 'secondary';
  }
  // Display tone per risk band. The bands and their thresholds come from the service;
  // only the colour each one is drawn in is decided here.
  var BAND_TONE = { critical: 'danger', high: 'orange', medium: 'warning', low: 'info', clean: 'success' };
  function bandTone(band) { return band ? (BAND_TONE[band.key] || 'neutral') : 'neutral'; }
  function bandRange(band, bands) {
    var i = bands.indexOf(band);
    var upper = i > 0 ? bands[i - 1].min - 1 : null;
    if (band.min === 0) return '0';
    return upper === null ? '≥ ' + band.min : band.min + '–' + upper;
  }
  function initials(name) { return String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(function(w) { return w.charAt(0); }).join('').toUpperCase(); }
  function pct(n, total) { return total ? (n / total * 100).toFixed(1) + '%' : '0%'; }

  var bands = data.riskBands || [];
  var bandCounts = {};
  rows.forEach(function(ws) { var key = ws.band ? ws.band.key : 'clean'; bandCounts[key] = (bandCounts[key] || 0) + 1; });

  // Finding tiles, worst-weighted first among those that fired, then the zeros.
  // A check nobody switched on is left out: a permanent zero reads as "clean".
  var tiles = findingDefs.filter(function(def) { return !(def.key === 'namingConvention' && !data.namingConventionEnabled); })
    .map(function(def) { return { def: def, count: (data.byFinding || {})[def.key] || 0 }; });
  tiles.sort(function(a, b) { return (b.count > 0) - (a.count > 0) || b.count - a.count || b.def.weight - a.def.weight; });
  var TILE_TONE = { high: 'danger', medium: 'orange', low: 'neutral' };
  var FINDING_ICON = { ownerless: 'user-x', orphanedAdmin: 'bot', singleAdmin: 'user-round', staleContent: 'hourglass', orphanedContent: 'file-x',
    capacityRisk: 'zap', personalAccess: 'users', overShared: 'network', namingConvention: 'type', emptyWorkspace: 'inbox' };
%>

<%- include(pd + 'page-header', { ui: {
  title: 'Workspace Triage', icon: 'layers',
  subtitle: 'Identify governance risks across the tenant and act on them. Select a workspace to see why it was flagged.',
  actionsHtml: include(pd + 'button', { ui: { label: 'Governance Overview', icon: 'shield-check', href: '/governance', size: 'sm' } })
} }) %>

<% if (!fromSavedData) { %>
  <div class="pd-card">
    <%- include(pd + 'state', { ui: {
      kind: 'empty', icon: 'clipboard-list',
      title: 'No workspace data available',
      message: 'Triage is computed from a completed analysis scan. Select a scan in the bar above, or run an analysis first.',
      actions: [{ href: '/analysis', label: 'Run an analysis', icon: 'circle-play', primary: true }]
    } }) %>
  </div>
<% } else { %>

  <!-- Summary: three concise metrics and how risk is spread -->
  <div class="gov-summary">
    <%- include(pd + 'metric-card', { ui: { label: 'All workspaces', value: data.totalCount, hint: 'in this scan', icon: 'layers', tone: 'brand' } }) %>
    <%- include(pd + 'metric-card', { ui: { label: 'Need attention', value: data.flaggedCount, hint: pct(data.flaggedCount, data.totalCount) + ' of workspaces', icon: 'triangle-alert', tone: 'warning' } }) %>
    <%- include(pd + 'metric-card', { ui: { label: 'No issues', value: data.healthyCount, hint: pct(data.healthyCount, data.totalCount) + ' of workspaces', icon: 'circle-check', tone: 'success' } }) %>
    <div class="pd-card gov-dist">
      <p class="gov-dist-title"><span>Risk distribution</span><span class="pd-card-meta"><%= data.totalCount %> workspaces</span></p>
      <div class="pd-dist-bar" role="img" aria-label="Workspaces by risk level: <%= bands.map(function(b) { return b.label + ' ' + (bandCounts[b.key] || 0); }).join(', ') %>">
        <% bands.forEach(function(b) { var n = bandCounts[b.key] || 0; if (!n || !data.totalCount) return; %>
          <span class="pd-fill-<%= bandTone(b) %>" style="width:<%= (n / data.totalCount * 100).toFixed(2) %>%" title="<%= b.label %>: <%= n %>"></span>
        <% }) %>
      </div>
      <ul class="pd-dist-legend">
        <% bands.forEach(function(b) { var n = bandCounts[b.key] || 0; %>
          <li><span class="pd-dot pd-dot--<%= bandTone(b) %>" aria-hidden="true"></span><%= b.label %> <strong><%= n %></strong></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <!-- Findings: each tile filters the table -->
  <section class="pd-card gov-findings mb-3" aria-labelledby="findingsHeading">
    <div class="pd-card-header">
      <h2 class="pd-card-title" id="findingsHeading"><i data-lucide="list-checks" aria-hidden="true"></i>Key governance findings</h2>
      <span class="pd-card-meta">Select a finding to filter the workspaces</span>
      <label class="gov-zero-toggle"><input type="checkbox" class="form-check-input m-0" id="showZeroFindings" onchange="document.getElementById('findingTiles').setAttribute('data-hide-zero', this.checked ? 'false' : 'true')"> Show checks with no findings</label>
    </div>
    <div class="pd-card-body">
      <%- include(pd + 'filter-bar', { ui: {
        id: 'findingTiles', label: 'Filter workspaces by finding', hideZero: true,
        items: tiles.map(function(t) {
          return {
            key: t.def.key, label: t.def.label, count: t.count, icon: FINDING_ICON[t.def.key] || 'circle-alert',
            tone: t.count ? TILE_TONE[t.def.severity] : null, zero: t.count === 0,
            title: t.def.description + ' (' + t.def.severity + ' severity, +' + t.def.weight + ')',
            attrs: { onclick: "setFindingFilter('" + t.def.key + "')" }
          };
        })
      } }) %>
    </div>
  </section>

  <!-- Risk scale: the bands at a glance; the full arithmetic is one click away -->
  <section class="pd-card gov-scale" aria-labelledby="riskScaleHeading">
    <h2 class="gov-scale-title" id="riskScaleHeading"><i data-lucide="gauge" aria-hidden="true"></i>Risk scale</h2>
    <div class="gov-scale-bands">
      <% bands.forEach(function(band) { %>
        <span class="pd-badge pd-badge--<%= bandTone(band) %>" title="<%= band.description %>"><%= band.label %> <span class="pd-num"><%= bandRange(band, bands) %></span></span>
      <% }) %>
    </div>
    <span class="gov-scale-note">A score is the sum of the weights of the governance checks that fired.</span>
    <button type="button" class="pd-btn pd-btn--sm" data-pd-dialog-open="riskExplainerDialog"><i data-lucide="circle-help" aria-hidden="true"></i><span>How the Risk score works</span></button>
  </section>

  <div class="pd-dock">
    <section class="pd-card pd-grid" id="triage-table-card" aria-labelledby="triageTableHeading">
      <div class="pd-card-header">
        <h2 class="pd-visually-hidden" id="triageTableHeading">Ranked workspaces</h2>
        <%- include(pd + 'tabs', { ui: { label: 'Inventory', variant: 'pill', tabs: [
          { label: 'Workspaces', icon: 'layers', count: data.totalCount, href: '/workspaces' + (runId ? '?runId=' + runId : ''), selected: true },
          { label: 'Reports', icon: 'file-text', count: reportsTotal, href: '/governance/artifacts?type=Report' + (runId ? '&runId=' + runId : '') }
        ] } }) %>
        <span class="pd-visually-hidden" id="triageFilterLabel" aria-live="polite">Showing workspaces needing attention</span>
        <div class="pd-filterbar" role="group" aria-label="Bulk actions">
          <span class="badge bg-secondary" id="statusCheckBadge" title="Deletion is disabled until the live workspace status is confirmed">
            <i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>Status not verified
          </span>
          <button class="pd-btn pd-btn--sm" id="checkStatusBtn" onclick="checkWorkspaceStatus()">
            <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Check workspace status
          </button>
          <button class="pd-btn pd-btn--sm pd-btn--danger" id="deleteSelectedBtn" onclick="confirmDeleteSelected()" disabled>
            <i class="bi bi-trash" aria-hidden="true"></i><span>Delete selected (<span id="selectedCount">0</span>)</span>
          </button>
        </div>
      </div>
      <div data-grid-toolbar-for="triage-table">
        <button type="button" class="pd-btn pd-btn--sm" id="showAllBtn" onclick="toggleShowClean()" aria-pressed="false">Include clean workspaces</button>
        <div class="pd-popover-anchor">
          <button type="button" class="pd-btn pd-btn--sm" data-pd-popover="thresholdsPopover" aria-controls="thresholdsPopover" aria-expanded="false"><i data-lucide="sliders-horizontal" aria-hidden="true"></i><span>Thresholds</span></button>
          <div class="pd-popover" id="thresholdsPopover" role="dialog" aria-labelledby="thresholdsTitle" hidden style="width: 380px;">
            <p class="pd-popover-title" id="thresholdsTitle">Thresholds</p>
            <form method="get" action="/workspaces" class="d-grid gap-3">
              <% if (runId) { %><input type="hidden" name="runId" value="<%= runId %>"><% } %>
              <%- include(pd + 'input', { ui: { id: 'staleDaysInput', name: 'staleDays', type: 'number', label: 'Stale after (days)', value: thresholds.staleDays, size: 'sm', attrs: { min: 1, max: 3650 } } }) %>
              <%- include(pd + 'input', { ui: { id: 'overSharedInput', name: 'overSharedUsers', type: 'number', label: 'Broadly shared at (principals)', value: thresholds.overSharedUsers, size: 'sm', attrs: { min: 1, max: 10000 } } }) %>
              <div class="pd-help" id="thresholdHelp">
                Staleness is measured against the scan date<% if (data.referenceDate) { %> (<%= new Date(data.referenceDate).toISOString().slice(0, 10) %>)<% } %>,
                not today, so re-opening an older scan gives the same answer it gave then.
                <% if (data.namingConventionEnabled && namingPattern) { %>
                  <br>Artifact names are checked as <code><%= namingPattern %></code>
                  (<a href="/settings">change in Settings</a>). Open a workspace to see each off-convention name and what it should be.
                <% } else { %>
                  <br>No naming convention is being enforced.
                  <a href="/settings">Define one in Settings</a> to see which artifacts do not follow it.
                <% } %>
                <% if (!data.orphanDetectionAvailable) { %>
                  <br>Orphaned-content detection is off: this scan captured no workspace users to compare creators against.
                <% } %>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="pd-btn pd-btn--sm pd-btn--ghost" data-pd-popover-close>Cancel</button>
                <button type="submit" class="pd-btn pd-btn--sm pd-btn--primary"><i data-lucide="refresh-cw" aria-hidden="true"></i><span>Apply</span></button>
              </div>
            </form>
          </div>
        </div>
      </div>
      <div class="pd-grid-scroll">
        <table class="pd-table" id="triage-table"
               data-grid data-grid-label="workspaces" data-grid-search-placeholder="Search workspaces…"
               data-grid-empty="This scan contains no workspaces." data-grid-export-name="workspace-triage">
          <caption class="pd-visually-hidden">Workspaces ranked by risk score. Selection applies to the rows on the current page.</caption>
          <thead>
            <tr>
              <th scope="col" style="width:36px;" data-col-required data-no-export>
                <input type="checkbox" class="form-check-input" id="selectAllWs" onclick="toggleSelectAll(this.checked)" title="Select all visible" aria-label="Select all workspaces on this page">
              </th>
              <th scope="col" data-col="name" data-col-required>Workspace</th>
              <th scope="col" class="is-num" data-col="score" data-col-required data-col-label="Risk score">Risk score</th>
              <th scope="col" data-col="level" data-filter-col data-col-label="Risk level" data-filter-order="Critical|High|Medium|Low|Clean">Risk level</th>
              <th scope="col" data-col="owner">Owner</th>
              <th scope="col" data-col="access">Access</th>
              <th scope="col" data-col="content">Content</th>
              <th scope="col" data-col="capacity">Capacity</th>
              <th scope="col" data-col="status">Status</th>
              <th scope="col" data-col="findings" data-col-default="wide">Findings</th>
              <th scope="col" data-col="activity">Last activity</th>
              <th scope="col" class="is-num" data-col="items" data-col-default="hidden">Items</th>
              <th scope="col" class="is-num" data-col="users" data-col-default="hidden">Users</th>
              <th scope="col" class="is-num" data-col="storage" data-col-default="hidden">Storage</th>
              <th scope="col" data-col-required data-no-export><span class="pd-visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(ws, idx) {
                 var isDeleted = ws.state === 'Deleted';
                 var c = ctxById[ws.id] || {};
                 var band = ws.score > 0 ? (ws.band || { key: 'low', label: 'Low', color: severityColor(ws.highestSeverity) }) : (ws.band || { key: 'clean', label: 'Clean' });
                 var tone = bandTone(band);
                 var sum = ws.findings.map(function(f) { return f.label + ' +' + f.weight; }).join(', ');
                 var stale = ws.findings.some(function(f) { return f.key === 'staleContent'; });
            %>
            <tr data-filter="<%= (ws.name || '').toLowerCase() %>"
                data-findings="<%= ws.findings.map(function(f) { return f.key; }).join(' ') %>"
                data-clean="<%= ws.findings.length ? 'false' : 'true' %>"
                data-deleted="<%= isDeleted ? 'true' : 'false' %>"
                data-row-index="<%= idx %>"
                class="<%= isDeleted ? 'opacity-50' : '' %>">
              <td>
                <% if (!isDeleted) { %>
                  <input type="checkbox" class="form-check-input ws-select" value="<%= ws.id %>"
                         data-name="<%= ws.name %>" onchange="updateSelectionState()" aria-label="Select <%= ws.name %>">
                <% } %>
              </td>
              <td class="pd-cell-truncate" data-export-value="<%= ws.name %>">
                <a class="gov-ws-name" href="/workspaces/<%= ws.id %><%= runId ? '?runId=' + runId : '' %>"><i data-lucide="layers" aria-hidden="true"></i><span><%= ws.name %></span></a>
                <div class="pd-cell-sub"><%= ws.licenseType %><% if (ws.capacitySku) { %> · <%= ws.capacitySku %><% } %></div>
              </td>
              <td class="is-num" data-sort-value="<%= ws.score %>">
                <%# The sum is spelled out on hover, so the number can be checked rather than believed. %>
                <span class="gov-score gov-score--<%= tone %>" title="<%= band.label %> risk — <%= ws.score %> = <%= sum || 'nothing found by any check' %>"><%= ws.score %></span>
              </td>
              <td data-filter-value="<%= band.label %>" data-sort-value="<%= ws.score %>"><span class="pd-badge pd-badge--<%= tone %>"><%= band.label %></span></td>
              <td data-export-value="<%= c.owner || '' %>">
                <% if (c.owner) { %>
                  <span class="pd-person"><span class="pd-avatar" aria-hidden="true"><%= initials(c.owner) %></span><span><%= c.owner %></span></span>
                <% } else if (c.usersRead === false) { %>
                  <span class="pd-not-evaluated">Not available</span>
                <% } else if (ctxById[ws.id]) { %>
                  <span class="pd-badge pd-badge--danger">No user admin</span>
                <% } else { %>
                  <span class="pd-not-evaluated">Not available</span>
                <% } %>
              </td>
              <td class="text-nowrap">
                <% if (!ctxById[ws.id] || c.usersRead === false) { %><span class="pd-not-evaluated">Not available</span>
                <% } else if (c.groupCount) { %>Groups (<%= c.groupCount %>)
                <% } else { %>Individuals (<%= c.peopleCount %>)<% } %>
              </td>
              <td>
                <% if (!ws.totalItems) { %><span class="gov-content"><i data-lucide="inbox" aria-hidden="true"></i>Empty</span>
                <% } else if (stale) { %><span class="gov-content is-stale"><i data-lucide="circle-x" aria-hidden="true"></i>Stale (<%= ws.lastActivityDays %>d)</span>
                <% } else if (ws.lastActivityDays !== null && ws.lastActivityDays !== undefined) { %><span class="gov-content is-active"><i data-lucide="circle-check" aria-hidden="true"></i>Active (<%= ws.lastActivityDays %>d)</span>
                <% } else { %><span class="pd-not-evaluated">Not available</span><% } %>
              </td>
              <td><%= c.capacityName || ws.capacitySku || 'Shared' %></td>
              <td class="ws-status-cell" data-ws-id="<%= ws.id %>">
                <% if (isDeleted) { %>
                  <span class="badge bg-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>Deleted</span>
                  <% if (ws.deletedAt) { %>
                    <div class="pd-cell-sub"><time datetime="<%= new Date(ws.deletedAt).toISOString() %>" data-local-time><%= new Date(ws.deletedAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time></div>
                  <% } %>
                <% } else if (ws.state && ws.state !== '-' && ws.state !== 'Active') { %>
                  <span class="badge bg-warning"><%= ws.state %></span>
                <% } else { %>
                  <span class="badge bg-success">Active</span>
                <% } %>
              </td>
              <td data-sort-value="<%= ws.findings.length %>" data-export-value="<%= ws.findings.map(function(f) { return f.label; }).join('; ') %>">
                <% if (!ws.findings.length) { %><span class="pd-not-evaluated">None</span>
                <% } else { %>
                  <span class="pd-badge pd-badge--<%= severityColor(ws.findings[0].severity) === 'secondary' ? 'neutral' : severityColor(ws.findings[0].severity) %>" title="<%= ws.findings[0].detail %>"><%= ws.findings[0].label %></span>
                  <% if (ws.findings.length > 1) { %><span class="pd-cell-sub" title="<%= ws.findings.slice(1).map(function(f) { return f.label; }).join(', ') %>">+<%= ws.findings.length - 1 %></span><% } %>
                <% } %>
              </td>
              <td data-sort-value="<%= ws.lastActivityDays === null ? 999999 : ws.lastActivityDays %>">
                <% if (ws.lastActivity) { %><time datetime="<%= ws.lastActivity %>" data-local-time data-date-only><%= ws.lastActivity.slice(0, 10) %></time>
                <% } else { %><span class="pd-not-evaluated">Not available</span><% } %>
              </td>
              <td class="is-num"><%= ws.totalItems %></td>
              <td class="is-num"><%= ws.userCount %></td>
              <td class="is-num" data-sort-value="<%= ws.storageSize || 0 %>"><%= formatBytesWs(ws.storageSize) %></td>
              <td class="text-nowrap">
                <div class="pd-popover-anchor">
                  <button type="button" class="pd-icon-btn pd-icon-btn--sm" data-pd-popover="rowMenu-<%= idx %>" aria-controls="rowMenu-<%= idx %>" aria-expanded="false" aria-haspopup="menu" aria-label="Actions for <%= ws.name %>"><i data-lucide="ellipsis" aria-hidden="true"></i></button>
                  <div class="pd-popover pd-popover--end pd-menu" id="rowMenu-<%= idx %>" role="menu" hidden>
                    <button type="button" class="pd-menu-item" role="menuitem" onclick="Podavo.popover.close(); showWorkspaceFindings(<%= idx %>, this.closest('td').querySelector('[data-pd-popover]'))"><i data-lucide="panel-right" aria-hidden="true"></i>Show details</button>
                    <a class="pd-menu-item" role="menuitem" href="/workspaces/<%= ws.id %><%= runId ? '?runId=' + runId : '' %>"><i data-lucide="external-link" aria-hidden="true"></i>Open workspace</a>
                    <% if (!isDeleted) { %>
                      <div class="pd-menu-sep" role="separator"></div>
                      <button type="button" class="pd-menu-item pd-menu-item--danger ws-delete-btn" role="menuitem" title="Check workspace status before deleting" disabled
                              onclick="Podavo.popover.close(); confirmDeleteOne('<%= ws.id %>', '<%= (ws.name || '').replace(/'/g, "\\'") %>')">
                        <i data-lucide="trash-2" aria-hidden="true"></i>Delete workspace…
                      </button>
                    <% } %>
                  </div>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <%- include(pd + 'drawer', { ui: { id: 'workspaceDrawer', title: 'Workspace' } }) %>
  </div>

  <!-- How the Risk score works. Kept one click from the table, not in a tooltip:
       a ranking nobody can explain is a ranking nobody acts on. -->
  <dialog class="pd-dialog pd-dialog--lg" id="riskExplainerDialog" aria-labelledby="riskExplainerTitle">
    <div class="pd-dialog-header">
      <h2 class="pd-dialog-title" id="riskExplainerTitle">How the Risk score works</h2>
      <button type="button" class="pd-icon-btn" style="margin-left:auto" data-pd-dialog-close aria-label="Close"><i data-lucide="x" aria-hidden="true"></i></button>
    </div>
    <div class="pd-dialog-body">
      <p>
        Every check below that fires on a workspace adds its weight to that workspace's score, and the
        <strong>Risk score</strong> column is the total. Nothing is averaged and nothing is capped, so the number is a measure
        of <em>how much is wrong</em>, not a percentage: two medium problems outrank one, and one severe problem outranks
        several trivial ones. The highest possible score with every check firing at once is <%= data.maxScore || 0 %>.
      </p>
      <div class="d-flex flex-wrap gap-2 mb-2">
        <% bands.forEach(function(band) { %>
          <span class="pd-badge pd-badge--<%= bandTone(band) %>" title="<%= band.description %>"><%= band.label %><%= band.min > 0 ? ' — ' + band.min + '+' : ' — 0' %></span>
        <% }) %>
      </div>
      <p class="pd-help">
        A score is only ever about what the scan could see. A workspace whose access list could not be read is not
        scored on access at all — that is a gap in the evidence, not a clean result.
      </p>
      <div class="pd-grid-scroll" style="max-height:none;border:1px solid var(--pd-border);border-radius:var(--pd-radius-md);">
        <table class="pd-table" data-no-sort>
          <thead>
            <tr><th scope="col" style="width:70px;">Weight</th><th scope="col">Check</th><th scope="col">Severity</th><th scope="col">What it means</th><th scope="col" class="is-num">Workspaces</th></tr>
          </thead>
          <tbody>
            <% findingDefs.forEach(function(def) { var off = def.key === 'namingConvention' && !data.namingConventionEnabled; %>
              <tr class="<%= off ? 'opacity-50' : '' %>">
                <td><span class="pd-badge pd-badge--<%= TILE_TONE[def.severity] || 'neutral' %>">+<%= def.weight %></span></td>
                <td><strong><%= def.label %></strong></td>
                <td class="text-capitalize"><%= def.severity %></td>
                <td><%= def.description %>
                  <% if (off) { %><em>Not enforced — <a href="/settings/governance">define a convention</a> to switch this check on.</em><% } %>
                  <% if (def.key === 'staleContent') { %><em>Currently <%= thresholds.staleDays %> days.</em><% } %>
                  <% if (def.key === 'overShared') { %><em>Currently <%= thresholds.overSharedUsers %> principals.</em><% } %>
                </td>
                <td class="is-num"><%= off ? 'Not evaluated' : ((data.byFinding || {})[def.key] || 0) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="pd-help mt-3 mb-0">
        <strong>No group-based access</strong> is the one to read carefully: it fires when every principal holding a role is an
        individual account and no security group holds any. That access has to be maintained by hand, so it survives the person
        leaving. <a href="/settings/access/roles">Grant a security group a role</a> to resolve it.
      </p>
    </div>
    <div class="pd-dialog-footer"><button type="button" class="pd-btn pd-btn--primary" data-pd-dialog-close>Close</button></div>
  </dialog>

  <!-- Delete confirmation modal -->
  <div class="modal fade" id="deleteWsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete workspaces</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">This permanently deletes the following workspace(s) and all their content in Fabric. This cannot be undone.</p>
          <ul class="small mb-3" id="deleteWsList"></ul>
          <p class="text-muted small mb-2">The workspaces stay in this application's records with status <span class="badge bg-danger">Deleted</span>, so past scan results remain available.</p>
          <label class="form-label small" for="deleteWsConfirm">Type <strong>DELETE</strong> to confirm</label>
          <input type="text" class="form-control form-control-sm" id="deleteWsConfirm" autocomplete="off" oninput="onDeleteConfirmInput()">
        </div>
        <div class="modal-footer">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-sm btn-danger" id="deleteWsConfirmBtn" onclick="performDelete()" disabled>
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Failure details, with an explanation of the status code -->
  <div class="modal fade" id="errorDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title"><i class="bi bi-exclamation-octagon text-danger me-2"></i>Deletion errors</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="errorDetailsBody"></div>
        <div class="modal-footer">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Fabric administrator authorization prompt -->
  <div class="modal fade" id="adminAuthModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title"><i class="bi bi-shield-lock text-warning me-2"></i>Fabric administrator sign-in required</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-3" id="adminAuthMessage"></p>
          <p class="text-muted small mb-0">
            Deleting a workspace requires the <strong>Admin</strong> role on that workspace. Signing in as a Fabric
            administrator lets the application grant the service principal that role and retry the deletion automatically.
          </p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-sm btn-primary" id="adminAuthConfirmBtn">
            <i class="bi bi-box-arrow-in-right me-1"></i>Authorize as Fabric Admin
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
  // Embedded as JSON with "<" escaped, so a workspace name containing a closing
  // script tag stays data instead of ending this block.
  var triageRows = <%- JSON.stringify(rows.map(function(w) { return {
    id: w.id, name: w.name, findings: w.findings, state: w.state, licenseType: w.licenseType, capacitySku: w.capacitySku,
    totalItems: w.totalItems, userCount: w.userCount, adminCount: w.adminCount, humanAdminCount: w.humanAdminCount,
    storageSize: w.storageSize, lastActivity: w.lastActivity, lastActivityDays: w.lastActivityDays, score: w.score,
    band: w.band ? { key: w.band.key, label: w.band.label, color: w.band.color, description: w.band.description } : null,
    context: ctxById[w.id] || null, capacityName: (ctxById[w.id] || {}).capacityName || null
  }; })).replace(/</g, '\\u003c') %>;
  var bandTones = <%- JSON.stringify(BAND_TONE) %>;
  var findingIcons = <%- JSON.stringify(FINDING_ICON) %>;
  var canGrantRoles = <%= typeof permissions !== 'undefined' && permissions && permissions.isAdmin ? 'true' : 'false' %>;
  var findingLabels = <%- JSON.stringify(findingDefs.reduce(function(acc, d) { acc[d.key] = d.label; return acc; }, {})).replace(/</g, '\\u003c') %>;
  var triageRunId = <%= runId ? runId : 'null' %>;
  var activeFinding = '';
  var showClean = false;
  var triageGrid;
  var deleteWsModal;
  var adminAuthModal;
  var pendingDeletions = [];
  // Deletion stays locked until the live Fabric status has been confirmed.
  var statusVerified = false;

  // ── Live status check ──
  function setRowStatus(id, html, opts) {
    var cell = document.querySelector('.ws-status-cell[data-ws-id="' + id + '"]');
    if (cell) cell.innerHTML = html;

    var row = cell ? cell.closest('tr') : null;
    if (!row) return;
    var deletable = !!(opts && opts.deletable);
    row.setAttribute('data-deleted', deletable ? 'false' : 'true');

    var box = row.querySelector('.ws-select');
    if (box && !deletable) { box.checked = false; box.disabled = true; }
    else if (box) box.disabled = false;

    var btn = row.querySelector('.ws-delete-btn');
    if (btn) {
      btn.disabled = !deletable;
      btn.title = deletable ? 'Delete workspace' : ((opts && opts.reason) || 'This workspace cannot be deleted');
    }
  }

  async function checkWorkspaceStatus() {
    var btn = document.getElementById('checkStatusBtn');
    var badge = document.getElementById('statusCheckBadge');
    var ids = triageRows.map(function(r) { return r.id; });
    if (!ids.length) return;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking ' + ids.length + '...';
    badge.className = 'badge bg-secondary';
    badge.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Checking status...';

    try {
      var res = await fetch('/workspaces/status-check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: ids })
      });
      var data = await res.json();
      if (!data.success) throw new Error(describeFailure(data));

      data.statuses.forEach(function(s) {
        if (s.exists === true) {
          var active = !s.state || s.state === 'Active';
          setRowStatus(s.id, '<span class="badge bg-' + (active ? 'success' : 'warning') + '">' +
            escapeHtml(s.state || 'Active') + '</span>', { deletable: true });
        } else if (s.exists === false) {
          setRowStatus(s.id, '<span class="badge bg-danger"><i class="bi bi-trash me-1"></i>Deleted</span>' +
            '<div class="text-muted" style="font-size:0.7rem;">no longer in the tenant</div>',
            { deletable: false, reason: 'This workspace no longer exists' });
        } else {
          setRowStatus(s.id, '<span class="badge bg-secondary" title="' + escapeHtml(s.error || '') + '">Unknown</span>' +
            '<div class="text-muted" style="font-size:0.7rem;">' + escapeHtml(s.hint ? 'permission issue' : 'not readable') + '</div>',
            { deletable: false, reason: s.error || 'Current status could not be read' });
        }
      });

      statusVerified = true;
      badge.className = 'badge bg-success';
      badge.innerHTML = '<i class="bi bi-shield-check me-1"></i>Verified ' + new Date(data.checkedAt).toLocaleTimeString() +
        ' &middot; ' + data.activeCount + ' active, ' + data.deletedCount + ' deleted' +
        (data.unknownCount ? ', ' + data.unknownCount + ' unknown' : '');
      updateSelectionState();
      if (data.unknownCount) {
        showToast(data.unknownCount + ' workspace(s) could not be read — deletion stays disabled for those.', 'error');
      }
    } catch (e) {
      statusVerified = false;
      badge.className = 'badge bg-danger';
      badge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Status check failed';
      showToast(e.message, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Re-check workspace status';
      updateSelectionState();
    }
  }

  // Turn an API failure into something that explains itself.
  function describeFailure(data) {
    if (!data) return 'Request failed';
    var parts = [];
    if (data.status && data.statusTitle) parts.push(data.status + ' ' + data.statusTitle);
    if (data.message) parts.push(data.message);
    if (data.explanation) parts.push(data.explanation);
    if (data.hint) parts.push('What to do: ' + data.hint);
    return parts.length ? parts.join(' — ') : 'Request failed';
  }

  document.addEventListener('DOMContentLoaded', function() {
    deleteWsModal = new bootstrap.Modal(document.getElementById('deleteWsModal'));
    adminAuthModal = new bootstrap.Modal(document.getElementById('adminAuthModal'));

    var table = document.getElementById('triage-table');
    triageGrid = DataGrid.get(table);
    // Every redraw — search, filter, sort or page change — goes through here, so the
    // deletion safeguards below hold however the visible rows were arrived at.
    table.addEventListener('grid:render', onTriageRender);
    // A click anywhere on a row (other than its own controls) opens its details.
    // The details button in the last column is the keyboard route to the same place.
    table.tBodies[0].addEventListener('click', function(e) {
      if (e.target.closest('a, button, input, label')) return;
      var row = e.target.closest('tr[data-row-index]');
      if (row) showWorkspaceFindings(Number(row.getAttribute('data-row-index')), row.querySelector('button'));
    });

    // Deep links from the overview and the global search: ?finding=<key>&q=<text>
    var params = new URLSearchParams(window.location.search);
    var finding = params.get('finding');
    if (finding && Object.prototype.hasOwnProperty.call(findingLabels, finding)) activeFinding = finding;
    var q = params.get('q');
    if (q && triageGrid.searchInput) {
      triageGrid.searchInput.value = q;
      triageGrid.term = q.trim().toLowerCase();
      // A search by name should find a workspace even when it has nothing wrong.
      showClean = true;
      syncShowCleanButton();
    }
    applyTriageFilter();
  });

  function setFindingFilter(key) {
    // Selecting the active finding again clears the filter, like any toggle.
    activeFinding = key && key === activeFinding ? '' : key;
    if (activeFinding) showClean = false;
    syncShowCleanButton();
    applyTriageFilter();
  }

  function syncShowCleanButton() {
    var btn = document.getElementById('showAllBtn');
    btn.textContent = showClean ? 'Hide clean workspaces' : 'Include clean workspaces';
    btn.setAttribute('aria-pressed', showClean ? 'true' : 'false');
  }

  function toggleShowClean() {
    showClean = !showClean;
    syncShowCleanButton();
    applyTriageFilter();
  }

  function applyTriageFilter() {
    if (!triageGrid) return;
    triageGrid.setFilter('triage', function(row) {
      var isClean = row.getAttribute('data-clean') === 'true';
      var matchesFinding = !activeFinding || (row.getAttribute('data-findings') || '').split(' ').indexOf(activeFinding) !== -1;
      return matchesFinding && (showClean || !isClean);
    });
    triageGrid.refresh();
  }

  function onTriageRender(e) {
    document.querySelectorAll('#triage-table tbody tr').forEach(function(row) {
      // Hidden rows must never stay selected, otherwise a filtered-out workspace
      // (or one on another page) could be deleted without the user seeing it in
      // the confirmation list.
      if (row.style.display === 'none') {
        var box = row.querySelector('.ws-select');
        if (box) box.checked = false;
      }
    });
    updateSelectionState();

    var shown = e.detail.matched;
    var label = 'Showing ' + shown + ' workspace' + (shown === 1 ? '' : 's');
    if (activeFinding) {
      label += ' — ' + (findingLabels[activeFinding] || activeFinding);
    } else if (!showClean) {
      label += ' needing attention';
    }
    document.getElementById('triageFilterLabel').textContent = label;
    document.querySelectorAll('#findingTiles [data-filter-key]').forEach(function(tile) {
      tile.setAttribute('aria-pressed', tile.getAttribute('data-filter-key') === activeFinding ? 'true' : 'false');
    });
  }

  function escapeHtml(str) {
    return String(str === null || str === undefined ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function formatBytes(bytes) {
    if (!bytes) return null;
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
  }

  // Details open beside the list (docked on wide screens, as an overlay otherwise),
  // so a reviewer can work down the ranking without losing place, filters or selection.
  function initialsOf(name) {
    return String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(function(w) { return w.charAt(0); }).join('').toUpperCase();
  }
  function showWorkspaceFindings(index, opener) {
    var ws = triageRows[index];
    if (!ws) return;
    var c = ws.context || {};
    var href = '/workspaces/' + encodeURIComponent(ws.id) + (triageRunId ? '?runId=' + triageRunId : '');
    var na = '<span class="pd-not-evaluated">Not available</span>';
    var tone = ws.band ? (bandTones[ws.band.key] || 'neutral') : 'success';
    function val(v) { return v === null || v === undefined || v === '' ? na : escapeHtml(v); }
    function fact(label, value) { return '<div class="gov-fact"><span class="gov-fact-label">' + escapeHtml(label) + '</span><span class="gov-fact-value">' + value + '</span></div>'; }

    document.getElementById('workspaceDrawer-title').innerHTML = '<i data-lucide="layers" aria-hidden="true"></i> ' + escapeHtml(ws.name);
    document.getElementById('workspaceDrawer-subtitle').textContent =
      (ws.licenseType || '') + (ws.capacitySku ? ' · ' + ws.capacitySku : '') + (ws.state && ws.state !== '-' ? ' · ' + ws.state : '');

    var sum = ws.findings.map(function(f) { return f.label + ' +' + f.weight; }).join(', ');
    var owner = c.owner
      ? '<span class="pd-person"><span class="pd-avatar" aria-hidden="true">' + escapeHtml(initialsOf(c.owner)) + '</span><span>' + escapeHtml(c.owner) + '</span></span>'
      : (c.usersRead === false || !ws.context ? na : '<span class="pd-badge pd-badge--danger">No user admin</span>');

    var overview =
      '<div class="gov-drawer-score">' +
        '<span class="gov-score gov-score--' + tone + '">' + ws.score + '</span>' +
        '<span class="pd-badge pd-badge--' + tone + '">' + escapeHtml(ws.band ? ws.band.label + ' risk' : 'Clean') + '</span>' +
      '</div>' +
      '<p class="pd-help mt-2 mb-0">' + (ws.findings.length ? escapeHtml(sum) + ' = ' + ws.score : 'Nothing found by any check.') + '</p>' +
      '<div class="gov-drawer-facts">' +
        fact('Owner', owner) +
        fact('Capacity', val(ws.capacityName || ws.capacitySku || 'Shared')) +
        fact('Users with access', val(ws.userCount)) +
        fact('Admins', val(ws.adminCount + (ws.adminCount && ws.humanAdminCount !== ws.adminCount ? ' (' + ws.humanAdminCount + ' user)' : ''))) +
      '</div>';

    var findingsHtml = ws.findings.length ? ws.findings.map(function(f) {
      return '<div class="gov-finding"><span class="gov-finding-icon sev-' + escapeHtml(f.severity) + '" aria-hidden="true"><i data-lucide="' + escapeHtml(findingIcons[f.key] || 'circle-alert') + '"></i></span>' +
        '<div class="pd-min-w-0"><div class="gov-finding-title">' + escapeHtml(f.label) +
        ' <span class="pd-badge pd-badge--' + (f.severity === 'high' ? 'danger' : f.severity === 'medium' ? 'orange' : 'neutral') + '">' + escapeHtml(f.severity) + ' · +' + f.weight + '</span></div>' +
        '<div class="gov-finding-detail">' + escapeHtml(f.detail) + '</div>' +
        '<div class="gov-finding-desc">' + escapeHtml(f.description) + '</div></div></div>';
    }).join('') : '<p class="pd-help mb-0">No findings for this workspace.</p>';

    var access = '<dl class="pd-meta">' +
      '<dt>Owner</dt><dd>' + owner + '</dd>' +
      '<dt>Principals with access</dt><dd>' + val(ws.userCount) + '</dd>' +
      '<dt>Admins</dt><dd>' + val(ws.adminCount) + '</dd>' +
      '<dt>User admins</dt><dd>' + val(ws.humanAdminCount) + '</dd>' +
      '<dt>Security groups</dt><dd>' + (ws.context && c.usersRead !== false ? escapeHtml(c.groupCount) : na) + '</dd>' +
      '<dt>Individual accounts</dt><dd>' + (ws.context && c.usersRead !== false ? escapeHtml(c.peopleCount) : na) + '</dd></dl>' +
      (canGrantRoles && ws.findings.some(function(f) { return f.key === 'personalAccess' || f.key === 'ownerless' || f.key === 'singleAdmin' || f.key === 'orphanedAdmin'; })
        ? '<p class="pd-help mt-3 mb-0">Access findings are resolved by giving a security group a role. <a href="/settings/access/roles">Grant a security group a role</a>.</p>' : '');

    var content = '<dl class="pd-meta">' +
      '<dt>Items</dt><dd>' + val(ws.totalItems) + '</dd>' +
      '<dt>Storage</dt><dd>' + val(formatBytes(ws.storageSize)) + '</dd>' +
      '<dt>Status</dt><dd>' + (ws.findings.some(function(f) { return f.key === 'staleContent'; }) ? '<span class="gov-content is-stale">Stale</span>' : ws.totalItems ? '<span class="gov-content is-active">Active</span>' : 'Empty') + '</dd></dl>';

    var activity = '<dl class="pd-meta">' +
      '<dt>Newest item updated</dt><dd>' + (ws.lastActivity ? '<time datetime="' + escapeHtml(ws.lastActivity) + '" data-local-time data-date-only>' + escapeHtml(ws.lastActivity.slice(0, 10)) + '</time>' : na) + '</dd>' +
      '<dt>Days before the scan</dt><dd>' + val(ws.lastActivityDays) + '</dd>' +
      '<dt>Workspace ID</dt><dd><code>' + escapeHtml(ws.id) + '</code></dd></dl>' +
      '<p class="pd-help mt-3 mb-0">Activity history beyond the newest item is not collected by the scan.</p>';

    var tabs = [['overview', 'Overview', overview], ['findings', 'Findings (' + ws.findings.length + ')', findingsHtml],
      ['access', 'Access', access], ['content', 'Content', content], ['activity', 'Activity', activity]];
    document.getElementById('workspaceDrawer-body').innerHTML =
      '<div class="pd-tabs mb-3" role="tablist" aria-label="Workspace details">' + tabs.map(function(t, i) {
        return '<button type="button" class="pd-tab" role="tab" id="wsTab-' + t[0] + '" aria-controls="wsPanel-' + t[0] + '" aria-selected="' + (i === 0) + '" tabindex="' + (i === 0 ? 0 : -1) + '">' + escapeHtml(t[1]) + '</button>';
      }).join('') + '</div>' +
      tabs.map(function(t, i) {
        return '<section class="pd-tabpanel" role="tabpanel" id="wsPanel-' + t[0] + '" aria-labelledby="wsTab-' + t[0] + '"' + (i === 0 ? '' : ' hidden') + '>' + t[2] +
          (t[0] === 'overview' && ws.findings.length ? '<h3 class="gov-section-title mt-4">Top findings</h3>' + ws.findings.slice(0, 3).map(function(f) {
            return '<div class="gov-finding"><span class="gov-finding-icon sev-' + escapeHtml(f.severity) + '" aria-hidden="true"><i data-lucide="' + escapeHtml(findingIcons[f.key] || 'circle-alert') + '"></i></span>' +
              '<div><div class="gov-finding-title">' + escapeHtml(f.label) + '</div><div class="gov-finding-desc">' + escapeHtml(f.detail) + '</div></div></div>';
          }).join('') : '') + '</section>';
      }).join('');
    document.getElementById('workspaceDrawer-footer').innerHTML =
      '<a class="pd-btn pd-btn--primary" href="' + escapeHtml(href) + '"><i data-lucide="external-link" aria-hidden="true"></i><span>Open workspace</span></a>' +
      '<button type="button" class="pd-btn" data-pd-drawer-close><span>Close</span></button>';
    if (window.Podavo) Podavo.localTime(document.getElementById('workspaceDrawer'));

    document.querySelectorAll('#triage-table tbody tr.is-selected').forEach(function(r) { r.classList.remove('is-selected'); });
    var row = document.querySelector('#triage-table tbody tr[data-row-index="' + index + '"]');
    if (row) row.classList.add('is-selected');
    Drawer.open('workspaceDrawer', opener);
  }

  document.addEventListener('drawer:close', function() {
    document.querySelectorAll('#triage-table tbody tr.is-selected').forEach(function(r) { r.classList.remove('is-selected'); });
  });

  // ── Workspace deletion ──

  function getSelectedWorkspaces() {
    var selected = [];
    document.querySelectorAll('#triage-table tbody tr').forEach(function(row) {
      if (row.style.display === 'none') return;
      var box = row.querySelector('.ws-select');
      if (box && box.checked) selected.push({ id: box.value, name: box.getAttribute('data-name') || box.value });
    });
    return selected;
  }

  function updateSelectionState() {
    var count = getSelectedWorkspaces().length;
    document.getElementById('selectedCount').textContent = count;
    // Deleting is only offered once the live status has been confirmed, so a stale
    // scan can never be used to delete a workspace that has already changed.
    document.getElementById('deleteSelectedBtn').disabled = count === 0 || !statusVerified;

    var visibleBoxes = [];
    document.querySelectorAll('#triage-table tbody tr').forEach(function(row) {
      if (row.style.display === 'none') return;
      var box = row.querySelector('.ws-select');
      if (box) visibleBoxes.push(box);
    });
    var selectAll = document.getElementById('selectAllWs');
    selectAll.checked = visibleBoxes.length > 0 && count === visibleBoxes.length;
    selectAll.indeterminate = count > 0 && count < visibleBoxes.length;
  }

  function toggleSelectAll(checked) {
    document.querySelectorAll('#triage-table tbody tr').forEach(function(row) {
      if (row.style.display === 'none') return;
      var box = row.querySelector('.ws-select');
      if (box) box.checked = checked;
    });
    updateSelectionState();
  }

  function openDeleteModal(targets) {
    pendingDeletions = targets;
    document.getElementById('deleteWsList').innerHTML = targets.map(function(t) {
      return '<li>' + escapeHtml(t.name) + '</li>';
    }).join('');
    var confirmInput = document.getElementById('deleteWsConfirm');
    confirmInput.value = '';
    document.getElementById('deleteWsConfirmBtn').disabled = true;
    deleteWsModal.show();
  }

  function onDeleteConfirmInput() {
    var value = (document.getElementById('deleteWsConfirm').value || '').trim().toUpperCase();
    document.getElementById('deleteWsConfirmBtn').disabled = value !== 'DELETE';
  }

  function confirmDeleteOne(id, name) {
    openDeleteModal([{ id: id, name: name || id }]);
  }

  function confirmDeleteSelected() {
    var selected = getSelectedWorkspaces();
    if (!selected.length) return;
    openDeleteModal(selected);
  }

  // Showing a second modal while the first is still animating out leaves a stuck
  // backdrop, so wait for the delete modal to finish hiding.
  function showAdminAuthPrompt(message, authUrl) {
    document.getElementById('adminAuthMessage').textContent = message ||
      'The service principal is not an Admin on these workspaces.';

    var confirmBtn = document.getElementById('adminAuthConfirmBtn');
    confirmBtn.onclick = function() {
      sessionStorage.setItem('pendingWorkspaceDeletions', JSON.stringify(pendingDeletions));
      window.location.href = authUrl;
    };

    var deleteEl = document.getElementById('deleteWsModal');
    if (deleteEl.classList.contains('show')) {
      deleteEl.addEventListener('hidden.bs.modal', function once() {
        deleteEl.removeEventListener('hidden.bs.modal', once);
        adminAuthModal.show();
      });
      deleteWsModal.hide();
    } else {
      adminAuthModal.show();
    }
  }

  // Explain each failure rather than dropping a raw status code into a toast.
  function showErrorDetails(failures, fallbackMessage) {
    var html = failures.map(function(f) {
      var head = escapeHtml(f.name || f.id || 'Workspace');
      var code = f.status ? '<span class="badge bg-danger me-2">' + f.status + ' ' + escapeHtml(f.statusTitle || '') + '</span>' : '';
      var body = '<div class="small mb-1">' + escapeHtml(f.message || fallbackMessage || 'Failed') + '</div>';
      if (f.explanation) {
        body += '<div class="small text-muted mb-1"><i class="bi bi-info-circle me-1"></i>' + escapeHtml(f.explanation) + '</div>';
      }
      if (f.hint) {
        body += '<div class="small"><i class="bi bi-lightbulb me-1 text-warning"></i><strong>What to do:</strong> ' + escapeHtml(f.hint) + '</div>';
      }
      return '<div class="border rounded p-2 mb-2"><div class="mb-1">' + code + '<strong>' + head + '</strong></div>' + body + '</div>';
    }).join('');

    document.getElementById('errorDetailsBody').innerHTML = html;
    var el = document.getElementById('errorDetailsModal');
    var modal = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
    modal.show();
  }

  async function performDelete() {
    var btn = document.getElementById('deleteWsConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...';
    try {
      var res = await fetch('/workspaces/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ workspaces: pendingDeletions })
      });
      var data = await res.json();

      // The service principal is not a workspace Admin. Offer to sign in as a Fabric
      // administrator so the app can grant that role and retry. Handled before the
      // delete modal is dismissed so the two modals hand over cleanly.
      if (data.requiresAdminAuth) {
        showAdminAuthPrompt(data.message, data.authUrl);
        return;
      }

      deleteWsModal.hide();

      if (data.deletedCount) {
        showToast('Deleted ' + data.deletedCount + ' workspace' + (data.deletedCount === 1 ? '' : 's') +
          (data.failedCount ? ', ' + data.failedCount + ' failed' : ''), data.failedCount ? 'error' : 'success');
      }

      var failures = (data.results || []).filter(function(r) { return !r.success; });
      if (failures.length) {
        // Reloading would tear the explanation away before it can be read, so the
        // page only refreshes once the user dismisses the error list.
        showErrorDetails(failures, data.message);
        if (data.deletedCount) {
          document.getElementById('errorDetailsModal').addEventListener('hidden.bs.modal', function once() {
            window.location.reload();
          }, { once: true });
        }
      } else if (!data.deletedCount) {
        showToast(data.message || 'Deletion failed', 'error');
      } else {
        setTimeout(function() { window.location.reload(); }, 1500);
      }
    } catch (e) {
      showToast(e.message, 'error');
    } finally {
      btn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
      btn.disabled = false;
    }
  }

  // Returning from the Fabric administrator sign-in: pick the deletion back up so
  // the user does not have to reselect the workspaces.
  (function resumePendingDeletion() {
    if (new URLSearchParams(window.location.search).get('grantAuth') !== 'success') return;
    var stored = sessionStorage.getItem('pendingWorkspaceDeletions');
    sessionStorage.removeItem('pendingWorkspaceDeletions');
    if (!stored) return;
    try {
      var targets = JSON.parse(stored);
      if (targets && targets.length) openDeleteModal(targets);
    } catch (e) { /* nothing worth resuming */ }
  })();
  </script>
<% } %>

