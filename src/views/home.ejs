<%- include('./partials/header') %>
<% var homeSections = (typeof visibleSections !== 'undefined' && visibleSections ? visibleSections : []).map(function(s) { return s.key; });
   var homeRun = typeof globalRun !== 'undefined' ? globalRun : null;
   var hasOutcome = typeof outcomeTenantId !== 'undefined' && !!outcomeTenantId; %>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-house me-2"></i>Welcome to Fabric Governance</h2>
    <p class="mb-0" style="color: var(--color-text-muted);">Your central hub for investigating Power BI &amp; Microsoft Fabric workspaces, reports, datasets, and all available metadata across your tenant.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% if (homeRun && homeSections.indexOf('governance') !== -1) { %>
      <a class="btn btn-sm btn-outline-primary text-nowrap" href="/governance/changes?runId=<%= homeRun.id %>" title="Compare the latest scan of <%= homeRun.sp_name || 'this principal' %> with its previous scan">
        <i class="bi bi-clock-history me-1" aria-hidden="true"></i>Since last scan
      </a>
    <% } %>
    <a class="btn btn-sm btn-outline-secondary text-nowrap" href="/getting-started">
      <i class="bi bi-clipboard-check me-1" aria-hidden="true"></i>Getting started &amp; prerequisites
    </a>
  </div>
</div>

<% if (hasOutcome) { %>
  <%- include('./partials/governance-outcome') %>
<% } else { %>
  <%# Nothing to show yet: a new installation, or no scan this reader may see. %>
  <%- include('./partials/getting-started-body') %>
<% } %>

<%- include('./partials/footer') %>
