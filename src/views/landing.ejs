<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Power BI Governance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="landing-hero">
    <div class="landing-card">
      <div class="landing-logo">G</div>
      <h1>Power BI Governance</h1>
      <p>Investigate Power BI &amp; Microsoft Fabric workspaces, reports, datasets, and all available metadata across your tenant.</p>

      <div class="landing-features">
        <span class="feature-pill"><i class="bi bi-collection"></i> Workspaces</span>
        <span class="feature-pill"><i class="bi bi-file-earmark-bar-graph"></i> Reports</span>
        <span class="feature-pill"><i class="bi bi-database"></i> Semantic Models</span>
        <span class="feature-pill"><i class="bi bi-shield-check"></i> Governance</span>
        <span class="feature-pill"><i class="bi bi-people"></i> User 360</span>
        <span class="feature-pill"><i class="bi bi-lightning"></i> Capacities</span>
      </div>

      <a href="/.auth/login/aad?post_login_redirect_uri=<%= encodeURIComponent('/governance') %>" class="btn-sign-in">
        <i class="bi bi-microsoft"></i> Sign in with Microsoft
      </a>

      <div style="margin-top: 1.5rem; color: var(--color-text-muted); font-size: 0.85rem;">
        <i class="bi bi-lock me-1"></i> Protected by Microsoft Entra ID
      </div>
    </div>
  </div>
</body>
</html>
