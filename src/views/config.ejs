<%- include('partials/header') %>
<div class="row">
  <div class="col-lg-8 mx-auto">
    <h2><i class="bi bi-gear me-2"></i>Settings</h2>
    <p class="text-muted">Manage service principals for Power BI API access.</p>

    <div id="flash-messages">
      <% if (success && success.length) { %>
        <% success.forEach(function(message) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
      <% if (error && error.length) { %>
        <% error.forEach(function(message) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0"><i class="bi bi-key me-2"></i>Service Principals (<%= servicePrincipals.length %>)</h5>
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#spModal" onclick="openSpForm()">
        <i class="bi bi-plus-lg me-1"></i>Add Service Principal
      </button>
    </div>

    <% if (!servicePrincipals.length) { %>
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>No service principals configured. Add one to start using the Power BI API.
      </div>
    <% } %>

    <% servicePrincipals.forEach(function(sp) { %>
      <div class="card mb-3">
        <div class="card-body py-2 d-flex justify-content-between align-items-center gap-3 flex-wrap">
          <h6 class="mb-0"><i class="bi bi-key me-2"></i><%= sp.name %></h6>
          <div class="btn-group btn-group-sm ms-auto">
           <button class="btn btn-outline-secondary" onclick="testSP(<%= sp.id %>)">
             <i class="bi bi-plug me-1"></i>Test
           </button>
           <button
             class="btn btn-outline-primary"
             data-bs-toggle="modal"
             data-bs-target="#spModal"
             data-sp-id="<%= sp.id %>"
             data-sp-name="<%= sp.name %>"
             data-sp-tenant-id="<%= sp.tenant_id %>"
             data-sp-client-id="<%= sp.client_id %>"
             data-sp-eaoid="<%= sp.enterprise_app_object_id || '' %>"
             onclick="openSpForm(this)"
           >
             <i class="bi bi-pencil me-1"></i>Edit
           </button>
           <button class="btn btn-outline-danger" onclick="if(confirm('Delete this service principal?')) document.getElementById('delete-sp-<%= sp.id %>').submit()">
             <i class="bi bi-trash me-1"></i>Delete
           </button>
          </div>
          <form id="delete-sp-<%= sp.id %>" method="POST" action="/settings/sp/delete/<%= sp.id %>" style="display:none;"></form>
        </div>
        <div id="test-result-<%= sp.id %>" class="px-3 pb-2" style="display:none;"></div>
      </div>
    <% }) %>
  </div>
</div>

<div class="modal fade" id="spModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/settings/sp/save">
        <div class="modal-header">
          <h5 class="modal-title" id="spModalTitle">Add Service Principal</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="id" id="spId">
          <div class="mb-3">
            <label for="spName" class="form-label">Name</label>
            <input type="text" class="form-control" id="spName" name="name" placeholder="e.g. Production Tenant" required>
          </div>
          <div class="mb-3">
            <label for="spTenantId" class="form-label">Tenant ID</label>
            <input type="text" class="form-control" id="spTenantId" name="tenantId" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" required>
          </div>
          <div class="mb-3">
            <label for="spClientId" class="form-label">Client ID (Application ID)</label>
            <input type="text" class="form-control" id="spClientId" name="clientId" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" required>
          </div>
          <div class="mb-3">
            <label for="spClientSecret" class="form-label">Client Secret</label>
            <input type="password" class="form-control" id="spClientSecret" name="clientSecret" placeholder="Enter client secret" required>
          </div>
          <div class="mb-3">
            <label for="spEnterpriseAppObjectId" class="form-label">Enterprise Application Object ID <span class="text-muted">(optional)</span></label>
            <input type="text" class="form-control" id="spEnterpriseAppObjectId" name="enterpriseAppObjectId" placeholder="Object ID from Enterprise Applications in Entra ID">
            <div class="form-text">Used for granting workspace access to this service principal. Find it in Entra ID → Enterprise Applications → your app → Object ID.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function openSpForm(button) {
  var isEdit = !!button;
  document.getElementById('spModalTitle').textContent = isEdit ? 'Edit Service Principal' : 'Add Service Principal';
  document.getElementById('spId').value = isEdit ? button.getAttribute('data-sp-id') || '' : '';
  document.getElementById('spName').value = isEdit ? button.getAttribute('data-sp-name') || '' : '';
  document.getElementById('spTenantId').value = isEdit ? button.getAttribute('data-sp-tenant-id') || '' : '';
  document.getElementById('spClientId').value = isEdit ? button.getAttribute('data-sp-client-id') || '' : '';
  document.getElementById('spClientSecret').value = '';
  document.getElementById('spEnterpriseAppObjectId').value = isEdit ? button.getAttribute('data-sp-eaoid') || '' : '';
}

async function testSP(id) {
  var resultDiv = document.getElementById('test-result-' + id);
  resultDiv.style.display = 'block';
  resultDiv.innerHTML = '<div class="alert alert-info py-1 small"><i class="bi bi-hourglass-split me-2"></i>Testing connection...</div>';
  try {
    var response = await fetch('/settings/sp/test/' + id, { method: 'POST' });
    var data = await response.json();
    if (data.success) {
      resultDiv.innerHTML = '<div class="alert alert-success py-1 small"><i class="bi bi-check-circle me-2"></i>' + data.message + '</div>';
    } else {
      resultDiv.innerHTML = '<div class="alert alert-danger py-1 small"><i class="bi bi-x-circle me-2"></i>' + data.message + '</div>';
    }
  } catch (err) {
    resultDiv.innerHTML = '<div class="alert alert-danger py-1 small"><i class="bi bi-x-circle me-2"></i>Test failed: ' + err.message + '</div>';
  }
}
</script>
<%- include('partials/footer') %>
