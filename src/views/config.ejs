<%- include('partials/header') %>
<div class="row">
  <div class="col-lg-8 mx-auto">
    <h2><i class="bi bi-gear me-2"></i>Settings</h2>
    <p class="text-muted">Configure Service Principals for Power BI API access.</p>

    <div id="flash-messages">
      <% if (success && success.length) { %>
        <% success.forEach(function(message) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
      <% if (error && error.length) { %>
        <% error.forEach(function(message) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i><%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- ── Service Principals ── -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0"><i class="bi bi-key me-2 text-primary"></i>Service Principals (<%= servicePrincipals.length %>)</h5>
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#spModal" onclick="openSpForm()">
        <i class="bi bi-plus-lg me-1"></i>Add Service Principal
      </button>
    </div>

    <% if (!servicePrincipals.length) { %>
      <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>No Service Principal configured yet.
        Add one to enable Power BI and Fabric API access. The first entry will be used for all API calls.
      </div>
    <% } %>

    <% servicePrincipals.forEach(function(sp, idx) { %>
      <div class="card mb-3 <%= idx === 0 ? 'border-primary' : '' %>">
        <div class="card-body py-2 d-flex justify-content-between align-items-center gap-3 flex-wrap">
          <div>
            <span class="<%= idx === 0 ? 'badge bg-primary me-2' : 'badge bg-secondary me-2' %>"><%= idx === 0 ? 'Active' : 'Inactive' %></span>
            <strong><i class="bi bi-key me-1 text-primary"></i><%= sp.name %></strong>
            <span class="text-muted small ms-2 font-monospace"><%= sp.client_id %></span>
            <% if (sp.key_vault_name) { %>
              <span class="badge bg-info ms-2"><i class="bi bi-safe me-1"></i>Key Vault</span>
            <% } %>
            <% if (sp.client_secret) { %>
              <span class="badge bg-secondary ms-2"><i class="bi bi-lock-fill me-1"></i>Stored secret</span>
            <% } %>
          </div>
          <div class="btn-group btn-group-sm ms-auto">
            <button class="btn btn-outline-secondary" onclick="testSP(<%= sp.id %>)">
              <i class="bi bi-plug me-1"></i>Test
            </button>
            <button
              class="btn btn-outline-primary"
              data-bs-toggle="modal"
              data-bs-target="#spModal"
              data-sp-id="<%= sp.id %>"
              data-sp-name="<%= sp.name %>"
              data-sp-tenant-id="<%= sp.tenant_id %>"
              data-sp-client-id="<%= sp.client_id %>"
              data-sp-eaoid="<%= sp.enterprise_app_object_id || '' %>"
              data-sp-kv-name="<%= sp.key_vault_name || '' %>"
              data-sp-kv-secret="<%= sp.key_vault_secret_name || '' %>"
              data-sp-has-secret="<%= sp.client_secret ? 'true' : 'false' %>"
              onclick="openSpForm(this)"
            >
              <i class="bi bi-pencil me-1"></i>Edit
            </button>
            <button class="btn btn-outline-danger rounded-end" onclick="confirmDeleteSp('<%= sp.id %>', '<%- (sp.name || '').replace(/'/g, '&#39;') %>')">
              <i class="bi bi-trash me-1"></i>Delete
            </button>
          </div>
          <form id="delete-sp-<%= sp.id %>" method="POST" action="/settings/sp/delete/<%= sp.id %>" style="display:none;"></form>
        </div>
        <div id="test-result-<%= sp.id %>" class="px-3 pb-2" style="display:none;"></div>
      </div>
    <% }) %>

    <div class="text-muted small mb-4">
      <i class="bi bi-info-circle me-1"></i>
      The first Service Principal in the list is used for all API calls (workspaces, capacities, analysis, storage).
    </div>
  </div>
</div>

<!-- Service Principal Modal -->
<div class="modal fade" id="spModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="POST" action="/settings/sp/save">
        <div class="modal-header">
          <h5 class="modal-title" id="spModalTitle"><i class="bi bi-key me-2"></i>Add Service Principal</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="id" id="spId">
          <div class="mb-3">
            <label for="spName" class="form-label">Name</label>
            <input type="text" class="form-control" id="spName" name="name" placeholder="e.g. Production Tenant" required>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="spTenantId" class="form-label">Tenant ID</label>
              <input type="text" class="form-control font-monospace" id="spTenantId" name="tenantId" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="spClientId" class="form-label">Client ID (Application ID)</label>
              <input type="text" class="form-control font-monospace" id="spClientId" name="clientId" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" required>
            </div>
          </div>

          <div class="card border-primary mb-3">
            <div class="card-body">
              <h6 class="card-title"><i class="bi bi-safe me-2 text-primary"></i>Client secret source</h6>
              <p class="text-muted small mb-3">Key Vault is recommended. Use a directly stored secret only when the vault cannot be reached from this app (for example a workspace in another tenant).</p>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="secretSource" id="secretSourceKv" value="keyvault" checked onchange="updateSecretSource()">
                <label class="form-check-label" for="secretSourceKv"><strong>Azure Key Vault</strong> <span class="badge bg-success ms-1">Recommended</span></label>
              </div>
              <div id="kvFields" class="ms-4 mb-3">
                <div class="row">
                  <div class="col-md-6 mb-3 mb-md-0">
                    <label for="spKvName" class="form-label">Key Vault Name</label>
                    <input type="text" class="form-control" id="spKvName" name="keyVaultName" placeholder="my-key-vault">
                    <div class="form-text">Azure Key Vault name (without .vault.azure.net)</div>
                  </div>
                  <div class="col-md-6">
                    <label for="spKvSecret" class="form-label">Secret Name</label>
                    <input type="text" class="form-control" id="spKvSecret" name="keyVaultSecretName" placeholder="pbi-sp-client-secret">
                    <div class="form-text">Name of the secret containing the SP client secret</div>
                  </div>
                </div>
                <div class="form-text mt-2">
                  <i class="bi bi-shield-check me-1 text-success"></i>
                  The App Service managed identity must have <strong>Key Vault Secrets User</strong> role on the vault.
                </div>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="secretSource" id="secretSourceDirect" value="direct" onchange="updateSecretSource()">
                <label class="form-check-label" for="secretSourceDirect"><strong>Enter the client secret directly</strong></label>
              </div>
              <div id="directFields" class="ms-4" style="display:none;">
                <label for="spClientSecret" class="form-label">Client Secret</label>
                <input type="password" class="form-control" id="spClientSecret" name="clientSecret" autocomplete="new-password" placeholder="Paste the client secret value">
                <div class="form-text" id="spClientSecretHelp">
                  Encrypted with AES-256-GCM before it is written to the database — it is never stored as plain text,
                  and it is never sent back to the browser.
                </div>
                <% if (typeof secretEncryptionReady !== 'undefined' && !secretEncryptionReady) { %>
                  <div class="alert alert-warning py-2 px-3 small mt-2 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>SECRET_ENCRYPTION_KEY is not set</strong> on this App Service, so a secret cannot be stored securely.
                    Add that app setting before using this option.
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="spEnterpriseAppObjectId" class="form-label">Enterprise Application Object ID <span class="text-muted">(optional)</span></label>
            <input type="text" class="form-control font-monospace" id="spEnterpriseAppObjectId" name="enterpriseAppObjectId" placeholder="Object ID from Enterprise Applications in Entra ID">
            <div class="form-text">Used for granting workspace access. Find it in Entra ID → Enterprise Applications → your app → Object ID.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function openSpForm(button) {
  var isEdit = !!button;
  document.getElementById('spModalTitle').innerHTML = isEdit ? '<i class="bi bi-key me-2"></i>Edit Service Principal' : '<i class="bi bi-key me-2"></i>Add Service Principal';
  document.getElementById('spId').value = isEdit ? button.getAttribute('data-sp-id') || '' : '';
  document.getElementById('spName').value = isEdit ? button.getAttribute('data-sp-name') || '' : '';
  document.getElementById('spTenantId').value = isEdit ? button.getAttribute('data-sp-tenant-id') || '' : '';
  document.getElementById('spClientId').value = isEdit ? button.getAttribute('data-sp-client-id') || '' : '';
  document.getElementById('spEnterpriseAppObjectId').value = isEdit ? button.getAttribute('data-sp-eaoid') || '' : '';
  document.getElementById('spKvName').value = isEdit ? button.getAttribute('data-sp-kv-name') || '' : '';
  document.getElementById('spKvSecret').value = isEdit ? button.getAttribute('data-sp-kv-secret') || '' : '';

  // Never round-trip a stored secret to the browser: the field starts empty and an
  // empty value on save means "keep the existing secret".
  var secretInput = document.getElementById('spClientSecret');
  secretInput.value = '';
  var hasStoredSecret = isEdit && button.getAttribute('data-sp-has-secret') === 'true';
  var usesKeyVault = !isEdit || !!(button.getAttribute('data-sp-kv-name') || '');
  document.getElementById('secretSourceKv').checked = usesKeyVault || !hasStoredSecret;
  document.getElementById('secretSourceDirect').checked = !usesKeyVault && hasStoredSecret;
  document.getElementById('spClientSecretHelp').innerHTML = hasStoredSecret
    ? 'A secret is already stored (encrypted). Leave this blank to keep it, or enter a new value to replace it.'
    : 'Encrypted with AES-256-GCM before it is written to the database — it is never stored as plain text, and it is never sent back to the browser.';
  updateSecretSource();
}

function updateSecretSource() {
  var useKv = document.getElementById('secretSourceKv').checked;
  document.getElementById('kvFields').style.display = useKv ? '' : 'none';
  document.getElementById('directFields').style.display = useKv ? 'none' : '';
  document.getElementById('spKvName').required = useKv;
  document.getElementById('spKvSecret').required = useKv;
}

async function testSP(id) {
  var resultDiv = document.getElementById('test-result-' + id);
  resultDiv.style.display = 'block';
  resultDiv.innerHTML = '<div class="alert alert-info py-1 small"><i class="bi bi-hourglass-split me-2"></i>Testing connection...</div>';
  try {
    var response = await fetch('/settings/sp/test/' + id, { method: 'POST' });
    var data = await response.json();
    if (data.requiresKeyVaultAuth && data.authUrl) {
      window.location.href = data.authUrl;
      return;
    }
    if (data.success) {
      resultDiv.innerHTML = '<div class="alert alert-success py-1 small"><i class="bi bi-check-circle me-2"></i>' + data.message + '</div>';
    } else {
      resultDiv.innerHTML = '<div class="alert alert-danger py-1 small"><i class="bi bi-x-circle me-2"></i>' + data.message + '</div>';
    }
  } catch (err) {
    resultDiv.innerHTML = '<div class="alert alert-danger py-1 small"><i class="bi bi-x-circle me-2"></i>Test failed: ' + err.message + '</div>';
  }
}

function confirmDeleteSp(id, name) {
  showConfirmAction({
    title: 'Delete Service Principal',
    message: 'Delete "' + name + '"? This cannot be undone.',
    confirmText: 'Delete',
    confirmClass: 'btn-danger',
    onConfirm: function() {
      if (typeof showPageReloading === 'function') {
        showPageReloading('Deleting service principal...');
      }
      document.getElementById('delete-sp-' + id).submit();
    }
  });
}
</script>
<%- include('partials/footer') %>
