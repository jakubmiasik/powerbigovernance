<%- include('../partials/header') %>
<%
  var o = overview || { workspaces: [], principals: [], grants: [], totals: {} };
  var t = o.totals || {};
  function badgeFor(right) { var level = accessLevel(right); return '<span class="badge bg-' + level.color + (level.color === 'light' ? ' text-dark border' : '') + '">' + level.label + '</span>'; }
%>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2><i class="bi bi-key me-2"></i>Grant Access</h2>
    <p class="text-muted mb-0">
      Who can reach which workspace, and adding the service principal where it is missing.
      <% if (run) { %>
        · From scan #<%= run.id %>, <%= run.started_at ? new Date(run.started_at).toLocaleString() : 'date unknown' %>
        · <%= describeScope(scopeFromRow(run)) %>
      <% } %>
    </p>
  </div>
  <div class="d-flex gap-2 align-items-center flex-wrap">
    <% if ((runs || []).length > 1) { %>
      <select class="form-select form-select-sm" style="max-width:280px;"
              onchange="window.location = '/settings/access?accessRunId=' + this.value">
        <% runs.forEach(function(r) { %>
          <option value="<%= r.id %>" <%= run && Number(run.id) === Number(r.id) ? 'selected' : '' %>>
            Scan #<%= r.id %> — <%= r.started_at ? new Date(r.started_at).toLocaleDateString() : 'unknown' %>
            (<%= describeScope(scopeFromRow(r), { limit: 1 }) %>)
          </option>
        <% }) %>
      </select>
    <% } %>
    <a href="/settings" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Settings</a>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
<% } %>

<% if (grantAuth) { %>
  <div class="alert alert-success alert-dismissible">
    <i class="bi bi-check-circle me-2"></i>Signed in as a Power BI administrator. You can now grant workspace access.
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (!run) { %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>No completed scan yet. Access is whatever the last scan observed, so
    <a href="/analysis">run an analysis</a> first.
  </div>
<% } else if (partialScope) { %>
  <div class="alert alert-warning">
    <i class="bi bi-funnel me-2"></i>This scan covered <strong><%= describeScope(scopeFromRow(run)) %></strong>, not the
    whole tenant, so everything below describes only those workspaces. The counts that read as tenant-wide —
    workspaces with no admin, how many principals hold access — are counts within that scope. Run a whole-tenant
    scan, or pick one above, for the full picture.
  </div>
<% } else if (!indexed) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>This scan has not been indexed, so the access below was read from
    its stored results rather than queried. It is the same data, read a slower way — indexing the run from the
    <a href="/analysis">Run Analysis</a> page makes it a query.
  </div>
<% } %>

<!-- ── What the access model looks like ── -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-2">
    <div class="card h-100"><div class="card-body py-3">
      <div class="text-muted small">Workspaces</div>
      <div class="h4 mb-0"><%= t.workspaces || 0 %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card h-100"><div class="card-body py-3">
      <div class="text-muted small">Access grants</div>
      <div class="h4 mb-0"><%= t.grants || 0 %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card h-100"><div class="card-body py-3">
      <div class="text-muted small">Principals</div>
      <div class="h4 mb-0"><%= t.principals || 0 %></div>
      <div class="small text-muted"><%= t.servicePrincipals || 0 %> service principal(s)</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card h-100 <%= (t.withoutAdmin || 0) ? 'border-danger' : '' %>"><div class="card-body py-3">
      <div class="text-muted small">No admin at all</div>
      <div class="h4 mb-0 <%= (t.withoutAdmin || 0) ? 'text-danger' : '' %>"><%= t.withoutAdmin || 0 %></div>
      <div class="small text-muted">Only a tenant admin can fix these</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card h-100 <%= (t.singleAdmin || 0) ? 'border-warning' : '' %>"><div class="card-body py-3">
      <div class="text-muted small">A single admin</div>
      <div class="h4 mb-0"><%= t.singleAdmin || 0 %></div>
      <div class="small text-muted">One departure from the above</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-2">
    <div class="card h-100 <%= (t.unreadable || 0) ? 'border-secondary' : '' %>"><div class="card-body py-3">
      <div class="text-muted small">Access unreadable</div>
      <div class="h4 mb-0"><%= t.unreadable || 0 %></div>
      <div class="small text-muted">Not "no users" — not seen</div>
    </div></div>
  </div>
</div>

<!-- ── Granting ── -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-shield-plus me-2"></i>Grant Service Principal Access to Workspaces</span>
    <button class="btn btn-sm btn-warning" onclick="openGrantAccess()" <%= (servicePrincipals || []).length ? '' : 'disabled' %>>
      <i class="bi bi-key me-1"></i>Grant access
    </button>
  </div>
  <div class="card-body py-3">
    <% if (!(servicePrincipals || []).length) { %>
      <div class="text-muted small">
        No service principal configured. <a href="/settings">Add one in Settings</a> first.
      </div>
    <% } else { %>
      <div class="row g-2 align-items-end">
        <div class="col-md-6">
          <label class="form-label small" for="grantSpSelect">Service principal</label>
          <select class="form-select form-select-sm" id="grantSpSelect">
            <% servicePrincipals.forEach(function(sp) { %>
              <option value="<%= sp.id %>" data-eaoid="<%= sp.enterprise_app_object_id || '' %>">
                <%= sp.name %> (<%= sp.tenant_id %>)<%= sp.enterprise_app_object_id ? '' : ' — no enterprise app object ID' %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <div class="form-text mb-0">
            <i class="bi bi-info-circle me-1"></i>The tenant-wide scan sees every workspace through the admin APIs, but
            reading a lakehouse or warehouse SQL endpoint needs the principal to be a <strong>member of the
            workspace</strong>. Granting uses the Power BI admin API and acts on behalf of an administrator, so it asks
            you to sign in as one. The principal is added as <strong>Admin</strong>.
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- ── Who has access to what ── -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-people me-2"></i>Who Has Access to What</span>
    <ul class="nav nav-pills nav-sm" role="tablist">
      <li class="nav-item"><button class="nav-link active btn-sm py-1" data-bs-toggle="tab" data-bs-target="#tabGrants" type="button">Every grant</button></li>
      <li class="nav-item"><button class="nav-link btn-sm py-1" data-bs-toggle="tab" data-bs-target="#tabWorkspaces" type="button">By workspace</button></li>
      <li class="nav-item"><button class="nav-link btn-sm py-1" data-bs-toggle="tab" data-bs-target="#tabPrincipals" type="button">By principal</button></li>
    </ul>
  </div>

  <div class="card-body py-3 border-bottom">
    <div class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small" for="accessSearch">Search</label>
        <input type="text" class="form-control form-control-sm" id="accessSearch"
               placeholder="Workspace, name or email" oninput="applyAccessFilters()">
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="accessRole">Role</label>
        <select class="form-select form-select-sm" id="accessRole" onchange="applyAccessFilters()">
          <option value="">Any role</option>
          <% accessLevels.forEach(function(level) { %>
            <option value="<%= level.key %>"><%= level.label %></option>
          <% }) %>
          <option value="unknown">Unknown</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="accessType">Principal type</label>
        <select class="form-select form-select-sm" id="accessType" onchange="applyAccessFilters()">
          <option value="">Any type</option>
          <% principalTypes.forEach(function(type) { %>
            <option value="<%= type.key %>"><%= type.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <div class="form-text mb-0" id="accessCount"></div>
      </div>
    </div>
  </div>

  <div class="tab-content">
    <!-- Every grant -->
    <div class="tab-pane fade show active" id="tabGrants">
      <div class="table-responsive" style="max-height:600px;">
        <table class="table table-sm table-hover mb-0" id="grantsTable">
          <thead class="sticky-top"><tr>
            <th>Workspace</th><th>Principal</th><th>Email</th><th>Type</th><th>Role</th>
          </tr></thead>
          <tbody>
            <% if (!o.grants.length) { %>
              <tr><td colspan="5" class="text-muted small py-3">No access grants recorded in this scan.</td></tr>
            <% } %>
            <% o.grants.forEach(function(g) { %>
              <tr data-search="<%= [g.workspaceName || '', g.displayName || '', g.email || ''].join(' ').toLowerCase() %>"
                  data-role="<%= g.accessRight %>" data-type="<%= g.principalType %>">
                <td class="small">
                  <a href="/workspaces/<%= g.workspaceId %>"><%= g.workspaceName || g.workspaceId %></a>
                </td>
                <td class="small"><%= g.displayName || '(no name recorded)' %></td>
                <td class="small text-muted"><%= g.email || '-' %></td>
                <td class="small"><%= principalTypeLabel(g.principalType) %></td>
                <td><%- badgeFor(g.accessRight) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- By workspace -->
    <div class="tab-pane fade" id="tabWorkspaces">
      <div class="table-responsive" style="max-height:600px;">
        <table class="table table-sm mb-0" id="workspacesTable">
          <thead class="sticky-top"><tr>
            <th style="width:32px;"></th>
            <th>Workspace</th><th>Capacity</th><th class="text-end">Items</th>
            <th class="text-end">People &amp; apps</th><th>Roles</th>
          </tr></thead>
          <tbody>
            <% if (!o.workspaces.length) { %>
              <tr><td colspan="6" class="text-muted small py-3">This scan recorded no workspaces.</td></tr>
            <% } %>
            <% o.workspaces.forEach(function(w, index) { %>
              <tr data-search="<%= (w.name || '').toLowerCase() %>" data-role="" data-type=""
                  class="<%= w.usersReadable && w.counts.admin === 0 ? 'table-danger' : '' %>">
                <td>
                  <% if (w.grants.length) { %>
                    <button class="btn btn-sm p-0 px-1" type="button" data-bs-toggle="collapse"
                            data-bs-target="#wsAccess-<%= index %>" title="Show who is in this workspace">
                      <i class="bi bi-chevron-right"></i>
                    </button>
                  <% } %>
                </td>
                <td class="small">
                  <a href="/workspaces/<%= w.workspaceId %>"><strong><%= w.name || w.workspaceId %></strong></a>
                  <% if (!w.usersReadable) { %>
                    <span class="badge bg-secondary ms-1" title="The scan could not read this workspace's access list">not readable</span>
                  <% } else if (w.counts.admin === 0) { %>
                    <span class="badge bg-danger ms-1" title="Nobody can administer this workspace or grant anyone else access to it">no admin</span>
                  <% } else if (w.counts.admin === 1) { %>
                    <span class="badge bg-warning text-dark ms-1" title="One departure from having no admin at all">single admin</span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= w.capacityName || '-' %></td>
                <td class="text-end small"><%= w.itemCount %></td>
                <td class="text-end small"><%= w.grants.length %></td>
                <td class="small">
                  <% accessLevels.forEach(function(level) { %>
                    <% if (w.counts[level.key]) { %>
                      <span class="badge bg-<%= level.color %> me-1"><%= w.counts[level.key] %> <%= level.label.toLowerCase() %></span>
                    <% } %>
                  <% }) %>
                  <% if (w.counts.unknown) { %><span class="badge bg-light text-dark border"><%= w.counts.unknown %> unknown</span><% } %>
                </td>
              </tr>
              <% if (w.grants.length) { %>
                <tr class="collapse" id="wsAccess-<%= index %>">
                  <td></td>
                  <td colspan="5" class="p-0">
                    <table class="table table-sm mb-0" style="background: var(--color-surface-2);">
                      <tbody>
                        <% w.grants.forEach(function(g) { %>
                          <tr>
                            <td class="small"><%= g.displayName || '(no name recorded)' %></td>
                            <td class="small text-muted"><%= g.email || '-' %></td>
                            <td class="small"><%= principalTypeLabel(g.principalType) %></td>
                            <td class="small"><%- badgeFor(g.accessRight) %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </td>
                </tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- By principal -->
    <div class="tab-pane fade" id="tabPrincipals">
      <div class="table-responsive" style="max-height:600px;">
        <table class="table table-sm mb-0" id="principalsTable">
          <thead class="sticky-top"><tr>
            <th style="width:32px;"></th>
            <th>Principal</th><th>Email</th><th>Type</th>
            <th class="text-end">Workspaces</th><th>Strongest</th><th>Roles held</th>
          </tr></thead>
          <tbody>
            <% if (!o.principals.length) { %>
              <tr><td colspan="7" class="text-muted small py-3">This scan recorded no access grants.</td></tr>
            <% } %>
            <% o.principals.forEach(function(p, index) { %>
              <tr data-search="<%= [p.displayName || '', p.email || ''].join(' ').toLowerCase() %>"
                  data-role="<%= p.strongest %>" data-type="<%= p.principalType %>">
                <td>
                  <button class="btn btn-sm p-0 px-1" type="button" data-bs-toggle="collapse"
                          data-bs-target="#pAccess-<%= index %>" title="Show which workspaces this principal can reach">
                    <i class="bi bi-chevron-right"></i>
                  </button>
                </td>
                <td class="small"><strong><%= p.displayName || p.email || '(no name recorded)' %></strong></td>
                <td class="small text-muted"><%= p.email || '-' %></td>
                <td class="small"><%= principalTypeLabel(p.principalType) %></td>
                <td class="text-end small"><%= p.workspaces.length %></td>
                <td><%- badgeFor(p.strongest) %></td>
                <td class="small">
                  <% accessLevels.forEach(function(level) { %>
                    <% if (p.counts[level.key]) { %>
                      <span class="badge bg-<%= level.color %> me-1"><%= p.counts[level.key] %> <%= level.label.toLowerCase() %></span>
                    <% } %>
                  <% }) %>
                </td>
              </tr>
              <tr class="collapse" id="pAccess-<%= index %>">
                <td></td>
                <td colspan="6" class="p-0">
                  <table class="table table-sm mb-0" style="background: var(--color-surface-2);">
                    <tbody>
                      <% p.workspaces.forEach(function(w) { %>
                        <tr>
                          <td class="small"><a href="/workspaces/<%= w.workspaceId %>"><%= w.name || w.workspaceId %></a></td>
                          <td class="small"><%- badgeFor(w.accessRight) %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card-footer small text-muted">
    Access is what the selected scan observed, not live state — grant a role after this scan ran and it appears on the
    next one. A workspace marked <strong>not readable</strong> is one the scan could not read the access list for,
    which is a gap in the evidence rather than a workspace with nobody in it.
  </div>
</div>

<script>
// ── Filtering ──
// One filter drives all three tables: the same question asked three ways should
// not need asking three times.
function applyAccessFilters() {
  var needle = document.getElementById('accessSearch').value.trim().toLowerCase();
  var role = document.getElementById('accessRole').value;
  var type = document.getElementById('accessType').value;
  var shown = 0;
  var total = 0;

  ['grantsTable', 'workspacesTable', 'principalsTable'].forEach(function(id) {
    var table = document.getElementById(id);
    if (!table) return;
    table.querySelectorAll('tbody tr').forEach(function(row) {
      // The expanded detail rows follow their parent and carry no filter data.
      if (!row.hasAttribute('data-search')) return;
      var matches = (!needle || (row.getAttribute('data-search') || '').indexOf(needle) !== -1)
        && (!role || !row.getAttribute('data-role') || row.getAttribute('data-role') === role)
        && (!type || !row.getAttribute('data-type') || row.getAttribute('data-type') === type);
      row.style.display = matches ? '' : 'none';
      if (id === 'grantsTable') { total += 1; if (matches) shown += 1; }
    });
  });

  document.getElementById('accessCount').textContent =
    (needle || role || type) ? shown + ' of ' + total + ' grant(s)' : total + ' grant(s)';
}

document.addEventListener('DOMContentLoaded', function() {
  applyAccessFilters();
  document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(function(button) {
    var target = document.querySelector(button.getAttribute('data-bs-target'));
    if (!target || !button.querySelector('i')) return;
    target.addEventListener('show.bs.collapse', function() { button.querySelector('i').className = 'bi bi-chevron-down'; });
    target.addEventListener('hide.bs.collapse', function() { button.querySelector('i').className = 'bi bi-chevron-right'; });
  });
});

// ── Granting ──
function escapeHtml(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

async function openGrantAccess() {
  var option = document.getElementById('grantSpSelect').selectedOptions[0];
  if (!option || !option.getAttribute('data-eaoid')) {
    showToast('This service principal has no Enterprise Application Object ID. Add it in Settings before granting access.', 'error');
    return;
  }

  // Granting acts on behalf of an administrator, so it needs a delegated sign-in
  // rather than the application's own credential.
  try {
    var authResp = await fetch('/governance/grant-auth/status');
    var authData = await authResp.json();
    if (!authData.authenticated) {
      showConfirmAction({
        title: 'Sign in as a Power BI administrator',
        message: 'Granting workspace access uses the Power BI admin API on behalf of an administrator. You will be redirected to sign in and brought back here.',
        confirmText: 'Sign in',
        confirmClass: 'btn-primary',
        onConfirm: function() { window.location.href = '/governance/grant-auth?returnTo=access'; },
      });
      return;
    }
  } catch (e) {
    showToast('Could not check the administrator sign-in: ' + e.message, 'error');
    return;
  }

  document.getElementById('grantWsList').innerHTML =
    '<div class="text-center py-3"><span class="spinner-border spinner-border-sm text-primary me-1"></span>Loading workspaces...</div>';
  document.getElementById('grantStatusArea').classList.add('d-none');
  document.getElementById('grantAccessBtn').disabled = false;
  new bootstrap.Modal(document.getElementById('grantAccessModal')).show();

  try {
    var params = new URLSearchParams({ spId: document.getElementById('grantSpSelect').value });
    <% if (run) { %>params.set('accessRunId', '<%= run.id %>');<% } %>
    var resp = await fetch('/settings/access/workspaces?' + params.toString());
    var data = await resp.json();
    if (!data.success) {
      document.getElementById('grantWsList').innerHTML = '<div class="alert alert-warning mb-0">' + escapeHtml(data.message) + '</div>';
      return;
    }

    var note = data.objectIdKnown
      ? '<div class="small text-muted mb-2">' + data.missing + ' workspace(s) do not have this principal. Those are ticked; the rest already have it.</div>'
      : '<div class="alert alert-warning py-2 small">This principal has no Enterprise Application Object ID recorded, so which workspaces already have it cannot be determined. Nothing is pre-selected.</div>';

    var html = data.workspaces.map(function(ws) {
      var already = ws.hasAccess
        ? ' <span class="badge bg-success">already ' + escapeHtml(ws.accessRight || 'a member') + '</span>'
        : '';
      var checked = (data.objectIdKnown && !ws.hasAccess) ? ' checked' : '';
      return '<div class="form-check grant-ws-item" data-name="' + escapeHtml((ws.name || '').toLowerCase()) + '" data-has="' + (ws.hasAccess ? '1' : '0') + '">' +
        '<input class="form-check-input grant-ws-cb" type="checkbox" value="' + escapeHtml(ws.workspaceId) + '" id="grant-' + escapeHtml(ws.workspaceId) + '"' + checked + '>' +
        '<label class="form-check-label small" for="grant-' + escapeHtml(ws.workspaceId) + '">' +
        escapeHtml(ws.name || 'Unnamed') + ' <span class="text-muted">(' + escapeHtml(ws.state || 'Active') + ')</span>' + already +
        '</label></div>';
    }).join('');

    document.getElementById('grantWsList').innerHTML = note +
      (html || '<div class="text-muted text-center py-3">This scan recorded no workspaces.</div>');
    updateGrantCount();
  } catch (e) {
    document.getElementById('grantWsList').innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(e.message) + '</div>';
  }
}

function toggleAllGrantWs(checked) {
  document.querySelectorAll('.grant-ws-item').forEach(function(item) {
    if (item.style.display === 'none') return;
    item.querySelector('.grant-ws-cb').checked = checked;
  });
  updateGrantCount();
}

function selectMissingGrantWs() {
  document.querySelectorAll('.grant-ws-item').forEach(function(item) {
    item.querySelector('.grant-ws-cb').checked = item.getAttribute('data-has') === '0';
  });
  updateGrantCount();
}

function filterGrantWs(query) {
  var needle = query.toLowerCase();
  document.querySelectorAll('.grant-ws-item').forEach(function(item) {
    item.style.display = item.getAttribute('data-name').indexOf(needle) !== -1 ? '' : 'none';
  });
}

function updateGrantCount() {
  var selected = document.querySelectorAll('.grant-ws-cb:checked').length;
  document.getElementById('grantCount').textContent = selected + ' selected';
  document.getElementById('grantAccessBtn').disabled = selected === 0;
}

async function grantSpAccess() {
  var selected = Array.from(document.querySelectorAll('.grant-ws-cb:checked')).map(function(cb) { return cb.value; });
  if (!selected.length) return;

  document.getElementById('grantStatusArea').classList.remove('d-none');
  document.getElementById('grantInProgress').classList.remove('d-none');
  document.getElementById('grantResult').classList.add('d-none');
  document.getElementById('grantAccessBtn').disabled = true;
  document.getElementById('grantStatusText').textContent = 'Granting access to ' + selected.length + ' workspace(s)...';

  var result = document.getElementById('grantResult');
  try {
    var resp = await fetch('/governance/grant-sp-access', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ workspaceIds: selected, spId: document.getElementById('grantSpSelect').value }),
    });
    var data = await resp.json();
    document.getElementById('grantInProgress').classList.add('d-none');
    result.classList.remove('d-none');

    if (!data.success) {
      result.innerHTML = '<div class="alert alert-danger mb-0"><i class="bi bi-x-circle me-1"></i>' + escapeHtml(data.message) + '</div>';
      document.getElementById('grantAccessBtn').disabled = false;
      return;
    }

    // Failures are named. "Granted 38 of 50" without saying which twelve, or why,
    // is not something anyone can act on.
    var failures = (data.results || []).filter(function(r) { return !r.success; });
    var detail = failures.length
      ? '<ul class="mb-0 mt-1 small">' + failures.slice(0, 20).map(function(r) {
          return '<li>' + escapeHtml(r.workspaceId) + ' — ' + escapeHtml(r.error) + '</li>';
        }).join('') + (failures.length > 20 ? '<li>… and ' + (failures.length - 20) + ' more</li>' : '') + '</ul>'
      : '';
    result.innerHTML = '<div class="alert alert-' + (failures.length ? 'warning' : 'success') + ' mb-0">' +
      '<i class="bi bi-' + (failures.length ? 'exclamation-triangle' : 'check-circle') + ' me-1"></i>' +
      escapeHtml(data.message) + detail +
      '<div class="small mt-1">The access list above still shows the last scan. Re-run an analysis to see the change here.</div>' +
      '</div>';
  } catch (e) {
    document.getElementById('grantInProgress').classList.add('d-none');
    result.classList.remove('d-none');
    result.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(e.message) + '</div>';
  }
  document.getElementById('grantAccessBtn').disabled = false;
}
</script>

<div class="modal fade" id="grantAccessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-key me-2"></i>Grant Service Principal Access</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-2">
          The principal is added as <strong>Admin</strong> to each selected workspace, through the Power BI admin API.
        </p>
        <div class="mb-3 d-flex gap-2 flex-wrap align-items-center">
          <button class="btn btn-sm btn-outline-secondary" onclick="selectMissingGrantWs()">Only those missing it</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="toggleAllGrantWs(true)">Select all</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="toggleAllGrantWs(false)">Deselect all</button>
          <input type="text" class="form-control form-control-sm" placeholder="Filter..." oninput="filterGrantWs(this.value)" style="max-width:220px;">
          <span class="small text-muted ms-auto" id="grantCount">0 selected</span>
        </div>
        <div style="max-height: 350px; overflow-y: auto;" id="grantWsList" onchange="updateGrantCount()"></div>
        <div class="d-none mt-3" id="grantStatusArea">
          <div class="d-flex align-items-center gap-2" id="grantInProgress">
            <div class="spinner-border spinner-border-sm text-primary"></div>
            <span id="grantStatusText">Granting access...</span>
          </div>
          <div class="d-none mt-2" id="grantResult"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="grantAccessBtn" onclick="grantSpAccess()" disabled>
          <i class="bi bi-check-lg me-1"></i>Grant access
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
